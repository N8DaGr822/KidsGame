    // ---- Paint jobs ----

    private bool OwnsPaint(string id) => id == "classic" || mineProfile.OwnedPaints.Contains(id);

    private string PaintClassFor(string id) => id == RainbowPaint ? "mo-paint-rainbow" : "";

    private string PaintStyleFor(string id)
    {
        var filter = Paints.FirstOrDefault(p => p.Id == id)?.Filter ?? "none";
        return filter == "none" ? "" : $"filter:{filter} drop-shadow(0 2px 3px #0009);";
    }

    private string PaintClass => PaintClassFor(mineProfile.SelectedPaint);
    private string PaintStyle => PaintStyleFor(mineProfile.SelectedPaint);

    private void BuyPaint(string id)
    {
        var paint = Paints.FirstOrDefault(p => p.Id == id);
        if (paint is null || paint.Unlock is not null || OwnsPaint(id) || gold < paint.Cost) return;
        gold -= paint.Cost;
        mineProfile.OwnedPaints.Add(id);
        mineProfile.SelectedPaint = id;
        _ = Interop.InvokeVoidAsync("playBuildCompleteSound");
        _ = SaveMineProfileAsync();
    }

    private void EquipPaint(string id)
    {
        if (!OwnsPaint(id)) return;
        mineProfile.SelectedPaint = id;
        _ = SaveMineProfileAsync();
    }

    private void UnlockPaint(string id)
    {
        if (OwnsPaint(id)) return;
        mineProfile.OwnedPaints.Add(id);
        ShowToast($"🎨 New paint job unlocked: {Paints.First(p => p.Id == id).Name}! Equip it at the Shipwright.");
        _ = SaveMineProfileAsync();
    }

    private static string ShipTabName(ShipTab tab) => tab switch
    {
        ShipTab.Upgrades => "⚙️ Upgrades",
        ShipTab.Supplies => "🎒 Supplies",
        _ => "🎨 Paint Shop",
    };

    // ---- Joystick ----

    // Maps the knob offset onto the same held directions the keyboard and
    // buttons use. Down needs a firmer, more vertical push so drifting the
    // thumb while steering doesn't start an accidental drill.
    private async Task OnStickDown(PointerEventArgs e)
    {
        if (phase != Phase.Playing || overlay != Overlay.None) return;
        stickPointerId = e.PointerId;
        stickRect = await Interop.InvokeAsync<StickRect>("getBoundingRect", stickRef);
        await Interop.InvokeVoidAsync("setPointerCapture", stickRef, e.PointerId);
        UpdateStick(e.ClientX, e.ClientY);
    }

    private void OnStickMove(PointerEventArgs e)
    {
        if (stickPointerId == e.PointerId) UpdateStick(e.ClientX, e.ClientY);
    }

    private void OnStickUp(PointerEventArgs e)
    {
        if (stickPointerId != e.PointerId) return;
        stickPointerId = null;
        stickX = stickY = 0;
        heldPointer.Clear();
        needsFocus = true;
    }

    private void UpdateStick(double clientX, double clientY)
    {
        if (stickRect is not { Width: > 0 } rect || overlay != Overlay.None) return;

        var radius = rect.Width / 2;
        var nx = (clientX - (rect.Left + radius)) / radius;
        var ny = (clientY - (rect.Top + rect.Height / 2)) / radius;
        var len = Math.Sqrt(nx * nx + ny * ny);
        if (len > 1)
        {
            nx /= len;
            ny /= len;
        }
        stickX = nx;
        stickY = ny;

        heldPointer.Clear();
        if (nx < -0.35) heldPointer.Add(Direction.Left);
        if (nx > 0.35) heldPointer.Add(Direction.Right);
        if (ny < -0.35) heldPointer.Add(Direction.Up);
        if (ny > 0.55 && Math.Abs(nx) < 0.6) heldPointer.Add(Direction.Down);
    }

    private void ToggleControls()
    {
        mineProfile.UseButtons = !mineProfile.UseButtons;
        stickPointerId = null;
        stickX = stickY = 0;
        heldPointer.Clear();
        needsFocus = true;
        _ = SaveMineProfileAsync();
    }

    // ---- Camera & input ----

    private void UpdateCamera(double dt)
    {
        var targetX = Math.Clamp(px - visibleCols / 2.0, 0, Cols - visibleCols);
        var targetY = Math.Clamp(py - visibleRows * 0.45, SkyTop, TotalDepthRows + 1 - visibleRows);
        var k = Math.Min(1, dt * 9);
        camX += (targetX - camX) * k;
        camY += (targetY - camY) * k;
    }

    private void SetHeld(Direction d)
    {
        if (overlay == Overlay.None) heldPointer.Add(d);
    }

    private void ClearHeld(Direction d)
    {
        heldPointer.Remove(d);
        needsFocus = true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (phase != Phase.Playing || overlay != Overlay.None) return;
        if (KeyToDirection(e.Key) is { } d)
        {
            heldKeys.Add(d);
            return;
        }
        if (e.Key.Length == 1 && e.Key[0] is >= '1' and <= '6')
            UseItem(ItemKinds[e.Key[0] - '1']);
    }

    private void OnKeyUp(KeyboardEventArgs e)
    {
        if (KeyToDirection(e.Key) is { } d) heldKeys.Remove(d);
    }

    private static Direction? KeyToDirection(string key) => key switch
    {
        "ArrowUp" or "w" or "W" => Direction.Up,
        "ArrowDown" or "s" or "S" => Direction.Down,
        "ArrowLeft" or "a" or "A" => Direction.Left,
        "ArrowRight" or "d" or "D" => Direction.Right,
        _ => null,
    };

    private void Shake() => shakeUntilUtc = DateTime.UtcNow.AddSeconds(0.3);

    private void ShowToast(string message)
    {
        toast = message;
        toastUntilUtc = DateTime.UtcNow.AddSeconds(ToastSeconds);
    }

    private string Hint
    {
        get
        {
            if (!Underground) return "Drive into a building and stop to visit it. Hold ⬇️ to drill down.";
            if (FuelPct < 25) return "⛽ Fuel is low - fly home to the Fuel Dock!";
            if (HullPct < 25) return "🛠️ Hull badly damaged - head home for repairs!";
            if (CargoCount >= CargoCapacity(cargoTier)) return "🎒 Cargo full - fly up and sell at the Trader!";
            return "Hold ⬆️ to fly. You can't drill upward - keep a shaft open to get home!";
        }
    }

    // ---- World generation ----

    // A fixed-size grid built once per run. Odds shift by depth tier from
    // soft dirt/copper near the surface to bedrock, diamonds, and lava far
    // below; horizontal caverns break up the rock, and the treasure sits in
    // the bottom row under a bedrock floor. Difficulty scales hazard odds.
    private void GenerateWorld(Difficulty diff)
    {
        tiles = new TileKind[TotalDepthRows + 1, Cols];
        var hazardMul = HazardMultiplier(diff);

        for (var r = 1; r < TotalDepthRows; r++)
        {
            var table = TierTable(r, hazardMul);
            for (var c = 0; c < Cols; c++)
            {
                var kind = PickWeighted(table);
                if (r <= 2 && kind is TileKind.Empty or TileKind.Gas or TileKind.Lava or TileKind.Boulder) kind = TileKind.Dirt;
                tiles[r, c] = kind;
            }

            if (r >= 8 && r < TotalDepthRows - 2 && rng.NextDouble() < 0.12)
            {
                var len = rng.Next(2, 6);
                var start = rng.Next(0, Cols - len);
                for (var c = start; c < start + len; c++) tiles[r, c] = TileKind.Empty;
            }
        }

        for (var c = 0; c < Cols; c++)
            tiles[TotalDepthRows, c] = c == CenterCol ? TileKind.Treasure : TileKind.Bedrock;
    }

    private (TileKind Kind, double Weight)[] TierTable(int row, double hazardMul)
    {
        (TileKind Kind, double Weight)[] baseTable = row switch
        {
            <= 12 => new (TileKind, double)[] { (TileKind.Dirt, 74), (TileKind.Copper, 16), (TileKind.Silver, 3), (TileKind.Stone, 5), (TileKind.Empty, 2), (TileKind.Crate, 0.6) },
            <= 35 => new (TileKind, double)[] { (TileKind.Stone, 46), (TileKind.Dirt, 14), (TileKind.Copper, 8), (TileKind.Silver, 13), (TileKind.Gold, 3), (TileKind.HardRock, 5), (TileKind.Empty, 3), (TileKind.Gas, 4), (TileKind.Boulder, 2), (TileKind.LooseRock, 4), (TileKind.Crate, 0.8) },
            <= 60 => new (TileKind, double)[] { (TileKind.HardRock, 38), (TileKind.Stone, 16), (TileKind.Silver, 7), (TileKind.Gold, 10), (TileKind.Emerald, 4), (TileKind.DenseRock, 6), (TileKind.Empty, 3), (TileKind.Gas, 5), (TileKind.Lava, 5), (TileKind.Boulder, 3), (TileKind.LooseRock, 5), (TileKind.Crate, 0.8) },
            <= 90 => new (TileKind, double)[] { (TileKind.DenseRock, 34), (TileKind.HardRock, 16), (TileKind.Gold, 5), (TileKind.Emerald, 9), (TileKind.Ruby, 5), (TileKind.Diamond, 1.5), (TileKind.Empty, 3), (TileKind.Gas, 5), (TileKind.Lava, 10), (TileKind.Boulder, 4), (TileKind.LooseRock, 5), (TileKind.Crate, 0.8) },
            _ => new (TileKind, double)[] { (TileKind.Bedrock, 32), (TileKind.DenseRock, 16), (TileKind.Emerald, 4), (TileKind.Ruby, 9), (TileKind.Diamond, 6), (TileKind.Relic, 2.5), (TileKind.Empty, 3), (TileKind.Gas, 6), (TileKind.Lava, 15), (TileKind.Boulder, 4), (TileKind.LooseRock, 4), (TileKind.Crate, 0.8) },
        };

        return baseTable.Select(t => (t.Kind, t.Kind is TileKind.Gas or TileKind.Lava or TileKind.Boulder or TileKind.LooseRock ? t.Weight * hazardMul : t.Weight)).ToArray();
    }

    private TileKind PickWeighted((TileKind Kind, double Weight)[] table)
    {
        var total = table.Sum(t => t.Weight);
        var roll = rng.NextDouble() * total;
        var acc = 0.0;
        foreach (var (kind, weight) in table)
        {
            acc += weight;
            if (roll <= acc) return kind;
        }
        return table[^1].Kind;
    }

    // ---- Tile data ----

    private static int Hardness(TileKind k) => k switch
    {
        TileKind.Empty => 0,
        TileKind.Dirt or TileKind.Copper or TileKind.Gas or TileKind.Crate => 1,
        TileKind.Stone or TileKind.Silver or TileKind.LooseRock => 2,
        TileKind.HardRock or TileKind.Gold or TileKind.Emerald or TileKind.Lava => 3,
        TileKind.DenseRock or TileKind.Ruby or TileKind.Diamond => 4,
        TileKind.Bedrock or TileKind.Relic => 5,
        _ => 6, // Treasure (Boulder is never drillable)
    };

    private static int MaxHardness(int drillTierValue) => drillTierValue + 1;

    private static double DigSeconds(TileKind kind, int drillTierValue) =>
        (0.3 + 0.3 * Hardness(kind)) / (1 + 0.35 * (drillTierValue - 1));

    private static string HardnessName(int hardness) => hardness switch
    {
        <= 1 => "dirt",
        2 => "stone",
        3 => "hard rock",
        4 => "dense rock",
        5 => "bedrock",
        _ => "the vault",
    };

    private static bool IsOre(TileKind k) =>
        k is TileKind.Copper or TileKind.Silver or TileKind.Gold or TileKind.Emerald or TileKind.Ruby or TileKind.Diamond or TileKind.Relic;

    private static int OreValue(TileKind k) => k switch
    {
        TileKind.Copper => 20,
        TileKind.Silver => 45,
        TileKind.Gold => 120,
        TileKind.Emerald => 300,
        TileKind.Ruby => 800,
        TileKind.Diamond => 2000,
        TileKind.Relic => 5000,
        _ => 0,
    };

    // Hard mode disguises gas as stone, but it shimmers into view once the
    // pod is right next to it - a fair warning rather than a pure trap.
    private TileKind DisplayKind(TileKind k, int r, int c)
    {
        if (k != TileKind.Gas || !HideGas) return k;
        var near = Math.Abs(r + 0.5 - py) < 1.6 && Math.Abs(c + 0.5 - px) < 1.6;
        return near ? TileKind.Gas : TileKind.Stone;
    }

    private static string? TileGlyph(TileKind k) => k switch
    {
        TileKind.Gas => "💨",
        TileKind.Boulder => "🪨",
