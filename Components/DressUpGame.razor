    private static bool IsOutfitSticker(StickerDef sticker) =>
        sticker.Id.Contains("dress", StringComparison.Ordinal) ||
        sticker.Id.Contains("gown", StringComparison.Ordinal) ||
        sticker.Id.Contains("pinafore", StringComparison.Ordinal) ||
        sticker.Id.Contains("outfit", StringComparison.Ordinal) ||
        sticker.Id.Contains("tailcoat", StringComparison.Ordinal) ||
        sticker.Id.Contains("pirate-coat", StringComparison.Ordinal) ||
        sticker.Id.Contains("corset", StringComparison.Ordinal) ||
        sticker.Id.Contains("skirt", StringComparison.Ordinal);

    private static bool IsHeadwearSticker(StickerDef sticker) =>
        sticker.Id.Contains("crown", StringComparison.Ordinal) ||
        sticker.Id.Contains("hat", StringComparison.Ordinal) ||
        sticker.Id.Contains("tiara", StringComparison.Ordinal);

    private static bool IsJewelrySticker(StickerDef sticker) =>
        sticker.Id.Contains("necklace", StringComparison.Ordinal) ||
        sticker.Id.Contains("pendant", StringComparison.Ordinal) ||
        sticker.Id.Contains("bracelet", StringComparison.Ordinal);

    private static bool IsBagSticker(StickerDef sticker) =>
        sticker.Id.Contains("bag", StringComparison.Ordinal) ||
        sticker.Id.Contains("purse", StringComparison.Ordinal);

    private static bool IsWearableSticker(StickerDef sticker) =>
        sticker.Id.Contains("shoes", StringComparison.Ordinal) ||
        sticker.Id.Contains("boots", StringComparison.Ordinal) ||
        sticker.Id.Contains("gloves", StringComparison.Ordinal) ||
        sticker.Id.Contains("belt", StringComparison.Ordinal) ||
        sticker.Id.Contains("shoulder", StringComparison.Ordinal);

    private static bool IsFantasySticker(StickerDef sticker) =>
        sticker.Id.Contains("horn", StringComparison.Ordinal) ||
        sticker.Id.Contains("wings", StringComparison.Ordinal) ||
        sticker.Id == "fire";

    private static bool IsSpaceSticker(StickerDef sticker) =>
        sticker.Id.StartsWith("space-", StringComparison.Ordinal);

