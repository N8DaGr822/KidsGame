@page "/admin/access/{ProfileId}"
@inject AppDataService Data
@inject AppState State
@inject NavigationManager Nav

<div class="screen admin-screen">
    @if (State.CurrentProfile is null || State.CurrentProfile.Type != ProfileType.Admin)
    {
        <p class="muted">Redirecting…</p>
    }
    else if (_profile is null || _allGames is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="admin-header">
            <a class="link-back" href="admin">← Back to admin</a>
            <h1>Games for @_profile.Name</h1>
        </div>

        <section class="admin-section">
            <div class="admin-section-header">
                <h2>Game catalog</h2>
                <button class="btn-primary" @onclick="StartAddGame">+ Add game to catalog</button>
            </div>

            @if (_allGames.Count > 0)
            {
                <div class="access-controls">
                    <label class="access-search">
                        <span class="muted">Search</span>
                        <input type="search" placeholder="Search games…" value="@_searchText" @oninput="e => _searchText = (string)e.Value!" />
                    </label>
                    <label class="access-sort">
                        <span class="muted">Sort by</span>
                        <select value="@_sortKey" @onchange="e => SetSortKey((string)e.Value!)">
                            <option value="@nameof(GameSortKey.Name)">Name</option>
                            <option value="@nameof(GameSortKey.Age)">Age</option>
                            <option value="@nameof(GameSortKey.Enabled)">Enabled first</option>
                        </select>
                    </label>
                    <div class="access-bulk-actions">
                        <button type="button" class="btn-secondary" @onclick="SelectAllFilteredAsync">Select all@(_searchText.Length > 0 ? " (filtered)" : "")</button>
                        <button type="button" class="btn-secondary" @onclick="ClearAllFilteredAsync">Clear all@(_searchText.Length > 0 ? " (filtered)" : "")</button>
                    </div>
                </div>
            }

            @if (_allGames.Count == 0)
            {
                <p class="muted">No games in the catalog yet. Add one to get started.</p>
            }
            else
            {
                var filteredGames = SortedGames().ToList();
                @if (filteredGames.Count == 0)
                {
                    <p class="muted">No games match "@_searchText".</p>
                }
                else
                {
                    <div class="access-list">
                        @foreach (var game in filteredGames)
                        {
                            <div class="access-row">
                                <input type="checkbox"
                                       checked="@_allowedIds.Contains(game.Id)"
                                       @onchange="e => ToggleAccessAsync(game.Id, (bool)e.Value!)" />
                                <AssetGlyph Class="access-row-thumb" Src="@game.ThumbnailImagePath" Fallback="@game.ThumbnailEmoji" Alt="@game.Title" />
                                <span class="access-row-title">@game.Title</span>
                                <div class="access-row-meta">
                                    @if (game.MinAge is not null || game.MaxAge is not null)
                                    {
                                        <span class="access-row-age">Ages @AgeRangeLabel(game)</span>
                                    }
                                    @if (!game.IsCatalogEnabled)
                                    {
                                        <span class="access-row-hidden">Hidden from catalog</span>
                                    }
                                    @if (SupportsDifficultyLock(game))
                                    {
                                        <label class="access-row-difficulty">
                                            <span class="muted">Difficulty</span>
                                            <select value="@(_difficultyOverrides.GetValueOrDefault(game.Id, ""))"
                                                    @onchange="e => SetDifficultyOverrideAsync(game.Id, (string)e.Value!)">
                                                <option value="">Let @_profile.Name choose</option>
                                                <option value="Easy">Easy</option>
                                                <option value="Medium">Medium</option>
                                                <option value="Hard">Hard</option>
                                            </select>
                                        </label>
                                    }
                                </div>
                                <button type="button" class="btn-secondary" @onclick="() => StartEditGame(game)">Edit</button>
                            </div>
                        }
                    </div>
                }
            }
        </section>

        @if (_editingCatalogGame is not null)
        {
            <div class="pin-modal-backdrop">
                <div class="pin-modal">
                    <h2>Edit game art</h2>
                    <label>
                        Title
                        <input @bind="_editingCatalogGame.Title" />
                    </label>
                    <label>
                        Thumbnail image path
                        <input @bind="_editingCatalogGame.ThumbnailImagePath" placeholder="images/game-thumbs/memory-match.png" />
                    </label>
                    <label>
                        Thumbnail fallback emoji
                        <input @bind="_editingCatalogGame.ThumbnailEmoji" maxlength="8" />
                    </label>
                    <div class="age-range-fields">
                        <label>
                            Min age
                            <input type="number" min="0" max="18" @bind="_editingCatalogGame.MinAge" />
                        </label>
                        <label>
                            Max age
                            <input type="number" min="0" max="18" @bind="_editingCatalogGame.MaxAge" />
                        </label>
                    </div>
                    <label>
                        <span>
                            <input type="checkbox" @bind="_editingCatalogGame.IsCatalogEnabled" />
                            Show in game catalog
                        </span>
                    </label>
                    <div class="pin-modal-actions">
                        <button class="btn-secondary" @onclick="CancelEditGame">Cancel</button>
                        <button class="btn-primary" @onclick="SaveCatalogGameAsync">Save</button>
                    </div>
                </div>
            </div>
        }

        @if (_showAddGame)
        {
            <div class="pin-modal-backdrop">
                <div class="pin-modal">
                    <h2>Add game</h2>

                    @if (_availableBuiltIns.Count > 0)
                    {
                        <p class="muted">Choose a game that's built into the app:</p>
                        <div class="access-list">
                            @foreach (var builtIn in _availableBuiltIns)
                            {
                                <button class="access-row" @onclick="() => AddBuiltInGameAsync(builtIn)">
                                    <AssetGlyph Class="access-row-thumb" Src="@builtIn.ThumbnailImagePath" Fallback="@builtIn.ThumbnailEmoji" Alt="@builtIn.Title" />
                                    <span class="access-row-title">@builtIn.Title</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">Every built-in game is already in your catalog.</p>
                    }

                    <details>
                        <summary>Add a web game by link instead</summary>
                        <label>
                            Title
                            <input @bind="_editingGame.Title" />
                        </label>
                        <label>
                            Thumbnail image path
                            <input @bind="_editingGame.ThumbnailImagePath" placeholder="images/game-thumbs/my-game.png" />
                        </label>
                        <label>
                            Thumbnail fallback emoji
                            <input @bind="_editingGame.ThumbnailEmoji" maxlength="8" />
                        </label>
                        <label>
                            Web address
                            <input @bind="_editingGame.LaunchTarget" placeholder="https://…" />
                        </label>
                        <div class="age-range-fields">
                            <label>
                                Min age
                                <input type="number" min="0" max="18" @bind="_editingGame.MinAge" />
                            </label>
                            <label>
                                Max age
                                <input type="number" min="0" max="18" @bind="_editingGame.MaxAge" />
                            </label>
                        </div>
                        <div class="pin-modal-actions">
                            <button class="btn-primary" @onclick="SaveExternalGameAsync">Add web game</button>
                        </div>
                    </details>

                    <div class="pin-modal-actions">
                        <button class="btn-secondary" @onclick="CancelAddGame">Close</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string ProfileId { get; set; } = "";

    private static readonly HashSet<string> DifficultyLockableTargets = new()
    {
        BuiltInGames.MemoryMatch,
        BuiltInGames.SimonSays,
        BuiltInGames.SlidingPuzzle,
        BuiltInGames.WordScramble,
        BuiltInGames.Minesweeper,
        BuiltInGames.Sudoku,
        BuiltInGames.WhackAMole,
        BuiltInGames.CatchGame,
        BuiltInGames.FruitSlice,
        BuiltInGames.BubblePop,
        BuiltInGames.ReactionTimer,
        BuiltInGames.RedLightGreenLight,
        BuiltInGames.TicTacToe,
        BuiltInGames.ConnectFour,
        BuiltInGames.RockPaperScissors,
        BuiltInGames.HigherOrLower,
        BuiltInGames.TowerDefense,
        BuiltInGames.OddOneOut,
        BuiltInGames.PatternComplete,
        BuiltInGames.NumberSequence,
        BuiltInGames.ColorMatch,
        BuiltInGames.ShapeSorter,
        BuiltInGames.ShadowMatch,
        BuiltInGames.GuessTheWord,
        BuiltInGames.WordSearch,
        BuiltInGames.Mastermind,
        BuiltInGames.CodeBreaker,
        BuiltInGames.Battleships,
        BuiltInGames.DotsAndBoxes,
        BuiltInGames.Puzzle2048,
        BuiltInGames.Reversi,
        BuiltInGames.Cryptogram,
        BuiltInGames.MorseCodeChallenge,
        BuiltInGames.RobotCommands,
        BuiltInGames.ArcheryChallenge,
        BuiltInGames.BasketballShot,
        BuiltInGames.PenaltyShootout,
        BuiltInGames.LaserMaze,
        BuiltInGames.RhythmGame,
        BuiltInGames.WordLadder,
        BuiltInGames.TriviaBattle,
        BuiltInGames.FlagGuessingGame,
        BuiltInGames.AirHockey,
    };

    // Extend with more cases (e.g. play count, difficulty) as new sortable
    // fields get added to Game - the dropdown and SortedGames() below are
    // the only two places a new key needs wiring.
    private enum GameSortKey { Name, Age, Enabled }

    private Profile? _profile;
    private List<Game>? _allGames;
    private GameSortKey _sortKey = GameSortKey.Name;
    private string _searchText = "";
    private List<string> _allowedIds = new();
    private Dictionary<string, string> _difficultyOverrides = new();
    private bool _showAddGame;
    private Game _editingGame = new();
    private Game? _editingCatalogGame;
    private List<BuiltInGame> _availableBuiltIns = new();

    protected override async Task OnInitializedAsync()
    {
        if (State.CurrentProfile is null || State.CurrentProfile.Type != ProfileType.Admin)
        {
            Nav.NavigateTo("");
            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var profiles = await Data.GetProfilesAsync();
        _profile = profiles.FirstOrDefault(p => p.Id == ProfileId);

        if (_profile is null)
        {
            Nav.NavigateTo("admin");
            return;
        }

        _allGames = await Data.GetAllGamesAsync();
        _allowedIds = await Data.GetAccessListAsync(ProfileId);

        _difficultyOverrides.Clear();
        foreach (var game in _allGames.Where(SupportsDifficultyLock))
        {
            var value = await Data.GetDifficultyOverrideAsync(ProfileId, game.Id);
            if (!string.IsNullOrEmpty(value)) _difficultyOverrides[game.Id] = value;
        }

        var catalogTargets = _allGames.Select(g => g.LaunchTarget).ToHashSet();
        _availableBuiltIns = BuiltInGames.All.Where(b => !catalogTargets.Contains(b.LaunchTarget)).ToList();
    }

    private static bool SupportsDifficultyLock(Game game) => DifficultyLockableTargets.Contains(game.LaunchTarget);

    private void SetSortKey(string value)
    {
        _sortKey = Enum.TryParse<GameSortKey>(value, out var key) ? key : GameSortKey.Name;
    }

    private IEnumerable<Game> FilteredGames() =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _allGames!
            : _allGames!.Where(g => g.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    // Games without an age set sort after ones that have it, regardless of
    // sort direction, so unrated catalog entries don't scatter to the top.
    private IEnumerable<Game> SortedGames() => _sortKey switch
    {
        GameSortKey.Age => FilteredGames().OrderBy(g => g.MinAge is null).ThenBy(g => g.MinAge).ThenBy(g => g.Title),
        GameSortKey.Enabled => FilteredGames().OrderByDescending(g => _allowedIds.Contains(g.Id)).ThenBy(g => g.Title),
        _ => FilteredGames().OrderBy(g => g.Title),
    };

    private static string AgeRangeLabel(Game game) => (game.MinAge, game.MaxAge) switch
    {
        (int min, int max) => $"{min}-{max}",
        (int min, null) => $"{min}+",
        (null, int max) => $"up to {max}",
        _ => "",
    };

    private async Task SetDifficultyOverrideAsync(string gameId, string difficulty)
    {
        await Data.SetDifficultyOverrideAsync(ProfileId, gameId, difficulty);
        if (string.IsNullOrEmpty(difficulty))
        {
            _difficultyOverrides.Remove(gameId);
        }
        else
        {
            _difficultyOverrides[gameId] = difficulty;
        }
    }

    private async Task ToggleAccessAsync(string gameId, bool allowed)
    {
        await Data.SetGameAccessAsync(ProfileId, gameId, allowed);
        _allowedIds = await Data.GetAccessListAsync(ProfileId);
    }

    // Both act on SortedGames() - the currently searched/sorted list - not
    // the whole catalog, so a parent can search "puzzle" and grant just
    // that group without touching everything else.
    private async Task SelectAllFilteredAsync()
    {
        await Data.SetGameAccessBulkAsync(ProfileId, SortedGames().Select(g => g.Id).ToList(), allowed: true);
        _allowedIds = await Data.GetAccessListAsync(ProfileId);
    }

    private async Task ClearAllFilteredAsync()
    {
        await Data.SetGameAccessBulkAsync(ProfileId, SortedGames().Select(g => g.Id).ToList(), allowed: false);
        _allowedIds = await Data.GetAccessListAsync(ProfileId);
    }

    private void StartAddGame()
    {
        _editingGame = new Game();
        _showAddGame = true;
    }

    private void CancelAddGame()
    {
        _showAddGame = false;
    }

    private void StartEditGame(Game game)
    {
        _editingCatalogGame = new Game
        {
            Id = game.Id,
            Title = game.Title,
            ThumbnailImagePath = game.ThumbnailImagePath,
            ThumbnailEmoji = game.ThumbnailEmoji,
            LaunchTarget = game.LaunchTarget,
            LaunchMode = game.LaunchMode,
            IsCatalogEnabled = game.IsCatalogEnabled,
            MinAge = game.MinAge,
            MaxAge = game.MaxAge
        };
    }

    private void CancelEditGame() => _editingCatalogGame = null;

    private async Task SaveCatalogGameAsync()
    {
        if (_editingCatalogGame is null || string.IsNullOrWhiteSpace(_editingCatalogGame.Title))
            return;

        await Data.UpdateGameAsync(_editingCatalogGame);
        _editingCatalogGame = null;
        await RefreshAsync();
    }

    private async Task AddBuiltInGameAsync(BuiltInGame builtIn)
    {
        await Data.AddGameAsync(new Game
        {
            Title = builtIn.Title,
            ThumbnailImagePath = builtIn.ThumbnailImagePath,
            ThumbnailEmoji = builtIn.ThumbnailEmoji,
            LaunchTarget = builtIn.LaunchTarget,
            LaunchMode = GameLaunchMode.InternalRoute,
            MinAge = builtIn.MinAge,
            MaxAge = builtIn.MaxAge
        });

        _showAddGame = false;
        await RefreshAsync();
    }

    private async Task SaveExternalGameAsync()
    {
        if (string.IsNullOrWhiteSpace(_editingGame.Title) || string.IsNullOrWhiteSpace(_editingGame.LaunchTarget))
            return;

        _editingGame.LaunchMode = GameLaunchMode.ExternalIframe;
        await Data.AddGameAsync(_editingGame);

        _showAddGame = false;
        await RefreshAsync();
    }
}
