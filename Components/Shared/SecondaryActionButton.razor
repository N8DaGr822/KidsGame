@* Outlined action button (.game-secondary-action in app.css) - "Exit",
   "Change Game", "Close", etc. Same shape as PrimaryActionButton. *@

<button class="game-secondary-action @Class" disabled="@Disabled" @onclick="OnClick">
    @ChildContent
</button>

@code {
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
