@*
    PeekReveal.razor
    A toddler cause-and-effect toy (~1 year old target): tap a hiding spot
    and something friendly appears with a sound. No score, no timer, no
    fail state - every tap is a valid, pleasant action. Three presentation
    themes cover the "peek/reveal" family of ideas from the roadmap
    (Curtain doubles as "what's in the box", Doors is "open the doors",
    Egg is "egg surprise" / "where did it go") without three near-identical
    components.

    Unlike the arcade games, there's no natural "round" to complete, so
    the in-scene Exit button itself is what logs the play session - it
    fires OnComplete with how long the child played and how many reveals
    they triggered, then returns to the theme picker.

    Usage:
        <PeekReveal OnComplete="HandleGameComplete" />
*@
@inject InteropService Interop

<div class="pr-game">

    @if (phase == Phase.Setup)
    {
        <div class="pr-setup game-setup-panel">
            <h2>🎁 Peek-a-Boo</h2>
            <p>Tap to see what's hiding! Every tap is a happy surprise.</p>

            <h3 class="pr-section-title game-section-title">Choose a theme</h3>
            <div class="pr-theme-select game-option-grid">
                @foreach (var t in Themes)
                {
                    <button class="pr-theme-btn game-option-button @(t.Name == selectedTheme.Name ? "selected" : "")" @onclick="() => selectedTheme = t">
                        <span class="pr-theme-icon">@t.Icon</span>
                        <span class="pr-theme-name">@t.Name</span>
                    </button>
                }
            </div>

            <button class="pr-start-btn game-primary-action" @onclick="StartGame">Start</button>
        </div>
    }
    else
    {
        <div class="pr-hud game-hud">
            <span class="pr-title">@selectedTheme.Name</span>
            <button class="pr-restart-btn game-secondary-action" @onclick="FinishSession">All done</button>
        </div>

        <div class="pr-scene">
            @if (selectedTheme.Kind == ThemeKind.Doors)
            {
                <div class="pr-doors">
                    @for (var i = 0; i < doorItems.Length; i++)
                    {
                        var idx = i;
                        <button class="pr-door @(doorOpen[idx] ? "open" : "")" @onclick="() => TapDoor(idx)">
                            @if (doorOpen[idx])
                            {
                                <span class="pr-door-item">@doorItems[idx]</span>
                            }
                            else
                            {
                                <span class="pr-door-face">🚪</span>
                            }
                        </button>
                    }
                </div>
            }
            else if (selectedTheme.Kind == ThemeKind.Egg)
            {
                <button class="pr-egg-spot" @onclick="TapEgg">
                    @if (eggRevealed)
                    {
                        <span class="pr-reveal-item">@eggItem</span>
                    }
                    else
                    {
                        <span class="pr-egg @($"crack-{crackStage}")">🥚</span>
                    }
                </button>
            }
            else
            {
                <button class="pr-single-spot" @onclick="TapSingle">
                    @if (singleRevealed)
                    {
                        <span class="pr-reveal-item">@singleItem</span>
                    }
                    else
                    {
                        <span class="pr-single-icon">@selectedTheme.ClosedIcon</span>
                    }
                </button>
            }
        </div>

        <p class="pr-hint">@Hint()</p>
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<PeekRevealResult> OnComplete { get; set; }

    private enum Phase { Setup, Playing }
    private enum ThemeKind { SingleReveal, Doors, Egg }

    private record ThemeDefinition(string Name, string Icon, ThemeKind Kind, string ClosedIcon);

    private static readonly string[] RevealPool = { "🐶", "🐱", "🐰", "🐻", "🦁", "🐸", "🦆", "🐷", "🐵", "🦋" };

    private static readonly ThemeDefinition[] Themes =
    {
        new("Curtain", "🎭", ThemeKind.SingleReveal, "🎭"),
        new("Present Box", "🎁", ThemeKind.SingleReveal, "🎁"),
        new("Doors", "🚪", ThemeKind.Doors, "🚪"),
        new("Egg Surprise", "🥚", ThemeKind.Egg, "🥚"),
    };

    private const int EggCracksNeeded = 3;

    private Phase phase = Phase.Setup;
    private ThemeDefinition selectedTheme = Themes[0];
    private readonly Random rng = new();
    private int reveals;
    private DateTime startedAtUtc;

    // Single-reveal (Curtain / Present Box) state.
    private bool singleRevealed;
    private string singleItem = "";

    // Doors state.
    private string[] doorItems = new string[3];
    private bool[] doorOpen = new bool[3];

    // Egg state.
    private int crackStage;
    private bool eggRevealed;
    private string eggItem = "";

    private void StartGame()
    {
        reveals = 0;
        singleRevealed = false;
        crackStage = 0;
        eggRevealed = false;
        doorOpen = new bool[3];
        doorItems = new string[3];
        AssignDoorItems();
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    private void AssignDoorItems()
    {
        for (var i = 0; i < doorItems.Length; i++)
        {
            doorItems[i] = RevealPool[rng.Next(RevealPool.Length)];
        }
    }

    private async Task TapSingle()
    {
        if (singleRevealed) return;

        singleItem = RevealPool[rng.Next(RevealPool.Length)];
        singleRevealed = true;
        reveals++;
        StateHasChanged();
        await Interop.InvokeVoidAsync("playMatchSound");

        await Task.Delay(1600);
        singleRevealed = false;
        StateHasChanged();
    }

    private async Task TapDoor(int index)
    {
        if (doorOpen[index]) return;

        doorOpen[index] = true;
        reveals++;
        StateHasChanged();
        await Interop.InvokeVoidAsync("playMatchSound");

        await Task.Delay(1600);

        // Only reset once every door has had its turn, so a quick tapper
        // can still open all three before the scene resets.
        if (Array.TrueForAll(doorOpen, o => o))
        {
            doorOpen = new bool[3];
            AssignDoorItems();
        }
        StateHasChanged();
    }

    private async Task TapEgg()
    {
        if (eggRevealed) return;

        crackStage++;
        StateHasChanged();
        await Interop.InvokeVoidAsync("playImpactSound");

        if (crackStage >= EggCracksNeeded)
        {
            eggItem = RevealPool[rng.Next(RevealPool.Length)];
            eggRevealed = true;
            reveals++;
            StateHasChanged();
            await Interop.InvokeVoidAsync("playMatchSound");

            await Task.Delay(1800);
            eggRevealed = false;
            crackStage = 0;
            StateHasChanged();
        }
    }

    private string Hint() => selectedTheme.Kind switch
    {
        ThemeKind.Doors => "Tap a door to peek inside!",
        ThemeKind.Egg => "Tap the egg to crack it open!",
        _ => "Tap to see who's hiding!",
    };

    private async Task FinishSession()
    {
        phase = Phase.Setup;

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new PeekRevealResult(
                Theme: selectedTheme.Name,
                Reveals: reveals,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    public record PeekRevealResult(string Theme, int Reveals, int ElapsedSeconds);
}
