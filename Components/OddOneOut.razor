@*
    OddOneOut.razor
    A grid of matching emoji tiles with one different tile hidden among
    them - tap the one that doesn't belong. Difficulty controls grid size
    (more tiles = harder to spot), not reading or math, so it works for
    kids well before they're reading fluently. A fixed 8-round session ends
    with a result overlay.

    Usage:
        <OddOneOut OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="oo-game">

    @if (phase == Phase.Setup)
    {
        <div class="oo-setup game-setup-panel">
            <h2>🔎 Odd One Out</h2>
            <p>Find the tile that's different from all the others and tap it!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="oo-diff-name">@DifficultyName(diff)</span>
                            <span class="oo-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="oo-title">Odd One Out</span>
            <span class="game-stat">Round @Math.Min(round, TotalRounds)/@TotalRounds</span>
            <span class="game-stat">🌟 Score @score</span>
            <span class="game-stat">🔥 Streak @streak</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="oo-grid oo-grid-@tileCount">
            @for (var i = 0; i < tiles.Count; i++)
            {
                var index = i;
                <button class="oo-tile @(TileState(index))" disabled="@(locked)" @onclick="() => Pick(index)">
                    @tiles[index]
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="oo-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🔎 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Nice spotting" : PlayerName + ", nice spotting")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Score</span><span class="game-stat-value">@score/@TotalRounds</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<OddOneOutResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int TotalRounds = 8;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    // (everyday item, visually-distinct odd item) - same broad category so
    // the odd tile still feels like a fair, spottable difference rather
    // than a random unrelated emoji. Split by how obvious the odd one out
    // reads at a glance - previously every difficulty drew from the same
    // pool regardless of tier, only tile count scaled, so a "Hard" round
    // could randomly draw an obvious pair while "Easy" drew a subtle one.
    private static readonly (string Base, string Odd)[] ObviousPairs =
    {
        ("🍎", "🍌"), ("⭐", "🌙"), ("🌞", "☁️"), ("🍇", "🍓"), ("🎈", "🎁"), ("🌸", "🌵"),
    };

    private static readonly (string Base, string Odd)[] MediumPairs =
    {
        ("🐶", "🐱"), ("🚗", "🚌"), ("🐟", "🐙"), ("🍉", "🍒"),
    };

    private static readonly (string Base, string Odd)[] SubtlePairs =
    {
        ("🦋", "🐝"), ("🐸", "🐢"), ("🍪", "🍩"), ("🚀", "🛸"), ("🐔", "🦆"),
    };

    private static (string Base, string Odd)[] PairsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => ObviousPairs,
        Difficulty.Medium => ObviousPairs.Concat(MediumPairs).ToArray(),
        _ => ObviousPairs.Concat(MediumPairs).Concat(SubtlePairs).ToArray(),
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int TileCountFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 4,
        Difficulty.Medium => 6,
        _ => 9,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private readonly List<string> tiles = new();
    private int oddIndex;
    private int? pickedIndex;
    private bool locked;
    private int tileCount = 4;
    private int round;
    private int score;
    private int streak;
    private int bestStreak;
    private string roundMessage = "";
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        round = 0;
        score = 0;
        streak = 0;
        bestStreak = 0;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        NextRound();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new OddOneOutResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void NextRound()
    {
        round++;
        roundMessage = "";
        pickedIndex = null;
        locked = false;

        tileCount = TileCountFor(selectedDifficulty);
        var pairs = PairsFor(selectedDifficulty);
        var pair = pairs[rng.Next(pairs.Length)];
        oddIndex = rng.Next(tileCount);

        tiles.Clear();
        for (var i = 0; i < tileCount; i++)
        {
            tiles.Add(i == oddIndex ? pair.Odd : pair.Base);
        }
    }

    private string TileState(int index)
    {
        if (pickedIndex is null) return "";
        if (index == oddIndex) return "correct";
        if (index == pickedIndex) return "wrong";
        return "";
    }

    private async Task Pick(int index)
    {
        if (locked || phase != Phase.Playing) return;

        locked = true;
        pickedIndex = index;

        if (index == oddIndex)
        {
            score++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            roundMessage = "Found it!";
            await PlaySoundAsync("playMatchSound");
        }
        else
        {
            streak = 0;
            roundMessage = "So close - here it is!";
            await PlaySoundAsync("playMismatchSound");
        }

        StateHasChanged();
        await Task.Delay(1000);

        if (round >= TotalRounds)
        {
            await FinishGame();
        }
        else
        {
            NextRound();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new OddOneOutResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "4 tiles",
        Difficulty.Medium => "6 tiles",
        _ => "9 tiles",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record OddOneOutResult(string Difficulty, int Score, int TotalRounds, int BestStreak, int ElapsedSeconds);
}
