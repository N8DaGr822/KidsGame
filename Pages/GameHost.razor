    private void GoBack() => Nav.NavigateTo("games");

    private void HandleHudChanged() => InvokeAsync(StateHasChanged);

    // Built-in games log their own PlayHistoryEntry on completion (with
    // real gameplay stats). Iframe-hosted games have no completion signal
    // at all, so this is the only place their play time is ever recorded -
    // measured as wall-clock time the game was mounted, written on exit
    // (button, browser back, or navigating elsewhere) rather than only on
    // a "finish" that may never come.
    public async ValueTask DisposeAsync()
    {
        _hudSlot.Changed -= HandleHudChanged;

        if (_game is { LaunchMode: GameLaunchMode.ExternalIframe } game
            && _sessionStartedAtUtc is { } startedAt
            && State.CurrentProfile is { } profile)
        {
            var elapsed = (int)(DateTime.UtcNow - startedAt).TotalSeconds;
            if (elapsed > 0)
            {
                await Data.AddPlayHistoryAsync(new PlayHistoryEntry
                {
                    ProfileId = profile.Id,
                    GameId = game.Id,
                    ElapsedSeconds = elapsed,
                });
            }
        }
    }
