@*
    CopyThePattern.razor
    Simon Says' sequence-and-replay loop, but spatial instead of temporal
    (see GAMES_ROADMAP.md Section 5) - a set of grid cells all light up
    at once, then hide, and you tap back the same set from memory in any
    order rather than repeating a timed sequence. Every round adds one
    more cell to remember. A single wrong tap ends the run immediately
    (no mistake tolerance by difficulty, unlike Simon Says - a spatial
    snapshot is either remembered or it isn't, there's no "replay the
    same round" beat to forgive into). Personal best tracks the longest
    pattern reached, per difficulty (which also sets grid size).

    Usage:
        <CopyThePattern OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject InteropService Interop
@inject AppDataService Data

<div class="cp-game">

    @if (phase == Phase.Setup)
    {
        <div class="cp-setup game-setup-panel">
            <h2>🧩 Copy the Pattern</h2>
            <p>Watch which tiles light up, then tap them all back from memory - in any order! Each round adds one more tile.</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="cp-diff-name">@DifficultyName(diff)</span>
                            <span class="cp-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="cp-title">Copy the Pattern</span>
            <span class="game-stat">Round @Math.Max(patternSize, 1)</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <p class="cp-status">@StatusText()</p>

        <div class="cp-grid" style="--cp-size:@gridSize;">
            @for (var r = 0; r < gridSize; r++)
            {
                for (var c = 0; c < gridSize; c++)
                {
                    var idx = r * gridSize + c;
                    <button class="cp-cell @(shownPattern.Contains(idx) ? "shown" : "") @(foundCells.Contains(idx) ? "found" : "") @(wrongCell == idx ? "wrong" : "")"
                            disabled="@(phase != Phase.Guessing || foundCells.Contains(idx))"
                            @onclick="() => OnCellTap(idx)"></button>
                }
            }
        </div>

        @if (phase == Phase.RoundEnd)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>Game Over</h2>
                    <p>You remembered a pattern of @roundsReached tiles!</p>
                    <PersonalBestBadge Value="@((bestPattern ?? roundsReached).ToString())" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="() => phase = Phase.Setup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<CopyThePatternResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (longest pattern reached, per difficulty) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private int? bestPattern;
    private bool isNewBest;

    private enum Phase { Setup, Showing, Guessing, RoundEnd }
    public enum Difficulty { Easy, Medium, Hard }

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int GridSizeFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 3,
        Difficulty.Medium => 4,
        _ => 5,
    };

    private static int StartPatternFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 3,
        Difficulty.Medium => 4,
        _ => 5,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Medium;
    private int gridSize = 4;
    private int patternSize;
    private readonly HashSet<int> shownPattern = new();
    private readonly HashSet<int> foundCells = new();
    private int? wrongCell;
    private int roundsReached;
    private DateTime startedAtUtc;
    private readonly Random rng = new();
    private CancellationTokenSource? _roundCts;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        gridSize = GridSizeFor(selectedDifficulty);
        patternSize = StartPatternFor(selectedDifficulty);
        roundsReached = 0;
        isNewBest = false;
        startedAtUtc = DateTime.UtcNow;
        _ = ShowRoundAsync();
    }

    private async Task ExitToSetup()
    {
        if ((phase == Phase.Showing || phase == Phase.Guessing) && OnComplete.HasDelegate)
        {
            await RecordBestIfNeededAsync();
            await OnComplete.InvokeAsync(new CopyThePatternResult(
                RoundsReached: roundsReached,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task RecordBestIfNeededAsync()
    {
        if (roundsReached <= 0 || string.IsNullOrEmpty(ProfileId)) return;

        var key = $"pattern:{DifficultyName(selectedDifficulty)}";
        bestPattern = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.CopyThePattern, key);
        isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.CopyThePattern, key, roundsReached, lowerIsBetter: false);
    }

    private async Task ShowRoundAsync()
    {
        _roundCts?.Cancel();
        var cts = new CancellationTokenSource();
        _roundCts = cts;

        phase = Phase.Showing;
        foundCells.Clear();
        wrongCell = null;
        shownPattern.Clear();

        var cellCount = gridSize * gridSize;
        while (shownPattern.Count < Math.Min(patternSize, cellCount))
        {
            shownPattern.Add(rng.Next(cellCount));
        }

        StateHasChanged();
        await Interop.InvokeVoidAsync("playImpactSound");

        // Give a slightly longer look at bigger patterns, floored so it
        // never becomes unfairly brief for a young player.
        var showMs = Math.Clamp(900 + patternSize * 120, 1200, 3200);
        try { await Task.Delay(showMs, cts.Token); }
        catch (TaskCanceledException) { return; }
        if (cts.IsCancellationRequested) return;

        shownPattern.Clear();
        phase = Phase.Guessing;
        StateHasChanged();
    }

    private bool isHandlingTap;

    private async Task OnCellTap(int idx)
    {
        if (phase != Phase.Guessing || isHandlingTap || foundCells.Contains(idx)) return;
        isHandlingTap = true;

        try
        {
            if (!shownPattern.Contains(idx))
            {
                wrongCell = idx;
                StateHasChanged();
                await Interop.InvokeVoidAsync("playSimonErrorSound");
                await Task.Delay(700);
                await EndRoundAsync();
                return;
            }

            foundCells.Add(idx);
            StateHasChanged();
            await Interop.InvokeVoidAsync("playMatchSound");

            if (foundCells.Count == shownPattern.Count)
            {
                roundsReached = patternSize;
                await Task.Delay(500);
                patternSize++;
                await ShowRoundAsync();
            }
        }
        finally
        {
            isHandlingTap = false;
        }
    }

    private async Task EndRoundAsync()
    {
        phase = Phase.RoundEnd;
        await RecordBestIfNeededAsync();
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CopyThePatternResult(
                RoundsReached: roundsReached,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private string StatusText() => phase switch
    {
        Phase.Showing => "Watch closely...",
        Phase.Guessing => "Tap the tiles you saw!",
        Phase.RoundEnd => "Game over",
        _ => "",
    };

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "3x3 grid",
        Difficulty.Medium => "4x4 grid",
        _ => "5x5 grid",
    };

    public ValueTask DisposeAsync()
    {
        _roundCts?.Cancel();
        return ValueTask.CompletedTask;
    }

    public record CopyThePatternResult(int RoundsReached, int ElapsedSeconds);
}
