@*
    NumberSequence.razor
    A counting sequence plays out (e.g. "2, 4, 6, 8") and the next number
    is hidden - tap the option that continues it. Difficulty controls the
    step size and whether sequences can count down, not the length of the
    sequence shown. A fixed 8-round session ends with a result overlay.

    Usage:
        <NumberSequence OnComplete="HandleGameComplete" />
*@
@inject InteropService Interop
@inject AppDataService Data

<div class="ns-game">

    @if (phase == Phase.Setup)
    {
        <div class="ns-setup game-setup-panel">
            <h2>🔢 Number Sequence</h2>
            <p>Watch the numbers count, then tap what comes next!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="ns-diff-name">@DifficultyName(diff)</span>
                            <span class="ns-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="ns-title">Number Sequence</span>
            <span class="game-stat">Round @Math.Min(round, TotalRounds)/@TotalRounds</span>
            <span class="game-stat">🌟 Score @score</span>
            <span class="game-stat">🔥 Streak @streak</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="ns-sequence">
            @foreach (var n in sequence)
            {
                <span class="ns-seq-tile">@n</span>
            }
            <span class="ns-seq-tile ns-seq-blank">@(revealed ? correctValue.ToString() : "❓")</span>
        </div>

        <div class="ns-choices game-option-grid">
            @for (var i = 0; i < choices.Count; i++)
            {
                var index = i;
                <button class="ns-choice-btn game-option-button @(ChoiceState(index))" disabled="@(locked)" @onclick="() => Pick(index)">
                    <span class="ns-choice-value">@choices[index]</span>
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="ns-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🔢 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great counting" : PlayerName + ", great counting")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Score</span><span class="game-stat-value">@score/@TotalRounds</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <PersonalBestBadge Value="@((bestScore ?? score).ToString())" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<NumberSequenceResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (high score per difficulty) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    private int? bestScore;
    private bool isNewBest;

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int TotalRounds = 8;
    private const int ChoiceCount = 4;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int[] StepsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => new[] { 1, 2 },
        Difficulty.Medium => new[] { 1, 2, 3, 4, 5 },
        _ => new[] { 2, 3, 4, 5, 6, 7, 8, 9, 10 },
    };

    private static int LengthFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 4,
        Difficulty.Medium => 5,
        _ => 6,
    };

    private static bool AllowDescendingFor(Difficulty d) => d != Difficulty.Easy;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private readonly List<int> sequence = new();
    private readonly List<int> choices = new();
    private int correctValue;
    private int? pickedIndex;
    private bool revealed;
    private bool locked;
    private int round;
    private int score;
    private int streak;
    private int bestStreak;
    private string roundMessage = "";
    private readonly Random rng = new();
    private DateTime startedAtUtc;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        round = 0;
        score = 0;
        streak = 0;
        bestStreak = 0;
        isNewBest = false;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        NextRound();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new NumberSequenceResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void NextRound()
    {
        round++;
        roundMessage = "";
        pickedIndex = null;
        revealed = false;
        locked = false;

        var steps = StepsFor(selectedDifficulty);
        var length = LengthFor(selectedDifficulty);
        var step = steps[rng.Next(steps.Length)];
        var descending = AllowDescendingFor(selectedDifficulty) && rng.Next(2) == 0;

        int start;
        if (descending)
        {
            // Guarantee every term (including the hidden one) stays >= 0.
            var minStart = step * length;
            start = minStart + rng.Next(0, 21);
        }
        else
        {
            start = rng.Next(0, 11);
        }

        sequence.Clear();
        for (var i = 0; i < length; i++)
        {
            sequence.Add(descending ? start - step * i : start + step * i);
        }
        correctValue = descending ? start - step * length : start + step * length;

        var distractors = new HashSet<int>();
        var signedStep = descending ? -step : step;
        TryAddDistractor(distractors, correctValue + signedStep);
        TryAddDistractor(distractors, correctValue - signedStep);
        TryAddDistractor(distractors, correctValue + (descending ? step : -step) * 2);
        while (distractors.Count < ChoiceCount - 1)
        {
            TryAddDistractor(distractors, correctValue + rng.Next(-10, 11));
        }

        choices.Clear();
        choices.Add(correctValue);
        choices.AddRange(distractors.Take(ChoiceCount - 1));
        Shuffle(choices);
    }

    private void TryAddDistractor(HashSet<int> distractors, int value)
    {
        if (value >= 0 && value != correctValue) distractors.Add(value);
    }

    private void Shuffle(List<int> list)
    {
        for (var i = list.Count - 1; i > 0; i--)
        {
            var j = rng.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }

    private string ChoiceState(int index)
    {
        if (pickedIndex is null) return "";
        if (choices[index] == correctValue) return "correct";
        if (index == pickedIndex) return "wrong";
        return "";
    }

    private async Task Pick(int index)
    {
        if (locked || phase != Phase.Playing) return;

        locked = true;
        pickedIndex = index;
        revealed = true;

        if (choices[index] == correctValue)
        {
            score++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            roundMessage = "That's next in line!";
            await Interop.InvokeVoidAsync("playMatchSound");
        }
        else
        {
            streak = 0;
            roundMessage = "So close - here's the answer!";
            await Interop.InvokeVoidAsync("playMismatchSound");
        }

        StateHasChanged();
        await Task.Delay(1200);

        if (round >= TotalRounds)
        {
            await FinishGame();
        }
        else
        {
            NextRound();
        }
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            var key = $"score:{DifficultyName(selectedDifficulty)}";
            bestScore = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.NumberSequence, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.NumberSequence, key, score, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new NumberSequenceResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "Count by 1s and 2s",
        Difficulty.Medium => "Count by 1-5, up or down",
        _ => "Count by 2-10, up or down",
    };

    public record NumberSequenceResult(string Difficulty, int Score, int TotalRounds, int BestStreak, int ElapsedSeconds);
}
