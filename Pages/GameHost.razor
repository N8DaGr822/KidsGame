@code {
    [Parameter] public string GameId { get; set; } = "";

    private Game? _game;
    private DateTime? _sessionStartedAtUtc;
    private string? _difficultyOverride;
    private readonly GameHudSlot _hudSlot = new();

    protected override async Task OnInitializedAsync()
    {
        _hudSlot.Changed += HandleHudChanged;

        if (State.CurrentProfile is null)
        {
            Nav.NavigateTo("");
            return;
        }

        var allGames = await Data.GetAllGamesAsync();
        _game = allGames.FirstOrDefault(g => g.Id == GameId);

        if (_game is null)
        {
            Nav.NavigateTo("games");
            return;
        }

        _difficultyOverride = await Data.GetDifficultyOverrideAsync(State.CurrentProfile.Id, _game.Id);
        _sessionStartedAtUtc = DateTime.UtcNow;
    }

    private async Task HandleMemoryMatchComplete(MemoryMatchGame.MemoryMatchResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = result.Theme,
            Difficulty = result.Difficulty,
            Moves = result.Moves,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

