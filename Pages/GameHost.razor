@page "/play/{GameId}"
@inject AppDataService Data
@inject AppState State
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="screen game-host-screen">
    @if (_game is null)
    {
        <p class="muted">Loading game…</p>
    }
    else
    {
        <div class="game-host-bar">
            <button class="game-host-exit-btn" @onclick="GoBack" aria-label="Exit game">←</button>
            @if (_game.LaunchMode == GameLaunchMode.ExternalIframe)
            {
                <span class="game-host-title">@_game.Title</span>
            }
            @_hudSlot.Content
        </div>

        <div @key="_session" class="game-host-surface @GameThemes.For(_game.LaunchTarget)">
            @if (_game.LaunchMode == GameLaunchMode.ExternalIframe)
            {
                <iframe title="@_game.Title" src="@_game.LaunchTarget"></iframe>
            }
            else if (_game.LaunchTarget == BuiltInGames.MemoryMatch)
            {
                <MemoryMatchGame PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" ForcedDifficulty="@_difficultyOverride" OnComplete="GuardResult<MemoryMatchGame.MemoryMatchResult>(HandleMemoryMatchComplete)" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Fishing)
            {
                <FishingGame PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" OnComplete="GuardResult<FishingGame.FishingResult>(HandleFishingComplete)" />
            }
            else if (_game.LaunchTarget == BuiltInGames.DressUp)
            {
                <DressUpGame PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" OnComplete="GuardResult<DressUpGame.DressUpResult>(HandleDressUpComplete)" HudSlot="_hudSlot" />
            }
            else if (_game.LaunchTarget == BuiltInGames.MannersGarden)
