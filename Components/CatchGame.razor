@*
    CatchGame.razor
    Good items and bombs fall down a set of lanes; move the basket into a
    lane to catch what's above it. Catching a good item scores (streaks
    raise a multiplier, same as Whack-a-Mole); catching a bomb costs a
    strike. Run out of strikes and the round ends early - otherwise it
    plays out until the round timer expires. Harder difficulties add more
    lanes, faster falls, and a higher bomb ratio.

    Usage:
        <CatchGame OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="cg-game">

    @if (phase == Phase.Setup)
    {
        <div class="cg-setup game-setup-panel">
            <h2>🧺 Catch the Falling Objects</h2>
            <p>Move your basket to catch the good stuff and dodge the bombs!</p>

            <h3 class="cg-section-title game-section-title">Choose a theme</h3>
            <div class="cg-theme-select game-option-grid">
                @foreach (var t in Themes)
                {
                    <button class="cg-theme-btn game-option-button @(t.Name == selectedTheme.Name ? "selected" : "")" @onclick="() => selectedTheme = t">
                        <span class="cg-theme-icon">@t.Icon</span>
                        <span class="cg-theme-name">@t.Name</span>
                    </button>
                }
            </div>

            <h3 class="cg-section-title game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="cg-difficulty-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="cg-difficulty-select game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="cg-diff-btn game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="cg-diff-name">@DifficultyName(diff)</span>
                            <span class="cg-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="cg-start-btn game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="cg-hud game-hud">
            <span class="cg-title">@selectedTheme.Name Catch</span>
            <span class="cg-stat">⭐ @score</span>
            <span class="cg-stat">🔥 @($"{CurrentMultiplier}x")</span>
            <span class="cg-stat">💣 @strikes/@config.MaxStrikes</span>
            <span class="cg-stat">⏱️ @FormatTime(remainingMs)</span>
            <button class="cg-restart-btn game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="cg-field" style="--cg-lanes:@config.Lanes;">
            @for (var i = 0; i < config.Lanes; i++)
            {
                var lane = i;
                <button class="cg-lane" aria-label="Move basket here" disabled="@(phase != Phase.Playing)" @onclick="() => MoveBasket(lane)"></button>
            }

            @foreach (var item in items)
            {
                <span @key="item.Id" class="cg-item @(item.IsBomb ? "bomb" : "")" style="@ItemStyle(item)">@item.Symbol</span>
            }

            <div class="cg-basket" style="@BasketStyle()">🧺</div>
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="cg-overlay game-result-overlay">
                <div class="cg-win-panel game-result-panel">
                    @if (won)
                    {
                        <h2>🎉 Nice Catching!</h2>
                        <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great job" : PlayerName + ", great job") clearing the round!</p>
                    }
                    else
                    {
                        <h2>💥 Too Many Bombs!</h2>
                        <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "No worries" : PlayerName + ", no worries") - give it another go!</p>
                    }
                    <div class="cg-win-stats game-result-stats">
                        <div><span class="game-stat-label">Score</span><span class="game-stat-value">@score</span></div>
                        <div><span class="game-stat-label">Caught</span><span class="game-stat-value">@goodCaught</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <div class="cg-win-actions game-result-actions">
                        <button class="cg-start-btn game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="cg-restart-btn game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<CatchResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private record ThemeDefinition(string Name, string Icon, string[] GoodSymbols);
    private record DifficultyConfig(int Lanes, int RoundSeconds, int FallMs, int MinSpawnMs, int MaxSpawnMs, double BadRatio, int MaxStrikes);

    private static readonly ThemeDefinition[] Themes =
    {
        new("Fruit", "🍎", new[] { "🍎", "🍌", "🍇", "🍓" }),
        new("Stars", "⭐", new[] { "⭐", "🌟", "✨", "🌙" }),
        new("Candy", "🍬", new[] { "🍬", "🍭", "🍫", "🧁" }),
    };

    private const string BadSymbol = "💣";

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static DifficultyConfig ConfigFor(Difficulty d) => d switch
    {
        Difficulty.Easy => new DifficultyConfig(3, 30, 3200, 900, 1300, 0.15, 5),
        Difficulty.Medium => new DifficultyConfig(4, 40, 2600, 700, 1050, 0.25, 4),
        _ => new DifficultyConfig(5, 45, 2000, 550, 850, 0.35, 3),
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private class FallingItem
    {
        public string Id { get; } = Guid.NewGuid().ToString();
        public int Lane;
        public string Symbol = "";
        public bool IsBomb;
        public int ElapsedMs;
        public bool Resolved;
    }

    private const int TickMs = 100;
    private const double CatchZonePct = 84;

    private Phase phase = Phase.Setup;
    private ThemeDefinition selectedTheme = Themes[0];
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private DifficultyConfig config = ConfigFor(Difficulty.Easy);
    private readonly List<FallingItem> items = new();
    private int basketLane;
    private int score;
    private int goodCaught;
    private int badCaught;
    private int strikes;
    private int streak;
    private int bestStreak;
    private bool won;
    private int remainingMs;
    private int nextSpawnInMs;
    private readonly Random rng = new();
    private System.Threading.Timer? timer;
    private IJSObjectReference? _module;

    private int CurrentMultiplier => 1 + Math.Min(streak / 5, 3);

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        config = ConfigFor(selectedDifficulty);
        items.Clear();
        basketLane = config.Lanes / 2;
        score = 0;
        goodCaught = 0;
        badCaught = 0;
        strikes = 0;
        streak = 0;
        bestStreak = 0;
        won = false;
        remainingMs = config.RoundSeconds * 1000;
        nextSpawnInMs = rng.Next(config.MinSpawnMs, config.MaxSpawnMs + 1);
        phase = Phase.Playing;
        StartTimer();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CatchResult(
                Theme: selectedTheme.Name,
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                GoodCaught: goodCaught,
                BadCaught: badCaught,
                BestStreak: bestStreak,
                Won: false,
                ElapsedSeconds: config.RoundSeconds - remainingMs / 1000));
        }
        StopTimer();
        phase = Phase.Setup;
    }

    private void MoveBasket(int lane)
    {
        if (phase != Phase.Playing) return;
        basketLane = lane;
    }

    private void Tick(object? _) => InvokeAsync(async () =>
    {
        if (phase != Phase.Playing) return;

        remainingMs -= TickMs;
        if (remainingMs <= 0)
        {
            remainingMs = 0;
            await FinishGame(won: true);
            return;
        }

        nextSpawnInMs -= TickMs;
        if (nextSpawnInMs <= 0)
        {
            SpawnItem();
            nextSpawnInMs = rng.Next(config.MinSpawnMs, config.MaxSpawnMs + 1);
        }

        foreach (var item in items.Where(i => !i.Resolved))
        {
            item.ElapsedMs += TickMs;
            var pct = 100.0 * item.ElapsedMs / config.FallMs;

            if (pct >= CatchZonePct && pct < 100 && item.Lane == basketLane)
            {
                item.Resolved = true;
                await ResolveCatch(item);
            }
            else if (pct >= 100)
            {
                item.Resolved = true;
                if (!item.IsBomb) streak = 0;
            }
        }

        items.RemoveAll(i => i.Resolved);

        if (strikes >= config.MaxStrikes)
        {
            await FinishGame(won: false);
            return;
        }

        StateHasChanged();
    });

    private void SpawnItem()
    {
        var isBomb = rng.NextDouble() < config.BadRatio;
        items.Add(new FallingItem
        {
            Lane = rng.Next(config.Lanes),
            IsBomb = isBomb,
            Symbol = isBomb ? BadSymbol : selectedTheme.GoodSymbols[rng.Next(selectedTheme.GoodSymbols.Length)],
        });
    }

    private async Task ResolveCatch(FallingItem item)
    {
        if (item.IsBomb)
        {
            badCaught++;
            strikes++;
            streak = 0;
            await PlaySoundAsync("playMismatchSound");
        }
        else
        {
            goodCaught++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            score += 10 * CurrentMultiplier;
            await PlaySoundAsync("playCatchSound");
        }
    }

    private string ItemStyle(FallingItem item)
    {
        var pct = Math.Min(100.0, 100.0 * item.ElapsedMs / config.FallMs);
        var laneWidth = 100.0 / config.Lanes;
        var left = laneWidth * item.Lane + laneWidth / 2;
        return $"top:{pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%; left:{left.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    private string BasketStyle()
    {
        var laneWidth = 100.0 / config.Lanes;
        var left = laneWidth * basketLane + laneWidth / 2;
        return $"left:{left.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame(bool won)
    {
        StopTimer();
        phase = Phase.Finished;
        this.won = won;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CatchResult(
                Theme: selectedTheme.Name,
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                GoodCaught: goodCaught,
                BadCaught: badCaught,
                BestStreak: bestStreak,
                Won: won,
                ElapsedSeconds: config.RoundSeconds - remainingMs / 1000));
        }
    }

    private void StartTimer()
    {
        StopTimer();
        timer = new System.Threading.Timer(Tick, null, TickMs, TickMs);
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    private static string FormatTime(int totalMs)
    {
        var span = TimeSpan.FromMilliseconds(totalMs);
        return span.Minutes > 0 ? $"{span.Minutes}:{span.Seconds:00}" : $"0:{span.Seconds:00}";
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "3 lanes, slow fall",
        Difficulty.Medium => "4 lanes, quicker fall",
        _ => "5 lanes, fast fall",
    };

    public async ValueTask DisposeAsync()
    {
        StopTimer();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record CatchResult(string Theme, string Difficulty, int Score, int GoodCaught, int BadCaught, int BestStreak, bool Won, int ElapsedSeconds);
}
