@*
    RockPaperScissors.razor
    Best-of-5 match against the computer. Difficulty controls how the
    computer picks: Easy is uniform random, Medium sometimes counters the
    player's most-common pick so far, Hard always does. Tracks a win
    streak (consecutive round wins) alongside the match score.

    Usage:
        <RockPaperScissors OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="rp-game">

    @if (phase == Phase.Setup)
    {
        <div class="rp-setup game-setup-panel">
            <h2>✊ Rock Paper Scissors</h2>
            <p>First to 3 round wins takes the match. Rock beats scissors, scissors beats paper, paper beats rock!</p>

            <h3 class="rp-section-title game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="rp-difficulty-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="rp-difficulty-select game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="rp-diff-btn game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="rp-diff-name">@DifficultyName(diff)</span>
                            <span class="rp-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="rp-start-btn game-primary-action" @onclick="StartGame">Start Match</button>
        </div>
    }
    else
    {
        <div class="rp-hud game-hud">
            <span class="rp-title">Rock Paper Scissors</span>
            <span class="rp-stat">You @playerScore - @computerScore Computer</span>
            <span class="rp-stat">🔥 Streak @streak</span>
            <button class="rp-restart-btn game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="rp-arena">
            <div class="rp-side">
                <span class="rp-side-label">You</span>
                <span class="rp-choice-display">@(playerChoice is { } p ? ChoiceEmoji(p) : "❔")</span>
            </div>
            <span class="rp-vs">@(roundMessage == "" ? "VS" : roundMessage)</span>
            <div class="rp-side">
                <span class="rp-side-label">Computer</span>
                <span class="rp-choice-display">@(computerChoice is { } c && revealed ? ChoiceEmoji(c) : "❔")</span>
            </div>
        </div>

        <div class="rp-choices">
            @foreach (var choice in Choices)
            {
                <button class="rp-choice-btn game-option-button" disabled="@(roundInProgress || phase != Phase.Playing)" @onclick="() => PlayRound(choice)">
                    <span class="rp-choice-icon">@ChoiceEmoji(choice)</span>
                    <span class="rp-choice-name">@choice</span>
                </button>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="rp-overlay game-result-overlay">
                <div class="rp-win-panel game-result-panel">
                    @if (matchWon)
                    {
                        <h2>🏆 You Won the Match!</h2>
                        <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great job" : PlayerName + ", great job")!</p>
                    }
                    else
                    {
                        <h2>🤖 Computer Won the Match</h2>
                        <p>Good effort - want a rematch?</p>
                    }
                    <div class="rp-win-stats game-result-stats">
                        <div><span class="game-stat-label">You</span><span class="game-stat-value">@playerScore</span></div>
                        <div><span class="game-stat-label">Computer</span><span class="game-stat-value">@computerScore</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <div class="rp-win-actions game-result-actions">
                        <button class="rp-start-btn game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="rp-restart-btn game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<RockPaperScissorsResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }
    public enum Choice { Rock, Paper, Scissors }

    private const int WinsNeeded = 3;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };
    private static readonly Choice[] Choices = { Choice.Rock, Choice.Paper, Choice.Scissors };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private Choice? playerChoice;
    private Choice? computerChoice;
    private bool revealed;
    private bool roundInProgress;
    private string roundMessage = "";
    private int playerScore;
    private int computerScore;
    private int streak;
    private int bestStreak;
    private bool matchWon;
    private readonly Dictionary<Choice, int> playerHistory = new() { [Choice.Rock] = 0, [Choice.Paper] = 0, [Choice.Scissors] = 0 };
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        playerChoice = null;
        computerChoice = null;
        revealed = false;
        roundInProgress = false;
        roundMessage = "";
        playerScore = 0;
        computerScore = 0;
        streak = 0;
        bestStreak = 0;
        matchWon = false;
        playerHistory[Choice.Rock] = 0;
        playerHistory[Choice.Paper] = 0;
        playerHistory[Choice.Scissors] = 0;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    // Guarded to Playing so the Finished-overlay's Exit button (which
    // shares this handler) doesn't double-fire after FinishMatch already
    // invoked OnComplete.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new RockPaperScissorsResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: false,
                PlayerScore: playerScore,
                ComputerScore: computerScore,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task PlayRound(Choice choice)
    {
        if (roundInProgress || phase != Phase.Playing) return;

        roundInProgress = true;
        playerChoice = choice;
        computerChoice = null;
        revealed = false;
        roundMessage = "";
        StateHasChanged();

        await Task.Delay(450);

        playerHistory[choice]++;
        var computer = PickComputerChoice();
        computerChoice = computer;
        revealed = true;

        var result = Compare(choice, computer);
        if (result > 0)
        {
            playerScore++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            roundMessage = "You win!";
            await PlaySoundAsync("playMatchSound");
        }
        else if (result < 0)
        {
            computerScore++;
            streak = 0;
            roundMessage = "Computer wins!";
            await PlaySoundAsync("playMismatchSound");
        }
        else
        {
            roundMessage = "Tie!";
            await PlaySoundAsync("playImpactSound");
        }

        StateHasChanged();
        await Task.Delay(900);

        roundInProgress = false;

        if (playerScore >= WinsNeeded || computerScore >= WinsNeeded)
        {
            await FinishMatch(playerScore >= WinsNeeded);
        }
        else
        {
            StateHasChanged();
        }
    }

    private Choice PickComputerChoice()
    {
        var random = Choices[rng.Next(Choices.Length)];

        if (selectedDifficulty == Difficulty.Easy) return random;

        var favorsAdaptive = selectedDifficulty == Difficulty.Hard || rng.NextDouble() < 0.5;
        if (!favorsAdaptive) return random;

        var mostCommon = playerHistory.OrderByDescending(kv => kv.Value).First();
        if (mostCommon.Value == 0) return random;

        return Counter(mostCommon.Key);
    }

    private static Choice Counter(Choice c) => c switch
    {
        Choice.Rock => Choice.Paper,
        Choice.Paper => Choice.Scissors,
        _ => Choice.Rock,
    };

    private static int Compare(Choice player, Choice computer)
    {
        if (player == computer) return 0;
        return Counter(player) == computer ? -1 : 1;
    }

    private static string ChoiceEmoji(Choice c) => c switch
    {
        Choice.Rock => "🪨",
        Choice.Paper => "📄",
        _ => "✂️",
    };

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishMatch(bool won)
    {
        matchWon = won;
        phase = Phase.Finished;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new RockPaperScissorsResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: won,
                PlayerScore: playerScore,
                ComputerScore: computerScore,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "Computer picks randomly",
        Difficulty.Medium => "Computer sometimes reads your patterns",
        _ => "Computer reads your patterns",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record RockPaperScissorsResult(string Difficulty, bool Won, int PlayerScore, int ComputerScore, int BestStreak, int ElapsedSeconds);
}
