@*
    ChessGame.razor
    A real, full chess game vs a CPU opponent - not puzzles this time,
    played from the standard starting position with normal turn-by-turn
    play. You're always White. Reuses Services/ChessRules.cs for legal
    move generation and check/checkmate/stalemate detection (see that
    file's own doc comment: full piece rules, but no castling or en
    passant, and pawns always auto-promote to a queen - the same scoped
    engine Chess Puzzles already uses, just played as a whole game
    instead of solved position-by-position). CPU move selection lives in
    Services/GameAi.cs (ChessMove/ChessMinimax/ChessEvaluate), same
    alpha-beta minimax shape as Reversi/Checkers - Easy plays a legal
    move at random (favoring a free capture most of the time so it
    doesn't feel oblivious), Medium/Hard search 2-3 ply deeper on
    material + mobility. Tap a piece, then tap a highlighted destination;
    a "Check!" message appears whenever the side to move is in check.
    Personal best tracks fewest turns to win, per difficulty - same shape
    as Checkers.

    Usage:
        <ChessGame OnComplete="HandleGameComplete" />
*@
@inject InteropService Interop
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="cg-game">

    @if (phase == Phase.Setup)
    {
        <div class="cg-setup game-setup-panel">
            <h2>♞ Chess</h2>
            <p>A real game of chess against the CPU - you're always White. Checkmate the black king to win!</p>
            <p class="cg-scope-note">No castling or en passant yet - everything else is real, including check, checkmate, and stalemate.</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="cg-diff-name">@DifficultyName(diff)</span>
                            <span class="cg-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="cg-title">Chess</span>
            <span class="game-stat">⚪ You @whiteCount</span>
            <span class="game-stat">⚫ CPU @blackCount</span>
            <span class="game-stat">Turn @playerTurnsTaken</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <p class="cg-status">@statusText</p>

        <div class="cg-board">
            @for (var r = 0; r < ChessRules.Size; r++)
            {
                for (var c = 0; c < ChessRules.Size; c++)
                {
                    var row = r; var col = c;
                    var cell = board[row, col];
                    var light = (row + col) % 2 == 0;
                    var isSelected = selectedSquare == (row, col);
                    var isDestination = selectedSquare is not null && legalDestinations.Contains((row, col));
                    var canSelect = turn == Turn.Player && phase == Phase.Playing && !animating && cell != ChessRules.Empty && ChessRules.IsWhite(cell);

                    <button class="cg-cell @(light ? "light" : "dark")"
                            style="background-image:url('images/chess/@(light ? "tile-light.png" : "tile-dark.png")')"
                            disabled="@(animating || turn != Turn.Player || phase != Phase.Playing || !(canSelect || isDestination))"
                            @onclick="() => HandleTap(row, col)">
                        @if (cell != ChessRules.Empty)
                        {
                            <img class="cg-piece @(isSelected ? "selected" : "")" src="images/chess/@PieceImagePath(cell, row, col)" alt="" />
                        }
                        else if (isDestination)
                        {
                            <span class="cg-hint"></span>
                        }
                    </button>
                }
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>@(outcome switch { Outcome.PlayerWon => "🎉 Checkmate - You Win!", Outcome.CpuWon => "🤖 Checkmate - CPU Wins", _ => "🤝 Stalemate - Draw" })</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ")@playerTurnsTaken turns played.</p>
                    <PersonalBestBadge Value="@(bestTurns is { } bt ? $"{bt} turns" : null)" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<ChessGameResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fewest turns to win, per difficulty) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    private enum Turn { Player, Cpu }
    private enum Outcome { None, PlayerWon, CpuWon, Draw }

    private static readonly GameAi.Difficulty[] Difficulties = { GameAi.Difficulty.Easy, GameAi.Difficulty.Medium, GameAi.Difficulty.Hard };

    private GameAi.Difficulty? LockedDifficulty =>
        Enum.TryParse<GameAi.Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static readonly string[] StartingRows =
    {
        "rnbqkbnr",
        "pppppppp",
        "........",
        "........",
        "........",
        "........",
        "PPPPPPPP",
        "RNBQKBNR",
    };

    private Phase phase = Phase.Setup;
    private GameAi.Difficulty selectedDifficulty = GameAi.Difficulty.Easy;
    private Turn turn = Turn.Player;
    private int[,] board = new int[ChessRules.Size, ChessRules.Size];
    private (int Row, int Col)? selectedSquare;
    private HashSet<(int Row, int Col)> legalDestinations = new();
    private bool animating;
    private int whiteCount = 16;
    private int blackCount = 16;
    private int playerTurnsTaken;
    private Outcome outcome = Outcome.None;
    private string statusText = "";
    private int? bestTurns;
    private bool isNewBest;
    private readonly Random rng = new();
    private DateTime startedAtUtc;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        board = ChessRules.ParseBoard(StartingRows);
        turn = Turn.Player;
        selectedSquare = null;
        legalDestinations = new();
        animating = false;
        playerTurnsTaken = 0;
        outcome = Outcome.None;
        bestTurns = null;
        isNewBest = false;
        statusText = "Your move.";
        UpdateCounts();
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new ChessGameResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: false,
                PlayerTurnsTaken: playerTurnsTaken,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void HandleTap(int row, int col)
    {
        if (phase != Phase.Playing || animating || turn != Turn.Player) return;

        if (selectedSquare is { } sel && legalDestinations.Contains((row, col)))
        {
            _ = ApplyPlayerMoveAsync(sel.Row, sel.Col, row, col);
            return;
        }

        var cell = board[row, col];
        if (cell != ChessRules.Empty && ChessRules.IsWhite(cell))
        {
            selectedSquare = (row, col);
            legalDestinations = ChessRules.LegalMovesFor(board, row, col).Select(m => (m.ToRow, m.ToCol)).ToHashSet();
        }
        else
        {
            selectedSquare = null;
            legalDestinations = new();
        }
    }

    private async Task ApplyPlayerMoveAsync(int fromRow, int fromCol, int toRow, int toCol)
    {
        animating = true;
        selectedSquare = null;
        legalDestinations = new();

        var wasCapture = board[toRow, toCol] != ChessRules.Empty;
        ChessRules.ApplyMove(board, new ChessRules.Move(fromRow, fromCol, toRow, toCol));
        UpdateCounts();
        playerTurnsTaken++;
        await Interop.InvokeVoidAsync(wasCapture ? "playImpactSound" : "playMatchSound");
        StateHasChanged();

        if (ChessRules.IsCheckmate(board, false))
        {
            outcome = Outcome.PlayerWon;
            await FinishGame();
            return;
        }
        if (ChessRules.IsStalemate(board, false))
        {
            outcome = Outcome.Draw;
            await FinishGame();
            return;
        }

        statusText = ChessRules.IsInCheck(board, false) ? "Check! CPU is thinking..." : "CPU is thinking...";
        turn = Turn.Cpu;
        animating = false;
        StateHasChanged();
        await RunCpuTurnAsync();
    }

    private async Task RunCpuTurnAsync()
    {
        await Task.Delay(450);
        var move = GameAi.ChessMove(board, aiIsWhite: false, selectedDifficulty);
        if (move is null)
        {
            // No legal move for Black and not checkmate/stalemate above
            // can't happen (those are exhaustive), but treat defensively
            // as a draw rather than leaving the game stuck.
            outcome = Outcome.Draw;
            await FinishGame();
            return;
        }

        var wasCapture = board[move.Value.ToRow, move.Value.ToCol] != ChessRules.Empty;
        ChessRules.ApplyMove(board, move.Value);
        UpdateCounts();
        await Interop.InvokeVoidAsync(wasCapture ? "playImpactSound" : "playMatchSound");
        StateHasChanged();

        if (ChessRules.IsCheckmate(board, true))
        {
            outcome = Outcome.CpuWon;
            await FinishGame();
            return;
        }
        if (ChessRules.IsStalemate(board, true))
        {
            outcome = Outcome.Draw;
            await FinishGame();
            return;
        }

        statusText = ChessRules.IsInCheck(board, true) ? "Check! Your move." : "Your move.";
        turn = Turn.Player;
        StateHasChanged();
    }

    private void UpdateCounts()
    {
        whiteCount = 0;
        blackCount = 0;
        for (var r = 0; r < ChessRules.Size; r++)
        {
            for (var c = 0; c < ChessRules.Size; c++)
            {
                var cell = board[r, c];
                if (cell == ChessRules.Empty) continue;
                if (ChessRules.IsWhite(cell)) whiteCount++; else blackCount++;
            }
        }
    }

    // Pawn and Bishop each have exactly one real image file per color (not
    // several numbered variants) - the numbered filenames that remain
    // (white-pawn-1.png, black-pawn-2.png, white/black-bishop-3.png) are
    // just what survived after sorting out which numbered file actually
    // contained which piece's art. Queen still has two genuine variants.
    private static string? PieceImagePath(int cell, int row, int col)
    {
        var color = ChessRules.IsWhite(cell) ? "white" : "black";
        var variantSeed = row * ChessRules.Size + col;
        return ChessRules.PieceType(cell) switch
        {
            ChessRules.Pawn => ChessRules.IsWhite(cell) ? "white-pawn-1.png" : "black-pawn-2.png",
            ChessRules.Knight => $"{color}-knight.png",
            ChessRules.Rook => $"{color}-rook.png",
            ChessRules.Bishop => $"{color}-bishop-3.png",
            ChessRules.Queen => $"{color}-queen-{variantSeed % 2 + 1}.png",
            ChessRules.King => $"{color}-king.png",
            _ => null,
        };
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;
        statusText = "";

        if (!string.IsNullOrEmpty(ProfileId))
        {
            var key = $"fewest-turns-{DifficultyName(selectedDifficulty).ToLowerInvariant()}";
            bestTurns = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.ChessGame, key);
            if (outcome == Outcome.PlayerWon)
            {
                isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.ChessGame, key, playerTurnsTaken, lowerIsBetter: true);
            }
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new ChessGameResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: outcome == Outcome.PlayerWon,
                PlayerTurnsTaken: playerTurnsTaken,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(GameAi.Difficulty d) => d switch
    {
        GameAi.Difficulty.Easy => "Easy",
        GameAi.Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(GameAi.Difficulty d) => d switch
    {
        GameAi.Difficulty.Easy => "CPU moves fairly randomly",
        GameAi.Difficulty.Medium => "CPU plans a couple moves ahead",
        _ => "CPU plans several moves ahead + real strategy",
    };

    public record ChessGameResult(string Difficulty, bool Won, int PlayerTurnsTaken, int ElapsedSeconds);
}
