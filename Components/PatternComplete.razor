@*
    PatternComplete.razor
    A repeating emoji pattern (like a stamped sticker sequence) plays out
    with the last symbol hidden behind a "?" - tap the option that
    continues the pattern. Difficulty controls how many distinct symbols
    the cycle uses (2/3/4), not reading or math. A fixed 8-round session
    ends with a result overlay.

    Usage:
        <PatternComplete OnComplete="HandleGameComplete" />
*@
@inject InteropService Interop
@inject AppDataService Data

<div class="pc-game">

    @if (phase == Phase.Setup)
    {
        <div class="pc-setup game-setup-panel">
            <h2>🧩 Pattern Complete</h2>
            <p>Watch the pattern repeat, then tap what comes next!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="pc-diff-name">@DifficultyName(diff)</span>
                            <span class="pc-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="pc-title">Pattern Complete</span>
            <span class="game-stat">Round @Math.Min(round, TotalRounds)/@TotalRounds</span>
            <span class="game-stat">🌟 Score @score</span>
            <span class="game-stat">🔥 Streak @streak</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="pc-sequence">
            @foreach (var symbol in sequence)
            {
                <span class="pc-seq-tile">@symbol</span>
            }
            <span class="pc-seq-tile pc-seq-blank">@(revealedAnswer ?? "❓")</span>
        </div>

        <div class="pc-choices game-option-grid">
            @for (var i = 0; i < choices.Count; i++)
            {
                var index = i;
                <button class="pc-choice-btn game-option-button @(ChoiceState(index))" disabled="@(locked)" @onclick="() => Pick(index)">
                    <span class="pc-choice-emoji">@choices[index]</span>
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="pc-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🧩 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great pattern spotting" : PlayerName + ", great pattern spotting")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Score</span><span class="game-stat-value">@score/@TotalRounds</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <PersonalBestBadge Value="@((bestScore ?? score).ToString())" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<PatternCompleteResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (high score per difficulty) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    private int? bestScore;
    private bool isNewBest;

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int TotalRounds = 8;
    private const int ChoiceCount = 4;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };
    private static readonly string[] SymbolPool = { "⭐", "🔵", "🔴", "🟢", "🟡", "🟣", "🔺", "🔶", "❤️", "🍀" };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int CycleLengthFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 2,
        Difficulty.Medium => 3,
        _ => 4,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private readonly List<string> sequence = new();
    private readonly List<string> choices = new();
    private string correctSymbol = "";
    private int? pickedIndex;
    private string? revealedAnswer;
    private bool locked;
    private int round;
    private int score;
    private int streak;
    private int bestStreak;
    private string roundMessage = "";
    private readonly Random rng = new();
    private DateTime startedAtUtc;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        round = 0;
        score = 0;
        streak = 0;
        bestStreak = 0;
        isNewBest = false;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        NextRound();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new PatternCompleteResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void NextRound()
    {
        round++;
        roundMessage = "";
        pickedIndex = null;
        revealedAnswer = null;
        locked = false;

        var cycleLength = CycleLengthFor(selectedDifficulty);
        var pool = SymbolPool.OrderBy(_ => rng.Next()).ToArray();
        var activeSet = pool.Take(cycleLength).ToArray();

        // Show two full cycles plus a random number of extra symbols into a
        // third partial cycle before hiding the next one. The extra amount
        // varies the hidden position within the cycle (0..cycleLength-1) -
        // without it, displayLen-1 was always an exact multiple of
        // cycleLength, so the hidden answer was always the very first tile
        // of the sequence regardless of difficulty, and a kid could win by
        // copying the leftmost tile without ever reading the pattern.
        var extra = rng.Next(cycleLength);
        var displayLen = cycleLength * 2 + extra;

        sequence.Clear();
        for (var i = 0; i < displayLen; i++)
        {
            sequence.Add(activeSet[i % cycleLength]);
        }
        correctSymbol = activeSet[displayLen % cycleLength];

        var distractors = activeSet.Where(s => s != correctSymbol).ToList();
        var extras = pool.Skip(cycleLength).Where(s => !distractors.Contains(s)).ToList();
        while (distractors.Count < ChoiceCount - 1 && extras.Count > 0)
        {
            distractors.Add(extras[0]);
            extras.RemoveAt(0);
        }

        choices.Clear();
        choices.Add(correctSymbol);
        choices.AddRange(distractors.Take(ChoiceCount - 1));
        Shuffle(choices);
    }

    private void Shuffle(List<string> list)
    {
        for (var i = list.Count - 1; i > 0; i--)
        {
            var j = rng.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }

    private string ChoiceState(int index)
    {
        if (pickedIndex is null) return "";
        if (choices[index] == correctSymbol) return "correct";
        if (index == pickedIndex) return "wrong";
        return "";
    }

    private async Task Pick(int index)
    {
        if (locked || phase != Phase.Playing) return;

        locked = true;
        pickedIndex = index;
        revealedAnswer = correctSymbol;

        if (choices[index] == correctSymbol)
        {
            score++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            roundMessage = "That's the pattern!";
            await Interop.InvokeVoidAsync("playMatchSound");
        }
        else
        {
            streak = 0;
            roundMessage = "So close - here's what comes next!";
            await Interop.InvokeVoidAsync("playMismatchSound");
        }

        StateHasChanged();
        await Task.Delay(1200);

        if (round >= TotalRounds)
        {
            await FinishGame();
        }
        else
        {
            NextRound();
        }
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            var key = $"score:{DifficultyName(selectedDifficulty)}";
            bestScore = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.PatternComplete, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.PatternComplete, key, score, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new PatternCompleteResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "2-symbol cycle",
        Difficulty.Medium => "3-symbol cycle",
        _ => "4-symbol cycle",
    };

    public record PatternCompleteResult(string Difficulty, int Score, int TotalRounds, int BestStreak, int ElapsedSeconds);
}
