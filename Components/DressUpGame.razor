    // ---- Sticker resize -------------------------------------------------

    private PlacedSticker? selectedSticker;
    private PlacedSticker? resizing;
    private double resizeStartClientX, resizeStartClientY, resizeStartScale;
    private PlacedSticker? pinchingSticker;
    private double pinchStartDistance, pinchStartScale;

    // Every pointer currently down anywhere on the play surface (stage,
    // tray, handles) - not just ones that started on the selected sticker.
    // A pinch can begin from any two of these as long as a sticker is
    // selected, so a small sticker doesn't require both fingers to land
    // on its own (now-small, see .du-placed-sticker-hitbox) hitbox.
    private readonly Dictionary<long, (double X, double Y)> activePointers = new();

    private const double MinScale = 0.5;
    private const double MaxScale = 8.0;
    private const double MinPinchDistance = 12.0;

    private async Task StartResize(PointerEventArgs e, PlacedSticker placed)
    {
        if (await TryBeginAnywherePinch(e)) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        resizing = placed;
        selectedSticker = placed;
        resizeStartClientX = e.ClientX;
        resizeStartClientY = e.ClientY;
        resizeStartScale = placed.Scale;
    }

    // Pinch always targets whichever sticker is already selected, and can
    // start from any two pointers down anywhere on the play surface - not
    // just two fingers both landing on that sticker's own hitbox, which is
    // now too small (by design, see .du-placed-sticker-hitbox) to reliably
    // catch a second finger on a small sticker.
    private async Task<bool> TryBeginAnywherePinch(PointerEventArgs e)
    {
        activePointers[e.PointerId] = (e.ClientX, e.ClientY);
        if (DrawMode || selectedSticker is null || activePointers.Count < 2) return false;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        dragging = null;
        resizing = null;
        rotating = null;
        overTrash = false;

        var points = activePointers.Values.Take(2).ToList();
        pinchingSticker = selectedSticker;
        pinchStartDistance = Math.Max(MinPinchDistance, Distance(points[0], points[1]));
        pinchStartScale = selectedSticker.Scale;
        StateHasChanged();
        return true;
    }

    private void UpdateStickerPinch()
    {
        if (pinchingSticker is null || activePointers.Count < 2) return;

        var points = activePointers.Values.Take(2).ToList();
        var currentDistance = Math.Max(MinPinchDistance, Distance(points[0], points[1]));
        pinchingSticker.Scale = Math.Clamp(pinchStartScale * (currentDistance / pinchStartDistance), MinScale, MaxScale);
        StateHasChanged();
    }

    private static double Distance((double X, double Y) first, (double X, double Y) second)
    {
        var dx = first.X - second.X;
        var dy = first.Y - second.Y;
        return Math.Sqrt(dx * dx + dy * dy);
    }

    private void ClearStickerGestureState()
    {
        activePointers.Clear();
        pinchingSticker = null;
        pinchStartDistance = 0;
        dragging = null;
        resizing = null;
        rotating = null;
        overTrash = false;
    }

    // ---- Sticker rotate ---------------------------------------------------
    //
    // Angle-based (rather than resize's simpler linear-delta approach) -
    // dragging the handle around the sticker's own center reads as an
    // actual "spin" gesture, which matters more for rotation than it does
    // for size since the handle's own position moves along an arc.

    private PlacedSticker? rotating;
    private double rotateCenterClientX, rotateCenterClientY;
    private double rotateStartAngleDeg, rotateStartRotationDeg;

    private async Task StartRotate(PointerEventArgs e, PlacedSticker placed)
    {
        if (await TryBeginAnywherePinch(e)) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<StageRect>("getBoundingRect", stageRef);
        stageLeft = rect.Left;
        stageTop = rect.Top;
        stageWidth = rect.Width;
        stageHeight = rect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        rotating = placed;
        selectedSticker = placed;
        (rotateCenterClientX, rotateCenterClientY) = ToClientPoint(placed.X, placed.Y);
        rotateStartAngleDeg = AngleDeg(e.ClientX, e.ClientY);
        rotateStartRotationDeg = placed.RotationDeg;
    }

    private double AngleDeg(double clientX, double clientY) =>
        Math.Atan2(clientY - rotateCenterClientY, clientX - rotateCenterClientX) * 180.0 / Math.PI;

    private void ChooseCharacter(CharacterOption character)
    {
        selectedCharacter = character;
        placedStickers.Clear();
        undoStack.Clear();
        ClearStickerGestureState();
        selectedSticker = null;
        actionMenuOpen = false;
        PushHud();
    }

    private void ChangeCharacter()
    {
        ClearStickerGestureState();
        selectedCharacter = null;
        actionMenuOpen = false;
        PushHud();
    }

    // A full reset also resets undo history - keeping stale sticker/stroke
    // entries around after everything they refer to is gone would let
    // Undo do something confusing (e.g. re-add a sticker that predates
    // the reset the kid explicitly asked for).
    private void ResetOutfit()
    {
        placedStickers.Clear();
        undoStack.Clear();
        ClearStickerGestureState();
        selectedSticker = null;
        actionMenuOpen = false;
        PushHud();
    }

    // ---- Drag and drop (Pointer Events - works for mouse, touch, pen) ------

    // A tray pointerdown doesn't commit to adding+dragging a sticker right
    // away - it waits for movement to clear TrayDragThreshold first. That
    // distinguishes a deliberate "drag it out onto the stage" gesture from
    // a plain tap (which still adds the sticker via OnTrayPointerUp, just
    // without a drag to finish). Scrolling the tray itself is handled by
    // .du-drawer's own scrollbar now, not by touch gestures on a tile -
    // .du-tray-item is touch-action:none so this logic owns every touch
    // gesture that starts on one.
    private StickerDef? pendingTraySticker;
    private long? pendingTrayPointerId;
    private double pendingTrayStartClientX, pendingTrayStartClientY;
    private const double TrayDragThreshold = 10.0;

    private void StartPendingTrayDrag(PointerEventArgs e, StickerDef sticker)
    {
        if (DrawMode) return;

        pendingTraySticker = sticker;
        pendingTrayPointerId = e.PointerId;
        pendingTrayStartClientX = e.ClientX;
        pendingTrayStartClientY = e.ClientY;
    }

    private async Task OnTrayPointerMove(PointerEventArgs e)
    {
        if (pendingTraySticker is null || pendingTrayPointerId != e.PointerId) return;

        var dx = e.ClientX - pendingTrayStartClientX;
        var dy = e.ClientY - pendingTrayStartClientY;
        if (Math.Sqrt(dx * dx + dy * dy) < TrayDragThreshold) return;

        var sticker = pendingTraySticker;
        pendingTraySticker = null;
        pendingTrayPointerId = null;
        await StartDragFromTray(e, sticker!);
    }

    private async Task OnTrayPointerUp(PointerEventArgs e)
    {
        if (pendingTraySticker is null || pendingTrayPointerId != e.PointerId) return;

        // Released before clearing the threshold - a tap, not a drag.
        // Still adds the sticker (tap-to-add), just with no drag to finish.
        var sticker = pendingTraySticker;
        pendingTraySticker = null;
        pendingTrayPointerId = null;
        await StartDragFromTray(e, sticker!);
    }

    private void OnTrayPointerCancel(PointerEventArgs e)
    {
        // Something else claimed this gesture (another pointer taking
        // over, a system gesture, etc.) - back off and add nothing.
        if (pendingTrayPointerId != e.PointerId) return;
        pendingTraySticker = null;
        pendingTrayPointerId = null;
    }

    private async Task StartDragFromTray(PointerEventArgs e, StickerDef sticker)
    {
        if (DrawMode) return;
        if (await TryBeginAnywherePinch(e)) return;

        // Always a new instance (rather than reusing one already on the
        // stage) so the same sticker can be stacked as many times as a kid
        // wants - e.g. a handful of hearts.
        var placed = new PlacedSticker { StickerId = sticker.Id, Emoji = sticker.Emoji, X = 50, Y = 50, Scale = sticker.DefaultScale };
        placedStickers.Add(placed);
        undoStack.Push(new StickerAddedEntry(placed));

        await BeginDrag(e, placed);
    }

    private async Task StartDragPlaced(PointerEventArgs e, PlacedSticker placed)
    {
        if (DrawMode) return;
        if (await TryBeginAnywherePinch(e)) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        await BeginDrag(e, placed);
    }

    private async Task BeginDrag(PointerEventArgs e, PlacedSticker placed)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<StageRect>("getBoundingRect", stageRef);

        stageLeft = rect.Left;
        stageTop = rect.Top;
        stageWidth = rect.Width;
        stageHeight = rect.Height;

        // Fetched alongside the stage rect (rather than once, cached) so it
        // stays correct if the layout reflows between drags.
        var trashRect = await _module.InvokeAsync<StageRect>("getBoundingRect", trashRef);
        trashLeft = trashRect.Left;
        trashTop = trashRect.Top;
        trashWidth = trashRect.Width;
        trashHeight = trashRect.Height;

        // Without this, a fast drag that leaves .du-play's bounds (easy to
        // do on a touch screen) stops delivering pointermove/pointerup to
        // our handlers entirely, since those events would otherwise target
        // whatever element the pointer is now over instead.
        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        dragging = placed;
        selectedSticker = placed;
        overTrash = IsOverTrash(e.ClientX, e.ClientY);
        SetDragPosition(e.ClientX, e.ClientY, clamp: true);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (activePointers.ContainsKey(e.PointerId))
        {
            activePointers[e.PointerId] = (e.ClientX, e.ClientY);
        }

        if (pinchingSticker is not null)
        {
            UpdateStickerPinch();
            return;
        }

        if (isDrawing)
        {
            // Fire-and-forget: the canvas paints itself in JS, so there's
            // nothing here that needs a Blazor re-render per point.
            _ = _module!.InvokeVoidAsync("drawMove", canvasRef, e.ClientX - stageLeft, e.ClientY - stageTop);
            return;
        }

        if (resizing is not null)
        {
            // Dragging the handle down-right grows the sticker, up-left
            // shrinks it - averaging both axes so a diagonal drag (the
            // natural motion toward/away from a corner handle) reads
            // cleanly as a single "bigger/smaller" gesture.
            var delta = ((e.ClientX - resizeStartClientX) + (e.ClientY - resizeStartClientY)) / 2;
            resizing.Scale = Math.Clamp(resizeStartScale + delta / 100.0, MinScale, MaxScale);
            StateHasChanged();
            return;
        }

        if (rotating is not null)
        {
            var currentAngle = AngleDeg(e.ClientX, e.ClientY);
            var delta = currentAngle - rotateStartAngleDeg;
            rotating.RotationDeg = ((rotateStartRotationDeg + delta) % 360 + 360) % 360;
            StateHasChanged();
            return;
        }

        if (dragging is null) return;
        overTrash = IsOverTrash(e.ClientX, e.ClientY);
        SetDragPosition(e.ClientX, e.ClientY, clamp: true);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        activePointers.Remove(e.PointerId);
        if (pinchingSticker is not null)
        {
            if (activePointers.Count < 2)
            {
                pinchingSticker = null;
                pinchStartDistance = 0;
            }

            StateHasChanged();
            return;
        }

        if (isDrawing)
        {
            isDrawing = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("drawEnd", canvasRef);
            }
            return;
        }

        if (resizing is not null)
        {
            resizing = null;
            StateHasChanged();
            return;
        }

        if (rotating is not null)
        {
            rotating = null;
            StateHasChanged();
            return;
        }

        if (dragging is null) return;

        if (overTrash)
        {
            placedStickers.Remove(dragging);
            undoStack.Push(new StickerRemovedEntry(dragging));
            if (selectedSticker == dragging) selectedSticker = null;
        }

        overTrash = false;
        dragging = null;
        StateHasChanged();
    }

    // ---- Drawing (Pointer Events routed here instead of dragging while
    // draw mode is on - see StartDragFromTray/StartDragPlaced) ------------

    private async Task OnStagePointerDown(PointerEventArgs e)
    {
        if (await TryBeginAnywherePinch(e)) return;

        if (!DrawMode)
        {
            // Tapping empty stage space (this fires after any child sticker's
            // own pointerdown too, via bubbling, but that's harmless - this
            // just re-clears a selection the child handler is about to set
            // again on its own pointerup) deselects, hiding the resize handle.
            selectedSticker = null;
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<StageRect>("getBoundingRect", stageRef);

        stageLeft = rect.Left;
        stageTop = rect.Top;
        stageWidth = rect.Width;
        stageHeight = rect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        if (drawTool == DrawTool.Fill)
        {
            // Fill on a sticker recolors that sticker (a CSS mask tint on
            // its own element - see the markup) rather than painting the
            // shared draw canvas, which sits behind regular stickers and
            // couldn't visibly tint them. Only falls through to the canvas
            // flood-fill (background / hand-drawn shapes) when the tap
            // didn't land on any placed sticker.
            var stickerIndex = await _module.InvokeAsync<int>("findStickerAt", stageRef, e.ClientX - stageLeft, e.ClientY - stageTop);
            if (stickerIndex >= 0)
            {
                // findStickerAt only ever looks at rendered .du-placed-sticker-img
                // elements, i.e. exactly the image-backed stickers in this same
                // order - so the index it returns maps straight back here.
                var imageBackedStickers = placedStickers.Where(p => ImagePathFor(p.StickerId) is not null).ToList();
                if (stickerIndex < imageBackedStickers.Count)
                {
                    var target = imageBackedStickers[stickerIndex];
                    if (target.TintColor != drawColor)
                    {
                        undoStack.Push(new StickerTintedEntry(target, target.TintColor));
                        target.TintColor = drawColor;
                        StateHasChanged();
                    }
                }
                return;
            }

            // A no-op fill (tapping a region that's already this color)
            // returns false so it doesn't push a dead undo step - without
            // that check, Undo would restore the pre-tap canvas (a correct
            // no-op visually) but still burn a slot a kid would expect to
            // undo something real.
            var filled = await _module.InvokeAsync<bool>("floodFill", canvasRef, e.ClientX - stageLeft, e.ClientY - stageTop, drawColor);
            if (filled)
            {
                undoStack.Push(new StrokeEntry());
            }
            return;
        }

        isDrawing = true;
        await _module.InvokeVoidAsync("drawStart", canvasRef, e.ClientX - stageLeft, e.ClientY - stageTop, drawColor, brushSize);
        undoStack.Push(new StrokeEntry());
    }

    private async Task ClearDrawing()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("clearDrawCanvas", canvasRef);

        // Any StrokeEntry markers now point at pixels that no longer
        // exist - drop the whole history rather than leave Undo able to
        // "restore" a stroke from before the clear.
        undoStack.Clear();
    }

    private async Task UndoAsync()
    {
        if (undoStack.Count == 0) return;

        switch (undoStack.Pop())
        {
            case StickerAddedEntry added:
                placedStickers.Remove(added.Sticker);
                break;

            case StickerRemovedEntry removed:
                placedStickers.Add(removed.Sticker);
                break;

            case StickerTintedEntry tinted:
                tinted.Sticker.TintColor = tinted.PreviousTint;
                break;

            case StrokeEntry:
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
                await _module.InvokeVoidAsync("undoLastStroke", canvasRef);
                break;
        }

        StateHasChanged();
    }

    private async Task ExportOutfitAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        // Image-backed stickers are read straight off the DOM by exportOutfit
        // (see interop.js) - only stickers still on emoji fallback need to be
        // passed in for canvas text drawing.
        var emojiStickers = placedStickers
            .Where(s => ImagePathFor(s.StickerId) is null)
            .Select(s => new { emoji = s.Emoji, xPercent = s.X, yPercent = s.Y, scale = s.Scale, rotationDeg = s.RotationDeg })
            .ToArray();
        var filename = $"dress-up-{selectedCharacter!.Name.ToLowerInvariant()}.png";

        await _module.InvokeVoidAsync("exportOutfit", stageRef, baseImageRef, emojiStickers, canvasRef, filename, selectedScene.ImagePath, selectedScene.Aligned);
    }

    private static string? ImagePathFor(string stickerId) =>
        AllStickers.FirstOrDefault(s => s.Id == stickerId)?.ImagePath;

    // Wings render behind the character (see .du-placed-sticker.behind)
    // so they read as sprouting from the back rather than sitting flat on
    // top like a badge - everything else stays in front as normal.
    private static bool IsBehindCharacter(string stickerId) =>
        AllStickers.FirstOrDefault(s => s.Id == stickerId)?.BehindCharacter ?? false;

    private bool IsOverTrash(double clientX, double clientY) =>
        trashWidth > 0 && trashHeight > 0 &&
        clientX >= trashLeft && clientX <= trashLeft + trashWidth &&
        clientY >= trashTop && clientY <= trashTop + trashHeight;

    private (double x, double y) ToStagePercent(double clientX, double clientY)
    {
        if (stageWidth <= 0 || stageHeight <= 0) return (50, 50);
        var x = (clientX - stageLeft) / stageWidth * 100;
        var y = (clientY - stageTop) / stageHeight * 100;
        return (x, y);
    }

    private (double clientX, double clientY) ToClientPoint(double xPercent, double yPercent) =>
        (stageLeft + (xPercent / 100.0) * stageWidth, stageTop + (yPercent / 100.0) * stageHeight);

    private void SetDragPosition(double clientX, double clientY, bool clamp)
    {
        var (x, y) = ToStagePercent(clientX, clientY);
        if (clamp)
        {
            x = Math.Clamp(x, 4, 96);
            y = Math.Clamp(y, 4, 96);
        }

        dragging!.X = x;
        dragging!.Y = y;
        StateHasChanged();
    }

    private record StageRect(double Left, double Top, double Width, double Height);

    // ---- Completion ------------------------------------------------------

    private async Task FinishDressUp()
    {
        celebrate = true;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new DressUpResult(
                Character: selectedCharacter!.Name,
                StickersPlaced: placedStickers.Count));
        }
    }

    public async ValueTask DisposeAsync()
    {
        HudSlot?.Set(null);

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    // ---- Result payload ------------------------------------------------------

    public record DressUpResult(string Character, int StickersPlaced);
}
