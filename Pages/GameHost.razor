@page "/play/{GameId}"
@inject AppDataService Data
@inject AppState State
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="screen game-host-screen">
    @if (_game is null)
    {
        <p class="muted">Loading game…</p>
    }
    else
    {
        <div class="game-host-bar">
            <button class="btn-secondary" @onclick="GoBack">← Exit game</button>
            <span class="game-host-title">@_game.Title</span>
            @_hudSlot.Content
        </div>

        <div class="game-host-surface">
            @if (_game.LaunchMode == GameLaunchMode.ExternalIframe)
            {
                <iframe title="@_game.Title" src="@_game.LaunchTarget"></iframe>
            }
            else if (_game.LaunchTarget == BuiltInGames.MemoryMatch)
            {
                <MemoryMatchGame PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleMemoryMatchComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Fishing)
            {
                <FishingGame PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" OnComplete="HandleFishingComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.DressUp)
            {
                <DressUpGame PlayerName="@State.CurrentProfile?.Name" OnComplete="HandleDressUpComplete" HudSlot="_hudSlot" />
            }
            else if (_game.LaunchTarget == BuiltInGames.MannersGarden)
            {
                <MannersGarden PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" OnComplete="HandleMannersGardenComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.TankDuel)
            {
                <TankDuel PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" OnComplete="HandleTankDuelComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Uno)
            {
                <UnoGame PlayerName="@State.CurrentProfile?.Name" OnComplete="HandleUnoComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.SimonSays)
            {
                <SimonSays PlayerName="@State.CurrentProfile?.Name" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleSimonSaysComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.SlidingPuzzle)
            {
                <SlidingPuzzle PlayerName="@State.CurrentProfile?.Name" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleSlidingPuzzleComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.WordScramble)
            {
                <WordScramble PlayerName="@State.CurrentProfile?.Name" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleWordScrambleComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Minesweeper)
            {
                <Minesweeper PlayerName="@State.CurrentProfile?.Name" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleMinesweeperComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Sudoku)
