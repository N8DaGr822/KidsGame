    private static double HazardMultiplier(Difficulty d) => d switch { Difficulty.Easy => 0.55, Difficulty.Hard => 1.5, _ => 1.0 };
    private static double FuelDrainMultiplier(Difficulty d) => d switch { Difficulty.Easy => 0.8, Difficulty.Hard => 1.3, _ => 1.0 };

    private async Task FinishGame(FinishReason reason)
    {
        _loopCts?.Cancel();
        lastFinishReason = reason;
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            var key = $"deepest-{DifficultyName(selectedDifficulty).ToLowerInvariant()}";
            bestDepth = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.MineForTheOnePiece, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.MineForTheOnePiece, key, deepestRow, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new MineForTheOnePieceResult(
                Difficulty: DifficultyName(selectedDifficulty),
                DeepestDepth: deepestRow * 10,
                Gold: gold,
                FoundTreasure: reason == FinishReason.FoundTreasure,
                ElapsedSeconds: elapsedSeconds));
        }
    }

