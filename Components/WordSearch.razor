@*
    WordSearch.razor
    A themed grid of letters hides several words - drag across letters in
    a straight line (any of 8 directions on Hard, fewer on easier
    difficulties, though the drag itself never restricts direction; an
    invalid line just won't match anything at release) to find each one.
    Selection tracks the pointer via a single container-level
    pointerdown/move/up instead of per-cell events, the same reason
    DressUpGame's drag does it that way - touch browsers don't reliably
    fire pointer events on sibling elements mid-drag once a gesture has
    started on one. Difficulty scales grid size, word count, and how many
    directions words get placed in. A fixed 3-grid session ends with a
    result overlay.

    Usage:
        <WordSearch OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="wsr-game">

    @if (phase == Phase.Setup)
    {
        <div class="wsr-setup game-setup-panel">
            <h2>🔍 Word Search</h2>
            <p>Drag across the letters to find each hidden word!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="wsr-diff-name">@DifficultyName(diff)</span>
                            <span class="wsr-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="wsr-title">@currentCategory.Emoji Word Search</span>
            <span class="game-stat">Grid @Math.Min(gridNumber, TotalGrids)/@TotalGrids</span>
            <span class="game-stat">✅ Found @totalFound</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="wsr-words">
            @foreach (var w in placedWords)
            {
                <span class="wsr-word-chip @(w.Found ? "found" : "")">@w.Word</span>
            }
        </div>

        <div class="wsr-grid" style="--wsr-cols:@cols" @ref="gridRef"
             @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove"
             @onpointerup="OnPointerUp" @onpointercancel="OnPointerUp">
            @for (var r = 0; r < rows; r++)
            {
                for (var c = 0; c < cols; c++)
                {
                    var cellState = CellState(r, c);
                    <span class="wsr-cell @cellState">@grid[r][c]</span>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="wsr-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🔍 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great searching" : PlayerName + ", great searching")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Words found</span><span class="game-stat-value">@totalFound/@totalWords</span></div>
                        <div><span class="game-stat-label">Grids cleared</span><span class="game-stat-value">@(gridNumber - 1)/@TotalGrids</span></div>
                    </div>
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<WordSearchResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int TotalGrids = 3;
    private const int MaxPlacementAttempts = 200;

    private record Category(string Emoji, string[] Words);
    private record PlacedWord(string Word, List<(int Row, int Col)> Cells)
    {
        public bool Found { get; set; }
    }
    private record StageRect(double Left, double Top, double Width, double Height);

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static readonly (int DRow, int DCol)[] EasyDirections = { (0, 1), (1, 0) };
    private static readonly (int DRow, int DCol)[] MediumDirections = { (0, 1), (1, 0), (1, 1) };
    private static readonly (int DRow, int DCol)[] HardDirections =
    {
        (0, 1), (1, 0), (1, 1), (0, -1), (-1, 0), (-1, -1), (1, -1), (-1, 1),
    };

    private static readonly Category[] Categories =
    {
        new("🐾", new[] { "CAT", "DOG", "FOX", "OWL", "BEAR", "LION", "WOLF", "DEER", "TIGER", "ZEBRA", "RABBIT", "MONKEY" }),
        new("🚀", new[] { "SUN", "MOON", "STAR", "MARS", "EARTH", "COMET", "ORBIT", "ROCKET", "PLANET", "GALAXY" }),
        new("🍎", new[] { "CAKE", "RICE", "SOUP", "BREAD", "APPLE", "PIZZA", "GRAPE", "COOKIE", "BANANA", "PANCAKE" }),
        new("🌊", new[] { "FISH", "CRAB", "WAVE", "SHARK", "WHALE", "CORAL", "OCTOPUS", "DOLPHIN", "STARFISH" }),
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int GridSizeFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 8,
        Difficulty.Medium => 10,
        _ => 12,
    };

    private static int WordCountFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 4,
        Difficulty.Medium => 5,
        _ => 6,
    };

    private static (int DRow, int DCol)[] DirectionsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => EasyDirections,
        Difficulty.Medium => MediumDirections,
        _ => HardDirections,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private int rows;
    private int cols;
    private char[][] grid = Array.Empty<char[]>();
    private readonly List<PlacedWord> placedWords = new();
    private Category currentCategory = Categories[0];
    private int gridNumber;
    private int totalFound;
    private int totalWords;
    private string roundMessage = "";
    private readonly Random rng = new();
    private DateTime startedAtUtc;

    private ElementReference gridRef;
    private IJSObjectReference? _module;
    private bool selecting;
    private StageRect? dragRect;
    private (int Row, int Col) selStart;
    private (int Row, int Col) selEnd;
    private List<(int Row, int Col)> selectedPath = new();

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        gridNumber = 0;
        totalFound = 0;
        totalWords = 0;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        NextGrid();
    }

    private void ExitToSetup()
    {
        phase = Phase.Setup;
    }

    private void NextGrid()
    {
        gridNumber++;
        roundMessage = "";
        selecting = false;
        selectedPath.Clear();

        var size = GridSizeFor(selectedDifficulty);
        rows = size;
        cols = size;
        var wantCount = WordCountFor(selectedDifficulty);
        var directions = DirectionsFor(selectedDifficulty);

        currentCategory = Categories[rng.Next(Categories.Length)];
        var candidates = currentCategory.Words.Where(w => w.Length <= size - 1).OrderBy(_ => rng.Next()).ToList();

        grid = Enumerable.Range(0, rows).Select(_ => new char[cols]).ToArray();
        placedWords.Clear();

        foreach (var word in candidates)
        {
            if (placedWords.Count >= wantCount) break;
            if (TryPlaceWord(word, directions))
            {
                placedWords.Add(new PlacedWord(word, _lastPlacedCells!));
            }
        }

        for (var r = 0; r < rows; r++)
        {
            for (var c = 0; c < cols; c++)
            {
                if (grid[r][c] == '\0') grid[r][c] = (char)('A' + rng.Next(26));
            }
        }

        totalWords += placedWords.Count;
    }

    private List<(int Row, int Col)>? _lastPlacedCells;

    private bool TryPlaceWord(string word, (int DRow, int DCol)[] directions)
    {
        for (var attempt = 0; attempt < MaxPlacementAttempts; attempt++)
        {
            var (dRow, dCol) = directions[rng.Next(directions.Length)];
            var maxRowStart = dRow > 0 ? rows - word.Length : rows - 1;
            var minRowStart = dRow < 0 ? word.Length - 1 : 0;
            var maxColStart = dCol > 0 ? cols - word.Length : cols - 1;
            var minColStart = dCol < 0 ? word.Length - 1 : 0;

            if (maxRowStart < minRowStart || maxColStart < minColStart) continue;

            var startRow = minRowStart + rng.Next(maxRowStart - minRowStart + 1);
            var startCol = minColStart + rng.Next(maxColStart - minColStart + 1);

            var cells = new List<(int Row, int Col)>();
            var fits = true;
            for (var i = 0; i < word.Length; i++)
            {
                var r = startRow + dRow * i;
                var c = startCol + dCol * i;
                if (r < 0 || r >= rows || c < 0 || c >= cols || (grid[r][c] != '\0' && grid[r][c] != word[i]))
                {
                    fits = false;
                    break;
                }
                cells.Add((r, c));
            }

            if (!fits) continue;

            for (var i = 0; i < word.Length; i++)
            {
                grid[cells[i].Row][cells[i].Col] = word[i];
            }
            _lastPlacedCells = cells;
            return true;
        }

        return false;
    }

    private string CellState(int r, int c)
    {
        if (placedWords.Any(w => w.Found && w.Cells.Contains((r, c)))) return "found";
        if (selecting && selectedPath.Contains((r, c))) return "selecting";
        return "";
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (phase != Phase.Playing) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        dragRect = await _module.InvokeAsync<StageRect>("getBoundingRect", gridRef);
        await _module.InvokeVoidAsync("setPointerCapture", gridRef, e.PointerId);

        var cell = CellAt(e.ClientX, e.ClientY);
        if (cell is null) return;

        selecting = true;
        selStart = cell.Value;
        selEnd = cell.Value;
        selectedPath = new List<(int Row, int Col)> { cell.Value };
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!selecting || dragRect is null) return;

        var cell = CellAt(e.ClientX, e.ClientY);
        if (cell is null) return;

        var dr = cell.Value.Row - selStart.Row;
        var dc = cell.Value.Col - selStart.Col;
        var isStraight = dr == 0 || dc == 0 || Math.Abs(dr) == Math.Abs(dc);
        if (!isStraight) return;

        selEnd = cell.Value;
        var steps = Math.Max(Math.Abs(dr), Math.Abs(dc));
        var stepRow = Math.Sign(dr);
        var stepCol = Math.Sign(dc);

        var path = new List<(int Row, int Col)>();
        for (var i = 0; i <= steps; i++)
        {
            path.Add((selStart.Row + stepRow * i, selStart.Col + stepCol * i));
        }
        selectedPath = path;
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (!selecting) return;
        selecting = false;

        var attempt = selectedPath;
        var reversed = Enumerable.Reverse(attempt).ToList();
        var match = placedWords.FirstOrDefault(w => !w.Found && (w.Cells.SequenceEqual(attempt) || w.Cells.SequenceEqual(reversed)));

        if (match is not null)
        {
            match.Found = true;
            totalFound++;
            roundMessage = $"Found {match.Word}!";
            await PlaySoundAsync("playMatchSound");

            if (placedWords.All(w => w.Found))
            {
                StateHasChanged();
                await Task.Delay(900);

                if (gridNumber >= TotalGrids)
                {
                    await FinishGame();
                    return;
                }

                NextGrid();
            }
        }

        selectedPath = new List<(int Row, int Col)>();
        StateHasChanged();
    }

    private (int Row, int Col)? CellAt(double clientX, double clientY)
    {
        if (dragRect is null || dragRect.Width <= 0) return null;

        var cellSize = dragRect.Width / cols;
        var col = (int)((clientX - dragRect.Left) / cellSize);
        var row = (int)((clientY - dragRect.Top) / cellSize);
        if (row < 0 || row >= rows || col < 0 || col >= cols) return null;

        return (row, col);
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new WordSearchResult(
                Difficulty: DifficultyName(selectedDifficulty),
                WordsFound: totalFound,
                TotalWords: totalWords,
                GridsCompleted: TotalGrids,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "8x8 grid, 4 words",
        Difficulty.Medium => "10x10 grid, 5 words",
        _ => "12x12 grid, 6 words",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record WordSearchResult(string Difficulty, int WordsFound, int TotalWords, int GridsCompleted, int ElapsedSeconds);
}
