    // ---- Upgrades ----

    private static int FuelCapacity(int tier) => tier switch { 1 => 70, 2 => 100, 3 => 140, 4 => 190, 5 => 260, _ => 350 };
    private static int CargoCapacity(int tier) => tier switch { 1 => 8, 2 => 14, 3 => 22, 4 => 32, 5 => 45, _ => 65 };
    private static int HullMax(int tier) => tier switch { 1 => 70, 2 => 100, 3 => 140, 4 => 190, 5 => 260, _ => 350 };
    private static double EngineMaxSpeed(int tier) => 3.6 + 0.6 * (tier - 1);
    private static double EngineMaxClimb(int tier) => 4.0 + 0.8 * (tier - 1);
    private static double EngineThrustBase(int tier) => tier switch { 1 => 21, 2 => 24, 3 => 27, 4 => 31, 5 => 35, _ => 40 };
    private static int UpgradeCost(int currentTier) => currentTier switch { 1 => 250, 2 => 800, 3 => 2200, 4 => 6000, 5 => 16000, _ => int.MaxValue };

    // A heavy hold makes the thruster work harder, like Motherload's
    // loaded-pod sluggishness.
    private double EngineThrust(int tier) =>
        EngineThrustBase(tier) - 6.0 * CargoCount / Math.Max(1, CargoCapacity(cargoTier));

    private int TierOf(UpgradeKind kind) => kind switch
    {
        UpgradeKind.Drill => drillTier,
        UpgradeKind.Engine => engineTier,
        UpgradeKind.FuelTank => fuelTankTier,
        UpgradeKind.CargoHold => cargoTier,
        UpgradeKind.Hull => hullTier,
        _ => radiatorTier,
    };

    private static string ShopIcon(UpgradeKind kind) => kind switch
    {
        UpgradeKind.Drill => "⛏️",
        UpgradeKind.Engine => "🚀",
        UpgradeKind.FuelTank => "⛽",
        UpgradeKind.CargoHold => "🎒",
        UpgradeKind.Hull => "🛡️",
        _ => "❄️",
    };

    private static string ShopName(UpgradeKind kind) => kind switch
    {
        UpgradeKind.Drill => "Drill",
        UpgradeKind.Engine => "Engine",
        UpgradeKind.FuelTank => "Fuel Tank",
        UpgradeKind.CargoHold => "Cargo Hold",
        UpgradeKind.Hull => "Hull",
        _ => "Radiator",
    };

    private static string ShopClass(UpgradeKind kind) => "mo-shop-" + kind.ToString().ToLowerInvariant();

    private static string ShopStat(UpgradeKind kind, int tier, bool maxed)
    {
        var next = maxed ? tier : tier + 1;
        string Arrow<T>(T now, T then) => maxed ? $"{now}" : $"{now} → {then}";
        return kind switch
        {
            UpgradeKind.Drill => maxed || MaxHardness(next) > 6
                ? "Faster drilling"
                : $"Digs {HardnessName(MaxHardness(next))}, faster",
            UpgradeKind.Engine => "Climbs & drives faster",
            UpgradeKind.FuelTank => Arrow(FuelCapacity(tier), FuelCapacity(next)),
            UpgradeKind.CargoHold => Arrow(CargoCapacity(tier), CargoCapacity(next)) + " slots",
            UpgradeKind.Hull => Arrow(HullMax(tier), HullMax(next)) + " hull",
            _ => "Resists heat & lava",
        };
    }

    private void BuyUpgrade(UpgradeKind kind)
    {
        if (overlay != Overlay.Station || phase != Phase.Playing) return;

        var tier = TierOf(kind);
        if (tier >= MaxTier) return;

        var cost = UpgradeCost(tier);
        if (gold < cost) return;

        gold -= cost;
        switch (kind)
        {
            case UpgradeKind.Drill: drillTier++; break;
            case UpgradeKind.Engine: engineTier++; break;
            case UpgradeKind.FuelTank:
                fuel += FuelCapacity(fuelTankTier + 1) - FuelCapacity(fuelTankTier);
                fuelTankTier++;
                break;
            case UpgradeKind.CargoHold: cargoTier++; break;
            case UpgradeKind.Hull:
                hull += HullMax(hullTier + 1) - HullMax(hullTier);
                hullTier++;
                break;
            default: radiatorTier++; break;
        }

        _ = Interop.InvokeVoidAsync("playBuildCompleteSound");
    }

