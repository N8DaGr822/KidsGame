@*
    PopAndSparkle.razor
    A toddler cause-and-effect toy (~1 year old target): a few large
    targets drift gently around the screen; tapping one pops with a
    sparkle and a soft sound, then it reappears somewhere new. No score,
    no timer, no fail state - covers "Tap the Star", "Pop the Balloons",
    and "Bubble Machine" from the roadmap as one component since they're
    the same tap-and-respawn mechanic in different clothes.

    There's no natural "round" here, so the in-scene "All done" button is
    what logs the play session - it fires OnComplete with how long the
    child played and how many pops they made, then returns to the theme
    picker.

    Usage:
        <PopAndSparkle OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="ps-game">

    @if (phase == Phase.Setup)
    {
        <div class="ps-setup game-setup-panel">
            <h2>✨ Pop &amp; Sparkle</h2>
            <p>Tap the floating shapes to pop them - they always come right back!</p>

            <h3 class="ps-section-title game-section-title">Choose a theme</h3>
            <div class="ps-theme-select game-option-grid">
                @foreach (var t in Themes)
                {
                    <button class="ps-theme-btn game-option-button @(t.Name == selectedTheme.Name ? "selected" : "")" @onclick="() => selectedTheme = t">
                        <span class="ps-theme-icon">@t.Icon</span>
                        <span class="ps-theme-name">@t.Name</span>
                    </button>
                }
            </div>

            <button class="ps-start-btn game-primary-action" @onclick="StartGame">Start</button>
        </div>
    }
    else
    {
        <div class="ps-hud game-hud">
            <span class="ps-title">@selectedTheme.Name</span>
            <button class="ps-restart-btn game-secondary-action" @onclick="FinishSession">All done</button>
        </div>

        <div class="ps-field">
            @for (var i = 0; i < items.Length; i++)
            {
                var idx = i;
                var item = items[idx];
                <button class="ps-item @(item.Popped ? "popped" : "")" style="@ItemStyle(item)" @onclick="() => Pop(idx)">@selectedTheme.Icon</button>
            }
        </div>
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<PopAndSparkleResult> OnComplete { get; set; }

    private enum Phase { Setup, Playing }

    private record ThemeDefinition(string Name, string Icon);

    private static readonly ThemeDefinition[] Themes =
    {
        new("Stars", "⭐"),
        new("Balloons", "🎈"),
        new("Bubbles", "🫧"),
    };

    private const int ItemCount = 3;

    private class FloatingItem
    {
        public double Left;
        public double Top;
        public double DriftMs;
        public bool Popped;
    }

    private Phase phase = Phase.Setup;
    private ThemeDefinition selectedTheme = Themes[0];
    private FloatingItem[] items = Array.Empty<FloatingItem>();
    private readonly Random rng = new();
    private int pops;
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    private void StartGame()
    {
        pops = 0;
        items = Enumerable.Range(0, ItemCount).Select(_ => NewItem()).ToArray();
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    private FloatingItem NewItem() => new()
    {
        Left = 12 + rng.NextDouble() * 76,
        Top = 12 + rng.NextDouble() * 66,
        DriftMs = 2600 + rng.NextDouble() * 1800,
    };

    private async Task Pop(int index)
    {
        var item = items[index];
        if (item.Popped) return;

        item.Popped = true;
        pops++;
        StateHasChanged();
        await PlaySoundAsync("playCatchSound");

        await Task.Delay(450);

        var fresh = NewItem();
        items[index] = fresh;
        StateHasChanged();
    }

    private string ItemStyle(FloatingItem item)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return $"left:{item.Left.ToString("0.#", inv)}%; top:{item.Top.ToString("0.#", inv)}%; animation-duration:{item.DriftMs.ToString("0", inv)}ms;";
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishSession()
    {
        phase = Phase.Setup;

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new PopAndSparkleResult(
                Theme: selectedTheme.Name,
                Pops: pops,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record PopAndSparkleResult(string Theme, int Pops, int ElapsedSeconds);
}
