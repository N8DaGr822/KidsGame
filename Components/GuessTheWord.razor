@*
    GuessTheWord.razor
    Hangman without the gallows: tap letters on an on-screen keyboard to
    reveal a hidden word before the rocket runs out of fuel. Each wrong
    letter burns one flame off the fuel gauge; a correct letter reveals
    itself everywhere it appears. Run out of fuel and the rocket sputters
    (word is revealed, round lost) - solve it in time and the rocket
    launches. A fixed 5-word session (same size as Word Scramble) ends
    with a result overlay. Difficulty scales word length (via the same
    word-list shape as WordScramble) and how much fuel you start with.

    Usage:
        <GuessTheWord OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="gw-game">

    @if (phase == Phase.Setup)
    {
        <div class="gw-setup game-setup-panel">
            <h2>🚀 Guess the Word</h2>
            <p>Tap letters to reveal the word and launch the rocket before you run out of fuel!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="gw-diff-name">@DifficultyName(diff)</span>
                            <span class="gw-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="gw-title">Guess the Word</span>
            <span class="game-stat">Word @Math.Min(wordIndex + 1, SessionSize)/@SessionSize</span>
            <span class="game-stat">🏆 Won @wordsWon</span>
            <span class="game-stat">🔥 Streak @streak</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="gw-fuel">
            @for (var i = 0; i < maxFuel; i++)
            {
                <span class="gw-fuel-flame @(i < fuel ? "lit" : "")">🔥</span>
            }
        </div>

        <div class="gw-emoji-clue">@CurrentWord.Emoji</div>

        <div class="gw-blanks">
            @foreach (var ch in CurrentWord.Word)
            {
                var revealed = guessedLetters.Contains(ch) || roundOver;
                <span class="gw-blank @(revealed ? "revealed" : "")">@(revealed ? ch.ToString() : "")</span>
            }
        </div>

        <div class="gw-keyboard">
            @foreach (var letter in Alphabet)
            {
                var used = guessedLetters.Contains(letter);
                var correct = used && CurrentWord.Word.Contains(letter);
                <button class="gw-key @(used ? (correct ? "correct" : "wrong") : "")" disabled="@(used || roundOver)" @onclick="() => GuessLetter(letter)">@letter</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="gw-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🚀 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great guessing" : PlayerName + ", great guessing")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Words won</span><span class="game-stat-value">@wordsWon/@SessionSize</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <PersonalBestBadge Value="@($"{allTimeBestStreak ?? bestStreak} streak")" IsNew="isNewStreakBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<GuessTheWordResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (longest streak, all-time) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    private int? allTimeBestStreak;
    private bool isNewStreakBest;

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int SessionSize = 5;
    private const string Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    private record WordEntry(string Word, string Emoji);

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static readonly List<WordEntry> EasyWords = new()
    {
        new("CAT", "🐱"), new("DOG", "🐶"), new("SUN", "☀️"), new("FISH", "🐟"), new("STAR", "⭐"),
        new("MOON", "🌙"), new("TREE", "🌳"), new("BOOK", "📖"), new("BALL", "⚽"), new("BIRD", "🐦"),
        new("CAKE", "🎂"), new("FROG", "🐸"), new("DUCK", "🦆"), new("LION", "🦁"), new("BEAR", "🐻"),
    };

    private static readonly List<WordEntry> MediumWords = new()
    {
        new("APPLE", "🍎"), new("HOUSE", "🏠"), new("HORSE", "🐴"), new("TIGER", "🐯"), new("CLOUD", "☁️"),
        new("SNAKE", "🐍"), new("PLANET", "🪐"), new("RABBIT", "🐰"), new("DRAGON", "🐉"), new("CASTLE", "🏰"),
        new("ROCKET", "🚀"), new("PENCIL", "✏️"), new("GUITAR", "🎸"), new("WIZARD", "🧙"), new("TURTLE", "🐢"),
    };

    private static readonly List<WordEntry> HardWords = new()
    {
        new("ELEPHANT", "🐘"), new("DINOSAUR", "🦖"), new("BUTTERFLY", "🦋"), new("RAINBOW", "🌈"), new("MOUNTAIN", "🏔️"),
        new("PINEAPPLE", "🍍"), new("OCTOPUS", "🐙"), new("HELICOPTER", "🚁"), new("STRAWBERRY", "🍓"), new("TREASURE", "💰"),
        new("UNICORN", "🦄"), new("SANDWICH", "🥪"), new("BACKPACK", "🎒"), new("TELESCOPE", "🔭"), new("WATERMELON", "🍉"),
    };

    private static List<WordEntry> WordsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => EasyWords,
        Difficulty.Medium => MediumWords,
        _ => HardWords,
    };

    private static int MaxFuelFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 8,
        Difficulty.Medium => 6,
        _ => 5,
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Medium;
    private List<WordEntry> sessionWords = new();
    private int wordIndex;
    private WordEntry CurrentWord => sessionWords[wordIndex];

    private readonly HashSet<char> guessedLetters = new();
    private int maxFuel;
    private int fuel;
    private bool roundOver;
    private string roundMessage = "";
    private int wordsWon;
    private int streak;
    private int bestStreak;
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        sessionWords = WordsFor(selectedDifficulty).OrderBy(_ => rng.Next()).Take(SessionSize).ToList();
        wordIndex = 0;
        wordsWon = 0;
        streak = 0;
        bestStreak = 0;
        allTimeBestStreak = null;
        isNewStreakBest = false;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        LoadWord();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new GuessTheWordResult(
                Difficulty: DifficultyName(selectedDifficulty),
                WordsWon: wordsWon,
                SessionSize: SessionSize,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void LoadWord()
    {
        guessedLetters.Clear();
        maxFuel = MaxFuelFor(selectedDifficulty);
        fuel = maxFuel;
        roundOver = false;
        roundMessage = "";
    }

    private async Task GuessLetter(char letter)
    {
        if (phase != Phase.Playing || roundOver || guessedLetters.Contains(letter)) return;

        guessedLetters.Add(letter);

        if (CurrentWord.Word.Contains(letter))
        {
            await PlaySoundAsync("playMatchSound");

            if (CurrentWord.Word.Distinct().All(c => guessedLetters.Contains(c)))
            {
                await WinRoundAsync();
            }
        }
        else
        {
            fuel--;
            await PlaySoundAsync("playMismatchSound");
            StateHasChanged();
            await Task.Delay(350);

            if (fuel <= 0)
            {
                await LoseRoundAsync();
            }
        }
    }

    private async Task WinRoundAsync()
    {
        roundOver = true;
        wordsWon++;
        streak++;
        bestStreak = Math.Max(bestStreak, streak);
        roundMessage = "Blast off!";
        await PlaySoundAsync("playMatchSound");
        StateHasChanged();
        await Task.Delay(1400);
        await AdvanceAsync();
    }

    private async Task LoseRoundAsync()
    {
        roundOver = true;
        streak = 0;
        roundMessage = $"Out of fuel - it was {CurrentWord.Word}!";
        StateHasChanged();
        await Task.Delay(1600);
        await AdvanceAsync();
    }

    private async Task AdvanceAsync()
    {
        if (wordIndex + 1 >= sessionWords.Count)
        {
            await FinishGame();
        }
        else
        {
            wordIndex++;
            LoadWord();
            StateHasChanged();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "best-streak";
            allTimeBestStreak = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.GuessTheWord, key);
            isNewStreakBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.GuessTheWord, key, bestStreak, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new GuessTheWordResult(
                Difficulty: DifficultyName(selectedDifficulty),
                WordsWon: wordsWon,
                SessionSize: SessionSize,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "3-4 letters, 8 fuel",
        Difficulty.Medium => "5-6 letters, 6 fuel",
        _ => "7-10 letters, 5 fuel",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record GuessTheWordResult(string Difficulty, int WordsWon, int SessionSize, int BestStreak, int ElapsedSeconds);
}
