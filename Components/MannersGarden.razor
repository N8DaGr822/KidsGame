@*
    MannersGarden.razor
    A manners-practice game for ages 3-5. The player helps one of five
    animal friends (Benny Bear, Poppy Penguin, Milo Monkey, Lulu Lamb,
    Tilly Turtle) through a short social scenario - most often by tapping
    one of two big picture choices, no reading required, since every
    choice is spoken aloud (Web Speech API) and paired with a distinct
    emoji/icon. Choosing the unkind option never "loses" anything: it
    shows the other character's natural reaction, the narrator gently
    re-prompts, and the child tries again until they pick the kind
    response. Two lessons (Greeting, Achoo) are single-path positive
    actions with no "wrong" option at all, matching how those manners
    were originally spec'd. Every completed scenario adds a
    flower/butterfly/etc. to the session's Manners Garden.

    A session is 3 scenarios drawn at random from 9 lesson types (each
    with a few character/item variations so repeat sessions don't look
    identical), followed by a short garden celebration screen.

    Usage:
        <MannersGarden OnComplete="HandleGameComplete" />

    Optional:
        <MannersGarden PlayerName="Riley" OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data

<div class="mng-game">

    @if (phase == Phase.Setup)
    {
        <div class="mng-setup game-setup-panel">
            <h2>🌷 Manners Garden</h2>
            <p>Help Benny, Poppy, Milo, Lulu, and Tilly practice kind manners - and grow a beautiful garden together!</p>

            <div class="mng-cast">
                @foreach (var member in Cast)
                {
                    <div class="mng-cast-member">
                        <AssetGlyph Class="mng-cast-emoji" Src="@member.ImagePath" Fallback="@member.Emoji" Alt="@member.FullName" />
                        <span>@member.FullName</span>
                    </div>
                }
            </div>

            <div class="mng-setup-actions">
                <button class="mng-start-btn game-primary-action" @onclick="() => StartSession(null)">▶️ Start Playing</button>
                @if (persistedGardenItems.Count > 0)
                {
                    <button class="mng-restart-btn game-secondary-action" @onclick="() => showingGardenAtSetup = true">🌷 View My Garden</button>
                }
            </div>

            <h3 class="mng-section-title game-section-title">Or practice just one skill</h3>
            <div class="mng-focus-select game-option-grid">
                @foreach (var lesson in AllLessons)
                {
                    <button class="mng-focus-btn game-option-button" @onclick="() => StartSession(lesson)">@LessonDisplayName(lesson)</button>
                }
            </div>

            <h3 class="mng-section-title game-section-title">Ready for a challenge?</h3>
            <p class="mng-quiz-intro">Read short everyday scenarios and pick the best response - for kids comfortable reading on their own.</p>
            <div class="mng-setup-actions">
                <button class="mng-start-btn game-primary-action" @onclick="StartQuizSession">📝 Manners Quiz</button>
            </div>
        </div>

        @if (showingGardenAtSetup)
        {
            <div class="mng-garden-overlay game-result-overlay">
                <div class="mng-garden-panel game-result-panel">
                    <h2>🌼 Your Manners Garden!</h2>
                    <p>Everything you've grown so far.</p>

                    <MannersGardenScene Items="persistedGardenItems" />

                    <div class="mng-garden-actions game-result-actions">
                        <button class="mng-restart-btn game-secondary-action" @onclick="() => showingGardenAtSetup = false">Close</button>
                    </div>
                </div>
            </div>
        }
    }
    else if (phase == Phase.SessionComplete)
    {
        <div class="mng-garden-overlay game-result-overlay">
            <div class="mng-garden-panel game-result-panel">
                <h2>🌼 Your Manners Garden!</h2>
                <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great job" : PlayerName + ", great job") practicing kind manners today!</p>

                <MannersGardenScene Items="persistedGardenItems" />

                <div class="mng-garden-actions game-result-actions">
                    <button class="mng-start-btn game-primary-action" @onclick="() => (quizMode ? StartQuizSession() : StartSession(null))">Play Again</button>
                    <button class="mng-restart-btn game-secondary-action" @onclick="ExitToSetup">Change Game</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mng-hud game-hud">
            <button class="mng-mute-btn" @onclick="ToggleMute" aria-label="@(muted ? "Unmute narration" : "Mute narration")">@(muted ? "🔇" : "🔊")</button>
            <div class="mng-progress">
                @{ var progressTotal = quizMode ? sessionQuiz.Count : sessionLessons.Count; var progressCurrent = quizMode ? quizIndex : roundIndex; }
                @for (int i = 0; i < progressTotal; i++)
                {
                    var dotIndex = i;
                    <span class="mng-progress-dot @(dotIndex < progressCurrent ? "done" : "") @(dotIndex == progressCurrent ? "active" : "")">🌱</span>
                }
            </div>
            <button class="mng-garden-peek-btn" @onclick="ToggleGarden">@(showingGarden ? "▶️ Back to Play" : "🌷 View Garden")</button>
            <button class="mng-restart-btn game-secondary-action" @onclick="ExitToSetup">Change Game</button>
        </div>

        @if (showingGarden)
        {
            <MannersGardenScene Items="persistedGardenItems" />
        }
        else
        {
        @if (gardenItems.Count > 0)
        {
            <div class="mng-garden-strip">
                @foreach (var item in gardenItems)
                {
                    <span class="mng-garden-chip">@item</span>
                }
            </div>
        }

        <div class="mng-stage">
            <div class="mng-speech-bubble">@narratorText</div>

            @if (quizMode)
            {
                var scenario = sessionQuiz[quizIndex];
                var answeredCorrectly = selectedChoiceIndex is { } sel && shuffledChoices[sel].IsCorrect;
                <div class="mng-quiz">
                    <div class="mng-quiz-choices">
                        @for (int i = 0; i < shuffledChoices.Count; i++)
                        {
                            var idx = i;
                            var choice = shuffledChoices[idx];
                            var isSelected = selectedChoiceIndex == idx;
                            <button class="mng-quiz-choice @(isSelected && choice.IsCorrect ? "correct" : "") @(isSelected && !choice.IsCorrect ? "wrong" : "")"
                                    disabled="@(answeredCorrectly || (isSelected && !choice.IsCorrect))"
                                    @onclick="() => ChooseQuizAnswer(idx)">
                                <span class="mng-quiz-choice-letter">@((char)('A' + idx))</span>
                                <span class="mng-quiz-choice-text">@choice.Text</span>
                            </button>
                        }
                    </div>

                    @if (selectedChoiceIndex is { } si)
                    {
                        <div class="mng-quiz-feedback @(shuffledChoices[si].IsCorrect ? "correct" : "wrong")">
                            @shuffledChoices[si].Feedback
                            @if (shuffledChoices[si].IsCorrect)
                            {
                                <span class="mng-quiz-skill">Skill: @scenario.Skill</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (round.Lesson == LessonType.CleanUp)
            {
                <div class="mng-cleanup-area" @ref="cleanupAreaRef" @onpointermove="OnCleanupPointerMove" @onpointerup="OnCleanupPointerUp" @onpointercancel="OnCleanupPointerUp">
                    @foreach (var toy in round.Toys)
                    {
                        <span @key="toy.Id" class="mng-cleanup-toy @(draggingToy == toy ? "dragging" : "")"
                              style="left:@(toy.X.ToString(Inv))%; top:@(toy.Y.ToString(Inv))%;"
                              @onpointerdown="e => StartDragToy(e, toy)"
                              @onpointerdown:preventDefault>
                            @toy.Emoji
                        </span>
                    }
                    <div class="mng-toy-bin" @ref="binRef">🧺</div>
                </div>
            }
            else if (round.Lesson == LessonType.Greeting)
            {
                <div class="mng-characters">
                    <div class="mng-character @(round.ReactorHappy ? "happy" : "")">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Reactor.ImagePath" Fallback="@round.Reactor.Emoji" Alt="@round.Reactor.FullName" />
                        <span class="mng-char-name">@round.Reactor.FullName</span>
                    </div>
                    <div class="mng-character @(round.WavedHello ? "happy" : "")">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Actor.ImagePath" Fallback="@round.Actor.Emoji" Alt="@round.Actor.FullName" />
                        <span class="mng-char-name">@round.Actor.FullName</span>
                    </div>
                </div>

                @if (!round.ShowingConsequence && phase == Phase.Playing)
                {
                    <div class="mng-single-choice">
                        <button class="mng-choice-btn polite" @onclick="WaveGreeting">
                            <span class="mng-choice-emoji">👋</span>
                            <span class="mng-choice-text">@(round.WavedHello ? "Wave Goodbye!" : "Wave Hello!")</span>
                        </button>
                    </div>
                }
            }
            else if (round.Lesson == LessonType.Achoo)
            {
                <div class="mng-achoo-area" @ref="achooAreaRef" @onpointermove="OnAchooPointerMove" @onpointerup="OnAchooPointerUp" @onpointercancel="OnAchooPointerUp">
                    <div class="mng-character mng-achoo-character">
                        @if (round.ElbowPlaced)
                        {
                            <span class="mng-char-emoji">🤧</span>
                        }
                        else
                        {
                            <AssetGlyph Class="mng-char-emoji" Src="@round.Actor.ImagePath" Fallback="@round.Actor.Emoji" Alt="@round.Actor.FullName" />
                        }
                        <span class="mng-char-name">@round.Actor.FullName</span>
                        <div class="mng-achoo-target" @ref="achooTargetRef"></div>
                    </div>

                    @if (!round.ElbowPlaced)
                    {
                        <span class="mng-elbow"
                              style="left:@(round.ElbowX.ToString(Inv))%; top:@(round.ElbowY.ToString(Inv))%;"
                              @onpointerdown="StartDragElbow"
                              @onpointerdown:preventDefault>
                            💪
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="mng-characters">
                    <div class="mng-character @(round.ReactorSad ? "sad" : "") @(round.ReactorHappy ? "happy" : "")">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Reactor.ImagePath" Fallback="@round.Reactor.Emoji" Alt="@round.Reactor.FullName" />
                        <span class="mng-char-name">@round.Reactor.FullName</span>
                        @if (round.ReactorSad)
                        {
                            <span class="mng-reaction">😢</span>
                        }
                        else if (round.ReactorHappy)
                        {
                            <span class="mng-reaction">💕</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(round.ItemEmoji))
                    {
                        <span class="mng-item">@round.ItemEmoji</span>
                    }

                    <div class="mng-character">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Actor.ImagePath" Fallback="@round.Actor.Emoji" Alt="@round.Actor.FullName" />
                        <span class="mng-char-name">@round.Actor.FullName</span>
                    </div>
                </div>

                @if (round.Lesson == LessonType.Sorry && round.HelpingRebuild)
                {
                    <p class="mng-helper-text">Tap the blocks to help rebuild!</p>
                    <div class="mng-blocks-rebuild">
                        @for (int i = 0; i < round.BlockTapped.Length; i++)
                        {
                            var idx = i;
                            <button class="mng-block @(round.BlockTapped[idx] ? "stacked" : "")" disabled="@round.BlockTapped[idx]" @onclick="() => TapBlock(idx)">🧱</button>
                        }
                    </div>
                }
                else if (!round.ShowingConsequence && phase == Phase.Playing)
                {
                    <div class="mng-choices">
                        <button class="mng-choice-btn polite" @onclick="() => ChooseOption(true)">
                            <span class="mng-choice-emoji">@PoliteEmoji(round.Lesson)</span>
                            <span class="mng-choice-text">@PoliteText(round)</span>
                        </button>
                        <button class="mng-choice-btn" @onclick="() => ChooseOption(false)">
                            <span class="mng-choice-emoji">@ImpoliteEmoji(round.Lesson)</span>
                            <span class="mng-choice-text">@ImpoliteText(round)</span>
                        </button>
                    </div>
                }
            }
        </div>
        }

        @if (phase == Phase.Reward && gardenItems.Count > 0)
        {
            <div class="mng-reward-toast">✨ @gardenItems[^1] added to your garden!</div>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    // ---- Public parameters -------------------------------------------------

    /// <summary>Optional display name, e.g. from the active kid profile.</summary>
    [Parameter] public string? PlayerName { get; set; }

    /// <summary>Active kid profile's Id - keys the persisted, all-time garden.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>Fired once when the 3-scenario session's garden celebration is shown.</summary>
    [Parameter] public EventCallback<MannersGardenResult> OnComplete { get; set; }

    // ---- Cast ----------------------------------------------------------------

    // ImagePath is null for Lulu and Tilly until matching art is added -
    // AssetGlyph falls back to Emoji automatically, so this is a
    // one-character-at-a-time migration like the rest of the app's art.
    public record CharacterDef(string FirstName, string FullName, string Emoji, string? ImagePath = null);

    private static readonly CharacterDef Benny = new("Benny", "Benny Bear", "🐻", "images/manners/benny-bear.png");
    private static readonly CharacterDef Poppy = new("Poppy", "Poppy Penguin", "🐧", "images/manners/poppy-penguin.png");
    private static readonly CharacterDef Milo = new("Milo", "Milo Monkey", "🐵", "images/manners/milo-monkey.png");
    private static readonly CharacterDef Lulu = new("Lulu", "Lulu Lamb", "🐑");
    private static readonly CharacterDef Tilly = new("Tilly", "Tilly Turtle", "🐢");

    private static readonly List<CharacterDef> Cast = new() { Benny, Poppy, Milo, Lulu, Tilly };

    // ---- Lessons ---------------------------------------------------------

    public enum LessonType { Please, ThankYou, Turns, Sorry, CleanUp, Greeting, Achoo, GentleHands, InsideVoice }

    private static readonly List<LessonType> AllLessons = Enum.GetValues<LessonType>().ToList();

    // Actor is whichever character's behavior the child chooses for;
    // Reactor is who emotionally responds to that choice.
    private record ItemVariation(CharacterDef Actor, CharacterDef Reactor, string ItemEmoji, string ItemLabel);

    private static readonly List<ItemVariation> PleaseVariations = new()
    {
        new(Milo, Poppy, "🍪", "crackers"),
        new(Benny, Milo, "🧃", "juice"),
        new(Poppy, Benny, "🖍️", "crayons"),
        new(Lulu, Tilly, "🥕", "carrots"),
        new(Tilly, Lulu, "🍇", "grapes"),
    };

    private static readonly List<ItemVariation> ThankYouVariations = new()
    {
        new(Milo, Poppy, "🌼", "flower"),
        new(Poppy, Benny, "🐚", "seashell"),
        new(Benny, Milo, "⭐", "sticker"),
        new(Lulu, Tilly, "🎈", "balloon"),
        new(Tilly, Lulu, "🍓", "berry"),
    };

    private static readonly List<ItemVariation> TurnsVariations = new()
    {
        new(Milo, Benny, "🚂", "toy train"),
        new(Benny, Poppy, "🧱", "blocks"),
        new(Poppy, Milo, "⚽", "ball"),
        new(Lulu, Tilly, "🪁", "kite"),
        new(Tilly, Benny, "🧩", "puzzle"),
    };

    private static readonly List<ItemVariation> SorryVariations = new()
    {
        new(Milo, Benny, "🧱", "block tower"),
        new(Poppy, Milo, "🧱", "block tower"),
        new(Benny, Poppy, "🧱", "block tower"),
        new(Lulu, Tilly, "🧱", "block tower"),
        new(Tilly, Lulu, "🧱", "block tower"),
    };

    private static readonly List<ItemVariation> GentleHandsVariations = new()
    {
        new(Milo, Lulu, "", ""),
        new(Benny, Tilly, "", ""),
        new(Poppy, Milo, "", ""),
        new(Lulu, Benny, "", ""),
    };

    private static readonly List<ItemVariation> InsideVoiceVariations = new()
    {
        new(Milo, Poppy, "", ""),
        new(Lulu, Tilly, "", ""),
        new(Benny, Milo, "", ""),
    };

    private static readonly List<ItemVariation> GreetingVariations = new()
    {
        new(Milo, Benny, "", ""),
        new(Lulu, Poppy, "", ""),
        new(Tilly, Milo, "", ""),
        new(Poppy, Lulu, "", ""),
    };

    private static readonly List<CharacterDef> AchooCharacters = new() { Benny, Poppy, Milo, Lulu, Tilly };

    private static readonly (string Emoji, string Label)[] ToyPool =
    {
        ("🧸", "teddy bear"), ("🧱", "blocks"), ("⚽", "ball"),
        ("📚", "book"), ("🚗", "car"), ("🖍️", "crayon"),
    };

    private static readonly string[] GardenRewardPool =
    {
        "🌸", "🌷", "🌻", "🌼", "🌹", "🦋", "🐦", "🍎", "🐞", "🌳", "✨", "🍓",
    };

    // ---- Manners Quiz content ---------------------------------------------
    //
    // Wrong choices are deliberately plausible - a reasonable-sounding
    // response with a real (if minor) downside - rather than cartoonishly
    // rude, so the feedback can teach the reasoning behind the manner
    // rather than just rewarding pattern-matching "which one is nice."
    public sealed record QuizChoice(string Text, bool IsCorrect, string Feedback);
    public sealed record QuizScenario(string Title, string Skill, string Prompt, List<QuizChoice> Choices);

    private static readonly List<QuizScenario> QuizScenarios = new()
    {
        new("Someone Holds the Door", "Saying thank you",
            "You're walking into a building and someone holds the door open for you. What do you do?",
            new()
            {
                new("Walk through without saying anything.", false, "It's easy to forget, but a quick \"thank you\" lets them know you noticed their kindness."),
                new("Say \"Thank you!\" as you walk through.", true, "That's it! A quick thank you shows you appreciate their kindness."),
                new("Rush past quickly so you don't hold them up.", false, "Being quick is thoughtful, but you can walk normally and still say thank you - it only takes a second."),
            }),

        new("The Last Cookie", "Sharing / consideration",
            "There is one cookie left on the plate. You and your friend both want it.",
            new()
            {
                new("Grab it quickly before your friend can.", false, "Grabbing it fast might get you the cookie, but it could hurt your friend's feelings and doesn't feel fair to them."),
                new("Ask, \"Do you want to split it?\"", true, "Great idea! Splitting it means you both get some, and nobody feels left out."),
                new("Tell your friend you deserve it because you saw it first.", false, "Seeing it first doesn't make it more yours than theirs - sharing feels better for both of you."),
            }),

        new("Interrupting a Conversation", "Waiting politely / saying \"excuse me\"",
            "Two adults are talking and you need to ask one of them something.",
            new()
            {
                new("Shout their name from across the room until they notice.", false, "Shouting can startle people and interrupt their conversation. There's a quieter way to get noticed."),
                new("Walk up, wait for a pause, and say \"Excuse me.\"", true, "That's it! Waiting for a pause and saying \"excuse me\" lets them know you have something to say without cutting them off."),
                new("Tap their arm right away and start talking.", false, "It's okay to get their attention, but jumping straight into talking cuts off what they were saying. Try saying \"excuse me\" and waiting a moment."),
            }),

        new("A Friend Drops Their Books", "Offering help",
            "Someone drops their books or belongings in front of you.",
            new()
            {
                new("Walk around them and keep going - it's not your mess.", false, "It's not your mess, but helping out anyway is a kind thing to do for someone having a hard moment."),
                new("Stop and help pick everything up.", true, "Exactly! A small favor like that can really turn someone's day around."),
                new("Laugh and point out that they dropped everything.", false, "Laughing at someone's accident can really embarrass them - try helping instead."),
            }),

        new("You Bump Into Someone", "Apologizing",
            "You accidentally bump into another person while walking.",
            new()
            {
                new("Keep walking like nothing happened.", false, "Even small bumps are nice to acknowledge - a quick apology shows you noticed."),
                new("Say \"Sorry about that!\" and keep going.", true, "Perfect. A quick apology is all it takes."),
                new("Blame them for being in your way.", false, "Even if they were partly in the way, blaming them can start an argument over something small. A simple sorry is easier for everyone."),
            }),

        new("Meeting Someone New", "Greeting people politely",
            "You are introduced to someone you've never met before.",
            new()
            {
                new("Look at the floor and stay quiet.", false, "It's normal to feel shy, but staying silent can make the other person feel unwelcome too."),
                new("Say hi, smile, and tell them your name.", true, "That's a great way to make someone feel welcome!"),
                new("Say hi but keep looking at your phone.", false, "Saying hi is a good start, but looking at your phone can make the other person feel like you're not really interested in meeting them."),
            }),

        new("Someone Gives You a Gift", "Showing gratitude",
            "You receive a present that isn't exactly what you wanted.",
            new()
            {
                new("Say \"I already have one of these\" or \"I wanted something else.\"", false, "Even if it's not what you hoped for, saying that can hurt the giver's feelings after they picked something out for you."),
                new("Say \"Thank you, that's so nice of you!\"", true, "Right! They spent time thinking of you, and showing gratitude matters more than the gift itself."),
                new("Say thank you, but with a disappointed sigh so they know you're not thrilled.", false, "Saying thank you is good, but a sigh can still show you're disappointed. Try to really mean the thank you instead."),
            }),

        new("Waiting Your Turn", "Taking turns",
            "Several kids are waiting to use the same swing, game, or toy.",
            new()
            {
                new("Cut in line because you've been waiting the longest in your head.", false, "Everyone thinks they've waited long enough! Cutting in line isn't fair to the kids who got there first."),
                new("Wait in line and take your turn when it comes.", true, "That's the way to do it! Waiting your turn is fair to everyone."),
                new("Ask an adult to let you go first because you really want it.", false, "Wanting something a lot doesn't mean you should skip ahead of everyone else waiting."),
            }),

        new("Borrowing Something", "Asking permission",
            "You want to use your friend's markers.",
            new()
            {
                new("Take them without saying anything since you'll give them back.", false, "Even if you plan to give it back, taking something without asking can feel surprising or unfair to your friend."),
                new("Ask, \"Can I use your markers?\"", true, "That's it! Asking first means your friend gets a say in sharing their things."),
                new("Wait until your friend isn't looking and quietly borrow them.", false, "Borrowing quietly so they don't notice is still taking without permission - it's better to just ask."),
            }),

        new("Returning Something You Borrowed", "Returning belongings / gratitude",
            "You're finished using something a friend loaned you.",
            new()
            {
                new("Leave it in your backpack until they ask for it back.", false, "Your friend might need it before they think to ask - it's kinder to return it as soon as you're done."),
                new("Give it back and say thank you for letting you use it.", true, "Exactly! Returning it promptly and saying thanks shows you appreciate them sharing."),
                new("Give it back without saying anything about it.", false, "Returning it is good, but adding a quick thank you shows extra appreciation for the favor."),
            }),

        new("Someone Is Speaking", "Listening without interrupting",
            "Your friend is telling a story, but you're excited to tell your own.",
            new()
            {
                new("Jump in and start telling your story right away.", false, "Jumping in can make your friend feel like their story doesn't matter. Try waiting for a pause."),
                new("Wait until they finish, then share yours.", true, "Perfect. Listening all the way through shows your friend you care about what they're saying."),
                new("Keep saying \"uh-huh\" impatiently until they hurry up.", false, "Rushing someone with impatient sounds can feel unfriendly, even if you don't mean it that way."),
            }),

        new("Choosing a Seat", "Consideration for others",
            "You get on a crowded bus and notice someone who may need your seat more than you do.",
            new()
            {
                new("Sit down quickly so you don't have to stand.", false, "Getting a seat is nice, but someone who needs it more - like an elderly person or someone carrying something heavy - could really use it."),
                new("Offer your seat to them.", true, "That's very considerate! Offering your seat when someone else needs it more is a kind thing to do."),
                new("Pretend not to notice them so you don't have to decide.", false, "It's easier to look away, but noticing and offering your seat anyway is the kinder choice."),
            }),

        new("Eating at Someone Else's House", "Being gracious about food",
            "You are served a food you don't like.",
            new()
            {
                new("Say \"Ew, I don't like this\" out loud.", false, "That can hurt the cook's feelings after they made food for you. There's a more polite way to handle it."),
                new("Try a small bite and politely eat what you can.", true, "That's a great approach! Trying it shows respect for the effort someone put into cooking."),
                new("Quietly push it around your plate so it looks like you ate some.", false, "That might avoid an awkward moment, but it's a little sneaky. It's better to just eat a small polite amount or say something kindly."),
            }),

        new("Talking With Food in Your Mouth", "Table manners",
            "Someone asks you a question while you're chewing.",
            new()
