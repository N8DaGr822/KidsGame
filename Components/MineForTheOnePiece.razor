    private void BuyUpgrade(UpgradeKind kind)
    {
        if (podRow != 0 || phase != Phase.Playing) return;

        var tier = TierOf(kind);
        if (tier >= MaxTier) return;

        var cost = UpgradeCost(tier);
        if (gold < cost) return;

        gold -= cost;
        switch (kind)
        {
            case UpgradeKind.Drill:
                drillTier++;
                break;
            case UpgradeKind.FuelTank:
                fuelTankTier++;
                fuel = FuelCapacity(fuelTankTier);
                break;
            case UpgradeKind.CargoHold:
                cargoTier++;
                break;
            default:
                hullTier++;
                hull = HullMax(hullTier);
                break;
        }

        _ = Interop.InvokeVoidAsync("playBuildCompleteSound");
    }

