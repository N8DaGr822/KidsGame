@*
    FollowTheCups.razor
    Classic shell game: a ball is hidden under one of several cups, then the
    cups shuffle positions while the ball secretly stays with its cup. Tap
    the cup you think still holds it. A fixed 6-round session tracks a
    streak that resets on a wrong guess (never ends the session early -
    unlike HigherOrLower/GuessTheWord's run-ending streak games, a miss here
    just costs that one round, matching the exploratory feel one shell-game
    reveal warrants). Difficulty scales cup count and shuffle speed/count.
    Personal best tracks longest streak, all-time.

    Usage:
        <FollowTheCups OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="ftc-game">

    @if (phase == Phase.Setup)
    {
        <div class="ftc-setup game-setup-panel">
            <h2>🎩 Follow the Cups</h2>
            <p>Watch which cup hides the ball, then track it through the shuffle. Tap the cup you think still has it!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="ftc-diff-name">@DifficultyName(diff)</span>
                            <span class="ftc-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="ftc-title">Follow the Cups</span>
            <span class="game-stat">Round @Math.Min(roundIndex + 1, SessionSize)/@SessionSize</span>
            <span class="game-stat">🏆 Won @roundsWon</span>
            <span class="game-stat">🔥 Streak @streak</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <p class="ftc-status">@StatusText</p>

        <div class="ftc-table" style="width:@(Math.Max(1, cups.Count) * CupStepPx)px">
            @foreach (var cup in cups)
            {
                var isBallCup = cup.Id == ballCupId;
                var isLifted = cup.Id == revealedCupId || (roundState == RoundState.Revealing && cup.Id == guessedCupId);
                var isWrongGuess = roundState == RoundState.Revealing && cup.Id == guessedCupId && !isBallCup;
                var isCorrectGuess = roundState == RoundState.Revealing && cup.Id == guessedCupId && isBallCup;

                <div class="ftc-slot" @key="cup.Id" style="left:@(cup.Position * CupStepPx)px">
                    @if (isBallCup)
                    {
                        <span class="ftc-ball">🔴</span>
                    }
                    <button class="ftc-cup @(isLifted ? "lifted" : "") @(isWrongGuess ? "wrong" : "") @(isCorrectGuess ? "correct" : "")"
                            disabled="@(roundState != RoundState.Guessing)"
                            @onclick="() => TapCup(cup.Id)">
                    </button>
                </div>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🎩 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Nice tracking" : PlayerName + ", nice tracking")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Rounds won</span><span class="game-stat-value">@roundsWon/@SessionSize</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <PersonalBestBadge Value="@($"{allTimeBestStreak ?? bestStreak} streak")" IsNew="isNewStreakBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<FollowTheCupsResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (longest streak, all-time) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    private enum RoundState { Peeking, Shuffling, Guessing, Revealing }
    public enum Difficulty { Easy, Medium, Hard }

    private class CupState
    {
        public int Id { get; init; }
        public int Position { get; set; }
    }

    private const int SessionSize = 6;
    private const int CupStepPx = 130;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int CupCountFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 3,
        Difficulty.Medium => 4,
        _ => 5,
    };

    private static int ShuffleCountFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 4,
        Difficulty.Medium => 7,
        _ => 10,
    };

    private static int ShuffleDelayMsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 620,
        Difficulty.Medium => 460,
        _ => 340,
    };

    private Phase phase = Phase.Setup;
    private RoundState roundState = RoundState.Peeking;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private List<CupState> cups = new();
    private int ballCupId;
    private int? revealedCupId;
    private int? guessedCupId;
    private int roundIndex;
    private int roundsWon;
    private int streak;
    private int bestStreak;
    private int? allTimeBestStreak;
    private bool isNewStreakBest;
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    private string StatusText => roundState switch
    {
        RoundState.Peeking => "Watch closely...",
        RoundState.Shuffling => "Shuffling!",
        RoundState.Guessing => "Which cup has the ball?",
        RoundState.Revealing when guessedCupId == ballCupId => "Found it! 🎉",
        _ => "Not that one - it was here!",
    };

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private async Task StartGame()
    {
        roundIndex = 0;
        roundsWon = 0;
        streak = 0;
        bestStreak = 0;
        allTimeBestStreak = null;
        isNewStreakBest = false;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        await StartRound();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new FollowTheCupsResult(
                Difficulty: DifficultyName(selectedDifficulty),
                RoundsWon: roundsWon,
                SessionSize: SessionSize,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task StartRound()
    {
        if (phase != Phase.Playing) return;

        var cupCount = CupCountFor(selectedDifficulty);
        cups = Enumerable.Range(0, cupCount).Select(i => new CupState { Id = i, Position = i }).ToList();
        ballCupId = rng.Next(cupCount);
        guessedCupId = null;
        revealedCupId = ballCupId;
        roundState = RoundState.Peeking;
        StateHasChanged();
        await PlaySoundAsync("playImpactSound");
        await Task.Delay(900);
        if (phase != Phase.Playing) return;

        revealedCupId = null;
        StateHasChanged();
        await Task.Delay(300);
        await ShuffleAsync();
    }

    private async Task ShuffleAsync()
    {
        if (phase != Phase.Playing) return;

        roundState = RoundState.Shuffling;
        var count = ShuffleCountFor(selectedDifficulty);
        var delay = ShuffleDelayMsFor(selectedDifficulty);

        for (var i = 0; i < count; i++)
        {
            if (phase != Phase.Playing) return;

            var posA = rng.Next(cups.Count);
            int posB;
            do { posB = rng.Next(cups.Count); } while (posB == posA);
            var cupA = cups.First(c => c.Position == posA);
            var cupB = cups.First(c => c.Position == posB);
            (cupA.Position, cupB.Position) = (cupB.Position, cupA.Position);
            StateHasChanged();
            await Task.Delay(delay);
        }

        if (phase != Phase.Playing) return;
        roundState = RoundState.Guessing;
        StateHasChanged();
    }

    private async Task TapCup(int id)
    {
        if (roundState != RoundState.Guessing) return;

        roundState = RoundState.Revealing;
        guessedCupId = id;
        revealedCupId = ballCupId;
        var correct = id == ballCupId;

        if (correct)
        {
            roundsWon++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            await PlaySoundAsync("playMatchSound");
        }
        else
        {
            streak = 0;
            await PlaySoundAsync("playMismatchSound");
        }

        StateHasChanged();
        await Task.Delay(1400);
        if (phase != Phase.Playing) return;
        await AdvanceRoundAsync();
    }

    private async Task AdvanceRoundAsync()
    {
        if (roundIndex + 1 >= SessionSize)
        {
            await FinishGame();
        }
        else
        {
            roundIndex++;
            await StartRound();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "best-streak";
            allTimeBestStreak = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.FollowTheCups, key);
            isNewStreakBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.FollowTheCups, key, bestStreak, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new FollowTheCupsResult(
                Difficulty: DifficultyName(selectedDifficulty),
                RoundsWon: roundsWon,
                SessionSize: SessionSize,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "3 cups, slow shuffle",
        Difficulty.Medium => "4 cups, medium shuffle",
        _ => "5 cups, fast shuffle",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record FollowTheCupsResult(string Difficulty, int RoundsWon, int SessionSize, int BestStreak, int ElapsedSeconds);
}
