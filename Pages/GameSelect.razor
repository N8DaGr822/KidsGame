@page "/games"
@inject AppDataService Data
@inject AppState State
@inject NavigationManager Nav

<div class="screen games-screen" style="--profile-color:@(State.CurrentProfile?.ColorHex ?? "#4ECDC4")">
    @if (State.CurrentProfile is null)
    {
        <p class="muted">Redirecting…</p>
    }
    else
    {
        <div class="games-header">
            <div class="profile-chip">
                <AssetGlyph Class="profile-chip-avatar" Src="@State.CurrentProfile.AvatarImagePath" Fallback="@State.CurrentProfile.AvatarEmoji" Alt="@State.CurrentProfile.Name" />
                <span>@State.CurrentProfile.Name</span>
            </div>
            <a class="link-switch-profile" href="">Switch profile</a>
        </div>

        <h1>Pick a game</h1>

        @if (_games is null)
        {
            <p class="muted">Loading games…</p>
        }
        else if (_games.Count == 0)
        {
            <p class="muted">No games have been added for this profile yet. Ask a parent to add some in the admin panel.</p>
        }
        else
        {
            <Carousel>
                @foreach (var game in _games.Take(8))
                {
                    <GameCard Game="game" OnSelect="PlayAsync" />
                }
            </Carousel>

            @if (_games.Count > 8)
            {
                <a class="link-see-all" href="games/all">See all @_games.Count games →</a>
            }
        }
    }
</div>

@code {
    private List<Game>? _games;

    protected override async Task OnInitializedAsync()
    {
        if (State.CurrentProfile is null)
        {
            Nav.NavigateTo("");
            return;
        }

        _games = await Data.GetGamesForProfileAsync(State.CurrentProfile.Id);
    }

    private void PlayAsync(Game game) => Nav.NavigateTo($"play/{game.Id}");
}
