    // ---- Play-area sizing ----

    // Target on-screen tile size; the row count is chosen so tiles land
    // near this, then as many columns as fit (up to the whole world width).
    private const double TargetTilePx = 72;

    private ElementReference boxRef;
    private DateTime nextMeasureUtc;

    private string StageStyle =>
        $"width:{(visibleCols * tilePx).ToString("0.#", Inv)}px; height:{(visibleRows * tilePx).ToString("0.#", Inv)}px;";

    // Re-measured about once a second (cheap) so window resizes and phone
    // rotation are picked up without a resize listener.
    private async Task MeasurePlayArea()
    {
        var box = await Interop.InvokeAsync<StickRect>("getBoundingRect", boxRef);
        if (box.Width < 50 || box.Height < 50) return;

        var rows = Math.Clamp((int)Math.Round(box.Height / TargetTilePx), 8, 13);
        var cols = Math.Clamp((int)Math.Round(box.Width / (box.Height / rows)), 7, Cols);
        var tile = Math.Floor(Math.Min(box.Height / rows, box.Width / cols));

        if (rows == visibleRows && cols == visibleCols && Math.Abs(tile - tilePx) < 1) return;
        visibleRows = rows;
        visibleCols = cols;
        tilePx = tile;
        UpdateCamera(1);
        StateHasChanged();
    }

    private string CellStyle(int r, int c, bool isDrill)
    {
        var style = $"left:{Pct(c, visibleCols)}%; top:{Pct(r - SkyTop, visibleRows)}%; width:{Pct(1, visibleCols)}%; height:{Pct(1, visibleRows)}%;";
        if (!isDrill) return style;
        var t = DrillT;
        return style + $" transform:scale({(1 - 0.45 * t).ToString("0.###", Inv)}); opacity:{(1 - 0.5 * t).ToString("0.###", Inv)};";
    }

    protected override async Task OnInitializedAsync()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
        if (string.IsNullOrEmpty(ProfileId)) return;

        savedGame = await Data.GetMineSaveAsync(ProfileId);
        mineProfile = await Data.GetMineProfileAsync(ProfileId);
    }

    // A save can be continued only if it's current-format and (when a
    // parent has locked the difficulty) matches that difficulty.
    private MineSave? ContinuableSave =>
        savedGame is { Version: SaveVersion } s
        && Enum.TryParse<Difficulty>(s.Difficulty, out var d)
        && (LockedDifficulty is null || LockedDifficulty == d)
            ? s
            : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (phase == Phase.Playing && DateTime.UtcNow >= nextMeasureUtc)
        {
            nextMeasureUtc = DateTime.UtcNow.AddSeconds(1);
            await MeasurePlayArea();
        }

        if (needsFocus && phase == Phase.Playing && overlay == Overlay.None)
        {
            needsFocus = false;
            await fieldRef.FocusAsync(preventScroll: true);
        }
    }

    private void StartGame()
    {
        GenerateWorld(selectedDifficulty);

        drillTier = engineTier = fuelTankTier = cargoTier = hullTier = radiatorTier = 1;
        fuel = FuelCapacity(fuelTankTier);
        hull = HullMax(hullTier);
        cargo.Clear();
        items.Clear();
        gold = StartingGold(selectedDifficulty);
        deepestRow = 0;
        nextMilestone = 0;
        elapsedSeconds = 0;

        BeginPlaying();
        _ = SaveCheckpointAsync();
    }

    private void ContinueGame()
    {
        if (ContinuableSave is not { } s) return;

        selectedDifficulty = Enum.Parse<Difficulty>(s.Difficulty);
        tiles = new TileKind[TotalDepthRows + 1, Cols];
        for (var r = 0; r <= TotalDepthRows; r++)
            for (var c = 0; c < Cols; c++)
            {
                var i = r * Cols + c;
                tiles[r, c] = i < s.Tiles.Length ? (TileKind)(s.Tiles[i] - 'A') : TileKind.Bedrock;
            }

        gold = s.Gold;
        drillTier = s.DrillTier;
        engineTier = s.EngineTier;
        fuelTankTier = s.FuelTankTier;
        cargoTier = s.CargoTier;
        hullTier = s.HullTier;
        radiatorTier = s.RadiatorTier;
        fuel = s.Fuel;
        hull = s.Hull;
        cargo.Clear();
        foreach (var (k, v) in s.Cargo)
            if (Enum.TryParse<TileKind>(k, out var kind)) cargo[kind] = v;
        items.Clear();
        foreach (var (k, v) in s.Items)
            if (Enum.TryParse<ItemKind>(k, out var item)) items[item] = v;
        deepestRow = s.DeepestRow;
        nextMilestone = s.NextMilestone;
        elapsedSeconds = s.ElapsedSeconds;

        BeginPlaying();
        ShowToast("💾 Welcome back, Captain! Your expedition is right where you left it.");
    }

    // Shared reset for a fresh or continued run: pod on the surface, all
    // transient state cleared, loop started.
    private void BeginPlaying()
    {
        ResetPodToSurface();
        facing = Direction.Down;
        ClearHeld();
        wobblingRocks.Clear();
        fallingRocks.Clear();
        anchorStepsLeft = 0;
        anchorActive = false;
        shipTab = ShipTab.Upgrades;
        lastHeatWarned = 0;
        accumulator = 0;
        camX = Math.Clamp(px - visibleCols / 2.0, 0, Cols - visibleCols);
        camY = SkyTop;
        toast = null;
        radioMessage = null;
        pendingWin = false;
        overlay = Overlay.None;
        activeStation = null;
        stationLatch = null;
        bestDepth = null;
        isNewBest = false;

        startedAtUtc = DateTime.UtcNow.AddSeconds(-elapsedSeconds);
        phase = Phase.Playing;
        needsFocus = true;

        _loopCts?.Cancel();
        _loopCts = new CancellationTokenSource();
        _ = RunLoopAsync(_loopCts.Token);
    }

    private void ResetPodToSurface()
    {
        px = StartX;
        py = 1 - PodHalf - Eps;
        vx = vy = 0;
        grounded = true;
        thrusting = false;
        drilling = false;
        anchorStepsLeft = 0;
        anchorActive = false;
    }

    // ---- Saving ----

    // Checkpoints the expedition. Called whenever the pod is safely on the
    // surface (docking at a station, after a rescue, exiting from the
    // surface) - exiting mid-dive keeps the last checkpoint instead, so
    // quitting can't dodge a tow fee or undo a bad dive.
    private async Task SaveCheckpointAsync()
    {
        if (string.IsNullOrEmpty(ProfileId) || phase != Phase.Playing) return;

        var chars = new char[(TotalDepthRows + 1) * Cols];
        for (var r = 0; r <= TotalDepthRows; r++)
            for (var c = 0; c < Cols; c++)
                chars[r * Cols + c] = (char)('A' + (int)tiles[r, c]);

        savedGame = new MineSave
        {
            Version = SaveVersion,
            Difficulty = DifficultyName(selectedDifficulty),
            Tiles = new string(chars),
            Gold = gold,
            DrillTier = drillTier,
            EngineTier = engineTier,
            FuelTankTier = fuelTankTier,
            CargoTier = cargoTier,
            HullTier = hullTier,
            RadiatorTier = radiatorTier,
            Fuel = fuel,
            Hull = hull,
            Cargo = cargo.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value),
            Items = items.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value),
            DeepestRow = deepestRow,
            NextMilestone = nextMilestone,
            ElapsedSeconds = elapsedSeconds,
            SavedAtUtc = DateTime.UtcNow,
        };
        await Data.SetMineSaveAsync(ProfileId, savedGame);
    }

    private async Task SaveMineProfileAsync()
    {
        if (!string.IsNullOrEmpty(ProfileId)) await Data.SaveMineProfileAsync(ProfileId, mineProfile);
    }

    private async Task ExitToSetup()
    {
        _loopCts?.Cancel();
        if (phase == Phase.Playing)
        {
            if (!Underground) await SaveCheckpointAsync();
            await RecordBestAsync();
            if (OnComplete.HasDelegate)
            {
                await OnComplete.InvokeAsync(new MineForTheOnePieceResult(
                    Difficulty: DifficultyName(selectedDifficulty),
                    DeepestDepth: deepestRow * 10,
                    Gold: gold,
                    FoundTreasure: false,
                    ElapsedSeconds: elapsedSeconds));
            }
        }
        phase = Phase.Setup;
    }

    private async Task RunLoopAsync(CancellationToken ct)
    {
        var lastTick = DateTime.UtcNow;

        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(FrameDelayMs, ct);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            try
            {
                var now = DateTime.UtcNow;
                accumulator += (now - lastTick).TotalSeconds;
                lastTick = now;

                var substeps = 0;
                while (accumulator >= FixedDt && substeps < MaxSubstepsPerFrame)
                {
                    StepPhysics(FixedDt);
                    accumulator -= FixedDt;
                    substeps++;
                }
                if (substeps >= MaxSubstepsPerFrame) accumulator = 0;

                elapsedSeconds = (int)(now - startedAtUtc).TotalSeconds;
                if (toast is not null && now >= toastUntilUtc) toast = null;
                if (radioMessage is not null && now >= radioUntilUtc) radioMessage = null;

                if (pendingWin)
                {
                    await FinishGame();
                    return;
                }

                StateHasChanged();
            }
            catch (Exception) when (!ct.IsCancellationRequested)
            {
            }
        }
    }

    private void StepPhysics(double dt)
    {
        if (phase != Phase.Playing || overlay != Overlay.None || pendingWin) return;

        if (drilling) UpdateDrill(dt);
        else UpdateMovement(dt);

        if (pendingWin) return;

        UpdateRocks(dt);
        UpdateFuelAndHeat(dt);
        deepestRow = Math.Max(deepestRow, PodRow);
        CheckMilestones();

        if (hull <= 0)
        {
            Rescue("💥 Hull wrecked!", "Your pod fell apart, but the crew hauled it back to the surface.");
            return;
        }
        if (fuel <= 0 && Underground)
        {
            Rescue("⛽ Out of fuel!", "Your pod sputtered to a stop, so the crew towed it home.");
            return;
        }

        CheckStations();
        UpdateCamera(dt);
    }

    // ---- Movement & collision ----

    private bool Held(Direction d) => heldKeys.Contains(d) || heldPointer.Contains(d);

    private void ClearHeld()
    {
        heldKeys.Clear();
        heldPointer.Clear();
    }

    private void UpdateMovement(double dt)
    {
        var hx = (Held(Direction.Right) ? 1 : 0) - (Held(Direction.Left) ? 1 : 0);
        var up = Held(Direction.Up) && fuel > 0;

        if (grounded && TryDrillFromInput()) return;

        if (hx != 0)
        {
            vx += hx * (grounded ? GroundAccel : AirAccel) * dt;
        }
        else
        {
            var damp = (grounded ? GroundFriction : AirDrag) * dt;
            vx = Math.Abs(vx) <= damp ? 0 : vx - Math.Sign(vx) * damp;
        }
        var maxH = EngineMaxSpeed(engineTier);
        vx = Math.Clamp(vx, -maxH, maxH);

        thrusting = up;
        if (up) vy -= EngineThrust(engineTier) * dt;
        vy += Gravity * dt;
        vy = Math.Clamp(vy, -EngineMaxClimb(engineTier), MaxFallSpeed);

        // Horizontal pass
        px += vx * dt;
        var top = (int)Math.Floor(py - PodHalf + Eps);
        var bot = (int)Math.Floor(py + PodHalf - Eps);
        if (vx > 0)
        {
            var col = (int)Math.Floor(px + PodHalf);
            for (var r = top; r <= bot; r++)
                if (Solid(r, col)) { px = col - PodHalf - Eps; vx = 0; break; }
        }
        else if (vx < 0)
        {
            var col = (int)Math.Floor(px - PodHalf);
            for (var r = top; r <= bot; r++)
                if (Solid(r, col)) { px = col + 1 + PodHalf + Eps; vx = 0; break; }
        }

        // Vertical pass
        var wasGrounded = grounded;
        grounded = false;
        py += vy * dt;
        var lc = (int)Math.Floor(px - PodHalf + Eps);
        var rc = (int)Math.Floor(px + PodHalf - Eps);
        if (vy > 0)
        {
            var row = (int)Math.Floor(py + PodHalf);
            for (var c = lc; c <= rc; c++)
            {
                if (!Solid(row, c)) continue;
                py = row - PodHalf - Eps;
                if (!wasGrounded) Land(vy);
                vy = 0;
                grounded = true;
                break;
            }
        }
        else if (vy < 0)
        {
            var row = (int)Math.Floor(py - PodHalf);
            for (var c = lc; c <= rc; c++)
                if (Solid(row, c)) { py = row + 1 + PodHalf + Eps; vy = 0; break; }
        }

        facing = thrusting ? Direction.Up
            : hx > 0 ? Direction.Right
            : hx < 0 ? Direction.Left
            : Direction.Down;
    }

    private void Land(double impactSpeed)
    {
        if (impactSpeed <= SafeImpactSpeed) return;
        ApplyDamage((impactSpeed - SafeImpactSpeed) * ImpactDamagePerSpeed);
        ShowToast("💥 Ouch! That was a rough landing.");
        Shake();
        _ = Interop.InvokeVoidAsync("playImpactSound");
    }

    private bool Solid(int r, int c)
    {
        if (c < 0 || c >= Cols) return true;
        if (r < SkyTop) return true;
        if (r < 1) return false;
        if (r > TotalDepthRows) return true;
        return tiles[r, c] != TileKind.Empty;
    }

    // ---- Drilling ----

    private bool TryDrillFromInput()
    {
        var row = (int)Math.Floor(py);
        if (Held(Direction.Down))
            return TryStartDrill(row + 1, (int)Math.Floor(px), Direction.Down);
        if (Held(Direction.Left) && Solid(row, (int)Math.Floor(px - PodHalf - 0.02)))
            return TryStartDrill(row, (int)Math.Floor(px - PodHalf - 0.02), Direction.Left);
        if (Held(Direction.Right) && Solid(row, (int)Math.Floor(px + PodHalf + 0.02)))
            return TryStartDrill(row, (int)Math.Floor(px + PodHalf + 0.02), Direction.Right);
        return false;
    }

    private bool TryStartDrill(int row, int col, Direction dir)
    {
        if (col < 0 || col >= Cols || row < 1 || row > TotalDepthRows) return false;
        var kind = tiles[row, col];
        if (kind == TileKind.Empty) return false;

        if (kind == TileKind.Boulder)
        {
            ShowToast("🪨 A boulder! Too tough to drill - blast it with a Powder Keg.");
            return false;
        }
        if (Hardness(kind) > MaxHardness(drillTier))
        {
            ShowToast(kind == TileKind.Treasure
                ? "🏆 The vault! Only a Tier 5 Drill can crack it."
                : "⛏️ Too hard! Upgrade your Drill at the Shipwright.");
            return false;
        }
        if (fuel <= 0) return false;

        BeginDrill(row, col, dir, DigSeconds(kind, drillTier));
        return true;
    }

    private void BeginDrill(int row, int col, Direction dir, double duration)
    {
        drilling = true;
        drillRow = row;
        drillCol = col;
        drillElapsed = 0;
        drillDuration = duration;
        drillFromX = px;
        drillFromY = py;
        drillToX = col + 0.5;
        drillToY = row + 1 - PodHalf - Eps;
        vx = vy = 0;
        thrusting = false;
        facing = dir;
    }

    private void UpdateDrill(double dt)
    {
        drillElapsed += dt;
        var t = DrillT;
        var ease = t * t * (3 - 2 * t);
        px = drillFromX + (drillToX - drillFromX) * ease;
        py = drillFromY + (drillToY - drillFromY) * ease;

        if (t < 1) return;

        drilling = false;
        var kind = tiles[drillRow, drillCol];
        tiles[drillRow, drillCol] = TileKind.Empty;
        px = drillToX;
        py = drillToY;
        grounded = Solid(drillRow + 1, drillCol);
        OnTileCleared(drillRow, drillCol);
        BreakTile(kind);

        if (anchorActive && !pendingWin) ContinueAnchorDrop();
    }

    private void BreakTile(TileKind kind)
    {
        if (kind == TileKind.Treasure)
        {
            pendingWin = true;
            _ = Interop.InvokeVoidAsync("playFanfareSound");
            return;
        }

        if (kind == TileKind.Crate)
        {
            OpenCrate();
            return;
        }

        if (kind is TileKind.Lava or TileKind.Gas && anchorActive)
        {
            ShowToast("⚓ The anchor line pulled you safely past the danger!");
            return;
        }

        if (kind is TileKind.Lava or TileKind.Gas)
        {
            var radiatorShield = 1 - (radiatorTier - 1) * 0.12;
            ApplyDamage((kind == TileKind.Lava ? 30 : 22) * radiatorShield);
            ShowToast(kind == TileKind.Lava ? "🔥 Ouch! Lava scorched your hull!" : "💨 A gas pocket exploded!");
            Shake();
            _ = Interop.InvokeVoidAsync("playExplosionSound");
            return;
        }

        if (IsOre(kind))
        {
            if (CargoCount < CargoCapacity(cargoTier))
            {
                cargo[kind] = cargo.GetValueOrDefault(kind) + 1;
                ShowToast($"+1 {TileLabel(kind)} (💰{OreValue(kind)})");
                _ = Interop.InvokeVoidAsync("playCatchSound");
            }
            else
            {
                ShowToast("🎒 Cargo full - that ore was lost! Sell at the Trader.");
            }
        }
    }

    // ---- Loose rock (cave-ins) ----

    // Any tile that opens up can undermine loose rock above it; the rock
    // wobbles first (the warning) and then drops.
    private void OnTileCleared(int row, int col)
    {
        var above = row - 1;
        if (above < 1 || tiles[above, col] != TileKind.LooseRock || wobblingRocks.ContainsKey((above, col))) return;

        wobblingRocks[(above, col)] = WobbleSeconds;
        if (Math.Abs(col + 0.5 - px) < 2 && Math.Abs(above + 0.5 - py) < 4)
            ShowToast("⚠️ Loose rock overhead - look out!");
    }

    private void UpdateRocks(double dt)
    {
        if (wobblingRocks.Count > 0)
        {
            foreach (var key in wobblingRocks.Keys.ToList())
            {
                var left = wobblingRocks[key] - dt;
                if (left > 0)
                {
                    wobblingRocks[key] = left;
                    continue;
                }

                wobblingRocks.Remove(key);
                var (r, c) = key;
                var beingDrilled = drilling && drillRow == r && drillCol == c;
                if (tiles[r, c] != TileKind.LooseRock || Solid(r + 1, c) || beingDrilled) continue;

                tiles[r, c] = TileKind.Empty;
                fallingRocks.Add(new FallingRock { Col = c, Y = r });
                OnTileCleared(r, c);
            }
        }

        for (var i = fallingRocks.Count - 1; i >= 0; i--)
        {
            var rock = fallingRocks[i];
            rock.Vy = Math.Min(rock.Vy + Gravity * dt, 12);
            rock.Y += rock.Vy * dt;

            var hitsPod = rock.Col < px + PodHalf && rock.Col + 1 > px - PodHalf
                && rock.Y < py + PodHalf && rock.Y + 1 > py - PodHalf;
            if (hitsPod)
            {
                fallingRocks.RemoveAt(i);
                ApplyDamage(RockHitDamage);
                ShowToast("🪨 Bonk! A falling rock hit your pod!");
                Shake();
                _ = Interop.InvokeVoidAsync("playImpactSound");
                continue;
            }

            var below = (int)Math.Floor(rock.Y + 1);
            if (!Solid(below, rock.Col)) continue;

            fallingRocks.RemoveAt(i);
            var restRow = below - 1;
            if (restRow >= 1 && tiles[restRow, rock.Col] == TileKind.Empty) tiles[restRow, rock.Col] = TileKind.LooseRock;
        }
    }

    // ---- Buried crates ----

    private static readonly ItemKind[] CrateItems = { ItemKind.FuelCan, ItemKind.RepairKit, ItemKind.PowderKeg, ItemKind.AnchorDrop };

    private void OpenCrate()
    {
        _ = Interop.InvokeVoidAsync("playMatchSound");

        if (rng.NextDouble() < 0.4)
        {
            var item = CrateItems[rng.Next(CrateItems.Length)];
            if (items.GetValueOrDefault(item) < MaxItemCount)
            {
                items[item] = items.GetValueOrDefault(item) + 1;
                ShowToast($"🎁 A buried crate! Inside: {ItemIcon(item)} {ItemName(item)}!");
                return;
            }
        }

        var bonus = 40 + drillRow * 15 + rng.Next(0, 30 + drillRow * 10);
        gold += bonus;
        ShowToast($"🎁 A buried crate full of doubloons! +{bonus} gold");
    }

    // ---- Anchor Drop (guided descent) ----

    // Digs straight down up to AnchorDropTiles at a steady pace, keeps
    // going through open caverns so it always ends on solid ground (no
    // fall damage), defuses hazards on the way, and stops early at
    // anything the drill can't handle.
    private void ContinueAnchorDrop()
    {
        var row = (int)Math.Floor(py) + 1;
        var col = (int)Math.Floor(px);
        if (row > TotalDepthRows)
        {
            anchorActive = false;
            return;
        }

        var kind = tiles[row, col];
        if (kind == TileKind.Empty)
        {
            BeginDrill(row, col, Direction.Down, AnchorStepSeconds);
            return;
        }

        if (anchorStepsLeft <= 0)
        {
            anchorActive = false;
            ShowToast("⚓ Anchor Drop complete!");
            return;
        }

        if (kind == TileKind.Boulder || Hardness(kind) > MaxHardness(drillTier))
        {
            anchorActive = false;
            anchorStepsLeft = 0;
            ShowToast("⚓ The anchor hit something too tough and stopped.");
            return;
        }

        anchorStepsLeft--;
        BeginDrill(row, col, Direction.Down, AnchorStepSeconds);
    }

    private void ApplyDamage(double raw)
    {
        hull = Math.Max(0, hull - raw * DamageMultiplier(selectedDifficulty));
    }

    // ---- Fuel, heat, milestones ----

    private int HeatLevel => PodRow switch
    {
        <= 40 => 0,
        <= 65 => 1,
        <= 90 => 2,
        <= 105 => 3,
        _ => 4,
    };

    private double HeatDamagePerSecond =>
        Math.Max(0, HeatLevel - (radiatorTier - 1)) * 0.8 * DamageMultiplier(selectedDifficulty);

    private void UpdateFuelAndHeat(double dt)
    {
        if (!Underground) return;

        var rate = IdleDrain;
        if (drilling) rate += DrillDrain;
        else
        {
            if (thrusting) rate += ThrustDrain;
            if (Held(Direction.Left) || Held(Direction.Right)) rate += MoveDrain;
        }
        fuel = Math.Max(0, fuel - rate * FuelDrainMultiplier(selectedDifficulty) * dt);

        var heatDmg = HeatDamagePerSecond;
        if (heatDmg > 0)
        {
            hull = Math.Max(0, hull - heatDmg * dt);
            if (HeatLevel > lastHeatWarned)
            {
                lastHeatWarned = HeatLevel;
                ShowToast("🌡️ It's getting hot down here! Upgrade your Radiator.");
            }
        }
    }

    private void CheckMilestones()
    {
        if (nextMilestone >= Milestones.Length || deepestRow < Milestones[nextMilestone].Row) return;

        var m = Milestones[nextMilestone++];
        gold += m.Bonus;
        radioMessage = m.Message;
        radioUntilUtc = DateTime.UtcNow.AddSeconds(RadioSeconds);
        _ = Interop.InvokeVoidAsync("playBuildCompleteSound");

        if (m.Row >= 70) UnlockPaint(AbyssPaint);
    }

    // ---- Rescue (soft failure) ----

    private void Rescue(string title, string reason)
    {
        var lost = CargoCount;
        var fee = (int)Math.Round(gold * TowFeeRate(selectedDifficulty));
        gold -= fee;
        cargo.Clear();

        ResetPodToSurface();
        fuel = Math.Max(fuel, FuelCapacity(fuelTankTier) * 0.25);
        hull = Math.Max(hull, HullMax(hullTier) * 0.25);
        ClearHeld();

        rescueTitle = title;
        rescueText = $"{reason} {(lost > 0 ? $"You lost {lost} piece{(lost == 1 ? "" : "s")} of cargo" : "Your hold was empty")}{(fee > 0 ? $" and paid a {fee} gold tow fee." : ".")}";
        overlay = Overlay.Rescue;
        UpdateCamera(1);
        _ = Interop.InvokeVoidAsync("playMismatchSound");
        _ = SaveCheckpointAsync();
    }

    // ---- Surface stations ----

    private Station? StationAtPod()
    {
        if (Underground || py < 0) return null;
        var col = (int)Math.Floor(px);
        foreach (var st in Stations)
            if (col >= st.Col && col < st.Col + StationWidth) return st.Kind;
        return null;
    }

    private void CheckStations()
    {
        var here = StationAtPod();
        if (here is null) stationLatch = null;
        if (here is not { } st || drilling || !grounded || Math.Abs(vx) > StationEnterSpeed || stationLatch == st) return;

        stationLatch = st;
        activeStation = st;
        overlay = Overlay.Station;
        vx = 0;
        ClearHeld();
        ShowToast("💾 Expedition saved");
        _ = SaveCheckpointAsync();
    }

    private void CloseOverlay()
    {
        // Leaving a station re-saves so anything just bought or sold sticks.
        if (overlay == Overlay.Station) _ = SaveCheckpointAsync();
        overlay = Overlay.None;
        activeStation = null;
        stationLatch = StationAtPod();
        needsFocus = true;
    }

    private int RefuelCost => (int)Math.Ceiling(Math.Max(0, FuelCapacity(fuelTankTier) - fuel) * FuelPrice);
    private int RepairCost => (int)Math.Ceiling(Math.Max(0, HullMax(hullTier) - hull) * RepairPrice);
    private double FuelPrice => selectedDifficulty switch { Difficulty.Easy => 0, Difficulty.Hard => 0.45, _ => 0.3 };
    private double RepairPrice => selectedDifficulty switch { Difficulty.Easy => 0, Difficulty.Hard => 2.5, _ => 1.5 };

    private void Refuel()
    {
        var cap = FuelCapacity(fuelTankTier);
        fuel = BuyFill(fuel, cap, FuelPrice, "fuel");
        _ = Interop.InvokeVoidAsync("playSplashSound");
    }

    private void Repair()
    {
        var max = HullMax(hullTier);
        hull = BuyFill(hull, max, RepairPrice, "repairs");
        _ = Interop.InvokeVoidAsync("playBuildCompleteSound");
    }

    // Buys as much of a resource as the player can afford; if they're too
    // broke to reach a quarter tank/hull, the crew spots them that much free
    // so a run can never soft-lock at the surface.
    private double BuyFill(double current, int max, double price, string what)
    {
        var missing = Math.Max(0, max - current);
        if (price <= 0) return max;

        var bought = Math.Min(missing, Math.Floor(gold / price));
        gold -= (int)Math.Ceiling(bought * price);
        current += bought;

        if (current < max * 0.25)
        {
            current = max * 0.25;
            ShowToast($"🏴‍☠️ The crew chipped in for some {what}!");
        }
        return current;
    }

    private void SellAll()
    {
        var earned = CargoValue;
        if (earned <= 0) return;
        gold += earned;
        cargo.Clear();
        ShowToast($"💰 Sold your haul for {earned} gold!");
        _ = Interop.InvokeVoidAsync("playMatchSound");
    }

    // ---- Items ----

    private bool CanUseItem(ItemKind item) => phase == Phase.Playing && overlay == Overlay.None && item switch
    {
        ItemKind.FuelCan => fuel < FuelCapacity(fuelTankTier),
        ItemKind.RepairKit => hull < HullMax(hullTier),
        ItemKind.AnchorDrop => grounded && !drilling && !anchorActive,
        _ => Underground,
    };

    private void UseItem(ItemKind item)
    {
        if (items.GetValueOrDefault(item) <= 0 || !CanUseItem(item)) return;
        items[item]--;

        // A blast or recall mid-drill cancels the drill; the blast clears
        // the tile being drilled anyway since it's always adjacent.
        if (item is ItemKind.PowderKeg or ItemKind.BigKeg or ItemKind.Recall) drilling = false;

        switch (item)
        {
            case ItemKind.FuelCan:
                fuel = Math.Min(FuelCapacity(fuelTankTier), fuel + 40);
                ShowToast("⛽ Glug glug - +40 fuel!");
                _ = Interop.InvokeVoidAsync("playSplashSound");
                break;
            case ItemKind.RepairKit:
                hull = Math.Min(HullMax(hullTier), hull + 40);
                ShowToast("🩹 Patched up - +40 hull!");
                _ = Interop.InvokeVoidAsync("playBuildCompleteSound");
                break;
            case ItemKind.PowderKeg:
                Blast(1);
                break;
            case ItemKind.BigKeg:
                Blast(2);
                break;
            case ItemKind.AnchorDrop:
                anchorActive = true;
                anchorStepsLeft = AnchorDropTiles;
                ShowToast("⚓ Anchor away! Hold on tight...");
                _ = Interop.InvokeVoidAsync("playSplashSound");
                ContinueAnchorDrop();
                break;
            case ItemKind.Recall:
                ResetPodToSurface();
                UpdateCamera(1);
                ShowToast("🐌 Puru puru... the crew reeled you home!");
                _ = Interop.InvokeVoidAsync("playFanfareSound");
                break;
        }

        needsFocus = true;
    }

    // Clears a square around the pod. Like Motherload's dynamite it
    // destroys ore too, but it's the only way through boulders and a safe
    // way to clear lava/gas. The treasure and the vault floor are immune.
    private void Blast(int radius)
    {
        var pr = (int)Math.Floor(py);
        var pc = (int)Math.Floor(px);
        var cleared = new List<(int Row, int Col)>();
        for (var r = pr - radius; r <= pr + radius; r++)
        {
            if (r < 1 || r >= TotalDepthRows) continue;
            for (var c = pc - radius; c <= pc + radius; c++)
            {
                if (c < 0 || c >= Cols || tiles[r, c] is TileKind.Treasure or TileKind.Empty) continue;
                tiles[r, c] = TileKind.Empty;
                wobblingRocks.Remove((r, c));
                cleared.Add((r, c));
            }
        }
        foreach (var (r, c) in cleared) OnTileCleared(r, c);
        grounded = false;
        Shake();
        ShowToast("💣 KA-BOOM!");
        _ = Interop.InvokeVoidAsync("playExplosionSound");
    }

    private void BuyItem(ItemKind item)
    {
        var cost = ItemCost(item);
        if (gold < cost || items.GetValueOrDefault(item) >= MaxItemCount) return;
        gold -= cost;
        items[item] = items.GetValueOrDefault(item) + 1;
        _ = Interop.InvokeVoidAsync("playCatchSound");
    }

