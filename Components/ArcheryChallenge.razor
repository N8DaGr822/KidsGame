@*
    ArcheryChallenge.razor
    Drag on the range to aim (slingshot-style: pull back, release to
    fire), same aiming feel as TankDuel, but solo - no AI opponent, no
    obstacles, just a scored target. A dotted trajectory preview shows
    exactly where the arrow will fly before you let go, using the same
    analytic "solve the exact impact point, don't just step and hope"
    approach as TankDuel's preview.

    Wind is the twist: a random per-shot crosswind (shown before you aim,
    so you can compensate) nudges the arrow's horizontal speed, which -
    since gravity acts over time, not distance - also throws off how high
    the arrow is when it reaches the target board. Difficulty controls
    target distance, wind strength, and (Hard) how much the target's
    height wobbles shot to shot. A fixed 6-arrow session sums ring
    scores (10/8/6/4/2/miss); personal best tracks the highest total.

    Usage:
        <ArcheryChallenge OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="ac-game">

    @if (phase == Phase.Setup)
    {
        <div class="ac-setup game-setup-panel">
            <h2>🏹 Archery Challenge</h2>
            <p>Drag back on the range to aim, then let go to fire! Watch the wind - it'll push your shot off course.</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="ac-diff-name">@DifficultyName(diff)</span>
                            <span class="ac-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="ac-title">Archery</span>
            <span class="game-stat">🏹 Arrow @Math.Min(arrowNumber, TotalArrows)/@TotalArrows</span>
            <span class="game-stat">⭐ Score @totalScore</span>
            <span class="game-stat">@WindLabel()</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="ac-field" @ref="fieldRef"
             @onpointerdown="OnFieldPointerDown" @onpointermove="OnFieldPointerMove"
             @onpointerup="OnFieldPointerUp" @onpointercancel="OnFieldPointerUp">
            <div class="ac-sky"></div>
            <span class="ac-sun">☀️</span>
            <span class="ac-cloud ac-cloud-1">☁️</span>
            <span class="ac-cloud ac-cloud-2">☁️</span>
            <div class="ac-ground"></div>

            <div class="ac-target-stand" style="left:@(targetX.ToString(Inv))%; top:@((targetCenterY + 8).ToString(Inv))%; height:@((GroundY - targetCenterY - 8).ToString(Inv))%;"></div>
            <div class="ac-target" style="left:@(targetX.ToString(Inv))%; top:@(targetCenterY.ToString(Inv))%;">
                <div class="ac-ring ac-ring-5"></div>
                <div class="ac-ring ac-ring-4"></div>
                <div class="ac-ring ac-ring-3"></div>
                <div class="ac-ring ac-ring-2"></div>
                <div class="ac-ring ac-ring-1"></div>
            </div>

            @if (previewPoints.Count > 0)
            {
                @foreach (var p in previewPoints)
                {
                    <span class="ac-preview-dot" style="left:@(p.X.ToString(Inv))%; top:@(p.Y.ToString(Inv))%;"></span>
                }
            }

            @if (flyingArrowPos is { } fp)
            {
                <span class="ac-flying-arrow" style="left:@(fp.X.ToString(Inv))%; top:@(fp.Y.ToString(Inv))%; transform: translate(-50%, -50%) rotate(@(flyingArrowAngle.ToString(Inv))deg);"></span>
            }

            <span class="ac-archer @(resolving ? "firing" : "") @(isDragging ? "aiming" : "")">🏹</span>

            @if (lastImpact is { } impact)
            {
                <span class="ac-impact" style="left:@(impact.X.ToString(Inv))%; top:@(impact.Y.ToString(Inv))%;">💥</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="ac-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🏹 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great shooting" : PlayerName + ", great shooting") - final score: @totalScore/@(TotalArrows * 10)!</p>
                    <PersonalBestBadge Value="@($"{bestScore ?? totalScore} points")" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<ArcheryChallengeResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (highest total score) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int TotalArrows = 6;
    private const double ArcherX = 10;
    private const double GroundY = 80;
    private const double LaunchYOffset = 8;
    private const double Gravity = 150;
    private const double MinSpeed = 60;
    private const double MaxSpeed = 140;
    private const double MinAngleDeg = 15;
    private const double MaxAngleDeg = 75;
    private const double MinDragDistance = 4;
    private const double MaxDragDistance = 42;
    private const double TargetOuterRadius = 8;
    private const int FlightSteps = 20;
    private const int FlightTotalMs = 650;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static double TargetXFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 62,
        Difficulty.Medium => 74,
        _ => 86,
    };

    private static double WindStrengthFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 0,
        Difficulty.Medium => 0.15,
        _ => 0.3,
    };

    private static double WobbleFor(Difficulty d) => d == Difficulty.Hard ? 6 : 0;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private double targetX = 62;
    private double targetCenterY = 55;
    private double windFactor;
    private int arrowNumber;
    private int totalScore;
    private string roundMessage = "";
    private int? bestScore;
    private bool isNewBest;
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    private ElementReference fieldRef;
    private double fieldLeft, fieldTop, fieldWidth, fieldHeight;
    private bool isDragging;
    private long? activeFieldPointerId;
    private readonly List<(double X, double Y)> previewPoints = new();
    private (double X, double Y)? lastImpact;
    private (double X, double Y)? flyingArrowPos;
    private double flyingArrowAngle;
    private bool resolving;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        arrowNumber = 0;
        totalScore = 0;
        roundMessage = "";
        bestScore = null;
        isNewBest = false;
        lastImpact = null;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        NextArrow();
    }

    private void NextArrow()
    {
        arrowNumber++;
        targetX = TargetXFor(selectedDifficulty);
        var wobble = WobbleFor(selectedDifficulty);
        targetCenterY = 55 + (wobble > 0 ? rng.NextDouble() * wobble * 2 - wobble : 0);

        var windStrength = WindStrengthFor(selectedDifficulty);
        windFactor = windStrength > 0 ? (rng.NextDouble() * 2 - 1) * windStrength : 0;

        previewPoints.Clear();
        lastImpact = null;
        roundMessage = "";
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new ArcheryChallengeResult(
                Difficulty: DifficultyName(selectedDifficulty),
                TotalScore: totalScore,
                ArrowsShot: arrowNumber - 1,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private string WindLabel()
    {
        if (Math.Abs(windFactor) < 0.02) return "🎌 No wind";
        var strength = Math.Abs(windFactor) < 0.2 ? "Light" : "Strong";
        var arrow = windFactor > 0 ? "➡️" : "⬅️";
        return $"{arrow} {strength} wind";
    }

    private async Task OnFieldPointerDown(PointerEventArgs e)
    {
        if (phase != Phase.Playing || resolving) return;

        activeFieldPointerId = e.PointerId;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<FieldRect>("getBoundingRect", fieldRef);
        fieldLeft = rect.Left;
        fieldTop = rect.Top;
        fieldWidth = rect.Width;
        fieldHeight = rect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", fieldRef, e.PointerId);

        if (activeFieldPointerId != e.PointerId) return;

        isDragging = true;
        UpdateAim(e.ClientX, e.ClientY);
    }

    private void OnFieldPointerMove(PointerEventArgs e)
    {
        if (!isDragging) return;
        UpdateAim(e.ClientX, e.ClientY);
    }

    private async Task OnFieldPointerUp(PointerEventArgs e)
    {
        activeFieldPointerId = null;
        if (!isDragging) return;
        isDragging = false;

        var (hasShot, angle, speed) = ResolveAim(e.ClientX, e.ClientY);
        previewPoints.Clear();

        if (!hasShot)
        {
            StateHasChanged();
            return;
        }

        await FireAsync(angle, speed);
    }

    private void UpdateAim(double clientX, double clientY)
    {
        var (hasShot, angle, speed) = ResolveAim(clientX, clientY);
        previewPoints.Clear();

        if (hasShot)
        {
            var (vx, vy) = VelocityFromAngleSpeed(angle, speed);
            previewPoints.AddRange(ComputeTrajectoryPreview(ArcherX, GroundY - LaunchYOffset, vx, vy));
        }

        StateHasChanged();
    }

    private (bool HasShot, double AngleDeg, double Speed) ResolveAim(double clientX, double clientY)
    {
        if (fieldWidth <= 0 || fieldHeight <= 0) return (false, 0, 0);

        var pointerXPct = (clientX - fieldLeft) / fieldWidth * 100;
        var pointerYPct = (clientY - fieldTop) / fieldHeight * 100;

        var pullX = pointerXPct - ArcherX;
        var pullY = pointerYPct - (GroundY - LaunchYOffset);
        var dragDistance = Math.Sqrt(pullX * pullX + pullY * pullY);
        if (dragDistance < MinDragDistance) return (false, 0, 0);

        var fireX = -pullX;
        var fireY = -pullY;

        var angleDeg = Math.Atan2(-fireY, Math.Abs(fireX)) * 180 / Math.PI;
        angleDeg = Math.Clamp(angleDeg, MinAngleDeg, MaxAngleDeg);

        var clampedDrag = Math.Clamp(dragDistance, MinDragDistance, MaxDragDistance);
        var t = (clampedDrag - MinDragDistance) / (MaxDragDistance - MinDragDistance);
        var speed = MinSpeed + t * (MaxSpeed - MinSpeed);

        return (true, angleDeg, speed);
    }

    private (double Vx, double Vy) VelocityFromAngleSpeed(double angleDeg, double speed)
    {
        var rad = angleDeg * Math.PI / 180.0;
        var vx = Math.Cos(rad) * speed * (1 + windFactor);
        var vy = -Math.Sin(rad) * speed;
        return (vx, vy);
    }

    private static double SolveImpactTime(double y0, double vy)
    {
        var a = 0.5 * Gravity;
        var b = vy;
        var c = y0 - GroundY;
        var discriminant = b * b - 4 * a * c;
        if (discriminant < 0) return 0;

        var sqrtDisc = Math.Sqrt(discriminant);
        return Math.Max((-b + sqrtDisc) / (2 * a), (-b - sqrtDisc) / (2 * a));
    }

    private List<(double X, double Y)> ComputeTrajectoryPreview(double x0, double y0, double vx, double vy)
    {
        var points = new List<(double, double)>();
        var impactTime = SolveImpactTime(y0, vy);
        if (impactTime <= 0) return points;

        const int steps = 14;
        for (var i = 1; i <= steps; i++)
        {
            var t = impactTime * i / steps;
            var x = x0 + vx * t;
            var y = y0 + vy * t + 0.5 * Gravity * t * t;
            if (x < 0 || x > 100) break;
            points.Add((x, y));
        }
        return points;
    }

    private async Task FireAsync(double angleDeg, double speed)
    {
        resolving = true;
        StateHasChanged();
        await Task.Delay(180);

        var (vx, vy) = VelocityFromAngleSpeed(angleDeg, speed);
        var y0 = GroundY - LaunchYOffset;

        var impactTime = SolveImpactTime(y0, vy);
        var impactX = impactTime > 0 ? ArcherX + vx * impactTime : ArcherX;

        int score;
        double landX, landY, flightDuration;

        if (impactX < targetX)
        {
            // Fell short - never reached the target board in the air.
            score = 0;
            landX = Math.Min(impactX, 100);
            landY = GroundY;
            flightDuration = impactTime;
            roundMessage = "Fell short!";
        }
        else
        {
            var tCross = (targetX - ArcherX) / vx;
            var yCross = y0 + vy * tCross + 0.5 * Gravity * tCross * tCross;
            var dist = Math.Abs(yCross - targetCenterY);

            score = dist <= TargetOuterRadius * 0.2 ? 10
                : dist <= TargetOuterRadius * 0.4 ? 8
                : dist <= TargetOuterRadius * 0.6 ? 6
                : dist <= TargetOuterRadius * 0.8 ? 4
                : dist <= TargetOuterRadius ? 2
                : 0;

            landX = targetX;
            landY = Math.Clamp(yCross, 5, GroundY);
            flightDuration = tCross;
            roundMessage = score switch
            {
                10 => "Bullseye!",
                >= 6 => "Great shot!",
                > 0 => "On the board!",
                _ => "Missed the target!",
            };
        }

        // Replays the same analytic curve the preview showed, frame by
        // frame, instead of teleporting straight to the impact point.
        if (flightDuration > 0)
        {
            var stepDelay = FlightTotalMs / FlightSteps;
            for (var i = 1; i <= FlightSteps; i++)
            {
                var t = flightDuration * i / FlightSteps;
                var x = ArcherX + vx * t;
                var y = y0 + vy * t + 0.5 * Gravity * t * t;
                var vyInstant = vy + Gravity * t;
                flyingArrowPos = (x, y);
                flyingArrowAngle = Math.Atan2(vyInstant, vx) * 180 / Math.PI;
                StateHasChanged();
                await Task.Delay(stepDelay);
            }
        }
        flyingArrowPos = null;

        totalScore += score;
        lastImpact = (landX, landY);
        await PlaySoundAsync(score >= 6 ? "playMatchSound" : score > 0 ? "playImpactSound" : "playMismatchSound");
        StateHasChanged();
        await Task.Delay(1100);

        resolving = false;

        if (arrowNumber >= TotalArrows)
        {
            await FinishGame();
        }
        else
        {
            NextArrow();
            StateHasChanged();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "highest-score";
            bestScore = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.ArcheryChallenge, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.ArcheryChallenge, key, totalScore, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new ArcheryChallengeResult(
                Difficulty: DifficultyName(selectedDifficulty),
                TotalScore: totalScore,
                ArrowsShot: TotalArrows,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "Close target, no wind",
        Difficulty.Medium => "Farther target, light wind",
        _ => "Far target, strong wind, wobbles",
    };

    private record FieldRect(double Left, double Top, double Width, double Height);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record ArcheryChallengeResult(string Difficulty, int TotalScore, int ArrowsShot, int ElapsedSeconds);
}
