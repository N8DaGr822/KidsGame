    // ---- Round state -----------------------------------------------------

    public class CleanUpToy
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Emoji { get; set; } = "";
        public double X { get; set; }
        public double Y { get; set; }
    }

    private class RoundState
    {
        public LessonType Lesson;
        public CharacterDef Actor = null!;
        public CharacterDef Reactor = null!;
        public string ItemEmoji = "";
        public string ItemLabel = "";

        public bool ShowingConsequence;
        public bool ReactorSad;
        public bool ReactorHappy;
        public bool HelpingRebuild;
        public bool[] BlockTapped = new bool[3];

        public List<CleanUpToy> Toys = new();

        // Greeting
        public bool WavedHello;

        // Achoo
        public bool ElbowPlaced;
        public double ElbowX = 78;
        public double ElbowY = 68;
    }

    private enum Phase { Setup, Playing, Reward, SessionComplete }

    private Phase phase = Phase.Setup;
    private readonly Random rng = new();
    private RoundState round = new();
    private List<LessonType> sessionLessons = new();
    private int roundIndex;
    private readonly List<string> gardenItems = new();
    private string narratorText = "";
    private bool muted;
    private bool showingGarden;
    private bool showingGardenAtSetup;

    // The full, all-time garden (persisted via AppDataService) - separate
    // from the session-local gardenItems above, which only tracks what
    // was earned in the round currently being played (used for the
    // in-play "+item added!" toast and progress strip).
    private List<string> persistedGardenItems = new();

    private IJSObjectReference? _module;
    private int elapsedSeconds;
    private System.Threading.Timer? timer;

    // ---- Manners Quiz (older kids, reading required) ---------------------
    //
    // A separate mode from the tap-a-picture lessons above: a short
    // written scenario with three answers (one correct, two plausible-
    // but-not-ideal), so the wrong choices teach a reason rather than
    // just being obviously silly. Reuses the same stage/HUD/garden-reward
    // plumbing as the regular lessons (see StartQuizSession/
    // CompleteQuizQuestion mirroring StartSession/CompleteRound) so both
    // modes feel like the same game.

    private const int QuizSessionSize = 5;

    private bool quizMode;
    private List<QuizScenario> sessionQuiz = new();
    private int quizIndex;
    private List<QuizChoice> shuffledChoices = new();
    private int? selectedChoiceIndex;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ProfileId))
        {
            persistedGardenItems = await Data.GetGardenItemsAsync(ProfileId);
        }
    }

    // ---- Drag state (clean-up toys) ---------------------------------------

    private ElementReference cleanupAreaRef;
    private ElementReference binRef;
    private double areaLeft, areaTop, areaWidth, areaHeight;
    private double binLeft, binTop, binWidth, binHeight;
    private CleanUpToy? draggingToy;

    // ---- Session flow ------------------------------------------------------

    private async Task StartSession(LessonType? focusLesson)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        quizMode = false;
        sessionLessons = focusLesson is { } lesson
            ? Enumerable.Repeat(lesson, 3).ToList()
            : AllLessons.OrderBy(_ => rng.Next()).Take(3).ToList();
        roundIndex = 0;
        gardenItems.Clear();
        elapsedSeconds = 0;
        showingGarden = false;
        showingGardenAtSetup = false;

        BuildRound(sessionLessons[0]);
        phase = Phase.Playing;
        StartTimer();
        StateHasChanged();
    }

    private async Task StartQuizSession()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        quizMode = true;
        sessionQuiz = QuizScenarios.OrderBy(_ => rng.Next()).Take(QuizSessionSize).ToList();
        quizIndex = 0;
        gardenItems.Clear();
        elapsedSeconds = 0;
        showingGarden = false;
        showingGardenAtSetup = false;

        LoadQuizQuestion();
        phase = Phase.Playing;
        StartTimer();
        StateHasChanged();
    }

    private void LoadQuizQuestion()
    {
        selectedChoiceIndex = null;
        var scenario = sessionQuiz[quizIndex];
        shuffledChoices = scenario.Choices.OrderBy(_ => rng.Next()).ToList();
        SetNarration(scenario.Prompt);
    }

    private async Task ChooseQuizAnswer(int index)
    {
        // Already-picked wrong answers stay disabled (see the markup), but
        // nothing stops re-picking a *different* option after a miss - same
        // "never a dead end, try again" spirit as the tap-choice lessons.
        if (selectedChoiceIndex == index && shuffledChoices[index].IsCorrect) return;

        selectedChoiceIndex = index;
        var choice = shuffledChoices[index];
        if (!muted)
        {
            _ = SpeakAsync(choice.Feedback);
        }
        StateHasChanged();

        if (choice.IsCorrect)
        {
            await Task.Delay(1600);
            await CompleteQuizQuestion();
        }
    }

    private async Task CompleteQuizQuestion()
    {
        var earned = GardenRewardPool[rng.Next(GardenRewardPool.Length)];
        gardenItems.Add(earned);
        persistedGardenItems.Add(earned);
        phase = Phase.Reward;
        StateHasChanged();

        if (!string.IsNullOrEmpty(ProfileId))
        {
            await Data.AddGardenItemAsync(ProfileId, earned);
        }

        await Task.Delay(1300);

        if (quizIndex + 1 >= sessionQuiz.Count)
        {
            await FinishSession();
        }
        else
        {
            quizIndex++;
            LoadQuizQuestion();
            phase = Phase.Playing;
            StateHasChanged();
        }
    }

    private void ExitToSetup()
    {
        StopTimer();
        _ = StopSpeakingAsync();
        phase = Phase.Setup;
        showingGarden = false;
        quizMode = false;
    }

    private void ToggleGarden() => showingGarden = !showingGarden;

    private void BuildRound(LessonType lesson)
    {
        round = new RoundState { Lesson = lesson };

        if (lesson == LessonType.CleanUp)
        {
            var chosen = ToyPool.OrderBy(_ => rng.Next()).Take(3).ToList();
            round.Toys = chosen.Select((t, idx) => new CleanUpToy
            {
                Emoji = t.Emoji,
                X = 18 + idx * 32 + rng.Next(-6, 6),
                Y = 28 + rng.Next(-8, 14),
            }).ToList();

            SetNarration("Playtime is over. Let's clean up together! Drag the toys into the basket.");
            return;
        }

        if (lesson == LessonType.Greeting)
        {
            var greeting = GreetingVariations[rng.Next(GreetingVariations.Count)];
            round.Actor = greeting.Actor;
            round.Reactor = greeting.Reactor;
            SetNarration($"{round.Actor.FirstName} just arrived! Let's say hello to {round.Reactor.FirstName}.");
            return;
        }

        if (lesson == LessonType.Achoo)
        {
            round.Actor = AchooCharacters[rng.Next(AchooCharacters.Count)];
            SetNarration($"{round.Actor.FirstName} feels a sneeze coming! Drag the elbow up to cover it.");
            return;
        }

        var pool = lesson switch
        {
            LessonType.Please => PleaseVariations,
            LessonType.ThankYou => ThankYouVariations,
            LessonType.Turns => TurnsVariations,
            LessonType.Sorry => SorryVariations,
            LessonType.GentleHands => GentleHandsVariations,
            LessonType.InsideVoice => InsideVoiceVariations,
            _ => throw new ArgumentOutOfRangeException(nameof(lesson)),
        };

        var variation = pool[rng.Next(pool.Count)];
        round.Actor = variation.Actor;
        round.Reactor = variation.Reactor;
        round.ItemEmoji = variation.ItemEmoji;
        round.ItemLabel = variation.ItemLabel;

        SetNarration(PromptLine(round));
    }

    private async Task CompleteRound()
    {
        var earned = GardenRewardPool[rng.Next(GardenRewardPool.Length)];
        gardenItems.Add(earned);
        persistedGardenItems.Add(earned);
        phase = Phase.Reward;
        StateHasChanged();

        if (!string.IsNullOrEmpty(ProfileId))
        {
            await Data.AddGardenItemAsync(ProfileId, earned);
        }

        await Task.Delay(1300);

        if (roundIndex + 1 >= sessionLessons.Count)
        {
            await FinishSession();
        }
        else
        {
            roundIndex++;
            BuildRound(sessionLessons[roundIndex]);
            phase = Phase.Playing;
            StateHasChanged();
        }
    }

    private async Task FinishSession()
    {
        StopTimer();
        phase = Phase.SessionComplete;
        SetNarration("Wow! Look at your beautiful garden! Great job practicing your manners today!");
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new MannersGardenResult(
                ScenariosCompleted: quizMode ? sessionQuiz.Count : sessionLessons.Count,
                GardenItemsEarned: gardenItems.Count,
                ElapsedSeconds: elapsedSeconds));
        }
    }

    // ---- Tap-choice lessons (Please / Thank You / Turns / Sorry) ---------

    private async Task ChooseOption(bool polite)
    {
        if (round.ShowingConsequence) return;
        round.ShowingConsequence = true;

        if (polite)
        {
            round.ReactorHappy = true;

            switch (round.Lesson)
            {
                case LessonType.Please:
                    SetNarration("Please is a kind way to ask!");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;

                case LessonType.ThankYou:
                    SetNarration("Thank you shows someone you appreciate their kindness!");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;

                case LessonType.Turns:
                    SetNarration("Great asking!");
                    StateHasChanged();
                    await Task.Delay(1300);
                    SetNarration($"{round.Reactor.FirstName} finished up and shared. Waiting for a turn was worth it!");
                    StateHasChanged();
                    await Task.Delay(1700);
                    await CompleteRound();
                    break;

                case LessonType.Sorry:
                    SetNarration("Saying sorry and helping can make things better!");
                    round.ShowingConsequence = false;
                    round.HelpingRebuild = true;
                    StateHasChanged();
                    break;

                case LessonType.GentleHands:
                    SetNarration("Gentle hands feel nice and keep friends safe!");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;

                case LessonType.InsideVoice:
                    SetNarration($"Great job using your inside voice! {round.Reactor.FirstName} could listen easily.");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;
            }
        }
        else
        {
            round.ReactorSad = true;
            SetNarration(GentleRetryLine(round));
            StateHasChanged();
            await Task.Delay(2200);

            // Never a dead end - reset back to the same scenario so the
            // child can pick again, rather than failing the round.
            round.ReactorSad = false;
            round.ShowingConsequence = false;
            SetNarration(PromptLine(round));
            StateHasChanged();
        }
    }

    private async Task TapBlock(int idx)
    {
        if (round.BlockTapped[idx]) return;
        round.BlockTapped[idx] = true;
        StateHasChanged();

        if (round.BlockTapped.All(t => t))
        {
            SetNarration($"You rebuilt the tower together! {round.Reactor.FirstName} feels happy again.");
            round.ReactorHappy = true;
            round.HelpingRebuild = false;

            // Without this, the original "I'm sorry / Run away" choice
            // buttons briefly re-match the "no consequence showing" guard
            // and flash back on screen during the pause before the round
            // actually advances.
            round.ShowingConsequence = true;
            StateHasChanged();
            await Task.Delay(1500);
            await CompleteRound();
        }
    }

    private async Task WaveGreeting()
    {
        round.ShowingConsequence = true;
        round.ReactorHappy = true;

        if (!round.WavedHello)
        {
            SetNarration($"Hi, {round.Reactor.FirstName}!");
            round.WavedHello = true;
            StateHasChanged();
            await Task.Delay(1500);

            SetNarration($"It's time for {round.Actor.FirstName} to go home. Let's wave goodbye!");
            round.ShowingConsequence = false;
            StateHasChanged();
        }
        else
        {
            SetNarration("Bye-bye! See you soon!");
            StateHasChanged();
            await Task.Delay(1500);
            await CompleteRound();
        }
    }

