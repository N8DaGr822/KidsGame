@*
    SoundButtons.razor
    A toddler cause-and-effect toy (~1 year old target): a grid of big
    buttons, each with a friendly picture. Tapping one wiggles it and
    plays a cheerful note - no wrong buttons, no score, no timer. Three
    themes cover "Animal Sounds", "Vehicle Sounds", and "Sound Buttons"
    from the roadmap as one component, since they're mechanically
    identical (grid of big buttons -> tap -> friendly response).

    There's no natural "round" here, so the in-scene "All done" button is
    what logs the play session - it fires OnComplete with how long the
    child played and how many taps they made, then returns to the theme
    picker.

    Usage:
        <SoundButtons OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sb-game">

    @if (phase == Phase.Setup)
    {
        <div class="sb-setup game-setup-panel">
            <h2>🔔 Sound Buttons</h2>
            <p>Tap any button to hear a happy sound - every button is a good one!</p>

            <h3 class="sb-section-title game-section-title">Choose a theme</h3>
            <div class="sb-theme-select game-option-grid">
                @foreach (var t in Themes)
                {
                    <button class="sb-theme-btn game-option-button @(t.Name == selectedTheme.Name ? "selected" : "")" @onclick="() => selectedTheme = t">
                        <span class="sb-theme-icon">@t.Icon</span>
                        <span class="sb-theme-name">@t.Name</span>
                    </button>
                }
            </div>

            <button class="sb-start-btn game-primary-action" @onclick="StartGame">Start</button>
        </div>
    }
    else
    {
        <div class="sb-hud game-hud">
            <span class="sb-title">@selectedTheme.Name</span>
            <button class="sb-restart-btn game-secondary-action" @onclick="FinishSession">All done</button>
        </div>

        <div class="sb-grid">
            @for (var i = 0; i < selectedTheme.Buttons.Length; i++)
            {
                var idx = i;
                var button = selectedTheme.Buttons[idx];
                <button class="sb-button @(activeIndex == idx ? "active" : "")" @onclick="() => Tap(idx)">
                    <span class="sb-icon">@button.Icon</span>
                    <span class="sb-label">@button.Label</span>
                </button>
            }
        </div>
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<SoundButtonsResult> OnComplete { get; set; }

    private enum Phase { Setup, Playing }

    private record ButtonDefinition(string Icon, string Label);
    private record ThemeDefinition(string Name, string Icon, ButtonDefinition[] Buttons);

    private static readonly ThemeDefinition[] Themes =
    {
        new("Animals", "🐶", new[]
        {
            new ButtonDefinition("🐶", "Dog"),
            new ButtonDefinition("🐱", "Cat"),
            new ButtonDefinition("🐮", "Cow"),
            new ButtonDefinition("🐷", "Pig"),
            new ButtonDefinition("🐔", "Chicken"),
            new ButtonDefinition("🐑", "Sheep"),
        }),
        new("Vehicles", "🚗", new[]
        {
            new ButtonDefinition("🚗", "Car"),
            new ButtonDefinition("🚒", "Fire Truck"),
            new ButtonDefinition("🚂", "Train"),
            new ButtonDefinition("🚁", "Helicopter"),
            new ButtonDefinition("🚜", "Tractor"),
            new ButtonDefinition("🚓", "Police Car"),
        }),
        new("Fun Sounds", "🎉", new[]
        {
            new ButtonDefinition("🎉", "Party"),
            new ButtonDefinition("🔔", "Bell"),
            new ButtonDefinition("🎺", "Horn"),
            new ButtonDefinition("🥳", "Yay"),
            new ButtonDefinition("🎶", "Music"),
            new ButtonDefinition("✨", "Sparkle"),
        }),
    };

    private Phase phase = Phase.Setup;
    private ThemeDefinition selectedTheme = Themes[0];
    private int? activeIndex;
    private int taps;
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    private void StartGame()
    {
        taps = 0;
        activeIndex = null;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    private async Task Tap(int index)
    {
        activeIndex = index;
        taps++;
        StateHasChanged();

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("playPianoNote", index);

        await Task.Delay(300);
        if (activeIndex == index) activeIndex = null;
        StateHasChanged();
    }

    private async Task FinishSession()
    {
        phase = Phase.Setup;

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new SoundButtonsResult(
                Theme: selectedTheme.Name,
                Taps: taps,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record SoundButtonsResult(string Theme, int Taps, int ElapsedSeconds);
}
