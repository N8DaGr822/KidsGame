@*
    CodeBreaker.razor
    Crack a numeric safe code. Unlike Mastermind's colored pegs (which can
    repeat), this code's digits never repeat - a genuinely different
    deduction strategy, not just a reskin. After each guess, feedback
    shows how many digits are the right value in the right spot vs. the
    right value in the wrong spot, as plain counts rather than peg dots.
    A fixed number of guesses per difficulty; run out and the code is
    revealed. Personal best tracks fewest guesses to crack a code.

    Usage:
        <CodeBreaker OnComplete="HandleGameComplete" />
*@
@inject InteropService Interop
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="cb-game">

    @if (phase == Phase.Setup)
    {
        <div class="cb-setup game-setup-panel">
            <h2>🔐 Code Breaker</h2>
            <p>Crack the safe! No digit repeats in the code. Each guess tells you how many digits are in the right spot vs. just the right digits.</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="cb-diff-name">@DifficultyName(diff)</span>
                            <span class="cb-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="cb-title">Code Breaker</span>
            <span class="game-stat">Guess @Math.Min(guesses.Count + 1, maxGuesses)/@maxGuesses</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="cb-board">
            @foreach (var g in guesses)
            {
                <div class="cb-row">
                    <div class="cb-digits">
                        @foreach (var d in g.Digits)
                        {
                            <span class="cb-digit">@d</span>
                        }
                    </div>
                    <div class="cb-feedback">
                        <span class="cb-fb-count cb-fb-spot">🎯@g.Spot</span>
                        <span class="cb-fb-count cb-fb-digit">🔀@g.Digit</span>
                    </div>
                </div>
            }

            @if (phase == Phase.Playing)
            {
                <div class="cb-row cb-row-active">
                    <div class="cb-digits">
                        @for (var i = 0; i < codeLength; i++)
                        {
                            var slot = i;
                            <button class="cb-digit cb-digit-slot @(selectedSlot == slot ? "selected" : "")" @onclick="() => selectedSlot = slot">
                                @(currentGuess[slot] is { } v ? v.ToString() : "")
                            </button>
                        }
                    </div>
                    <button class="game-primary-action cb-submit-btn" disabled="@(currentGuess.Any(v => v is null))" @onclick="SubmitGuess">Guess</button>
                </div>
                <div class="cb-keypad">
                    @for (var n = 0; n <= 9; n++)
                    {
                        var digit = n;
                        <button class="cb-key" disabled="@currentGuess.Contains(digit)" @onclick="() => PlaceDigit(digit)">@digit</button>
                    }
                    <button class="cb-key cb-erase-key" @onclick="ClearSlot">✖</button>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="cb-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>@(won ? "🔓 Safe Cracked!" : "🔒 Out of Guesses")</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ")@(won ? $"cracked it in {guesses.Count} guesses!" : "the code was:")</p>
                    @if (!won)
                    {
                        <div class="cb-digits cb-reveal">
                            @foreach (var d in secretCode)
                            {
                                <span class="cb-digit">@d</span>
                            }
                        </div>
                    }
                    <PersonalBestBadge Value="@(bestGuesses is { } bg ? $"{bg} guesses" : null)" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<CodeBreakerResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fewest guesses to win) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private record GuessRow(List<int> Digits, int Spot, int Digit);

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int CodeLengthFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 3,
        Difficulty.Medium => 4,
        _ => 5,
    };

    private static int MaxGuessesFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 8,
        Difficulty.Medium => 10,
        _ => 10,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private int codeLength = 3;
    private int maxGuesses = 8;
    private List<int> secretCode = new();
    private readonly List<int?> currentGuess = new();
    private int selectedSlot;
    private readonly List<GuessRow> guesses = new();
    private bool won;
    private string roundMessage = "";
    private int? bestGuesses;
    private bool isNewBest;
    private readonly Random rng = new();
    private DateTime startedAtUtc;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        codeLength = CodeLengthFor(selectedDifficulty);
        maxGuesses = MaxGuessesFor(selectedDifficulty);

        secretCode = Enumerable.Range(0, 10).OrderBy(_ => rng.Next()).Take(codeLength).ToList();
        guesses.Clear();
        currentGuess.Clear();
        currentGuess.AddRange(Enumerable.Repeat((int?)null, codeLength));
        selectedSlot = 0;
        won = false;
        roundMessage = "";
        bestGuesses = null;
        isNewBest = false;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CodeBreakerResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: false,
                GuessesUsed: guesses.Count,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void PlaceDigit(int digit)
    {
        if (phase != Phase.Playing || currentGuess.Contains(digit)) return;
        currentGuess[selectedSlot] = digit;
        var nextEmpty = currentGuess.FindIndex(selectedSlot + 1, v => v is null);
        if (nextEmpty < 0) nextEmpty = currentGuess.FindIndex(v => v is null);
        if (nextEmpty >= 0) selectedSlot = nextEmpty;
    }

    private void ClearSlot()
    {
        if (phase != Phase.Playing) return;
        currentGuess[selectedSlot] = null;
    }

    private async Task SubmitGuess()
    {
        if (phase != Phase.Playing || currentGuess.Any(v => v is null)) return;

        var digits = currentGuess.Select(v => v!.Value).ToList();
        var (spot, digit) = ScoreGuess(digits);
        guesses.Add(new GuessRow(digits, spot, digit));

        currentGuess.Clear();
        currentGuess.AddRange(Enumerable.Repeat((int?)null, codeLength));
        selectedSlot = 0;

        if (spot == codeLength)
        {
            won = true;
            roundMessage = "Safe cracked!";
            await Interop.InvokeVoidAsync("playMatchSound");
            await FinishGame();
        }
        else if (guesses.Count >= maxGuesses)
        {
            won = false;
            await Interop.InvokeVoidAsync("playMismatchSound");
            await FinishGame();
        }
        else
        {
            await Interop.InvokeVoidAsync(spot + digit > 0 ? "playImpactSound" : "playMismatchSound");
        }
    }

    // No repeats in either the code or a guess (enforced by the keypad
    // disabling already-used digits), so scoring is simpler than
    // Mastermind's: exact-position matches, then how many of the
    // remaining guessed digits appear anywhere else in the secret.
    private (int Spot, int Digit) ScoreGuess(List<int> guess)
    {
        var spot = 0;
        for (var i = 0; i < codeLength; i++)
        {
            if (guess[i] == secretCode[i]) spot++;
        }

        var digit = guess.Count(secretCode.Contains) - spot;
        return (spot, digit);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "fewest-guesses";
            bestGuesses = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.CodeBreaker, key);
            if (won)
            {
                isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.CodeBreaker, key, guesses.Count, lowerIsBetter: true);
            }
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CodeBreakerResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: won,
                GuessesUsed: guesses.Count,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "3 digits, 8 guesses",
        Difficulty.Medium => "4 digits, 10 guesses",
        _ => "5 digits, 10 guesses",
    };

    public record CodeBreakerResult(string Difficulty, bool Won, int GuessesUsed, int ElapsedSeconds);
}
