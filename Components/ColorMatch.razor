@*
    ColorMatch.razor
    A target color swatch appears - tap the option swatch that's the exact
    same color. No reading required. Difficulty controls the color pool
    size and how many close/similar hues are mixed in (harder to tell
    apart), plus how many options are shown at once. A fixed 8-round
    session ends with a result overlay.

    Usage:
        <ColorMatch OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="cm-game">

    @if (phase == Phase.Setup)
    {
        <div class="cm-setup game-setup-panel">
            <h2>🎨 Color Match</h2>
            <p>Look at the color, then tap the option that matches it!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="cm-diff-name">@DifficultyName(diff)</span>
                            <span class="cm-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="cm-title">Color Match</span>
            <span class="game-stat">Round @Math.Min(round, TotalRounds)/@TotalRounds</span>
            <span class="game-stat">🌟 Score @score</span>
            <span class="game-stat">🔥 Streak @streak</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="cm-target" style="background:@target.Hex"></div>

        <div class="cm-choices cm-choices-@choices.Count">
            @for (var i = 0; i < choices.Count; i++)
            {
                var index = i;
                <button class="cm-choice @(ChoiceState(index))" style="background:@choices[index].Hex" disabled="@(locked)" @onclick="() => Pick(index)"></button>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="cm-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🎨 All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great eye for color" : PlayerName + ", great eye for color")!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Score</span><span class="game-stat-value">@score/@TotalRounds</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<ColorMatchResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int TotalRounds = 8;

    private record ColorDef(string Name, string Hex);

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static readonly ColorDef[] EasyPalette =
    {
        new("Red", "#E63946"), new("Blue", "#3A86FF"), new("Yellow", "#FFD60A"),
        new("Green", "#2DC653"), new("Purple", "#9D4EDD"), new("Orange", "#FB8500"),
    };

    private static readonly ColorDef[] MediumPalette = EasyPalette.Concat(new[]
    {
        new ColorDef("Pink", "#FF70A6"), new ColorDef("Teal", "#06AED5"), new ColorDef("Brown", "#8B5E34"),
    }).ToArray();

    private static readonly ColorDef[] HardPalette = MediumPalette.Concat(new[]
    {
        new ColorDef("Maroon", "#7B241C"), new ColorDef("Navy", "#16324F"),
        // Fuchsia (hue ~308°), not Violet (~272°) - Violet sat right next
        // to Easy's Purple (~271°), close enough in hue (differing mainly
        // in lightness) that a 5-option Hard round could show what read as
        // "the same purple twice."
        new ColorDef("Lime", "#B5E61D"), new ColorDef("Fuchsia", "#C724B1"),
    }).ToArray();

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static ColorDef[] PaletteFor(Difficulty d) => d switch
    {
        Difficulty.Easy => EasyPalette,
        Difficulty.Medium => MediumPalette,
        _ => HardPalette,
    };

    private static int ChoiceCountFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 3,
        Difficulty.Medium => 4,
        _ => 5,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private ColorDef target = EasyPalette[0];
    private readonly List<ColorDef> choices = new();
    private int? pickedIndex;
    private bool locked;
    private int round;
    private int score;
    private int streak;
    private int bestStreak;
    private string roundMessage = "";
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        round = 0;
        score = 0;
        streak = 0;
        bestStreak = 0;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        NextRound();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new ColorMatchResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private void NextRound()
    {
        round++;
        roundMessage = "";
        pickedIndex = null;
        locked = false;

        var palette = PaletteFor(selectedDifficulty).OrderBy(_ => rng.Next()).ToArray();
        var choiceCount = Math.Min(ChoiceCountFor(selectedDifficulty), palette.Length);

        target = palette[0];
        choices.Clear();
        choices.AddRange(palette.Take(choiceCount));
        Shuffle(choices);
    }

    private void Shuffle(List<ColorDef> list)
    {
        for (var i = list.Count - 1; i > 0; i--)
        {
            var j = rng.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }

    private string ChoiceState(int index)
    {
        if (pickedIndex is null) return "";
        if (choices[index].Hex == target.Hex) return "correct";
        if (index == pickedIndex) return "wrong";
        return "";
    }

    private async Task Pick(int index)
    {
        if (locked || phase != Phase.Playing) return;

        locked = true;
        pickedIndex = index;

        if (choices[index].Hex == target.Hex)
        {
            score++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            roundMessage = "Perfect match!";
            await PlaySoundAsync("playMatchSound");
        }
        else
        {
            streak = 0;
            roundMessage = "So close - here's the match!";
            await PlaySoundAsync("playMismatchSound");
        }

        StateHasChanged();
        await Task.Delay(1000);

        if (round >= TotalRounds)
        {
            await FinishGame();
        }
        else
        {
            NextRound();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new ColorMatchResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                TotalRounds: TotalRounds,
                BestStreak: bestStreak,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "6 colors, 3 options",
        Difficulty.Medium => "9 colors, 4 options",
        _ => "13 colors, 5 options",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record ColorMatchResult(string Difficulty, int Score, int TotalRounds, int BestStreak, int ElapsedSeconds);
}
