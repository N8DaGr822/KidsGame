@*
    DressUpGame.razor
    A sticker-based dress-up game. Pick a character, then the character
    fills the screen; a collapsible side drawer holds the sticker tray and
    drawing tools. Stickers are repeatable (drag the same one out as many
    times as you like) and can be dragged onto the trash zone to remove
    them. Free play - no win state - "Done!" just logs the session and
    shows a small celebration.

    Drag-and-drop is implemented with Pointer Events (not the HTML5
    drag-and-drop API) so the same code path works for mouse, touch, and
    pen - HTML5 DnD is unreliable on touch/tablet browsers, especially
    iOS Safari, which doesn't support it on touch targets at all.

    Usage:
        <DressUpGame OnComplete="HandleGameComplete" />

    Optional:
        <DressUpGame PlayerName="Riley" OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="dress-up-game">

    @if (selectedCharacter is null)
    {
        <div class="du-setup">
            <div class="du-setup-header">
                <h2>Dress Up</h2>
                <button class="du-fullscreen-btn" @onclick="ToggleFullscreen">@(isFullscreen ? "⛶ Exit Full Screen" : "⛶ Full Screen")</button>
            </div>
            <p>Pick a character, then drag stickers onto them to build an outfit!</p>

            <h3 class="du-section-title">Choose a character</h3>
            <div class="du-character-select">
                @foreach (var character in Characters)
                {
                    <button class="du-character-btn" @onclick="() => ChooseCharacter(character)">
                        <img class="du-character-icon" src="@character.ImagePath" alt="@character.Name" />
                        <span class="du-character-name">@character.Name</span>
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="du-hud">
            <button class="du-restart-btn" @onclick="() => selectedCharacter = null">← Change Character</button>
            <span class="du-character-title">@selectedCharacter.Name</span>
            <button class="du-restart-btn" @onclick="ToggleFullscreen">@(isFullscreen ? "⛶ Exit Full Screen" : "⛶ Full Screen")</button>
            <button class="du-restart-btn" disabled="@(undoStack.Count == 0)" @onclick="UndoAsync">↩️ Undo</button>
            <button class="du-restart-btn" @onclick="ExportOutfitAsync">💾 Save Picture</button>
            <button class="du-restart-btn" @onclick="ResetOutfit">Reset Outfit</button>
        </div>

        <div class="du-play" @ref="playRef" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointercancel="OnPointerUp">
            <div class="du-stage @(DrawMode ? "draw-mode" : "")" @ref="stageRef" @onpointerdown="OnStagePointerDown">
                <img class="du-base" @ref="baseImageRef" src="@selectedCharacter.ImagePath" alt="@selectedCharacter.Name" />

                @foreach (var placed in placedStickers)
                {
                    <span @key="placed.Id" class="du-placed-sticker @(dragging == placed ? "dragging" : "") @(dragging == placed && overTrash ? "over-trash" : "") @(selectedSticker == placed ? "selected" : "")"
                          style="left:@(placed.X.ToString(Inv))%; top:@(placed.Y.ToString(Inv))%; --du-scale:@(placed.Scale.ToString(Inv));"
                          @onpointerdown="e => StartDragPlaced(e, placed)"
                          @onpointerdown:preventDefault>
                        @if (ImagePathFor(placed.StickerId) is { } placedImgPath)
                        {
                            <img class="du-placed-sticker-img" src="@placedImgPath" alt="" draggable="false" />
                        }
                        else
                        {
                            @placed.Emoji
                        }

                        @if (selectedSticker == placed && !DrawMode)
                        {
                            <span class="du-resize-handle"
                                  @onpointerdown="e => StartResize(e, placed)"
                                  @onpointerdown:preventDefault
                                  @onpointerdown:stopPropagation>↔</span>
                        }
                    </span>
                }

                <canvas class="du-draw-canvas" @ref="canvasRef"></canvas>

                <div class="du-trash-zone @(dragging is not null ? "visible" : "") @(overTrash ? "active" : "")" @ref="trashRef">🗑️</div>
            </div>

            <button class="du-drawer-toggle" @onclick="() => drawerOpen = !drawerOpen" aria-label="@(drawerOpen ? "Close stickers and drawing tools" : "Open stickers and drawing tools")">
                @(drawerOpen ? "✕" : "🎒")
            </button>

            <div class="du-drawer @(drawerOpen ? "open" : "")">
                <div class="du-drawer-tabs">
                    <button class="du-drawer-tab @(activeTab == DrawerTab.Stickers ? "active" : "")" @onclick="() => activeTab = DrawerTab.Stickers">
                        🎒 Stickers
                    </button>
                    <button class="du-drawer-tab @(activeTab == DrawerTab.Draw ? "active" : "")" @onclick="() => activeTab = DrawerTab.Draw">
                        🖍️ Draw
                    </button>
                </div>

                @if (activeTab == DrawerTab.Draw)
                {
                    <div class="du-draw-tools">
                        <div class="du-color-row">
                            @foreach (var color in DrawColors)
                            {
                                <button class="du-color-swatch @(drawColor == color ? "selected" : "")"
                                        style="background:@color"
                                        @onclick="() => drawColor = color"
                                        aria-label="Draw color @color"></button>
                            }
                        </div>

                        <div class="du-brush-row">
                            @foreach (var size in BrushSizes)
                            {
                                <button class="du-brush-btn @(brushSize == size ? "selected" : "")" @onclick="() => brushSize = size" aria-label="Brush size @size">
                                    <span class="du-brush-dot" style="width:@(size)px; height:@(size)px;"></span>
                                </button>
                            }
                        </div>

                        <button class="du-restart-btn" @onclick="ClearDrawing">Clear Drawing</button>
                    </div>
                }
                else
                {
                    <p class="du-drawer-hint">Drag a sticker onto the character - grab it as many times as you like. Tap a placed sticker to resize it.</p>
                    <div class="du-tray">
                        @foreach (var sticker in AllStickers)
                        {
                            <div @key="sticker.Id" class="du-tray-item"
                                 @onpointerdown="e => StartDragFromTray(e, sticker)"
                                 @onpointerdown:preventDefault>
                                @if (sticker.ImagePath is not null)
                                {
                                    <img class="du-tray-img" src="@sticker.ImagePath" alt="" draggable="false" />
                                }
                                else
                                {
                                    <span class="du-tray-emoji">@sticker.Emoji</span>
                                }
                                <span class="du-tray-label">@sticker.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <button class="du-done-btn" @onclick="FinishDressUp">Done! 🎉</button>
        </div>

        @if (celebrate)
        {
            <div class="du-win-overlay">
                <div class="du-win-panel">
                    <h2>🎉 All dressed up!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great styling" : PlayerName + ", great styling") on your @selectedCharacter.Name!</p>
                    <div class="du-win-actions">
                        <button class="du-start-btn" @onclick="() => { celebrate = false; selectedCharacter = null; }">Dress Another</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    // ---- Public parameters -------------------------------------------------

    /// <summary>Optional display name, e.g. from the active kid profile.</summary>
    [Parameter] public string? PlayerName { get; set; }

    /// <summary>Fired when the kid taps "Done!" on a dressed-up character.</summary>
    [Parameter] public EventCallback<DressUpResult> OnComplete { get; set; }

    // ---- Character catalog -------------------------------------------------

    public record StickerDef(string Id, string Emoji, string Label, string? ImagePath = null);
    public record CharacterOption(string Name, string ImagePath);

    private const string StickerArt = "images/dressup/stickers/";

    // Every sticker is available for every character - drag any of these
    // onto whichever character is selected. Stickers without an ImagePath
    // fall back to their emoji - either no matching art exists yet, or
    // the available art was rejected (stock-photo watermarks on
    // sword/horse/dress; wings/helmet were the wrong style/theme).
    private static readonly List<StickerDef> AllStickers = new()
    {
        new StickerDef("crown", "👑", "Crown", StickerArt + "Crown.jpg"),
        new StickerDef("gem", "💎", "Gem"),
        new StickerDef("dress", "👗", "Dress"),
        new StickerDef("ring", "💍", "Ring"),
        new StickerDef("rose", "🌹", "Rose", StickerArt + "Rose.jpg"),
        new StickerDef("purse", "👛", "Purse", StickerArt + "Bag.jpg"),
        new StickerDef("hat", "🎩", "Hat", StickerArt + "Hat.jpg"),
        new StickerDef("broom", "🧹", "Broom"),
        new StickerDef("crystal-ball", "🔮", "Crystal Ball", StickerArt + "Orb.jpg"),
        new StickerDef("cat", "🐈‍⬛", "Black Cat", StickerArt + "Cat.jpg"),
        new StickerDef("potion", "🧪", "Potion"),
        new StickerDef("star", "⭐", "Star", StickerArt + "Star.jpg"),
        new StickerDef("rainbow", "🌈", "Rainbow", StickerArt + "Rainbow.jpg"),
        new StickerDef("bow", "🎀", "Bow", StickerArt + "Bow.jpg"),
        new StickerDef("flowers", "💐", "Flowers"),
        new StickerDef("sparkles", "✨", "Sparkles", StickerArt + "Sparkle.png"),
        new StickerDef("heart", "💖", "Heart", StickerArt + "Heart.jpg"),
        new StickerDef("sword", "⚔️", "Sword"),
        new StickerDef("shield", "🛡️", "Shield"),
        new StickerDef("horse", "🐴", "Horse"),
        new StickerDef("medal", "🎖️", "Medal"),
        new StickerDef("helmet", "🪖", "Helmet"),
        new StickerDef("bow-arrow", "🏹", "Bow & Arrow"),
        new StickerDef("fire", "🔥", "Fire", StickerArt + "Fire.jpg"),
        new StickerDef("lightning", "⚡", "Lightning"),
        new StickerDef("wings", "🦇", "Wings"),
        new StickerDef("volcano", "🌋", "Volcano", StickerArt + "Volcano.jpg"),
    };

    private static readonly List<CharacterOption> Characters = new()
    {
        new("Princess", "images/dressup/Princess.png"),
        new("Prince", "images/dressup/Prince.png"),
        new("Knight", "images/dressup/knight.png"),
        new("Unicorn", "images/dressup/Unicorn.png"),
        new("Dragon", "images/dressup/Dragon.png"),
        new("Wizard", "images/dressup/Wizard.png"),
        new("Sorceress", "images/dressup/Sorc.png"),
    };

    // ---- Placed-sticker model ----------------------------------------------

    public class PlacedSticker
    {
        // Distinct from StickerId - the same sticker can be placed many
        // times, so this is what @key and reference-equality checks use.
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string StickerId { get; set; } = "";
        public string Emoji { get; set; } = "";
        public double X { get; set; } = 50;
        public double Y { get; set; } = 50;
        public double Scale { get; set; } = 1;
    }

    // ---- State ---------------------------------------------------------------

    private CharacterOption? selectedCharacter;
    private readonly List<PlacedSticker> placedStickers = new();
    private bool celebrate;
    private bool drawerOpen;

    private ElementReference stageRef;
    private ElementReference baseImageRef;
    private ElementReference playRef;
    private IJSObjectReference? _module;

    // ---- Fullscreen (tablet kiosk-style play) -------------------------------

    private bool isFullscreen;
    private bool fullscreenWatching;
    private DotNetObjectReference<DressUpGame>? _dotNetRef;

    private async Task ToggleFullscreen()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        if (!fullscreenWatching)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watchFullscreen", _dotNetRef);
            fullscreenWatching = true;
        }

        await _module.InvokeVoidAsync(isFullscreen ? "exitFullscreen" : "requestFullscreen");
    }

    // Fires on ANY fullscreen change, not just ones triggered by our own
    // button - e.g. a kid hitting Esc or swiping to exit at the OS level -
    // so the button's label always reflects what's actually on screen.
    [JSInvokable]
    public void OnFullscreenChanged(bool nowFullscreen)
    {
        isFullscreen = nowFullscreen;
        StateHasChanged();
    }

    // ---- Undo -----------------------------------------------------------
    //
    // One shared history so a single "Undo" button reverses whatever the
    // kid last did, whether that was placing/removing a sticker or a
    // drawing stroke - StrokeEntry is just a marker; the actual pixels
    // are undone JS-side via undoLastStroke, which keeps its own stack of
    // canvas snapshots in lockstep with these markers.
    private abstract record UndoEntry;
    private record StickerAddedEntry(PlacedSticker Sticker) : UndoEntry;
    private record StickerRemovedEntry(PlacedSticker Sticker) : UndoEntry;
    private record StrokeEntry : UndoEntry;

    private readonly Stack<UndoEntry> undoStack = new();

    private PlacedSticker? dragging;
    private double stageLeft, stageTop, stageWidth, stageHeight;

    private ElementReference trashRef;
    private double trashLeft, trashTop, trashWidth, trashHeight;
    private bool overTrash;

    // ---- Drawing -------------------------------------------------------------

    private static readonly List<string> DrawColors = new()
    {
        "#ff6b6b", "#ffc857", "#76e39f", "#4ecdc4", "#38b6ff", "#6c5ce7", "#ff8fab", "#f7f8fc",
    };

    private static readonly List<double> BrushSizes = new() { 4, 10, 18 };

    private ElementReference canvasRef;
    private bool isDrawing;
    private string drawColor = DrawColors[0];
    private double brushSize = BrushSizes[1];

    // ---- Drawer tabs --------------------------------------------------------
    //
    // The active tab IS the mode switch (not a separate toggle) - picking
    // "Draw" both shows the drawing tools and puts the stage into draw
    // mode, so there's exactly one obvious thing controlling whether a
    // tap on the character draws or drags a sticker.

    private enum DrawerTab { Stickers, Draw }

    private DrawerTab activeTab = DrawerTab.Stickers;

    private bool DrawMode => activeTab == DrawerTab.Draw;

    // ---- Sticker resize -------------------------------------------------

    private PlacedSticker? selectedSticker;
    private PlacedSticker? resizing;
    private double resizeStartClientX, resizeStartClientY, resizeStartScale;

    private const double MinScale = 0.5;
    private const double MaxScale = 2.5;

    private async Task StartResize(PointerEventArgs e, PlacedSticker placed)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        resizing = placed;
        selectedSticker = placed;
        resizeStartClientX = e.ClientX;
        resizeStartClientY = e.ClientY;
        resizeStartScale = placed.Scale;
    }

    private void ChooseCharacter(CharacterOption character)
    {
        selectedCharacter = character;
        placedStickers.Clear();
        undoStack.Clear();
        selectedSticker = null;
    }

    // A full reset also resets undo history - keeping stale sticker/stroke
    // entries around after everything they refer to is gone would let
    // Undo do something confusing (e.g. re-add a sticker that predates
    // the reset the kid explicitly asked for).
    private void ResetOutfit()
    {
        placedStickers.Clear();
        undoStack.Clear();
        selectedSticker = null;
    }

    // ---- Drag and drop (Pointer Events - works for mouse, touch, pen) ------

    private async Task StartDragFromTray(PointerEventArgs e, StickerDef sticker)
    {
        if (DrawMode) return;

        // Always a new instance (rather than reusing one already on the
        // stage) so the same sticker can be stacked as many times as a kid
        // wants - e.g. a handful of hearts.
        var placed = new PlacedSticker { StickerId = sticker.Id, Emoji = sticker.Emoji, X = 50, Y = 50 };
        placedStickers.Add(placed);
        undoStack.Push(new StickerAddedEntry(placed));

        await BeginDrag(e, placed);
    }

    private async Task StartDragPlaced(PointerEventArgs e, PlacedSticker placed)
    {
        if (DrawMode) return;
        await BeginDrag(e, placed);
    }

    private async Task BeginDrag(PointerEventArgs e, PlacedSticker placed)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<StageRect>("getBoundingRect", stageRef);

        stageLeft = rect.Left;
        stageTop = rect.Top;
        stageWidth = rect.Width;
        stageHeight = rect.Height;

        // Fetched alongside the stage rect (rather than once, cached) so it
        // stays correct if the layout reflows between drags.
        var trashRect = await _module.InvokeAsync<StageRect>("getBoundingRect", trashRef);
        trashLeft = trashRect.Left;
        trashTop = trashRect.Top;
        trashWidth = trashRect.Width;
        trashHeight = trashRect.Height;

        // Without this, a fast drag that leaves .du-play's bounds (easy to
        // do on a touch screen) stops delivering pointermove/pointerup to
        // our handlers entirely, since those events would otherwise target
        // whatever element the pointer is now over instead.
        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        dragging = placed;
        selectedSticker = placed;
        overTrash = IsOverTrash(e.ClientX, e.ClientY);
        SetDragPosition(e.ClientX, e.ClientY, clamp: true);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (isDrawing)
        {
            // Fire-and-forget: the canvas paints itself in JS, so there's
            // nothing here that needs a Blazor re-render per point.
            _ = _module!.InvokeVoidAsync("drawMove", canvasRef, e.ClientX - stageLeft, e.ClientY - stageTop);
            return;
        }

        if (resizing is not null)
        {
            // Dragging the handle down-right grows the sticker, up-left
            // shrinks it - averaging both axes so a diagonal drag (the
            // natural motion toward/away from a corner handle) reads
            // cleanly as a single "bigger/smaller" gesture.
            var delta = ((e.ClientX - resizeStartClientX) + (e.ClientY - resizeStartClientY)) / 2;
            resizing.Scale = Math.Clamp(resizeStartScale + delta / 100.0, MinScale, MaxScale);
            StateHasChanged();
            return;
        }

        if (dragging is null) return;
        overTrash = IsOverTrash(e.ClientX, e.ClientY);
        SetDragPosition(e.ClientX, e.ClientY, clamp: true);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (isDrawing)
        {
            isDrawing = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("drawEnd", canvasRef);
            }
            return;
        }

        if (resizing is not null)
        {
            resizing = null;
            StateHasChanged();
            return;
        }

        if (dragging is null) return;

        if (overTrash)
        {
            placedStickers.Remove(dragging);
            undoStack.Push(new StickerRemovedEntry(dragging));
            if (selectedSticker == dragging) selectedSticker = null;
        }

        overTrash = false;
        dragging = null;
        StateHasChanged();
    }

    // ---- Drawing (Pointer Events routed here instead of dragging while
    // draw mode is on - see StartDragFromTray/StartDragPlaced) ------------

    private async Task OnStagePointerDown(PointerEventArgs e)
    {
        if (!DrawMode)
        {
            // Tapping empty stage space (this fires after any child sticker's
            // own pointerdown too, via bubbling, but that's harmless - this
            // just re-clears a selection the child handler is about to set
            // again on its own pointerup) deselects, hiding the resize handle.
            selectedSticker = null;
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<StageRect>("getBoundingRect", stageRef);

        stageLeft = rect.Left;
        stageTop = rect.Top;
        stageWidth = rect.Width;
        stageHeight = rect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", playRef, e.PointerId);

        isDrawing = true;
        await _module.InvokeVoidAsync("drawStart", canvasRef, e.ClientX - stageLeft, e.ClientY - stageTop, drawColor, brushSize);
        undoStack.Push(new StrokeEntry());
    }

    private async Task ClearDrawing()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("clearDrawCanvas", canvasRef);

        // Any StrokeEntry markers now point at pixels that no longer
        // exist - drop the whole history rather than leave Undo able to
        // "restore" a stroke from before the clear.
        undoStack.Clear();
    }

    private async Task UndoAsync()
    {
        if (undoStack.Count == 0) return;

        switch (undoStack.Pop())
        {
            case StickerAddedEntry added:
                placedStickers.Remove(added.Sticker);
                break;

            case StickerRemovedEntry removed:
                placedStickers.Add(removed.Sticker);
                break;

            case StrokeEntry:
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
                await _module.InvokeVoidAsync("undoLastStroke", canvasRef);
                break;
        }

        StateHasChanged();
    }

    private async Task ExportOutfitAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        // Image-backed stickers are read straight off the DOM by exportOutfit
        // (see interop.js) - only stickers still on emoji fallback need to be
        // passed in for canvas text drawing.
        var emojiStickers = placedStickers
            .Where(s => ImagePathFor(s.StickerId) is null)
            .Select(s => new { emoji = s.Emoji, xPercent = s.X, yPercent = s.Y })
            .ToArray();
        var filename = $"dress-up-{selectedCharacter!.Name.ToLowerInvariant()}.png";

        await _module.InvokeVoidAsync("exportOutfit", stageRef, baseImageRef, emojiStickers, canvasRef, filename);
    }

    private static string? ImagePathFor(string stickerId) =>
        AllStickers.FirstOrDefault(s => s.Id == stickerId)?.ImagePath;

    private bool IsOverTrash(double clientX, double clientY) =>
        trashWidth > 0 && trashHeight > 0 &&
        clientX >= trashLeft && clientX <= trashLeft + trashWidth &&
        clientY >= trashTop && clientY <= trashTop + trashHeight;

    private (double x, double y) ToStagePercent(double clientX, double clientY)
    {
        if (stageWidth <= 0 || stageHeight <= 0) return (50, 50);
        var x = (clientX - stageLeft) / stageWidth * 100;
        var y = (clientY - stageTop) / stageHeight * 100;
        return (x, y);
    }

    private void SetDragPosition(double clientX, double clientY, bool clamp)
    {
        var (x, y) = ToStagePercent(clientX, clientY);
        if (clamp)
        {
            x = Math.Clamp(x, 4, 96);
            y = Math.Clamp(y, 4, 96);
        }

        dragging!.X = x;
        dragging!.Y = y;
        StateHasChanged();
    }

    private record StageRect(double Left, double Top, double Width, double Height);

    // ---- Completion ------------------------------------------------------

    private async Task FinishDressUp()
    {
        celebrate = true;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new DressUpResult(
                Character: selectedCharacter!.Name,
                StickersPlaced: placedStickers.Count));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                if (fullscreenWatching)
                {
                    await _module.InvokeVoidAsync("unwatchFullscreen");
                }
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }

        _dotNetRef?.Dispose();
    }

    // ---- Result payload ------------------------------------------------------

    public record DressUpResult(string Character, int StickersPlaced);
}
