@*
    TicTacToe.razor
    Classic 3x3 - the player is always X and goes first, the computer
    plays O. Difficulty controls the AI's strength via GameAi.TicTacToeMove
    (Easy is random, Medium mixes in mistakes, Hard is unbeatable). Match
    tally (wins/losses/draws) persists across "Play Again" for the rest of
    the session, since a single round only takes a few seconds.

    Usage:
        <TicTacToe OnComplete="HandleGameComplete" />
*@
@using KidsGameLauncher.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="tt-game">

    @if (phase == Phase.Setup)
    {
        <div class="tt-setup game-setup-panel">
            <h2>⭕ Tic-Tac-Toe</h2>
            <p>You're X and go first - get three in a row before the computer does!</p>

            <h3 class="tt-section-title game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="tt-difficulty-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="tt-difficulty-select game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="tt-diff-btn game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="tt-diff-name">@DifficultyName(diff)</span>
                            <span class="tt-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="tt-start-btn game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="tt-hud game-hud">
            <span class="tt-title">Tic-Tac-Toe</span>
            <span class="tt-stat">You @wins - @losses Computer</span>
            <span class="tt-stat">Draws @draws</span>
            <button class="tt-restart-btn game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="tt-board">
            @for (var i = 0; i < 9; i++)
            {
                var idx = i;
                <button class="tt-cell @(board[idx] == 'X' ? "x" : "") @(board[idx] == 'O' ? "o" : "")"
                        disabled="@(phase != Phase.Playing || board[idx] != '\0' || aiThinking)"
                        @onclick="() => PlayerMove(idx)">
                    @(board[idx] == '\0' ? "" : board[idx].ToString())
                </button>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="tt-overlay game-result-overlay">
                <div class="tt-win-panel game-result-panel">
                    @if (outcome == "Win")
                    {
                        <h2>🎉 You Win!</h2>
                        <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great job" : PlayerName + ", great job") - three in a row!</p>
                    }
                    else if (outcome == "Loss")
                    {
                        <h2>🤖 Computer Wins</h2>
                        <p>So close - want a rematch?</p>
                    }
                    else
                    {
                        <h2>🤝 It's a Draw!</h2>
                        <p>Nobody got three in a row this time.</p>
                    }
                    <div class="tt-win-stats game-result-stats">
                        <div><span class="game-stat-label">Wins</span><span class="game-stat-value">@wins</span></div>
                        <div><span class="game-stat-label">Losses</span><span class="game-stat-value">@losses</span></div>
                        <div><span class="game-stat-label">Draws</span><span class="game-stat-value">@draws</span></div>
                    </div>
                    <div class="tt-win-actions game-result-actions">
                        <button class="tt-start-btn game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="tt-restart-btn game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<TicTacToeResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }

    private static readonly GameAi.Difficulty[] Difficulties =
        { GameAi.Difficulty.Easy, GameAi.Difficulty.Medium, GameAi.Difficulty.Hard };

    private GameAi.Difficulty? LockedDifficulty =>
        Enum.TryParse<GameAi.Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private const char PlayerSymbol = 'X';
    private const char AiSymbol = 'O';

    private Phase phase = Phase.Setup;
    private GameAi.Difficulty selectedDifficulty = GameAi.Difficulty.Easy;
    private char[] board = new char[9];
    private bool aiThinking;
    private string outcome = "";
    private int wins;
    private int losses;
    private int draws;
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        board = new char[9];
        phase = Phase.Playing;
        aiThinking = false;
        startedAtUtc = DateTime.UtcNow;
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    // Guarded to Playing so the Finished-overlay's Exit button (which
    // shares this handler) doesn't double-fire after FinishGame already
    // invoked OnComplete.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new TicTacToeResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Outcome: "Exited",
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task PlayerMove(int index)
    {
        if (phase != Phase.Playing || aiThinking || board[index] != '\0') return;

        board[index] = PlayerSymbol;

        if (await CheckRoundOverAsync()) return;

        aiThinking = true;
        StateHasChanged();
        await Task.Delay(500);

        var move = GameAi.TicTacToeMove(board, AiSymbol, PlayerSymbol, selectedDifficulty);
        if (move >= 0) board[move] = AiSymbol;
        aiThinking = false;

        await CheckRoundOverAsync();
    }

    private async Task<bool> CheckRoundOverAsync()
    {
        var winner = GameAi.TicTacToeWinner(board);
        if (winner == PlayerSymbol)
        {
            wins++;
            await FinishGame("Win");
            return true;
        }
        if (winner == AiSymbol)
        {
            losses++;
            await FinishGame("Loss");
            return true;
        }
        if (Array.TrueForAll(board, c => c != '\0'))
        {
            draws++;
            await FinishGame("Draw");
            return true;
        }

        StateHasChanged();
        return false;
    }

    private async Task FinishGame(string result)
    {
        outcome = result;
        phase = Phase.Finished;
        StateHasChanged();
        await PlaySoundAsync(result == "Win" ? "playMatchSound" : result == "Loss" ? "playMismatchSound" : "playImpactSound");

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new TicTacToeResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Outcome: outcome,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private static string DifficultyName(GameAi.Difficulty d) => d switch
    {
        GameAi.Difficulty.Easy => "Easy",
        GameAi.Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(GameAi.Difficulty d) => d switch
    {
        GameAi.Difficulty.Easy => "Computer plays randomly",
        GameAi.Difficulty.Medium => "Computer plays pretty well",
        _ => "Computer never misses",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record TicTacToeResult(string Difficulty, string Outcome, int ElapsedSeconds);
}
