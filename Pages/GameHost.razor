    private void GoBack() => Nav.NavigateTo("games");

    private void HandleHudChanged() => InvokeAsync(StateHasChanged);

    private Func<T, Task> GuardResult<T>(Func<T, Task> handler)
    {
        var session = _session;
        // Route Lifecycle: A callback from an old child must never record against a newly loaded game.
        return result => !_disposed && ReferenceEquals(session, _session) ? handler(result) : Task.CompletedTask;
    }

    private Task RecordResultAsync(PlayHistoryEntry entry) => _session?.RecordResultAsync(entry) ?? Task.CompletedTask;

    private async Task EndSessionAsync()
    {
        _checkpointTimer?.Dispose();
        _checkpointTimer = null;
        if (_session is { } session) await session.EndAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _routeGeneration++;
        _hudSlot.Changed -= HandleHudChanged;
        _navigationRegistration?.Dispose();
        await EndSessionAsync();
    }
}
