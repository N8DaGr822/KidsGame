<div class="carousel-wrap">
    @if (ShowArrows)
    {
        <button class="carousel-arrow carousel-arrow-left" @onclick="() => ScrollAsync(-ScrollAmount)" aria-label="Scroll left">
            ‹
        </button>
    }

    <div class="carousel-track" @ref="_trackRef">
        @ChildContent
    </div>

    @if (ShowArrows)
    {
        <button class="carousel-arrow carousel-arrow-right" @onclick="() => ScrollAsync(ScrollAmount)" aria-label="Scroll right">
            ›
        </button>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowArrows { get; set; } = true;
    [Parameter] public int ScrollAmount { get; set; } = 320;

    [Inject] private InteropService Interop { get; set; } = default!;

    private ElementReference _trackRef;

    private async Task ScrollAsync(int amount)
    {
        await Interop.InvokeVoidAsync("scrollCarousel", _trackRef, amount);
    }
}
