@*
    Battleships.razor
    Classic Battleship vs a CPU opponent. The player places their own
    fleet ship-by-ship at the start of each game (tap a cell to drop the
    current ship there in the selected orientation, or randomize the
    rest); the CPU's fleet is still placed randomly, since it never sees
    the board anyway. Strict alternating turns: tap a cell on
    "Enemy Waters" to fire, then the CPU fires back. Sink every ship in a
    fleet to win. CPU gets smarter with difficulty: Easy fires randomly;
    Medium hunts adjacent cells after a hit; Hard hunts AND uses a
    checkerboard-parity search while hunting blind (a real advanced-player
    technique - every ship of length 2+ must occupy a parity cell, so it
    cuts the CPU's average shots-to-find substantially). Personal best
    tracks fewest shots to win.

    Usage:
        <Battleships OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="bs-game">

    @if (phase == Phase.Setup)
    {
        <div class="bs-setup game-setup-panel">
            <h2>🚢 Battleships</h2>
            <p>Place your fleet, then sink the enemy fleet before they sink yours!</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="bs-diff-name">@DifficultyName(diff)</span>
                            <span class="bs-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else if (phase == Phase.Placing)
    {
        <div class="game-hud">
            <span class="bs-title">Battleships</span>
            <span class="game-stat">🚢 Ship @(placingShipIndex + 1)/@playerShipLengths.Length (length @CurrentPlacingLength)</span>
            <button class="game-secondary-action" @onclick="RotateOrientation">🔄 @(placingHorizontal ? "Horizontal" : "Vertical")</button>
            <button class="game-secondary-action" @onclick="RandomizeRemaining">🎲 Randomize Rest</button>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <h3 class="bs-board-title">Place Your Fleet</h3>
        <div class="bs-grid bs-grid-placing" style="--bs-size:@gridSize;">
            @for (var r = 0; r < gridSize; r++)
            {
                for (var c = 0; c < gridSize; c++)
                {
                    var row = r; var col = c;
                    var cell = playerBoard[row, col];
                    <button class="bs-cell bs-place-cell @(cell.HasShip ? "ship" : "")" @onclick="() => PlaceShipManually(row, col)"></button>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="bs-message">@roundMessage</p>
        }
    }
    else
    {
        <div class="game-hud">
            <span class="bs-title">Battleships</span>
            <span class="game-stat">🎯 Shots @shotsFired</span>
            <span class="game-stat">@(turn == Turn.Player ? "Your turn" : "CPU's turn")</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <h3 class="bs-board-title">Enemy Waters</h3>
        <div class="bs-grid" style="--bs-size:@gridSize;">
            @for (var r = 0; r < gridSize; r++)
            {
                for (var c = 0; c < gridSize; c++)
                {
                    var row = r; var col = c;
                    var cell = enemyBoard[row, col];
                    <button class="bs-cell @(cell.Shot ? (cell.HasShip ? "hit" : "miss") : "")"
                            disabled="@(cell.Shot || turn != Turn.Player || phase != Phase.Playing)"
                            @onclick="() => FireAt(row, col)">
                        @(cell.Shot ? (cell.HasShip ? "🔥" : "💧") : "")
                    </button>
                }
            }
        </div>

        <h3 class="bs-board-title">Your Fleet</h3>
        <div class="bs-grid bs-grid-own" style="--bs-size:@gridSize;">
            @for (var r = 0; r < gridSize; r++)
            {
                for (var c = 0; c < gridSize; c++)
                {
                    var cell = playerBoard[r, c];
                    <span class="bs-cell bs-own-cell @(cell.HasShip ? "ship" : "") @(cell.Shot ? (cell.HasShip ? "hit" : "miss") : "")">
                        @(cell.Shot ? (cell.HasShip ? "🔥" : "💧") : "")
                    </span>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="bs-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>@(won ? "🎉 Victory!" : "💥 Fleet Lost")</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ")@(won ? $"you sank the enemy fleet in {shotsFired} shots!" : "the enemy sank your fleet - try again!")</p>
                    <PersonalBestBadge Value="@(bestShots is { } bs ? $"{bs} shots" : null)" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<BattleshipsResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fewest shots to win) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Placing, Playing, Finished }
    private enum Turn { Player, Cpu }
    public enum Difficulty { Easy, Medium, Hard }

    private class Cell
    {
        public bool HasShip;
        public bool Shot;
        public int ShipIndex = -1;
    }

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int GridSizeFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 8,
        Difficulty.Medium => 9,
        _ => 10,
    };

    private static int[] ShipsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => new[] { 2, 3, 3 },
        Difficulty.Medium => new[] { 2, 3, 3, 4 },
        _ => new[] { 2, 3, 3, 4, 5 },
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private Turn turn = Turn.Player;
    private int gridSize = 8;
    private Cell[,] playerBoard = new Cell[0, 0];
    private Cell[,] enemyBoard = new Cell[0, 0];
    private int[] playerShipLengths = Array.Empty<int>();
    private int[] enemyShipLengths = Array.Empty<int>();
    private int[] playerHitsPerShip = Array.Empty<int>();
    private int[] enemyHitsPerShip = Array.Empty<int>();
    private int shotsFired;
    private bool won;
    private string roundMessage = "";
    private int? bestShots;
    private bool isNewBest;
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    // Manual fleet-placement state (player only - the CPU never sees the
    // board, so its fleet is still placed randomly).
    private int placingShipIndex;
    private bool placingHorizontal = true;
    private int CurrentPlacingLength => placingShipIndex < playerShipLengths.Length ? playerShipLengths[placingShipIndex] : 0;

    // CPU targeting state.
    private readonly List<(int Row, int Col)> cpuHuntQueue = new();
    private readonly HashSet<(int Row, int Col)> cpuTried = new();

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        gridSize = GridSizeFor(selectedDifficulty);
        var ships = ShipsFor(selectedDifficulty);

        playerBoard = BuildEmptyBoard();
        playerShipLengths = ships;
        (enemyBoard, enemyShipLengths) = BuildFleet(ships);
        playerHitsPerShip = new int[playerShipLengths.Length];
        enemyHitsPerShip = new int[enemyShipLengths.Length];

        shotsFired = 0;
        won = false;
        roundMessage = "";
        turn = Turn.Player;
        bestShots = null;
        isNewBest = false;
        cpuHuntQueue.Clear();
        cpuTried.Clear();
        placingShipIndex = 0;
        placingHorizontal = true;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Placing;
    }

    private Cell[,] BuildEmptyBoard()
    {
        var board = new Cell[gridSize, gridSize];
        for (var r = 0; r < gridSize; r++)
            for (var c = 0; c < gridSize; c++)
                board[r, c] = new Cell();
        return board;
    }

    private (Cell[,] Board, int[] Lengths) BuildFleet(int[] shipLengths)
    {
        var board = BuildEmptyBoard();
        for (var i = 0; i < shipLengths.Length; i++)
        {
            PlaceShip(board, shipLengths[i], i);
        }

        return (board, shipLengths);
    }

    private bool TryComputeShipCells(int row, int col, int length, bool horizontal, out List<(int Row, int Col)> cells)
    {
        cells = new List<(int Row, int Col)>();
        for (var i = 0; i < length; i++)
        {
            var r = horizontal ? row : row + i;
            var c = horizontal ? col + i : col;
            if (r < 0 || r >= gridSize || c < 0 || c >= gridSize) return false;
            cells.Add((r, c));
        }
        return !cells.Any(p => playerBoard[p.Row, p.Col].HasShip);
    }

    private void RotateOrientation()
    {
        if (phase != Phase.Placing) return;
        placingHorizontal = !placingHorizontal;
    }

    private void PlaceShipManually(int row, int col)
    {
        if (phase != Phase.Placing || placingShipIndex >= playerShipLengths.Length) return;

        var length = playerShipLengths[placingShipIndex];
        if (!TryComputeShipCells(row, col, length, placingHorizontal, out var cells))
        {
            roundMessage = "Can't place there - try another spot.";
            return;
        }

        foreach (var (r, c) in cells)
        {
            playerBoard[r, c].HasShip = true;
            playerBoard[r, c].ShipIndex = placingShipIndex;
        }

        placingShipIndex++;
        roundMessage = "";

        if (placingShipIndex >= playerShipLengths.Length)
        {
            phase = Phase.Playing;
        }
    }

    private void RandomizeRemaining()
    {
        if (phase != Phase.Placing) return;

        for (var i = placingShipIndex; i < playerShipLengths.Length; i++)
        {
            PlaceShip(playerBoard, playerShipLengths[i], i);
        }

        placingShipIndex = playerShipLengths.Length;
        roundMessage = "";
        phase = Phase.Playing;
    }

    private void PlaceShip(Cell[,] board, int length, int shipIndex)
    {
        for (var attempt = 0; attempt < 200; attempt++)
        {
            var horizontal = rng.Next(2) == 0;
            var maxRow = horizontal ? gridSize - 1 : gridSize - length;
            var maxCol = horizontal ? gridSize - length : gridSize - 1;
            if (maxRow < 0 || maxCol < 0) continue;

            var row = rng.Next(maxRow + 1);
            var col = rng.Next(maxCol + 1);

            var cells = new List<(int, int)>();
            for (var i = 0; i < length; i++)
            {
                cells.Add(horizontal ? (row, col + i) : (row + i, col));
            }

            if (cells.Any(pos => board[pos.Item1, pos.Item2].HasShip)) continue;

            foreach (var (r, c) in cells)
            {
                board[r, c].HasShip = true;
                board[r, c].ShipIndex = shipIndex;
            }
            return;
        }
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing.
    private async Task ExitToSetup()
    {
        if ((phase == Phase.Playing || phase == Phase.Placing) && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new BattleshipsResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: false,
                ShotsFired: shotsFired,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task FireAt(int row, int col)
    {
        if (phase != Phase.Playing || turn != Turn.Player) return;
        var cell = enemyBoard[row, col];
        if (cell.Shot) return;

        cell.Shot = true;
        shotsFired++;

        if (cell.HasShip)
        {
            enemyHitsPerShip[cell.ShipIndex]++;
            var sunk = enemyHitsPerShip[cell.ShipIndex] == enemyShipLengths[cell.ShipIndex];
            roundMessage = sunk ? "Direct hit - enemy ship sunk!" : "Direct hit!";
            await PlaySoundAsync("playExplosionSound");

            if (enemyHitsPerShip.SequenceEqual(enemyShipLengths))
            {
                won = true;
                await FinishGame();
                return;
            }
        }
        else
        {
            roundMessage = "Splash - miss!";
            await PlaySoundAsync("playSplashSound");
        }

        StateHasChanged();
        await Task.Delay(500);

        turn = Turn.Cpu;
        StateHasChanged();
        await Task.Delay(600);
        await CpuFire();
    }

    private async Task CpuFire()
    {
        var (row, col) = PickCpuTarget();
        cpuTried.Add((row, col));

        var cell = playerBoard[row, col];
        cell.Shot = true;

        if (cell.HasShip)
        {
            playerHitsPerShip[cell.ShipIndex]++;
            var sunk = playerHitsPerShip[cell.ShipIndex] == playerShipLengths[cell.ShipIndex];
            roundMessage = sunk ? "The enemy sank one of your ships!" : "The enemy hit your fleet!";
            await PlaySoundAsync("playExplosionSound");

            if (selectedDifficulty != Difficulty.Easy && !sunk)
            {
                foreach (var n in Neighbors(row, col))
                {
                    if (!cpuTried.Contains(n) && !cpuHuntQueue.Contains(n)) cpuHuntQueue.Add(n);
                }
            }
            else if (sunk)
            {
                cpuHuntQueue.Clear();
            }

            if (playerHitsPerShip.SequenceEqual(playerShipLengths))
            {
                won = false;
                await FinishGame();
                return;
            }
        }
        else
        {
            roundMessage = "The enemy's shot missed!";
            await PlaySoundAsync("playSplashSound");
        }

        StateHasChanged();
        await Task.Delay(700);

        turn = Turn.Player;
        StateHasChanged();
    }

    private (int Row, int Col) PickCpuTarget()
    {
        while (cpuHuntQueue.Count > 0)
        {
            var next = cpuHuntQueue[0];
            cpuHuntQueue.RemoveAt(0);
            if (!cpuTried.Contains(next)) return next;
        }

        // Hard blind-searches only parity cells first - every ship of
        // length 2+ must occupy at least one, so this halves the average
        // search space before falling back to any remaining cell.
        if (selectedDifficulty == Difficulty.Hard)
        {
            var parityCandidates = AllCells().Where(p => !cpuTried.Contains(p) && (p.Row + p.Col) % 2 == 0).ToList();
            if (parityCandidates.Count > 0) return parityCandidates[rng.Next(parityCandidates.Count)];
        }

        var candidates = AllCells().Where(p => !cpuTried.Contains(p)).ToList();
        return candidates[rng.Next(candidates.Count)];
    }

    private IEnumerable<(int Row, int Col)> AllCells()
    {
        for (var r = 0; r < gridSize; r++)
            for (var c = 0; c < gridSize; c++)
                yield return (r, c);
    }

    private IEnumerable<(int Row, int Col)> Neighbors(int row, int col)
    {
        if (row > 0) yield return (row - 1, col);
        if (row < gridSize - 1) yield return (row + 1, col);
        if (col > 0) yield return (row, col - 1);
        if (col < gridSize - 1) yield return (row, col + 1);
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "fewest-shots";
            bestShots = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.Battleships, key);
            if (won)
            {
                isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.Battleships, key, shotsFired, lowerIsBetter: true);
            }
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new BattleshipsResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: won,
                ShotsFired: shotsFired,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "8x8, 3 ships, CPU fires randomly",
        Difficulty.Medium => "9x9, 4 ships, CPU hunts after a hit",
        _ => "10x10, 5 ships, CPU hunts + smart search",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record BattleshipsResult(string Difficulty, bool Won, int ShotsFired, int ElapsedSeconds);
}
