@page "/play/{GameId}"
@inject AppDataService Data
@inject AppState State
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="screen game-host-screen">
    @if (_game is null)
    {
        <p class="muted">Loading game…</p>
    }
    else
    {
        <div class="game-host-bar">
            <button class="btn-secondary" @onclick="GoBack">← Exit game</button>
            <span class="game-host-title">@_game.Title</span>
        </div>

        <div class="game-host-surface">
            @if (_game.LaunchMode == GameLaunchMode.ExternalIframe)
            {
                <iframe title="@_game.Title" src="@_game.LaunchTarget"></iframe>
            }
            else if (_game.LaunchTarget == BuiltInGames.MemoryMatch)
            {
                <MemoryMatchGame PlayerName="@State.CurrentProfile?.Name" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleMemoryMatchComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Fishing)
            {
                <FishingGame PlayerName="@State.CurrentProfile?.Name" OnComplete="HandleFishingComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.DressUp)
            {
                <DressUpGame PlayerName="@State.CurrentProfile?.Name" OnComplete="HandleDressUpComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.MannersGarden)
            {
                <MannersGarden PlayerName="@State.CurrentProfile?.Name" ProfileId="@State.CurrentProfile?.Id" OnComplete="HandleMannersGardenComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.TankDuel)
            {
                <TankDuel PlayerName="@State.CurrentProfile?.Name" OnComplete="HandleTankDuelComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.Uno)
            {
                <UnoGame PlayerName="@State.CurrentProfile?.Name" OnComplete="HandleUnoComplete" />
            }
            else if (_game.LaunchTarget == BuiltInGames.SimonSays)
            {
                <SimonSays PlayerName="@State.CurrentProfile?.Name" ForcedDifficulty="@_difficultyOverride" OnComplete="HandleSimonSaysComplete" />
            }
            else
            {
                @* Internal-route games are expected to be their own routed
                   pages/components. This placeholder is where you'd wire in
                   a dynamic component lookup (e.g. by convention on
                   LaunchTarget) once a real game is plugged in. *@
                <div class="game-placeholder">
                    <p>🎮 "@_game.Title" would load here.</p>
                    <p class="muted">Wire this route (@_game.LaunchTarget) up to the actual game component.</p>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string GameId { get; set; } = "";

    private Game? _game;
    private DateTime? _sessionStartedAtUtc;
    private string? _difficultyOverride;

    protected override async Task OnInitializedAsync()
    {
        if (State.CurrentProfile is null)
        {
            Nav.NavigateTo("");
            return;
        }

        var allGames = await Data.GetAllGamesAsync();
        _game = allGames.FirstOrDefault(g => g.Id == GameId);

        if (_game is null)
        {
            Nav.NavigateTo("games");
            return;
        }

        _difficultyOverride = await Data.GetDifficultyOverrideAsync(State.CurrentProfile.Id, _game.Id);
        _sessionStartedAtUtc = DateTime.UtcNow;
    }

    private async Task HandleMemoryMatchComplete(MemoryMatchGame.MemoryMatchResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = result.Theme,
            Difficulty = result.Difficulty,
            Moves = result.Moves,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

    private async Task HandleFishingComplete(FishingGame.FishingResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = result.Mode,
            Difficulty = $"{result.TargetsCompleted} completed",
            Moves = result.Attempts,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

    private async Task HandleDressUpComplete(DressUpGame.DressUpResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = result.Character,
            Difficulty = $"{result.StickersPlaced} stickers",
            Moves = result.StickersPlaced,
            ElapsedSeconds = 0,
        });
    }

    private async Task HandleMannersGardenComplete(MannersGarden.MannersGardenResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = "Manners Garden",
            Difficulty = $"{result.GardenItemsEarned} garden items",
            Moves = result.ScenariosCompleted,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

    private async Task HandleTankDuelComplete(TankDuel.TankDuelResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = result.Won ? "Victory" : "Defeat",
            Difficulty = $"{result.ShotsFired} shots",
            Moves = result.ShotsFired,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

    private async Task HandleUnoComplete(UnoGame.UnoResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = result.Won ? "Victory" : "Defeat",
            Difficulty = $"{result.CardsRemaining} cards left",
            Moves = result.TurnsPlayed,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

    private async Task HandleSimonSaysComplete(SimonSays.SimonSaysResult result)
    {
        if (State.CurrentProfile is null || _game is null) return;

        await Data.AddPlayHistoryAsync(new PlayHistoryEntry
        {
            ProfileId = State.CurrentProfile.Id,
            GameId = _game.Id,
            Theme = "Simon Says",
            Difficulty = $"Round {result.RoundsReached}",
            Moves = result.RoundsReached,
            ElapsedSeconds = result.ElapsedSeconds,
        });
    }

    private void GoBack() => Nav.NavigateTo("games");

    // Built-in games log their own PlayHistoryEntry on completion (with
    // real gameplay stats). Iframe-hosted games have no completion signal
    // at all, so this is the only place their play time is ever recorded -
    // measured as wall-clock time the game was mounted, written on exit
    // (button, browser back, or navigating elsewhere) rather than only on
    // a "finish" that may never come.
    public async ValueTask DisposeAsync()
    {
        if (_game is { LaunchMode: GameLaunchMode.ExternalIframe } game
            && _sessionStartedAtUtc is { } startedAt
            && State.CurrentProfile is { } profile)
        {
            var elapsed = (int)(DateTime.UtcNow - startedAt).TotalSeconds;
            if (elapsed > 0)
            {
                await Data.AddPlayHistoryAsync(new PlayHistoryEntry
                {
                    ProfileId = profile.Id,
                    GameId = game.Id,
                    ElapsedSeconds = elapsed,
                });
            }
        }
    }
}
