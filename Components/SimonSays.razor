@*
    SimonSays.razor
    A classic Simon-style sequence memory game: four colored pads each
    play a distinct tone when lit. Watch the sequence, then repeat it by
    tapping the same pads in order. Every successful round appends one
    more step (and the playback speeds up slightly), so it gets harder
    the longer you last. A wrong tap replays the same round to try again
    - whether it also costs you depends on the chosen difficulty: Easy
    never ends the game, Medium allows 3 mistakes, Hard ends on the
    first one.

    Usage:
        <SimonSays OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="simon-game">

    @if (phase == Phase.Setup)
    {
        <div class="simon-setup">
            <h2>Simon Says</h2>
            <p>Watch the pattern light up, then tap the pads in the same order. Each round adds one more step!</p>

            <h3 class="simon-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="simon-difficulty-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="simon-difficulty-select">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="simon-diff-btn @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="simon-diff-name">@DifficultyName(diff)</span>
                            <span class="simon-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="simon-start-btn" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="simon-hud">
            <span class="simon-title">Simon Says</span>
            <span class="simon-round">Round @Math.Max(sequence.Count, 1)</span>
            <span class="simon-mistakes">@MistakesText()</span>
            <button class="simon-restart-btn" @onclick="() => phase = Phase.Setup">← Exit</button>
        </div>

        <div class="simon-status">@StatusText()</div>

        <div class="simon-pad-grid">
            @for (var i = 0; i < 4; i++)
            {
                var idx = i;
                <button class="simon-pad @PadColorClass(idx) @(litIndex == idx ? "lit" : "") @(pressedIndex == idx ? "pressed" : "")"
                        disabled="@(phase != Phase.Listening)"
                        @onclick="() => OnPadTap(idx)"
                        aria-label="@PadName(idx)"></button>
            }
        </div>

        @if (phase == Phase.RoundEnd)
        {
            <div class="simon-overlay">
                <div class="simon-win-panel">
                    <h2>Game Over</h2>
                    <p>You reached round @roundsReached!</p>
                    <div class="simon-win-actions">
                        <button class="simon-start-btn" @onclick="StartGame">Play Again</button>
                        <button class="simon-restart-btn" @onclick="() => phase = Phase.Setup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<SimonSaysResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Watching, Listening, RoundEnd }
    public enum Difficulty { Easy, Medium, Hard }

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Medium;
    private readonly List<int> sequence = new();
    private int playerStep;
    private int litIndex = -1;
    private int pressedIndex = -1;
    private int roundsReached;
    private int mistakesMade;
    private DateTime startedAtUtc;
    private readonly Random rng = new();
    private IJSObjectReference? _module;

    // Cancels a stale playback loop if the kid exits mid-sequence and
    // starts a fresh game before the old one finishes its delays.
    private CancellationTokenSource? playbackCts;

    private static readonly string[] PadNames = { "Green", "Red", "Yellow", "Blue" };

    // Easy never ends on a mistake; Medium tolerates 3 before the game
    // ends on the 3rd; Hard ends on the very first one.
    private static int MaxMistakes(Difficulty d) => d switch
    {
        Difficulty.Easy => int.MaxValue,
        Difficulty.Medium => 3,
        _ => 1,
    };

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        sequence.Clear();
        sequence.Add(rng.Next(4));
        roundsReached = 0;
        mistakesMade = 0;
        startedAtUtc = DateTime.UtcNow;
        _ = PlaybackAsync();
    }

    private async Task PlaybackAsync()
    {
        playbackCts?.Cancel();
        var cts = new CancellationTokenSource();
        playbackCts = cts;

        phase = Phase.Watching;
        playerStep = 0;
        StateHasChanged();
        await Task.Delay(500, CancellationToken.None);

        // Speeds up gently as the sequence grows, floored so it never
        // becomes unfairly fast for a young player.
        var stepDelay = Math.Max(280, 700 - sequence.Count * 20);

        foreach (var step in sequence)
        {
            if (cts.IsCancellationRequested) return;

            litIndex = step;
            StateHasChanged();
            await PlaySoundAsync("playSimonTone", step);
            await Task.Delay(stepDelay, CancellationToken.None);
            if (cts.IsCancellationRequested) return;

            litIndex = -1;
            StateHasChanged();
            await Task.Delay(Math.Max(120, stepDelay / 3), CancellationToken.None);
        }

        if (cts.IsCancellationRequested) return;

        phase = Phase.Listening;
        StateHasChanged();
    }

    private async Task OnPadTap(int index)
    {
        if (phase != Phase.Listening) return;

        pressedIndex = index;
        StateHasChanged();
        await PlaySoundAsync("playSimonTone", index);
        await Task.Delay(180);
        pressedIndex = -1;
        StateHasChanged();

        if (sequence[playerStep] != index)
        {
            mistakesMade++;
            StateHasChanged(); // reflect the new mistake count immediately, not only once retry playback starts
            if (mistakesMade >= MaxMistakes(selectedDifficulty))
            {
                await EndRoundAsync();
                return;
            }

            // Forgiven mistake (Easy, or Medium under its limit) - replay
            // the same round from the start rather than growing it, so
            // the kid gets another shot at the exact sequence they missed.
            await PlaySoundAsync("playSimonErrorSound", null);
            await Task.Delay(600);
            await PlaybackAsync();
            return;
        }

        playerStep++;
        if (playerStep == sequence.Count)
        {
            roundsReached = sequence.Count;
            await Task.Delay(500);
            sequence.Add(rng.Next(4));
            await PlaybackAsync();
        }
    }

    private async Task EndRoundAsync()
    {
        phase = Phase.RoundEnd;
        StateHasChanged();
        await PlaySoundAsync("playSimonErrorSound", null);

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new SimonSaysResult(
                RoundsReached: roundsReached,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private string StatusText() => phase switch
    {
        Phase.Watching => "Watch closely...",
        Phase.Listening => "Your turn!",
        Phase.RoundEnd => "Game over",
        _ => "",
    };

    private static string PadColorClass(int index) => index switch
    {
        0 => "simon-green",
        1 => "simon-red",
        2 => "simon-yellow",
        _ => "simon-blue",
    };

    private static string PadName(int index) => PadNames[index];

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "Practice - can't fail",
        Difficulty.Medium => "3 mistakes allowed",
        _ => "No mistakes allowed",
    };

    private string MistakesText() => selectedDifficulty switch
    {
        Difficulty.Easy => "Practice mode",
        Difficulty.Medium => $"Mistakes: {mistakesMade}/{MaxMistakes(Difficulty.Medium)}",
        _ => "No mistakes allowed",
    };

    private async Task PlaySoundAsync(string fn, int? arg)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
            if (arg is int i)
            {
                await _module.InvokeVoidAsync(fn, i);
            }
            else
            {
                await _module.InvokeVoidAsync(fn);
            }
        }
        catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
    }

    public async ValueTask DisposeAsync()
    {
        playbackCts?.Cancel();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record SimonSaysResult(int RoundsReached, int ElapsedSeconds);
}
