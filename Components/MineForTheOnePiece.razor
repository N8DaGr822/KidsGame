    // ---- Finish ----

    private async Task RecordBestAsync()
    {
        if (string.IsNullOrEmpty(ProfileId)) return;
        var key = $"deepest-{DifficultyName(selectedDifficulty).ToLowerInvariant()}";
        bestDepth = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.MineForTheOnePiece, key);
        isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.MineForTheOnePiece, key, deepestRow, lowerIsBetter: false);
    }

    private async Task FinishGame()
    {
        _loopCts?.Cancel();
        deepestRow = Math.Max(deepestRow, TotalDepthRows);
        phase = Phase.Finished;

        await RecordBestAsync();

        // The expedition is complete - nothing left to continue - and the
        // legendary paint job is earned.
        savedGame = null;
        if (!string.IsNullOrEmpty(ProfileId)) await Data.SetMineSaveAsync(ProfileId, null);
        UnlockPaint(RainbowPaint);
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new MineForTheOnePieceResult(
                Difficulty: DifficultyName(selectedDifficulty),
                DeepestDepth: deepestRow * 10,
                Gold: gold,
                FoundTreasure: true,
                ElapsedSeconds: elapsedSeconds));
        }
    }

    private string NameOrDefault() => string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ";

    private static string FormatTime(int totalSeconds)
    {
        var ts = TimeSpan.FromSeconds(totalSeconds);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
    }

