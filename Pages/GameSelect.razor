@page "/games"
@inject AppDataService Data
@inject AppState State
@inject NavigationManager Nav

<div class="screen games-screen" style="--profile-color:@(State.CurrentProfile?.ColorHex ?? "#4ECDC4")">
    @if (State.CurrentProfile is null)
    {
        <p class="muted">Redirecting…</p>
    }
    else
    {
        <div class="games-header">
            <div class="profile-chip">
                <AssetGlyph Class="profile-chip-avatar" Src="@State.CurrentProfile.AvatarImagePath" Fallback="@State.CurrentProfile.AvatarEmoji" Alt="@State.CurrentProfile.Name" />
                <span>@State.CurrentProfile.Name</span>
            </div>
            <a class="link-switch-profile" href="">Switch profile</a>
        </div>

        <h1>Pick a game</h1>

        @if (_games is null)
        {
            <p class="muted">Loading games…</p>
        }
        else if (_games.Count == 0)
        {
            <p class="muted">No games have been added for this profile yet. Ask a parent to add some in the admin panel.</p>
        }
        else
        {
            @if (_recentGames.Count > 0)
            {
                <section class="game-picker-section" aria-labelledby="recent-games-title">
                    <div class="section-heading-row">
                        <h2 id="recent-games-title">Recently played</h2>
                    </div>

                    <Carousel>
                        @foreach (var game in _recentGames)
                        {
                            <GameCard Game="game" OnSelect="PlayAsync" />
                        }
                    </Carousel>
                </section>
            }

            <section class="game-picker-section" aria-labelledby="all-games-title">
                <div class="section-heading-row">
                    <h2 id="all-games-title">All games</h2>
                    <span class="section-count">@_games.Count games</span>
                </div>

                <div class="game-grid">
                    @foreach (var game in _games)
                    {
                        <GameCard Game="game" OnSelect="PlayAsync" />
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private List<Game>? _games;
    private List<Game> _recentGames = new();

    protected override async Task OnInitializedAsync()
    {
        if (State.CurrentProfile is null)
        {
            Nav.NavigateTo("");
            return;
        }

        _games = await Data.GetGamesForProfileAsync(State.CurrentProfile.Id);
        var gameById = _games.ToDictionary(game => game.Id);
        var recentGameIds = (await Data.GetPlayHistoryAsync(State.CurrentProfile.Id))
            .OrderByDescending(history => history.PlayedAtUtc)
            .Select(history => history.GameId)
            .Distinct()
            .Take(4);

        _recentGames = recentGameIds
            .Where(gameById.ContainsKey)
            .Select(gameId => gameById[gameId])
            .ToList();
    }

    private void PlayAsync(Game game) => Nav.NavigateTo($"play/{game.Id}");
}
