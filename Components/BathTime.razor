@*
    BathTime.razor
    A toddler cause-and-effect toy (~1 year old target): a bathtub scene
    with floating bubbles to pop, a rubber duck to squeak, and a cup to pour
    water from. Every tap is valid, no "correct" order, no score, no timer,
    no fail state.

    There's no natural "round" here, so the in-scene "All done" button is
    what logs the play session - it fires OnComplete with how many taps
    happened and how long the child played, then returns to the setup
    screen.

    Usage:
        <BathTime OnComplete="HandleGameComplete" />
*@
@inject InteropService Interop

<div class="bth-game">

    @if (phase == Phase.Setup)
    {
        <div class="bth-setup game-setup-panel">
            <h2>🛁 Bath Time</h2>
            <p>Pop the bubbles, squeak the duck, and pour water from the cup!</p>
            <button class="bth-start-btn game-primary-action" @onclick="StartGame">Start</button>
        </div>
    }
    else
    {
        <div class="bth-hud game-hud">
            <span class="bth-title">Bath Time</span>
            <button class="bth-restart-btn game-secondary-action" @onclick="FinishSession">All done</button>
        </div>

        <div class="bth-scene">
            <button class="bth-cup @(pouring ? "pouring" : "")" @onclick="PourCup">🥤</button>
            @if (pouring)
            {
                <div class="bth-stream"></div>
            }

            <button class="bth-duck @(squeaking ? "squeak" : "")" @onclick="SqueakDuck">🦆</button>

            <div class="bth-tub">
                @for (var i = 0; i < bubbles.Length; i++)
                {
                    var idx = i;
                    <button class="bth-bubble" style="left:@(bubbles[idx].X)%; bottom:@(bubbles[idx].Y)%; animation-duration:@(bubbles[idx].Bob)s;" @onclick="() => PopBubble(idx)">🫧</button>
                }
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<BathTimeResult> OnComplete { get; set; }

    private enum Phase { Setup, Playing }

    private record Bubble(double X, double Y, double Bob);

    private const int BubbleCount = 7;

    private Phase phase = Phase.Setup;
    private readonly Random rng = new();
    private Bubble[] bubbles = Array.Empty<Bubble>();
    private bool squeaking;
    private bool pouring;
    private int taps;
    private DateTime startedAtUtc;

    private void StartGame()
    {
        bubbles = Enumerable.Range(0, BubbleCount).Select(_ => RollBubble()).ToArray();
        squeaking = false;
        pouring = false;
        taps = 0;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
    }

    private Bubble RollBubble() => new(6 + rng.NextDouble() * 84, 4 + rng.NextDouble() * 55, 2.2 + rng.NextDouble() * 1.8);

    private async Task PopBubble(int index)
    {
        taps++;
        bubbles[index] = RollBubble();
        StateHasChanged();
        await Interop.InvokeVoidAsync("playCatchSound");
    }

    private async Task SqueakDuck()
    {
        taps++;
        squeaking = true;
        StateHasChanged();
        await Interop.InvokeVoidAsync("playMatchSound");

        await Task.Delay(400);
        squeaking = false;
        StateHasChanged();
    }

    private async Task PourCup()
    {
        taps++;
        pouring = true;
        StateHasChanged();
        await Interop.InvokeVoidAsync("playSplashSound");

        await Task.Delay(700);
        pouring = false;
        StateHasChanged();
    }

    private async Task FinishSession()
    {
        phase = Phase.Setup;

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new BathTimeResult(
                Taps: taps,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    public record BathTimeResult(int Taps, int ElapsedSeconds);
}
