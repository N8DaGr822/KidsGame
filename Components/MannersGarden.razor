    // ---- Clean-up lesson (drag toys into the basket) ----------------------

    private async Task StartDragToy(PointerEventArgs e, CleanUpToy toy)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        var areaRect = await _module.InvokeAsync<StageRect>("getBoundingRect", cleanupAreaRef);
        areaLeft = areaRect.Left;
        areaTop = areaRect.Top;
        areaWidth = areaRect.Width;
        areaHeight = areaRect.Height;

        var binRect = await _module.InvokeAsync<StageRect>("getBoundingRect", binRef);
        binLeft = binRect.Left;
        binTop = binRect.Top;
        binWidth = binRect.Width;
        binHeight = binRect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", cleanupAreaRef, e.PointerId);

        draggingToy = toy;
        SetToyPosition(e.ClientX, e.ClientY);
    }

    private void OnCleanupPointerMove(PointerEventArgs e)
    {
        if (draggingToy is null) return;
        SetToyPosition(e.ClientX, e.ClientY);
    }

    private async Task OnCleanupPointerUp(PointerEventArgs e)
    {
        if (draggingToy is null) return;

        var toy = draggingToy;
        draggingToy = null;

        var overBin = binWidth > 0 && binHeight > 0 &&
            e.ClientX >= binLeft && e.ClientX <= binLeft + binWidth &&
            e.ClientY >= binTop && e.ClientY <= binTop + binHeight;

        if (overBin)
        {
            round.Toys.Remove(toy);
            StateHasChanged();

            if (round.Toys.Count == 0)
            {
                SetNarration("Great job cleaning up together!");
                StateHasChanged();
                await Task.Delay(1400);
                await CompleteRound();
                return;
            }
        }

        StateHasChanged();
    }

    private void SetToyPosition(double clientX, double clientY)
    {
        if (draggingToy is null || areaWidth <= 0 || areaHeight <= 0) return;

        draggingToy.X = Math.Clamp((clientX - areaLeft) / areaWidth * 100, 4, 96);
        draggingToy.Y = Math.Clamp((clientY - areaTop) / areaHeight * 100, 4, 96);
        StateHasChanged();
    }

    // ---- Achoo lesson (drag the elbow up to cover a sneeze) ---------------

    private ElementReference achooAreaRef;
    private ElementReference achooTargetRef;
    private double achooAreaLeft, achooAreaTop, achooAreaWidth, achooAreaHeight;
    private double achooTargetLeft, achooTargetTop, achooTargetWidth, achooTargetHeight;
    private bool draggingElbow;

    private async Task StartDragElbow(PointerEventArgs e)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        var areaRect = await _module.InvokeAsync<StageRect>("getBoundingRect", achooAreaRef);
        achooAreaLeft = areaRect.Left;
        achooAreaTop = areaRect.Top;
        achooAreaWidth = areaRect.Width;
        achooAreaHeight = areaRect.Height;

        var targetRect = await _module.InvokeAsync<StageRect>("getBoundingRect", achooTargetRef);
        achooTargetLeft = targetRect.Left;
        achooTargetTop = targetRect.Top;
        achooTargetWidth = targetRect.Width;
        achooTargetHeight = targetRect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", achooAreaRef, e.PointerId);

        draggingElbow = true;
        SetElbowPosition(e.ClientX, e.ClientY);
    }

    private void OnAchooPointerMove(PointerEventArgs e)
    {
        if (!draggingElbow) return;
        SetElbowPosition(e.ClientX, e.ClientY);
    }

    private async Task OnAchooPointerUp(PointerEventArgs e)
    {
        if (!draggingElbow) return;
        draggingElbow = false;

        var overTarget = achooTargetWidth > 0 && achooTargetHeight > 0 &&
            e.ClientX >= achooTargetLeft && e.ClientX <= achooTargetLeft + achooTargetWidth &&
            e.ClientY >= achooTargetTop && e.ClientY <= achooTargetTop + achooTargetHeight;

        if (overTarget)
        {
            round.ElbowPlaced = true;
            SetNarration($"Achoo! Great job covering with your elbow, {round.Actor.FirstName}!");
            StateHasChanged();
            await Task.Delay(1600);
            await CompleteRound();
        }
        else
        {
            // Not a failure - just snap back so they can try again.
            round.ElbowX = 78;
            round.ElbowY = 68;
            StateHasChanged();
        }
    }

    private void SetElbowPosition(double clientX, double clientY)
    {
        if (!draggingElbow || achooAreaWidth <= 0 || achooAreaHeight <= 0) return;

        round.ElbowX = Math.Clamp((clientX - achooAreaLeft) / achooAreaWidth * 100, 4, 96);
        round.ElbowY = Math.Clamp((clientY - achooAreaTop) / achooAreaHeight * 100, 4, 96);
        StateHasChanged();
    }

    private record StageRect(double Left, double Top, double Width, double Height);

    // ---- Narration (Web Speech API, degrades silently if unsupported) -----

    private void SetNarration(string text)
    {
        narratorText = text;
        if (!muted)
        {
            _ = SpeakAsync(text);
        }
    }

    private async Task SpeakAsync(string text)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("speak", text);
    }

    private async Task StopSpeakingAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("stopSpeaking");
    }

    private void ToggleMute()
    {
        muted = !muted;
        if (muted)
        {
            _ = StopSpeakingAsync();
        }
    }

    // ---- Timer -------------------------------------------------------------

    private void StartTimer()
    {
        StopTimer();
        timer = new System.Threading.Timer(_ =>
        {
            elapsedSeconds++;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    public async ValueTask DisposeAsync()
    {
        StopTimer();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopSpeaking");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

