@*
    DressUpGame.razor
    A sticker-based dress-up game. Pick a character, then the character
    fills the screen; a collapsible side drawer holds the sticker tray and
    drawing tools. Stickers are repeatable (drag the same one out as many
    times as you like) and can be dragged onto the trash zone to remove
    them. Free play - no win state - "Done!" just logs the session and
    shows a small celebration.

    Drag-and-drop is implemented with Pointer Events (not the HTML5
    drag-and-drop API) so the same code path works for mouse, touch, and
    pen - HTML5 DnD is unreliable on touch/tablet browsers, especially
    iOS Safari, which doesn't support it on touch targets at all.

    Usage:
        <DressUpGame OnComplete="HandleGameComplete" />

    Optional:
        <DressUpGame PlayerName="Riley" OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="dress-up-game">

    @if (selectedCharacter is null)
    {
        <div class="du-setup game-setup-panel">
            <div class="du-setup-header">
                <h2>Dress Up</h2>
                <button class="du-fullscreen-btn" @onclick="ToggleFullscreen">@(isFullscreen ? "⛶ Exit Full Screen" : "⛶ Full Screen")</button>
            </div>
            <p>Pick a character, then drag stickers onto them to build an outfit!</p>

            <h3 class="du-section-title game-section-title">Choose a character</h3>
            <div class="du-character-select game-option-grid">
                @foreach (var character in Characters)
                {
                    <button class="du-character-btn game-option-button" @onclick="() => ChooseCharacter(character)">
                        <img class="du-character-icon" src="@character.ImagePath" alt="@character.Name" />
                        <span class="du-character-name">@character.Name</span>
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="du-hud">
            <button class="du-restart-btn" @onclick="() => selectedCharacter = null">← Change Character</button>
            <span class="du-character-title">@selectedCharacter.Name</span>
            <button class="du-restart-btn" @onclick="ToggleFullscreen">@(isFullscreen ? "⛶ Exit Full Screen" : "⛶ Full Screen")</button>
            <button class="du-restart-btn" disabled="@(undoStack.Count == 0)" @onclick="UndoAsync">↩️ Undo</button>
            <button class="du-restart-btn" @onclick="ExportOutfitAsync">💾 Save Picture</button>
            <button class="du-restart-btn" @onclick="ResetOutfit">Reset Outfit</button>
        </div>

        <div class="du-play" @ref="playRef" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointercancel="OnPointerUp">
            <div class="du-stage @(DrawMode ? "draw-mode" : "") @(DrawMode && drawTool == DrawTool.Fill ? "fill-tool" : "")" @ref="stageRef" @onpointerdown="OnStagePointerDown">
                <img class="du-base" @ref="baseImageRef" src="@selectedCharacter.ImagePath" alt="@selectedCharacter.Name" />

                @foreach (var placed in placedStickers)
                {
                    <span @key="placed.Id" class="du-placed-sticker @(IsBehindCharacter(placed.StickerId) ? "behind" : "") @(dragging == placed ? "dragging" : "") @(dragging == placed && overTrash ? "over-trash" : "") @(selectedSticker == placed ? "selected" : "")"
                          style="left:@(placed.X.ToString(Inv))%; top:@(placed.Y.ToString(Inv))%; --du-scale:@(placed.Scale.ToString(Inv)); --du-rotate:@(placed.RotationDeg.ToString(Inv))deg;"
                          @onpointerdown="e => StartDragPlaced(e, placed)"
                          @onpointerdown:preventDefault>
                        @if (ImagePathFor(placed.StickerId) is { } placedImgPath)
                        {
                            <img class="du-placed-sticker-img" src="@placedImgPath" alt="" draggable="false" />
                            @if (placed.TintColor is { } tint)
                            {
                                <div class="du-placed-sticker-tint"
                                     style="mask-image:url('@placedImgPath');-webkit-mask-image:url('@placedImgPath');background-color:@tint;"></div>
                            }
                        }
                        else
                        {
                            @placed.Emoji
                        }

                        @if (selectedSticker == placed && !DrawMode)
                        {
                            <span class="du-resize-handle"
                                  @onpointerdown="e => StartResize(e, placed)"
                                  @onpointerdown:preventDefault
                                  @onpointerdown:stopPropagation>↔</span>
                            <span class="du-rotate-handle"
                                  @onpointerdown="e => StartRotate(e, placed)"
                                  @onpointerdown:preventDefault
                                  @onpointerdown:stopPropagation>↻</span>
                        }
                    </span>
                }

                <canvas class="du-draw-canvas" @ref="canvasRef"></canvas>

                <div class="du-trash-zone @(dragging is not null || (drawerOpen && activeTab == DrawerTab.Stickers) ? "visible" : "") @(overTrash ? "active" : "")" @ref="trashRef">🗑️</div>
            </div>

            <button class="du-drawer-toggle" @onclick="() => drawerOpen = !drawerOpen" aria-label="@(drawerOpen ? "Close stickers and drawing tools" : "Open stickers and drawing tools")">
                @(drawerOpen ? "✕" : "🎒")
            </button>

            <div class="du-drawer @(drawerOpen ? "open" : "")">
                <div class="du-drawer-tabs">
                    <button class="du-drawer-tab @(activeTab == DrawerTab.Stickers ? "active" : "")" @onclick="() => activeTab = DrawerTab.Stickers">
                        🎒 Stickers
                    </button>
                    <button class="du-drawer-tab @(activeTab == DrawerTab.Draw ? "active" : "")" @onclick="() => activeTab = DrawerTab.Draw">
                        🖍️ Draw
                    </button>
                </div>

                @if (activeTab == DrawerTab.Draw)
                {
                    <div class="du-draw-tools">
                        <div class="du-tool-row">
                            <button class="du-tool-btn @(drawTool == DrawTool.Brush ? "selected" : "")" @onclick="() => drawTool = DrawTool.Brush">
                                🖌️ Brush
                            </button>
                            <button class="du-tool-btn @(drawTool == DrawTool.Fill ? "selected" : "")" @onclick="() => drawTool = DrawTool.Fill">
                                🪣 Fill
                            </button>
                        </div>

                        <p class="du-drawer-hint">
                            @(drawTool == DrawTool.Fill ? "Tap a sticker to recolor it, or tap inside a drawn shape to fill it." : "Draw with your finger - switch to Fill to color in a closed shape.")
                        </p>

                        <div class="du-color-row">
                            @foreach (var color in DrawColors)
                            {
                                <button class="du-color-swatch @(drawColor == color ? "selected" : "")"
                                        style="background:@color"
                                        @onclick="() => drawColor = color"
                                        aria-label="Draw color @color"></button>
                            }
                        </div>

                        @if (drawTool == DrawTool.Brush)
                        {
                            <div class="du-brush-row">
                                @foreach (var size in BrushSizes)
                                {
                                    <button class="du-brush-btn @(brushSize == size ? "selected" : "")" @onclick="() => brushSize = size" aria-label="Brush size @size">
                                        <span class="du-brush-dot" style="width:@(size)px; height:@(size)px;"></span>
                                    </button>
                                }
                            </div>
                        }

                        <button class="du-restart-btn" @onclick="ClearDrawing">Clear Drawing</button>
                    </div>
                }
                else
                {
                    <p class="du-drawer-hint">Drag a sticker onto the character - grab it as many times as you like. Tap a placed sticker to resize or rotate it.</p>
                    <div class="du-tray">
                        @foreach (var sticker in AllStickers)
                        {
                            <div @key="sticker.Id" class="du-tray-item"
                                 @onpointerdown="e => StartDragFromTray(e, sticker)"
                                 @onpointerdown:preventDefault>
                                @if (sticker.ImagePath is not null)
                                {
                                    <img class="du-tray-img" src="@sticker.ImagePath" alt="" draggable="false" />
                                }
                                else
                                {
                                    <span class="du-tray-emoji">@sticker.Emoji</span>
                                }
                                <span class="du-tray-label">@sticker.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <button class="du-done-btn" @onclick="FinishDressUp">Done! 🎉</button>
        </div>

        @if (celebrate)
        {
            <div class="du-win-overlay game-result-overlay">
                <div class="du-win-panel game-result-panel">
                    <h2>🎉 All dressed up!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great styling" : PlayerName + ", great styling") on your @selectedCharacter.Name!</p>
                    <div class="du-win-actions game-result-actions">
                        <button class="du-start-btn game-primary-action" @onclick="() => { celebrate = false; selectedCharacter = null; }">Dress Another</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

