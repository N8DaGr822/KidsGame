@*
    TimeTrialRacer.razor
    Solo version of Top-Down Racing: drive the same track alone, against
    the clock rather than opponents. Reuses Services/RaceTrack.cs (track
    layout, car roster, movement physics) directly, extracted from
    Components/RacingGame.razor once this became a second consumer of the
    exact same track/car system. No CPU opponents and no win/lose - the
    run ends the instant you complete the target lap count, and the
    result is always just "how fast." Difficulty controls lap count
    (2/3/4) rather than opponent strength, since there's no opponent to
    scale - more laps demands more sustained focus and more chances for
    an off-track mistake to cost you time. Personal best tracks fastest
    total time, per difficulty.

    Usage:
        <TimeTrialRacer OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using System.Numerics
@using KidsGameLauncher.Services

<div class="tt-game">

    @if (phase == Phase.Setup)
    {
        <div class="tt-setup game-setup-panel">
            <h2>⏱️ Time Trial Racer</h2>
            <p>Drag anywhere to drive - your car steers and speeds toward your finger. Stay on the road for full speed, and finish your laps as fast as you can!</p>

            <h3 class="game-section-title">Choose your car</h3>
            <div class="tt-car-select game-option-grid">
                @foreach (var car in RaceTrack.CarRoster)
                {
                    <button class="tt-car-btn game-option-button @(car.Slug == selectedCarSlug ? "selected" : "")" @onclick="() => selectedCarSlug = car.Slug">
                        <img class="tt-car-swatch" src="images/racing/car-@(car.Slug).png" alt="" />
                        <span class="tt-car-name">@car.Name</span>
                    </button>
                }
            </div>

            <h3 class="game-section-title">Choose a track</h3>
            <div class="tt-track-select game-option-grid">
                @foreach (var track in RaceTrack.Tracks)
                {
                    <button class="game-option-button @(track.Id == selectedTrack.Id ? "selected" : "")" @onclick="() => selectedTrack = track">
                        <span class="tt-diff-name">@track.Name</span>
                        <span class="tt-diff-detail">@track.Description</span>
                    </button>
                }
            </div>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="tt-diff-name">@DifficultyName(diff)</span>
                            <span class="tt-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="tt-title">Time Trial Racer</span>
            <span class="game-stat">🏁 Lap @Math.Min(car.LapsCompleted + 1, totalLaps)/@totalLaps</span>
            <span class="game-stat">⏱️ @FormatTime(liveElapsedSeconds)</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="tt-field" @ref="fieldRef" style="aspect-ratio:@(selectedTrack.GridCols)/@(selectedTrack.GridRows);"
             @onpointerdown="OnFieldPointerDown" @onpointermove="OnFieldPointerMove"
             @onpointerup="OnFieldPointerUp" @onpointercancel="OnFieldPointerUp">

            @foreach (var tile in selectedTrack.Tiles)
            {
                <img class="tt-tile" src="images/racing/@RaceTrack.TileImageFile(tile.Kind)"
                     style="left:@((RaceTrack.TileCenterX(tile) * 100f / selectedTrack.FieldWidth).ToString(Inv))%; top:@((RaceTrack.TileCenterY(tile) * 100f / selectedTrack.FieldHeight).ToString(Inv))%; transform:translate(-50%,-50%) rotate(@(tile.RotationDeg.ToString(Inv))deg);" />
            }

            <img class="tt-finish" src="images/racing/finish-strip.png"
                 style="left:@((selectedTrack.Waypoints[1].X * 100f / selectedTrack.FieldWidth).ToString(Inv))%; top:@((selectedTrack.Waypoints[1].Y * 100f / selectedTrack.FieldHeight).ToString(Inv))%;" />

            <img class="tt-decor tt-grandstand" src="images/racing/grandstand.png" style="left:50%; top:@(selectedTrack.Id == "thunder-oval" ? "50%" : "30%");" />
            @if (selectedTrack.Id != "switchback")
            {
                <img class="tt-decor tt-tire" src="images/racing/tire-stack.png" style="left:27.5%; top:18.3%;" />
                <img class="tt-decor tt-tire" src="images/racing/tire-stack.png" style="left:72.5%; top:18.3%;" />
                <img class="tt-decor tt-tire" src="images/racing/tire-stack.png" style="left:27.5%; top:81.7%;" />
                <img class="tt-decor tt-tire" src="images/racing/tire-stack.png" style="left:72.5%; top:81.7%;" />
            }

            <img class="tt-car" src="images/racing/car-@(car.CarSlug).png"
                 style="left:@((car.Body.Position.X * 100f / selectedTrack.FieldWidth).ToString(Inv))%; top:@((car.Body.Position.Y * 100f / selectedTrack.FieldHeight).ToString(Inv))%; transform:translate(-50%,-50%) rotate(@(RaceTrack.CssAngle(car.FacingDeg).ToString(Inv))deg);" />

            @if (ShowCountdown || ShowGo)
            {
                <div class="tt-countdown">@(ShowGo ? "GO!" : CountdownNumber())</div>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>⏱️ Finished!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ")@totalLaps laps in @FormatTime(finalElapsedSeconds)!</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Time</span><span class="game-stat-value">@FormatTime(finalElapsedSeconds)</span></div>
                    </div>
                    <PersonalBestBadge Value="@(bestTimeSeconds is { } bt ? FormatTime(bt) : null)" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<TimeTrialRacerResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fastest total time, per difficulty) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    private enum Difficulty { Easy, Medium, Hard }

    private const float PlayerMaxSpeed = 95f;
    private const float FixedDt = 1f / 120f;
    private const int MaxSubstepsPerFrame = 8;
    private const int FrameDelayMs = 16;
    private const int CountdownMs = 3000;
    private const int GoDisplayMs = 700;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static int LapsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 2,
        Difficulty.Medium => 3,
        _ => 4,
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private string selectedCarSlug = RaceTrack.CarRoster[0].Slug;
    private RaceTrack.TrackDef selectedTrack = RaceTrack.Tracks[0];
    private int totalLaps = 3;

    private RaceTrack.RacerState car = new() { IsPlayer = true };

    private int liveElapsedSeconds;
    private int finalElapsedSeconds;
    private int? bestTimeSeconds;
    private bool isNewBest;
    private DateTime startedAtUtc;
    private DateTime raceStartUtc;
    private IJSObjectReference? _module;

    private ElementReference fieldRef;
    private double fieldLeft, fieldTop, fieldWidth, fieldHeight;
    private long? activeFieldPointerId;
    private Vector2? pointerTarget;

    private CancellationTokenSource? _loopCts;
    private float accumulator;

    private bool ShowCountdown => DateTime.UtcNow < raceStartUtc;
    private bool ShowGo => !ShowCountdown && DateTime.UtcNow < raceStartUtc.AddMilliseconds(GoDisplayMs);

    private string CountdownNumber()
    {
        var remainingMs = (raceStartUtc - DateTime.UtcNow).TotalMilliseconds;
        if (remainingMs > 2000) return "3";
        if (remainingMs > 1000) return "2";
        return "1";
    }

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        totalLaps = LapsFor(selectedDifficulty);
        var startTile = selectedTrack.Tiles[0];
        car = new RaceTrack.RacerState
        {
            IsPlayer = true,
            CarSlug = selectedCarSlug,
            MaxSpeed = PlayerMaxSpeed,
            FacingDeg = RaceTrack.StartFacingDeg(selectedTrack),
            Body = new PhysicsBody { Radius = RaceTrack.CarRadius, Position = new Vector2(RaceTrack.TileCenterX(startTile), RaceTrack.TileCenterY(startTile)) },
        };

        pointerTarget = null;
        liveElapsedSeconds = 0;
        finalElapsedSeconds = 0;
        bestTimeSeconds = null;
        isNewBest = false;
        raceStartUtc = DateTime.UtcNow.AddMilliseconds(CountdownMs);
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;

        _loopCts?.Cancel();
        _loopCts = new CancellationTokenSource();
        _ = RunLoopAsync(_loopCts.Token);
    }

    private async Task ExitToSetup()
    {
        _loopCts?.Cancel();
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new TimeTrialRacerResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Finished: false,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task RunLoopAsync(CancellationToken ct)
    {
        var lastTick = DateTime.UtcNow;

        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(FrameDelayMs, ct);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            try
            {
                var now = DateTime.UtcNow;
                var elapsed = (float)(now - lastTick).TotalSeconds;
                lastTick = now;

                accumulator += elapsed;
                var substeps = 0;
                while (accumulator >= FixedDt && substeps < MaxSubstepsPerFrame && phase == Phase.Playing)
                {
                    StepPhysics(FixedDt);
                    accumulator -= FixedDt;
                    substeps++;
                }
                if (substeps >= MaxSubstepsPerFrame) accumulator = 0f;

                if (phase == Phase.Playing && DateTime.UtcNow >= raceStartUtc)
                {
                    liveElapsedSeconds = (int)(now - raceStartUtc).TotalSeconds;
                }

                StateHasChanged();

                if (phase != Phase.Playing) return;
            }
            catch (Exception) when (!ct.IsCancellationRequested)
            {
                accumulator = 0f;
            }
        }
    }

    private void StepPhysics(float dt)
    {
        if (DateTime.UtcNow < raceStartUtc) return;

        RaceTrack.UpdateRacer(selectedTrack, car, pointerTarget, dt);

        if (car.LapsCompleted >= totalLaps)
        {
            phase = Phase.Finished;
            _ = FinishRunAsync();
        }
    }

    private async Task OnFieldPointerDown(PointerEventArgs e)
    {
        if (phase != Phase.Playing) return;

        activeFieldPointerId = e.PointerId;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<FieldRect>("getBoundingRect", fieldRef);
        fieldLeft = rect.Left;
        fieldTop = rect.Top;
        fieldWidth = rect.Width;
        fieldHeight = rect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", fieldRef, e.PointerId);

        if (activeFieldPointerId != e.PointerId) return;
        UpdatePointerTarget(e.ClientX, e.ClientY);
    }

    private void OnFieldPointerMove(PointerEventArgs e)
    {
        if (activeFieldPointerId != e.PointerId) return;
        UpdatePointerTarget(e.ClientX, e.ClientY);
    }

    private void OnFieldPointerUp(PointerEventArgs e)
    {
        if (activeFieldPointerId != e.PointerId) return;
        activeFieldPointerId = null;
        pointerTarget = null;
    }

    private void UpdatePointerTarget(double clientX, double clientY)
    {
        if (fieldWidth <= 0 || fieldHeight <= 0) return;
        var xPct = (clientX - fieldLeft) / fieldWidth;
        var yPct = (clientY - fieldTop) / fieldHeight;
        pointerTarget = new Vector2((float)(xPct * selectedTrack.FieldWidth), (float)(yPct * selectedTrack.FieldHeight));
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishRunAsync()
    {
        _loopCts?.Cancel();
        finalElapsedSeconds = (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds;

        await PlaySoundAsync("playMatchSound");

        if (!string.IsNullOrEmpty(ProfileId))
        {
            var key = $"fastest-time-{DifficultyName(selectedDifficulty).ToLowerInvariant()}";
            bestTimeSeconds = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.TimeTrialRacer, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.TimeTrialRacer, key, finalElapsedSeconds, lowerIsBetter: true);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new TimeTrialRacerResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Finished: true,
                ElapsedSeconds: finalElapsedSeconds));
        }
    }

    private static string FormatTime(int totalSeconds)
    {
        var ts = TimeSpan.FromSeconds(totalSeconds);
        return ts.Minutes > 0 ? $"{ts.Minutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "2 laps",
        Difficulty.Medium => "3 laps",
        _ => "4 laps",
    };

    public async ValueTask DisposeAsync()
    {
        _loopCts?.Cancel();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    private record FieldRect(double Left, double Top, double Width, double Height);

    public record TimeTrialRacerResult(string Difficulty, bool Finished, int ElapsedSeconds);
}
