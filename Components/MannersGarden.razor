@*
    MannersGarden.razor
    A manners-practice game for ages 3-5. The player helps one of five
    animal friends (Benny Bear, Poppy Penguin, Milo Monkey, Lulu Lamb,
    Tilly Turtle) through a short social scenario - most often by tapping
    one of two big picture choices, no reading required, since every
    choice is spoken aloud (Web Speech API) and paired with a distinct
    emoji/icon. Choosing the unkind option never "loses" anything: it
    shows the other character's natural reaction, the narrator gently
    re-prompts, and the child tries again until they pick the kind
    response. Two lessons (Greeting, Achoo) are single-path positive
    actions with no "wrong" option at all, matching how those manners
    were originally spec'd. Every completed scenario adds a
    flower/butterfly/etc. to the session's Manners Garden.

    A session is 3 scenarios drawn at random from 9 lesson types (each
    with a few character/item variations so repeat sessions don't look
    identical), followed by a short garden celebration screen.

    Usage:
        <MannersGarden OnComplete="HandleGameComplete" />

    Optional:
        <MannersGarden PlayerName="Riley" OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data

<div class="mng-game">

    @if (phase == Phase.Setup)
    {
        <div class="mng-setup">
            <h2>🌷 Manners Garden</h2>
            <p>Help Benny, Poppy, Milo, Lulu, and Tilly practice kind manners - and grow a beautiful garden together!</p>

            <div class="mng-cast">
                @foreach (var member in Cast)
                {
                    <div class="mng-cast-member">
                        <AssetGlyph Class="mng-cast-emoji" Src="@member.ImagePath" Fallback="@member.Emoji" Alt="@member.FullName" />
                        <span>@member.FullName</span>
                    </div>
                }
            </div>

            <div class="mng-setup-actions">
                <button class="mng-start-btn" @onclick="() => StartSession(null)">▶️ Start Playing</button>
                @if (persistedGardenItems.Count > 0)
                {
                    <button class="mng-restart-btn" @onclick="() => showingGardenAtSetup = true">🌷 View My Garden</button>
                }
            </div>

            <h3 class="mng-section-title">Or practice just one skill</h3>
            <div class="mng-focus-select">
                @foreach (var lesson in AllLessons)
                {
                    <button class="mng-focus-btn" @onclick="() => StartSession(lesson)">@LessonDisplayName(lesson)</button>
                }
            </div>
        </div>

        @if (showingGardenAtSetup)
        {
            <div class="mng-garden-overlay">
                <div class="mng-garden-panel">
                    <h2>🌼 Your Manners Garden!</h2>
                    <p>Everything you've grown so far.</p>

                    <MannersGardenScene Items="persistedGardenItems" />

                    <div class="mng-garden-actions">
                        <button class="mng-restart-btn" @onclick="() => showingGardenAtSetup = false">Close</button>
                    </div>
                </div>
            </div>
        }
    }
    else if (phase == Phase.SessionComplete)
    {
        <div class="mng-garden-overlay">
            <div class="mng-garden-panel">
                <h2>🌼 Your Manners Garden!</h2>
                <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great job" : PlayerName + ", great job") practicing kind manners today!</p>

                <MannersGardenScene Items="persistedGardenItems" />

                <div class="mng-garden-actions">
                    <button class="mng-start-btn" @onclick="() => StartSession(null)">Play Again</button>
                    <button class="mng-restart-btn" @onclick="ExitToSetup">Change Game</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mng-hud">
            <button class="mng-mute-btn" @onclick="ToggleMute" aria-label="@(muted ? "Unmute narration" : "Mute narration")">@(muted ? "🔇" : "🔊")</button>
            <div class="mng-progress">
                @for (int i = 0; i < sessionLessons.Count; i++)
                {
                    var dotIndex = i;
                    <span class="mng-progress-dot @(dotIndex < roundIndex ? "done" : "") @(dotIndex == roundIndex ? "active" : "")">🌱</span>
                }
            </div>
            <button class="mng-garden-peek-btn" @onclick="ToggleGarden">@(showingGarden ? "▶️ Back to Play" : "🌷 View Garden")</button>
            <button class="mng-restart-btn" @onclick="ExitToSetup">Change Game</button>
        </div>

        @if (showingGarden)
        {
            <MannersGardenScene Items="persistedGardenItems" />
        }
        else
        {
        @if (gardenItems.Count > 0)
        {
            <div class="mng-garden-strip">
                @foreach (var item in gardenItems)
                {
                    <span class="mng-garden-chip">@item</span>
                }
            </div>
        }

        <div class="mng-stage">
            <div class="mng-speech-bubble">@narratorText</div>

            @if (round.Lesson == LessonType.CleanUp)
            {
                <div class="mng-cleanup-area" @ref="cleanupAreaRef" @onpointermove="OnCleanupPointerMove" @onpointerup="OnCleanupPointerUp" @onpointercancel="OnCleanupPointerUp">
                    @foreach (var toy in round.Toys)
                    {
                        <span @key="toy.Id" class="mng-cleanup-toy @(draggingToy == toy ? "dragging" : "")"
                              style="left:@(toy.X.ToString(Inv))%; top:@(toy.Y.ToString(Inv))%;"
                              @onpointerdown="e => StartDragToy(e, toy)"
                              @onpointerdown:preventDefault>
                            @toy.Emoji
                        </span>
                    }
                    <div class="mng-toy-bin" @ref="binRef">🧺</div>
                </div>
            }
            else if (round.Lesson == LessonType.Greeting)
            {
                <div class="mng-characters">
                    <div class="mng-character @(round.ReactorHappy ? "happy" : "")">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Reactor.ImagePath" Fallback="@round.Reactor.Emoji" Alt="@round.Reactor.FullName" />
                        <span class="mng-char-name">@round.Reactor.FullName</span>
                    </div>
                    <div class="mng-character @(round.WavedHello ? "happy" : "")">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Actor.ImagePath" Fallback="@round.Actor.Emoji" Alt="@round.Actor.FullName" />
                        <span class="mng-char-name">@round.Actor.FullName</span>
                    </div>
                </div>

                @if (!round.ShowingConsequence && phase == Phase.Playing)
                {
                    <div class="mng-single-choice">
                        <button class="mng-choice-btn polite" @onclick="WaveGreeting">
                            <span class="mng-choice-emoji">👋</span>
                            <span class="mng-choice-text">@(round.WavedHello ? "Wave Goodbye!" : "Wave Hello!")</span>
                        </button>
                    </div>
                }
            }
            else if (round.Lesson == LessonType.Achoo)
            {
                <div class="mng-achoo-area" @ref="achooAreaRef" @onpointermove="OnAchooPointerMove" @onpointerup="OnAchooPointerUp" @onpointercancel="OnAchooPointerUp">
                    <div class="mng-character mng-achoo-character">
                        @if (round.ElbowPlaced)
                        {
                            <span class="mng-char-emoji">🤧</span>
                        }
                        else
                        {
                            <AssetGlyph Class="mng-char-emoji" Src="@round.Actor.ImagePath" Fallback="@round.Actor.Emoji" Alt="@round.Actor.FullName" />
                        }
                        <span class="mng-char-name">@round.Actor.FullName</span>
                        <div class="mng-achoo-target" @ref="achooTargetRef"></div>
                    </div>

                    @if (!round.ElbowPlaced)
                    {
                        <span class="mng-elbow"
                              style="left:@(round.ElbowX.ToString(Inv))%; top:@(round.ElbowY.ToString(Inv))%;"
                              @onpointerdown="StartDragElbow"
                              @onpointerdown:preventDefault>
                            💪
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="mng-characters">
                    <div class="mng-character @(round.ReactorSad ? "sad" : "") @(round.ReactorHappy ? "happy" : "")">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Reactor.ImagePath" Fallback="@round.Reactor.Emoji" Alt="@round.Reactor.FullName" />
                        <span class="mng-char-name">@round.Reactor.FullName</span>
                        @if (round.ReactorSad)
                        {
                            <span class="mng-reaction">😢</span>
                        }
                        else if (round.ReactorHappy)
                        {
                            <span class="mng-reaction">💕</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(round.ItemEmoji))
                    {
                        <span class="mng-item">@round.ItemEmoji</span>
                    }

                    <div class="mng-character">
                        <AssetGlyph Class="mng-char-emoji" Src="@round.Actor.ImagePath" Fallback="@round.Actor.Emoji" Alt="@round.Actor.FullName" />
                        <span class="mng-char-name">@round.Actor.FullName</span>
                    </div>
                </div>

                @if (round.Lesson == LessonType.Sorry && round.HelpingRebuild)
                {
                    <p class="mng-helper-text">Tap the blocks to help rebuild!</p>
                    <div class="mng-blocks-rebuild">
                        @for (int i = 0; i < round.BlockTapped.Length; i++)
                        {
                            var idx = i;
                            <button class="mng-block @(round.BlockTapped[idx] ? "stacked" : "")" disabled="@round.BlockTapped[idx]" @onclick="() => TapBlock(idx)">🧱</button>
                        }
                    </div>
                }
                else if (!round.ShowingConsequence && phase == Phase.Playing)
                {
                    <div class="mng-choices">
                        <button class="mng-choice-btn polite" @onclick="() => ChooseOption(true)">
                            <span class="mng-choice-emoji">@PoliteEmoji(round.Lesson)</span>
                            <span class="mng-choice-text">@PoliteText(round)</span>
                        </button>
                        <button class="mng-choice-btn" @onclick="() => ChooseOption(false)">
                            <span class="mng-choice-emoji">@ImpoliteEmoji(round.Lesson)</span>
                            <span class="mng-choice-text">@ImpoliteText(round)</span>
                        </button>
                    </div>
                }
            }
        </div>
        }

        @if (phase == Phase.Reward && gardenItems.Count > 0)
        {
            <div class="mng-reward-toast">✨ @gardenItems[^1] added to your garden!</div>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    // ---- Public parameters -------------------------------------------------

    /// <summary>Optional display name, e.g. from the active kid profile.</summary>
    [Parameter] public string? PlayerName { get; set; }

    /// <summary>Active kid profile's Id - keys the persisted, all-time garden.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>Fired once when the 3-scenario session's garden celebration is shown.</summary>
    [Parameter] public EventCallback<MannersGardenResult> OnComplete { get; set; }

    // ---- Cast ----------------------------------------------------------------

    // ImagePath is null for Lulu and Tilly until matching art is added -
    // AssetGlyph falls back to Emoji automatically, so this is a
    // one-character-at-a-time migration like the rest of the app's art.
    public record CharacterDef(string FirstName, string FullName, string Emoji, string? ImagePath = null);

    private static readonly CharacterDef Benny = new("Benny", "Benny Bear", "🐻", "images/manners/benny-bear.png");
    private static readonly CharacterDef Poppy = new("Poppy", "Poppy Penguin", "🐧", "images/manners/poppy-penguin.png");
    private static readonly CharacterDef Milo = new("Milo", "Milo Monkey", "🐵", "images/manners/milo-monkey.png");
    private static readonly CharacterDef Lulu = new("Lulu", "Lulu Lamb", "🐑");
    private static readonly CharacterDef Tilly = new("Tilly", "Tilly Turtle", "🐢");

    private static readonly List<CharacterDef> Cast = new() { Benny, Poppy, Milo, Lulu, Tilly };

    // ---- Lessons ---------------------------------------------------------

    public enum LessonType { Please, ThankYou, Turns, Sorry, CleanUp, Greeting, Achoo, GentleHands, InsideVoice }

    private static readonly List<LessonType> AllLessons = Enum.GetValues<LessonType>().ToList();

    // Actor is whichever character's behavior the child chooses for;
    // Reactor is who emotionally responds to that choice.
    private record ItemVariation(CharacterDef Actor, CharacterDef Reactor, string ItemEmoji, string ItemLabel);

    private static readonly List<ItemVariation> PleaseVariations = new()
    {
        new(Milo, Poppy, "🍪", "crackers"),
        new(Benny, Milo, "🧃", "juice"),
        new(Poppy, Benny, "🖍️", "crayons"),
        new(Lulu, Tilly, "🥕", "carrots"),
        new(Tilly, Lulu, "🍇", "grapes"),
    };

    private static readonly List<ItemVariation> ThankYouVariations = new()
    {
        new(Milo, Poppy, "🌼", "flower"),
        new(Poppy, Benny, "🐚", "seashell"),
        new(Benny, Milo, "⭐", "sticker"),
        new(Lulu, Tilly, "🎈", "balloon"),
        new(Tilly, Lulu, "🍓", "berry"),
    };

    private static readonly List<ItemVariation> TurnsVariations = new()
    {
        new(Milo, Benny, "🚂", "toy train"),
        new(Benny, Poppy, "🧱", "blocks"),
        new(Poppy, Milo, "⚽", "ball"),
        new(Lulu, Tilly, "🪁", "kite"),
        new(Tilly, Benny, "🧩", "puzzle"),
    };

    private static readonly List<ItemVariation> SorryVariations = new()
    {
        new(Milo, Benny, "🧱", "block tower"),
        new(Poppy, Milo, "🧱", "block tower"),
        new(Benny, Poppy, "🧱", "block tower"),
        new(Lulu, Tilly, "🧱", "block tower"),
        new(Tilly, Lulu, "🧱", "block tower"),
    };

    private static readonly List<ItemVariation> GentleHandsVariations = new()
    {
        new(Milo, Lulu, "", ""),
        new(Benny, Tilly, "", ""),
        new(Poppy, Milo, "", ""),
        new(Lulu, Benny, "", ""),
    };

    private static readonly List<ItemVariation> InsideVoiceVariations = new()
    {
        new(Milo, Poppy, "", ""),
        new(Lulu, Tilly, "", ""),
        new(Benny, Milo, "", ""),
    };

    private static readonly List<ItemVariation> GreetingVariations = new()
    {
        new(Milo, Benny, "", ""),
        new(Lulu, Poppy, "", ""),
        new(Tilly, Milo, "", ""),
        new(Poppy, Lulu, "", ""),
    };

    private static readonly List<CharacterDef> AchooCharacters = new() { Benny, Poppy, Milo, Lulu, Tilly };

    private static readonly (string Emoji, string Label)[] ToyPool =
    {
        ("🧸", "teddy bear"), ("🧱", "blocks"), ("⚽", "ball"),
        ("📚", "book"), ("🚗", "car"), ("🖍️", "crayon"),
    };

    private static readonly string[] GardenRewardPool =
    {
        "🌸", "🌷", "🌻", "🌼", "🌹", "🦋", "🐦", "🍎", "🐞", "🌳", "✨", "🍓",
    };

    // ---- Round state -----------------------------------------------------

    public class CleanUpToy
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Emoji { get; set; } = "";
        public double X { get; set; }
        public double Y { get; set; }
    }

    private class RoundState
    {
        public LessonType Lesson;
        public CharacterDef Actor = null!;
        public CharacterDef Reactor = null!;
        public string ItemEmoji = "";
        public string ItemLabel = "";

        public bool ShowingConsequence;
        public bool ReactorSad;
        public bool ReactorHappy;
        public bool HelpingRebuild;
        public bool[] BlockTapped = new bool[3];

        public List<CleanUpToy> Toys = new();

        // Greeting
        public bool WavedHello;

        // Achoo
        public bool ElbowPlaced;
        public double ElbowX = 78;
        public double ElbowY = 68;
    }

    private enum Phase { Setup, Playing, Reward, SessionComplete }

    private Phase phase = Phase.Setup;
    private readonly Random rng = new();
    private RoundState round = new();
    private List<LessonType> sessionLessons = new();
    private int roundIndex;
    private readonly List<string> gardenItems = new();
    private string narratorText = "";
    private bool muted;
    private bool showingGarden;
    private bool showingGardenAtSetup;

    // The full, all-time garden (persisted via AppDataService) - separate
    // from the session-local gardenItems above, which only tracks what
    // was earned in the round currently being played (used for the
    // in-play "+item added!" toast and progress strip).
    private List<string> persistedGardenItems = new();

    private IJSObjectReference? _module;
    private int elapsedSeconds;
    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ProfileId))
        {
            persistedGardenItems = await Data.GetGardenItemsAsync(ProfileId);
        }
    }

    // ---- Drag state (clean-up toys) ---------------------------------------

    private ElementReference cleanupAreaRef;
    private ElementReference binRef;
    private double areaLeft, areaTop, areaWidth, areaHeight;
    private double binLeft, binTop, binWidth, binHeight;
    private CleanUpToy? draggingToy;

    // ---- Session flow ------------------------------------------------------

    private async Task StartSession(LessonType? focusLesson)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");

        sessionLessons = focusLesson is { } lesson
            ? Enumerable.Repeat(lesson, 3).ToList()
            : AllLessons.OrderBy(_ => rng.Next()).Take(3).ToList();
        roundIndex = 0;
        gardenItems.Clear();
        elapsedSeconds = 0;
        showingGarden = false;
        showingGardenAtSetup = false;

        BuildRound(sessionLessons[0]);
        phase = Phase.Playing;
        StartTimer();
        StateHasChanged();
    }

    private void ExitToSetup()
    {
        StopTimer();
        _ = StopSpeakingAsync();
        phase = Phase.Setup;
        showingGarden = false;
    }

    private void ToggleGarden() => showingGarden = !showingGarden;

    private void BuildRound(LessonType lesson)
    {
        round = new RoundState { Lesson = lesson };

        if (lesson == LessonType.CleanUp)
        {
            var chosen = ToyPool.OrderBy(_ => rng.Next()).Take(3).ToList();
            round.Toys = chosen.Select((t, idx) => new CleanUpToy
            {
                Emoji = t.Emoji,
                X = 18 + idx * 32 + rng.Next(-6, 6),
                Y = 28 + rng.Next(-8, 14),
            }).ToList();

            SetNarration("Playtime is over. Let's clean up together! Drag the toys into the basket.");
            return;
        }

        if (lesson == LessonType.Greeting)
        {
            var greeting = GreetingVariations[rng.Next(GreetingVariations.Count)];
            round.Actor = greeting.Actor;
            round.Reactor = greeting.Reactor;
            SetNarration($"{round.Actor.FirstName} just arrived! Let's say hello to {round.Reactor.FirstName}.");
            return;
        }

        if (lesson == LessonType.Achoo)
        {
            round.Actor = AchooCharacters[rng.Next(AchooCharacters.Count)];
            SetNarration($"{round.Actor.FirstName} feels a sneeze coming! Drag the elbow up to cover it.");
            return;
        }

        var pool = lesson switch
        {
            LessonType.Please => PleaseVariations,
            LessonType.ThankYou => ThankYouVariations,
            LessonType.Turns => TurnsVariations,
            LessonType.Sorry => SorryVariations,
            LessonType.GentleHands => GentleHandsVariations,
            LessonType.InsideVoice => InsideVoiceVariations,
            _ => throw new ArgumentOutOfRangeException(nameof(lesson)),
        };

        var variation = pool[rng.Next(pool.Count)];
        round.Actor = variation.Actor;
        round.Reactor = variation.Reactor;
        round.ItemEmoji = variation.ItemEmoji;
        round.ItemLabel = variation.ItemLabel;

        SetNarration(PromptLine(round));
    }

    private async Task CompleteRound()
    {
        var earned = GardenRewardPool[rng.Next(GardenRewardPool.Length)];
        gardenItems.Add(earned);
        persistedGardenItems.Add(earned);
        phase = Phase.Reward;
        StateHasChanged();

        if (!string.IsNullOrEmpty(ProfileId))
        {
            await Data.AddGardenItemAsync(ProfileId, earned);
        }

        await Task.Delay(1300);

        if (roundIndex + 1 >= sessionLessons.Count)
        {
            await FinishSession();
        }
        else
        {
            roundIndex++;
            BuildRound(sessionLessons[roundIndex]);
            phase = Phase.Playing;
            StateHasChanged();
        }
    }

    private async Task FinishSession()
    {
        StopTimer();
        phase = Phase.SessionComplete;
        SetNarration("Wow! Look at your beautiful garden! Great job practicing your manners today!");
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new MannersGardenResult(
                ScenariosCompleted: sessionLessons.Count,
                GardenItemsEarned: gardenItems.Count,
                ElapsedSeconds: elapsedSeconds));
        }
    }

    // ---- Tap-choice lessons (Please / Thank You / Turns / Sorry) ---------

    private async Task ChooseOption(bool polite)
    {
        if (round.ShowingConsequence) return;
        round.ShowingConsequence = true;

        if (polite)
        {
            round.ReactorHappy = true;

            switch (round.Lesson)
            {
                case LessonType.Please:
                    SetNarration("Please is a kind way to ask!");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;

                case LessonType.ThankYou:
                    SetNarration("Thank you shows someone you appreciate their kindness!");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;

                case LessonType.Turns:
                    SetNarration("Great asking!");
                    StateHasChanged();
                    await Task.Delay(1300);
                    SetNarration($"{round.Reactor.FirstName} finished up and shared. Waiting for a turn was worth it!");
                    StateHasChanged();
                    await Task.Delay(1700);
                    await CompleteRound();
                    break;

                case LessonType.Sorry:
                    SetNarration("Saying sorry and helping can make things better!");
                    round.ShowingConsequence = false;
                    round.HelpingRebuild = true;
                    StateHasChanged();
                    break;

                case LessonType.GentleHands:
                    SetNarration("Gentle hands feel nice and keep friends safe!");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;

                case LessonType.InsideVoice:
                    SetNarration($"Great job using your inside voice! {round.Reactor.FirstName} could listen easily.");
                    StateHasChanged();
                    await Task.Delay(1600);
                    await CompleteRound();
                    break;
            }
        }
        else
        {
            round.ReactorSad = true;
            SetNarration(GentleRetryLine(round));
            StateHasChanged();
            await Task.Delay(2200);

            // Never a dead end - reset back to the same scenario so the
            // child can pick again, rather than failing the round.
            round.ReactorSad = false;
            round.ShowingConsequence = false;
            SetNarration(PromptLine(round));
            StateHasChanged();
        }
    }

    private async Task TapBlock(int idx)
    {
        if (round.BlockTapped[idx]) return;
        round.BlockTapped[idx] = true;
        StateHasChanged();

        if (round.BlockTapped.All(t => t))
        {
            SetNarration($"You rebuilt the tower together! {round.Reactor.FirstName} feels happy again.");
            round.ReactorHappy = true;
            round.HelpingRebuild = false;

            // Without this, the original "I'm sorry / Run away" choice
            // buttons briefly re-match the "no consequence showing" guard
            // and flash back on screen during the pause before the round
            // actually advances.
            round.ShowingConsequence = true;
            StateHasChanged();
            await Task.Delay(1500);
            await CompleteRound();
        }
    }

    private async Task WaveGreeting()
    {
        round.ShowingConsequence = true;
        round.ReactorHappy = true;

        if (!round.WavedHello)
        {
            SetNarration($"Hi, {round.Reactor.FirstName}!");
            round.WavedHello = true;
            StateHasChanged();
            await Task.Delay(1500);

            SetNarration($"It's time for {round.Actor.FirstName} to go home. Let's wave goodbye!");
            round.ShowingConsequence = false;
            StateHasChanged();
        }
        else
        {
            SetNarration("Bye-bye! See you soon!");
            StateHasChanged();
            await Task.Delay(1500);
            await CompleteRound();
        }
    }

    private static string LessonDisplayName(LessonType lesson) => lesson switch
    {
        LessonType.Please => "Saying Please",
        LessonType.ThankYou => "Saying Thank You",
        LessonType.Turns => "Taking Turns",
        LessonType.Sorry => "Saying Sorry",
        LessonType.CleanUp => "Cleaning Up",
        LessonType.Greeting => "Hello & Goodbye",
        LessonType.Achoo => "Covering a Sneeze",
