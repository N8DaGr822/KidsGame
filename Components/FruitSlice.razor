@*
    FruitSlice.razor
    Fruit toss up from the bottom of the screen and arc back down - click
    one before it lands to slice it. The occasional bomb should be left
    alone. Consecutive slices build a streak that raises a score
    multiplier (same idea as Whack-a-Mole); a bomb hit or a fruit that
    lands unsliced resets the streak. Harder difficulties spawn faster
    with a shorter arc and more bombs mixed in.

    Usage:
        <FruitSlice OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="fs-game">

    @if (phase == Phase.Setup)
    {
        <div class="fs-setup game-setup-panel">
            <h2>🍉 Fruit Slice</h2>
            <p>Slice the fruit before it falls back down - but leave the bombs alone!</p>

            <h3 class="fs-section-title game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="fs-difficulty-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="fs-difficulty-select game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="fs-diff-btn game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="fs-diff-name">@DifficultyName(diff)</span>
                            <span class="fs-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="fs-start-btn game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="fs-hud game-hud">
            <span class="fs-title">Fruit Slice</span>
            <span class="fs-stat">⭐ @score</span>
            <span class="fs-stat">🔥 @($"{CurrentMultiplier}x")</span>
            <span class="fs-stat">⏱️ @FormatTime(remainingMs)</span>
            <button class="fs-restart-btn game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="fs-field">
            @foreach (var item in items)
            {
                <button @key="item.Id" class="fs-item @(item.IsBomb ? "bomb" : "") @(item.Sliced ? "sliced" : "")"
                        style="@ItemStyle(item)"
                        disabled="@(phase != Phase.Playing)"
                        @onclick="() => SliceItem(item)">@item.Symbol</button>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="fs-overlay game-result-overlay">
                <div class="fs-win-panel game-result-panel">
                    <h2>⏰ Time's Up!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Nice slicing" : PlayerName + ", nice slicing") - here's how you did!</p>
                    <div class="fs-win-stats game-result-stats">
                        <div><span class="game-stat-label">Score</span><span class="game-stat-value">@score</span></div>
                        <div><span class="game-stat-label">Sliced</span><span class="game-stat-value">@sliced</span></div>
                        <div><span class="game-stat-label">Best streak</span><span class="game-stat-value">@bestStreak</span></div>
                    </div>
                    <div class="fs-win-actions game-result-actions">
                        <button class="fs-start-btn game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="fs-restart-btn game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<FruitSliceResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private record DifficultyConfig(int RoundSeconds, int ArcMs, int MinSpawnMs, int MaxSpawnMs, double BombRatio, int MaxActive);

    private static readonly string[] FruitSymbols = { "🍉", "🍎", "🍊", "🍋", "🍇", "🍓", "🍍" };
    private const string BombSymbol = "💣";

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static DifficultyConfig ConfigFor(Difficulty d) => d switch
    {
        Difficulty.Easy => new DifficultyConfig(30, 2600, 900, 1300, 0.10, 5),
        Difficulty.Medium => new DifficultyConfig(40, 2100, 650, 950, 0.20, 6),
        _ => new DifficultyConfig(45, 1700, 450, 700, 0.30, 8),
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private class FruitItem
    {
        public string Id { get; } = Guid.NewGuid().ToString();
        public string Symbol = "";
        public bool IsBomb;
        public bool Sliced;
        public double StartXPct;
        public double PeakPct;
        public int DurationMs;
    }

    private const int TickMs = 100;

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private DifficultyConfig config = ConfigFor(Difficulty.Easy);
    private readonly List<FruitItem> items = new();
    private int score;
    private int sliced;
    private int bombsHit;
    private int streak;
    private int bestStreak;
    private int remainingMs;
    private int nextSpawnInMs;
    private readonly Random rng = new();
    private System.Threading.Timer? timer;
    private IJSObjectReference? _module;

    private int CurrentMultiplier => 1 + Math.Min(streak / 5, 3);

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        config = ConfigFor(selectedDifficulty);
        items.Clear();
        score = 0;
        sliced = 0;
        bombsHit = 0;
        streak = 0;
        bestStreak = 0;
        remainingMs = config.RoundSeconds * 1000;
        nextSpawnInMs = rng.Next(config.MinSpawnMs, config.MaxSpawnMs + 1);
        phase = Phase.Playing;
        StartTimer();
    }

    private void ExitToSetup()
    {
        StopTimer();
        phase = Phase.Setup;
        items.Clear();
    }

    private void Tick(object? _) => InvokeAsync(async () =>
    {
        if (phase != Phase.Playing) return;

        remainingMs -= TickMs;
        if (remainingMs <= 0)
        {
            remainingMs = 0;
            await FinishGame();
            return;
        }

        nextSpawnInMs -= TickMs;
        if (nextSpawnInMs <= 0 && items.Count(i => !i.Sliced) < config.MaxActive)
        {
            SpawnItem();
            nextSpawnInMs = rng.Next(config.MinSpawnMs, config.MaxSpawnMs + 1);
        }

        StateHasChanged();
    });

    private void SpawnItem()
    {
        var isBomb = rng.NextDouble() < config.BombRatio;
        var item = new FruitItem
        {
            Symbol = isBomb ? BombSymbol : FruitSymbols[rng.Next(FruitSymbols.Length)],
            IsBomb = isBomb,
            StartXPct = 8 + rng.NextDouble() * 84,
            PeakPct = 45 + rng.NextDouble() * 35,
            DurationMs = config.ArcMs + rng.Next(-150, 151),
        };
        items.Add(item);
        _ = ExpireItemAsync(item);
    }

    private async Task ExpireItemAsync(FruitItem item)
    {
        await Task.Delay(item.DurationMs);
        if (phase != Phase.Playing || item.Sliced || !items.Contains(item)) return;

        items.Remove(item);
        if (!item.IsBomb) streak = 0;
        StateHasChanged();
    }

    private async Task SliceItem(FruitItem item)
    {
        if (phase != Phase.Playing || item.Sliced) return;

        item.Sliced = true;

        if (item.IsBomb)
        {
            bombsHit++;
            streak = 0;
            await PlaySoundAsync("playMismatchSound");
        }
        else
        {
            sliced++;
            streak++;
            bestStreak = Math.Max(bestStreak, streak);
            score += 10 * CurrentMultiplier;
            await PlaySoundAsync("playImpactSound");
        }

        StateHasChanged();
        await Task.Delay(150);
        items.Remove(item);
        StateHasChanged();
    }

    private static string ItemStyle(FruitItem item)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return $"left:{item.StartXPct.ToString("0.#", inv)}%; --fs-peak:{item.PeakPct.ToString("0.#", inv)}%; animation-duration:{item.DurationMs}ms;";
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        StopTimer();
        phase = Phase.Finished;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new FruitSliceResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                Sliced: sliced,
                BombsHit: bombsHit,
                BestStreak: bestStreak,
                ElapsedSeconds: config.RoundSeconds));
        }
    }

    private void StartTimer()
    {
        StopTimer();
        timer = new System.Threading.Timer(Tick, null, TickMs, TickMs);
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    private static string FormatTime(int totalMs)
    {
        var span = TimeSpan.FromMilliseconds(totalMs);
        return span.Minutes > 0 ? $"{span.Minutes}:{span.Seconds:00}" : $"0:{span.Seconds:00}";
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "Slower arcs, few bombs",
        Difficulty.Medium => "Quicker arcs, more bombs",
        _ => "Fast arcs, lots of bombs",
    };

    public async ValueTask DisposeAsync()
    {
        StopTimer();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record FruitSliceResult(string Difficulty, int Score, int Sliced, int BombsHit, int BestStreak, int ElapsedSeconds);
}
