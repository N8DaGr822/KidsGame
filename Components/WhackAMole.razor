@*
    WhackAMole.razor
    Moles pop up at random holes in a grid and hide again after a moment -
    click one before it ducks back down to score. Consecutive hits build a
    streak that raises a score multiplier (every 5 hits in a row, up to
    4x); missing an empty hole or letting a mole escape resets the streak
    but never costs points, so it stays forgiving for younger players.
    Harder difficulties use a bigger grid, a shorter time on-screen per
    mole, and more moles up at once.

    Usage:
        <WhackAMole OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="wa-game">

    @if (phase == Phase.Setup)
    {
        <div class="wa-setup game-setup-panel">
            <h2>🐹 Whack-a-Mole</h2>
            <p>Moles pop up at random - click them before they duck back down. Chain hits together for a bigger score multiplier!</p>

            <h3 class="wa-section-title game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="wa-difficulty-select game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="wa-diff-btn game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="wa-diff-name">@DifficultyName(diff)</span>
                            <span class="wa-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="wa-start-btn game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="wa-hud game-hud">
            <span class="wa-title">Whack-a-Mole</span>
            <span class="wa-stat">⭐ @score</span>
            <span class="wa-stat">🔥 @($"{CurrentMultiplier}x")</span>
            <span class="wa-stat">⏱️ @FormatTime(remainingMs)</span>
            <button class="wa-restart-btn game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="wa-board" style="--wa-size:@gridSize;">
            @for (var i = 0; i < holes.Length; i++)
            {
                var idx = i;
                var hole = holes[idx];
                <button class="wa-hole @(hole.Up ? "up" : "") @(hole.Bonked ? "bonked" : "")"
                        disabled="@(phase != Phase.Playing)"
                        aria-label="@(hole.Up ? "Mole - whack it!" : "Empty hole")"
                        @onclick="() => WhackHole(idx)">
                    <span class="wa-mound"></span>
                    <img class="wa-mole" src="@MoleImagePath" alt="" draggable="false" />
                </button>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="wa-overlay game-result-overlay">
                <div class="wa-win-panel game-result-panel">
                    <h2>⏰ Time's Up!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Nice whacking" : PlayerName + ", nice whacking") - here's how you did!</p>
                    <div class="wa-win-stats game-result-stats">
                        <div><span class="wa-stat-label game-stat-label">Score</span><span class="wa-stat-value game-stat-value">@score</span></div>
                        <div><span class="wa-stat-label game-stat-label">Hits</span><span class="wa-stat-value game-stat-value">@hits</span></div>
                        <div><span class="wa-stat-label game-stat-label">Best streak</span><span class="wa-stat-value game-stat-value">@bestStreak</span></div>
                    </div>
                    <div class="wa-win-actions game-result-actions">
                        <button class="wa-start-btn game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="wa-restart-btn game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<WhackAMoleResult> OnComplete { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private record DifficultyConfig(int GridSize, int RoundSeconds, int MoleUpMs, int MinSpawnMs, int MaxSpawnMs, int MaxActiveMoles);

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static DifficultyConfig ConfigFor(Difficulty d) => d switch
    {
        Difficulty.Easy => new DifficultyConfig(3, 30, 1400, 900, 1300, 1),
        Difficulty.Medium => new DifficultyConfig(4, 40, 1000, 650, 950, 2),
        _ => new DifficultyConfig(5, 45, 750, 450, 700, 3),
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private class Hole
    {
        public bool Up;
        public bool Bonked;
        public int RemainingMs;
    }

    private const int TickMs = 100;
    private const string MoleImagePath = "images/whack/mole.png";

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private DifficultyConfig config = ConfigFor(Difficulty.Easy);
    private Hole[] holes = Array.Empty<Hole>();
    private int gridSize;
    private int score;
    private int hits;
    private int misses;
    private int streak;
    private int bestStreak;
    private int remainingMs;
    private int nextSpawnInMs;
    private readonly Random rng = new();
    private System.Threading.Timer? timer;
    private IJSObjectReference? _module;

    private int CurrentMultiplier => 1 + Math.Min(streak / 5, 3);

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        config = ConfigFor(selectedDifficulty);
        gridSize = config.GridSize;
        holes = Enumerable.Range(0, gridSize * gridSize).Select(_ => new Hole()).ToArray();
        score = 0;
        hits = 0;
        misses = 0;
        streak = 0;
        bestStreak = 0;
        remainingMs = config.RoundSeconds * 1000;
        nextSpawnInMs = rng.Next(config.MinSpawnMs, config.MaxSpawnMs + 1);
        phase = Phase.Playing;
        StartTimer();
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing - previously only a natural
    // finish invoked OnComplete, so an abandoned session left no trace.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new WhackAMoleResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                Hits: hits,
                Misses: misses,
                BestStreak: bestStreak,
                ElapsedSeconds: config.RoundSeconds - remainingMs / 1000));
        }
        StopTimer();
        phase = Phase.Setup;
    }

    private void Tick(object? _) => InvokeAsync(async () =>
    {
        if (phase != Phase.Playing) return;

        remainingMs -= TickMs;
        if (remainingMs <= 0)
        {
            remainingMs = 0;
            await FinishGame();
            return;
        }

        nextSpawnInMs -= TickMs;
        if (nextSpawnInMs <= 0)
        {
            TrySpawnMole();
            nextSpawnInMs = rng.Next(config.MinSpawnMs, config.MaxSpawnMs + 1);
        }

        foreach (var hole in holes)
        {
            if (!hole.Up || hole.Bonked) continue;

            hole.RemainingMs -= TickMs;
            if (hole.RemainingMs <= 0)
            {
                hole.Up = false;
                streak = 0;
            }
        }

        StateHasChanged();
    });

    private void TrySpawnMole()
    {
        if (holes.Count(h => h.Up) >= config.MaxActiveMoles) return;

        var emptyIndexes = holes.Select((h, i) => (Hole: h, Index: i)).Where(x => !x.Hole.Up).Select(x => x.Index).ToList();
        if (emptyIndexes.Count == 0) return;

        var hole = holes[emptyIndexes[rng.Next(emptyIndexes.Count)]];
        hole.Up = true;
        hole.RemainingMs = config.MoleUpMs;
    }

    private async Task WhackHole(int index)
    {
        if (phase != Phase.Playing) return;
        var hole = holes[index];

        if (!hole.Up || hole.Bonked)
        {
            misses++;
            streak = 0;
            await PlaySoundAsync("playMismatchSound");
            return;
        }

        hole.Bonked = true;
        hits++;
        streak++;
        bestStreak = Math.Max(bestStreak, streak);
        score += 10 * CurrentMultiplier;
        StateHasChanged();
        await PlaySoundAsync("playImpactSound");

        await Task.Delay(320);
        hole.Up = false;
        hole.Bonked = false;
        StateHasChanged();
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        StopTimer();
        phase = Phase.Finished;
        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new WhackAMoleResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Score: score,
                Hits: hits,
                Misses: misses,
                BestStreak: bestStreak,
                ElapsedSeconds: config.RoundSeconds));
        }
    }

    private void StartTimer()
    {
        StopTimer();
        timer = new System.Threading.Timer(Tick, null, TickMs, TickMs);
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    private static string FormatTime(int totalMs)
    {
        var span = TimeSpan.FromMilliseconds(totalMs);
        return span.Minutes > 0 ? $"{span.Minutes}:{span.Seconds:00}" : $"0:{span.Seconds:00}";
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "3x3, slower moles",
        Difficulty.Medium => "4x4, quicker moles",
        _ => "5x5, fast moles",
    };

    public async ValueTask DisposeAsync()
    {
        StopTimer();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record WhackAMoleResult(string Difficulty, int Score, int Hits, int Misses, int BestStreak, int ElapsedSeconds);
}
