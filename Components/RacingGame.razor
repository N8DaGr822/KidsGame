@*
    RacingGame.razor
    Top-down arcade racing vs 2 CPU opponents around a fixed rounded-
    rectangle track (a 4x6 tile grid - one curve tile image reused at all
    four corners via CSS rotation, plus horizontal/vertical straight
    tiles). Real-time loop shape copied from SpaceGame/AirHockey (fixed
    timestep, capped substeps, CancellationTokenSource for a clean
    stop). Controls match SpaceGame's: drag anywhere and your car
    accelerates toward your finger, always facing its direction of
    travel - steering is aiming/driving, no separate throttle. Driving
    off the track's centerline path (checked via point-to-segment
    distance against the ordered waypoint loop, not just nearest-
    waypoint distance - otherwise the middle of a straight would
    wrongly read as "off track") caps your top speed and adds extra
    drag, like driving onto grass, rather than a hard wall - forgiving
    by design. CPU cars use the exact same movement function as the
    player, just steering toward their next waypoint instead of a
    pointer target. All three cars gently bump off each other via
    Services/Physics2D.cs's circle/circle resolver, same as the
    asteroids in Space Survival. First car (player or CPU) to complete
    3 laps wins the race immediately. Personal best tracks fastest
    winning time, per difficulty.

    Usage:
        <RacingGame OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using System.Numerics
@using KidsGameLauncher.Services

<div class="rg-game">

    @if (phase == Phase.Setup)
    {
        <div class="rg-setup game-setup-panel">
            <h2>🏁 Top-Down Racing</h2>
            <p>Drag anywhere to drive - your car steers and speeds toward your finger. Stay on the road for full speed, and finish 3 laps ahead of both CPU racers!</p>

            <h3 class="game-section-title">Choose your car</h3>
            <div class="rg-car-select game-option-grid">
                @foreach (var car in RaceTrack.CarRoster)
                {
                    <button class="rg-car-btn game-option-button @(car.Slug == selectedCarSlug ? "selected" : "")" @onclick="() => selectedCarSlug = car.Slug">
                        <img class="rg-car-swatch" src="images/racing/car-@(car.Slug).png" alt="" />
                        <span class="rg-car-name">@car.Name</span>
                    </button>
                }
            </div>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="rg-diff-name">@DifficultyName(diff)</span>
                            <span class="rg-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="rg-title">Top-Down Racing</span>
            <span class="game-stat">🏁 Lap @Math.Min(player.LapsCompleted + 1, TotalLaps)/@TotalLaps</span>
            <span class="game-stat">@PlacementText(PlayerPlacement())</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="rg-field" @ref="fieldRef"
             @onpointerdown="OnFieldPointerDown" @onpointermove="OnFieldPointerMove"
             @onpointerup="OnFieldPointerUp" @onpointercancel="OnFieldPointerUp">

            @foreach (var tile in RaceTrack.TrackTiles)
            {
                <img class="rg-tile" src="images/racing/@RaceTrack.TileImageFile(tile.Kind)"
                     style="left:@((RaceTrack.TileCenterX(tile) * 100f / RaceTrack.FieldWidth).ToString(Inv))%; top:@((RaceTrack.TileCenterY(tile) * 100f / RaceTrack.FieldHeight).ToString(Inv))%; transform:translate(-50%,-50%) rotate(@(tile.RotationDeg.ToString(Inv))deg);" />
            }

            <img class="rg-finish" src="images/racing/finish-strip.png"
                 style="left:@((RaceTrack.Waypoints[1].X * 100f / RaceTrack.FieldWidth).ToString(Inv))%; top:@((RaceTrack.Waypoints[1].Y * 100f / RaceTrack.FieldHeight).ToString(Inv))%;" />

            <img class="rg-decor rg-grandstand" src="images/racing/grandstand.png" style="left:50%; top:30%;" />
            <img class="rg-decor rg-tire" src="images/racing/tire-stack.png" style="left:27.5%; top:18.3%;" />
            <img class="rg-decor rg-tire" src="images/racing/tire-stack.png" style="left:72.5%; top:18.3%;" />
            <img class="rg-decor rg-tire" src="images/racing/tire-stack.png" style="left:27.5%; top:81.7%;" />
            <img class="rg-decor rg-tire" src="images/racing/tire-stack.png" style="left:72.5%; top:81.7%;" />

            @foreach (var cpu in cpus)
            {
                <img class="rg-car" src="images/racing/car-@(cpu.CarSlug).png"
                     style="left:@((cpu.Body.Position.X * 100f / RaceTrack.FieldWidth).ToString(Inv))%; top:@((cpu.Body.Position.Y * 100f / RaceTrack.FieldHeight).ToString(Inv))%; transform:translate(-50%,-50%) rotate(@(RaceTrack.CssAngle(cpu.FacingDeg).ToString(Inv))deg);" />
            }

            <img class="rg-car rg-car-player" src="images/racing/car-@(player.CarSlug).png"
                 style="left:@((player.Body.Position.X * 100f / RaceTrack.FieldWidth).ToString(Inv))%; top:@((player.Body.Position.Y * 100f / RaceTrack.FieldHeight).ToString(Inv))%; transform:translate(-50%,-50%) rotate(@(RaceTrack.CssAngle(player.FacingDeg).ToString(Inv))deg);" />

            @if (ShowCountdown || ShowGo)
            {
                <div class="rg-countdown">@(ShowGo ? "GO!" : CountdownNumber())</div>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2><img class="rg-flag-icon" src="images/racing/checkered-flag.png" alt="" /> @(won ? "You Win!" : "Race Over")</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ")@(won ? "you crossed the line first!" : PlacementText(finalPlacement) + " place - nice driving!")</p>
                    <div class="game-result-stats">
                        <div><span class="game-stat-label">Time</span><span class="game-stat-value">@FormatTime(raceElapsedSeconds)</span></div>
                        <div><span class="game-stat-label">Finish</span><span class="game-stat-value">@PlacementText(finalPlacement)</span></div>
                    </div>
                    <PersonalBestBadge Value="@(bestTimeSeconds is { } bt ? $"{FormatTime(bt)} win" : null)" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<RacingGameResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fastest winning time, per difficulty) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    private enum Difficulty { Easy, Medium, Hard }

    private const int TotalLaps = 3;
    private const float PlayerMaxSpeed = 95f;
    private const float CarRestitution = 0.5f;
    private const float FixedDt = 1f / 120f;
    private const int MaxSubstepsPerFrame = 8;
    private const int FrameDelayMs = 16;
    private const int CountdownMs = 3000;
    private const int GoDisplayMs = 700;

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static float CpuMaxSpeedFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 72f,
        Difficulty.Medium => 92f,
        _ => 112f,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private string selectedCarSlug = RaceTrack.CarRoster[0].Slug;

    private RaceTrack.RacerState player = new() { IsPlayer = true };
    private readonly List<RaceTrack.RacerState> cpus = new();

    private bool won;
    private int finalPlacement;
    private int raceElapsedSeconds;
    private int? bestTimeSeconds;
    private bool isNewBest;
    private DateTime startedAtUtc;
    private DateTime raceStartUtc;
    private IJSObjectReference? _module;

    private ElementReference fieldRef;
    private double fieldLeft, fieldTop, fieldWidth, fieldHeight;
    private long? activeFieldPointerId;
    private Vector2? pointerTarget;

    private CancellationTokenSource? _loopCts;
    private float accumulator;
    private readonly Random rng = new();

    private bool ShowCountdown => DateTime.UtcNow < raceStartUtc;
    private bool ShowGo => !ShowCountdown && DateTime.UtcNow < raceStartUtc.AddMilliseconds(GoDisplayMs);

    private string CountdownNumber()
    {
        var remainingMs = (raceStartUtc - DateTime.UtcNow).TotalMilliseconds;
        if (remainingMs > 2000) return "3";
        if (remainingMs > 1000) return "2";
        return "1";
    }

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        var startTile = RaceTrack.TrackTiles[0];
        player = new RaceTrack.RacerState
        {
            IsPlayer = true,
            CarSlug = selectedCarSlug,
            MaxSpeed = PlayerMaxSpeed,
            Body = new PhysicsBody { Radius = RaceTrack.CarRadius, Position = new Vector2(RaceTrack.TileCenterX(startTile) - 10, RaceTrack.TileCenterY(startTile)) },
        };

        var cpuChoices = RaceTrack.CarRoster.Where(c => c.Slug != selectedCarSlug).OrderBy(_ => rng.Next()).Take(2).ToList();
        cpus.Clear();
        cpus.Add(new RaceTrack.RacerState
        {
            CarSlug = cpuChoices[0].Slug,
            MaxSpeed = CpuMaxSpeedFor(selectedDifficulty),
            Body = new PhysicsBody { Radius = RaceTrack.CarRadius, Position = new Vector2(RaceTrack.TileCenterX(startTile), RaceTrack.TileCenterY(startTile) - 10) },
        });
        cpus.Add(new RaceTrack.RacerState
        {
            CarSlug = cpuChoices[1].Slug,
            MaxSpeed = CpuMaxSpeedFor(selectedDifficulty),
            Body = new PhysicsBody { Radius = RaceTrack.CarRadius, Position = new Vector2(RaceTrack.TileCenterX(startTile) + 10, RaceTrack.TileCenterY(startTile) + 10) },
        });

        pointerTarget = null;
        won = false;
        finalPlacement = 0;
        raceElapsedSeconds = 0;
        bestTimeSeconds = null;
        isNewBest = false;
        raceStartUtc = DateTime.UtcNow.AddMilliseconds(CountdownMs);
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;

        _loopCts?.Cancel();
        _loopCts = new CancellationTokenSource();
        _ = RunLoopAsync(_loopCts.Token);
    }

    private async Task ExitToSetup()
    {
        _loopCts?.Cancel();
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new RacingGameResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: false,
                Placement: PlayerPlacement(),
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    private async Task RunLoopAsync(CancellationToken ct)
    {
        var lastTick = DateTime.UtcNow;

        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(FrameDelayMs, ct);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            try
            {
                var now = DateTime.UtcNow;
                var elapsed = (float)(now - lastTick).TotalSeconds;
                lastTick = now;

                accumulator += elapsed;
                var substeps = 0;
                while (accumulator >= FixedDt && substeps < MaxSubstepsPerFrame && phase == Phase.Playing)
                {
                    StepPhysics(FixedDt);
                    accumulator -= FixedDt;
                    substeps++;
                }
                if (substeps >= MaxSubstepsPerFrame) accumulator = 0f;

                StateHasChanged();

                if (phase != Phase.Playing) return;
            }
            catch (Exception) when (!ct.IsCancellationRequested)
            {
                accumulator = 0f;
            }
        }
    }

    private void StepPhysics(float dt)
    {
        if (DateTime.UtcNow < raceStartUtc) return;

        RaceTrack.UpdateRacer(player, pointerTarget, dt);
        foreach (var cpu in cpus) RaceTrack.UpdateRacer(cpu, RaceTrack.Waypoints[cpu.NextWaypointIndex], dt);

        var all = new List<RaceTrack.RacerState> { player };
        all.AddRange(cpus);
        for (var i = 0; i < all.Count; i++)
        {
            for (var j = i + 1; j < all.Count; j++)
            {
                Physics2D.ResolveCircleCollision(all[i].Body, all[j].Body, CarRestitution);
            }
        }

        var winner = CheckRaceFinished();
        if (winner is not null)
        {
            phase = Phase.Finished;
            _ = FinishRaceAsync(winner);
        }
    }

    private RaceTrack.RacerState? CheckRaceFinished()
    {
        if (player.LapsCompleted >= TotalLaps) return player;
        foreach (var cpu in cpus)
        {
            if (cpu.LapsCompleted >= TotalLaps) return cpu;
        }
        return null;
    }

    private int PlayerPlacement()
    {
        var all = new List<RaceTrack.RacerState> { player };
        all.AddRange(cpus);
        var ranked = all
            .OrderByDescending(r => r.LapsCompleted)
            .ThenByDescending(r => r.NextWaypointIndex)
            .ThenBy(r => Vector2.DistanceSquared(r.Body.Position, RaceTrack.Waypoints[r.NextWaypointIndex]))
            .ToList();
        return ranked.IndexOf(player) + 1;
    }

    private static string PlacementText(int place) => place switch
    {
        1 => "1st",
        2 => "2nd",
        3 => "3rd",
        _ => $"{place}th",
    };

    private async Task OnFieldPointerDown(PointerEventArgs e)
    {
        if (phase != Phase.Playing) return;

        activeFieldPointerId = e.PointerId;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        var rect = await _module.InvokeAsync<FieldRect>("getBoundingRect", fieldRef);
        fieldLeft = rect.Left;
        fieldTop = rect.Top;
        fieldWidth = rect.Width;
        fieldHeight = rect.Height;

        await _module.InvokeVoidAsync("setPointerCapture", fieldRef, e.PointerId);

        if (activeFieldPointerId != e.PointerId) return;
        UpdatePointerTarget(e.ClientX, e.ClientY);
    }

    private void OnFieldPointerMove(PointerEventArgs e)
    {
        if (activeFieldPointerId != e.PointerId) return;
        UpdatePointerTarget(e.ClientX, e.ClientY);
    }

    private void OnFieldPointerUp(PointerEventArgs e)
    {
        if (activeFieldPointerId != e.PointerId) return;
        activeFieldPointerId = null;
        pointerTarget = null;
    }

    private void UpdatePointerTarget(double clientX, double clientY)
    {
        if (fieldWidth <= 0 || fieldHeight <= 0) return;
        var xPct = (clientX - fieldLeft) / fieldWidth;
        var yPct = (clientY - fieldTop) / fieldHeight;
        pointerTarget = new Vector2((float)(xPct * RaceTrack.FieldWidth), (float)(yPct * RaceTrack.FieldHeight));
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishRaceAsync(RaceTrack.RacerState winner)
    {
        _loopCts?.Cancel();
        won = winner.IsPlayer;
        finalPlacement = won ? 1 : PlayerPlacement();
        raceElapsedSeconds = (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds;

        await PlaySoundAsync(won ? "playMatchSound" : "playMismatchSound");

        if (!string.IsNullOrEmpty(ProfileId))
        {
            var key = $"fastest-win-{DifficultyName(selectedDifficulty).ToLowerInvariant()}";
            bestTimeSeconds = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.RacingGame, key);
            if (won)
            {
                isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.RacingGame, key, raceElapsedSeconds, lowerIsBetter: true);
            }
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new RacingGameResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: won,
                Placement: finalPlacement,
                ElapsedSeconds: raceElapsedSeconds));
        }
    }

    private static string FormatTime(int totalSeconds)
    {
        var ts = TimeSpan.FromSeconds(totalSeconds);
        return ts.Minutes > 0 ? $"{ts.Minutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "Slower CPU racers",
        Difficulty.Medium => "Evenly matched racers",
        _ => "Fast, aggressive CPU racers",
    };

    public async ValueTask DisposeAsync()
    {
        _loopCts?.Cancel();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    private record FieldRect(double Left, double Top, double Width, double Height);

    public record RacingGameResult(string Difficulty, bool Won, int Placement, int ElapsedSeconds);
}
