@*
    LaserMaze.razor
    A beam fires from a fixed edge cell across a grid of mirrors. Tap a
    mirror to flip it between "/" and "\" and re-aim the beam toward the
    target. Puzzles are generated by building a guaranteed-solvable path
    first (a random walk with 90-degree turns, each turn assigned the one
    mirror orientation that produces it) and then scrambling every mirror's
    orientation away from that solution, so there is always a solve
    reachable by flipping mirrors back - no separate solver/verifier is
    needed the way RobotCommands' maze needed a BFS check, because the
    puzzle IS the solution in disguise.

    Usage:
        <LaserMaze OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="lm-game">

    @if (phase == Phase.Setup)
    {
        <div class="lm-setup game-setup-panel">
            <h2>🔦 Laser Maze</h2>
            <p>Tap mirrors to flip them and guide the beam from the emitter to the target.</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="lm-diff-name">@DifficultyName(diff)</span>
                            <span class="lm-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="lm-title">Laser Maze</span>
            <span class="game-stat">🖱️ Moves @moves</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="lm-grid-wrap">
            <div class="lm-grid" style="grid-template-columns: repeat(@size, 1fr);">
                @for (var r = 0; r < size; r++)
                {
                    @for (var c = 0; c < size; c++)
                    {
                        var row = r; var col = c;
                        var pos = (row, col);
                        var isSource = pos == sourceCell;
                        var isTarget = pos == targetCell;
                        var hasMirror = mirrorOrientation.TryGetValue(pos, out var orientation);
                        <div class="lm-cell @(isTarget && solved ? "solved" : "")">
                            @if (isSource)
                            {
                                <span class="lm-source">@SourceArrow()</span>
                            }
                            else if (isTarget)
                            {
                                <span class="lm-target">🎯</span>
                            }
                            else if (hasMirror)
                            {
                                <button class="lm-mirror @(justFlipped == pos ? "flip" : "")" disabled="@(solved || phase != Phase.Playing)" @onclick="() => FlipMirror(pos)">
                                    @(orientation == 0 ? "/" : "\\")
                                </button>
                            }
                        </div>
                    }
                }
            </div>

            <svg class="lm-beam-overlay" viewBox="0 0 @size @size" preserveAspectRatio="none">
                <polyline points="@BeamPoints()" class="lm-beam-glow @(solved ? "solved" : "")" />
                <polyline points="@BeamPoints()" class="lm-beam-core @(solved ? "solved" : "")" />
            </svg>
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🔦 Beam Connected!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "" : PlayerName + " - ")solved it in @moves move@(moves == 1 ? "" : "s")!</p>
                    <PersonalBestBadge Value="@($"{bestMoves ?? moves} moves")" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">New Puzzle</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<LaserMazeResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fewest moves to solve) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    // Direction indices: 0=Up, 1=Right, 2=Down, 3=Left.
    private static readonly int[] DR = { -1, 0, 1, 0 };
    private static readonly int[] DC = { 0, 1, 0, -1 };
    private static readonly int[] Slash = { 1, 0, 3, 2 };
    private static readonly int[] Backslash = { 3, 2, 1, 0 };
    private static readonly string[] Arrows = { "⬆️", "➡️", "⬇️", "⬅️" };

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int SizeFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 5,
        Difficulty.Medium => 6,
        _ => 7,
    };

    private static (int min, int max) TurnsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => (2, 3),
        Difficulty.Medium => (3, 4),
        _ => (4, 6),
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private int size;
    private (int, int) sourceCell;
    private int sourceDir;
    private (int, int) targetCell;
    private readonly Dictionary<(int, int), int> mirrorOrientation = new();
    private List<(int Row, int Col)> litPath = new();
    private bool solved;
    private (int, int)? justFlipped;
    private int moves;
    private int? bestMoves;
    private bool isNewBest;
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        size = SizeFor(selectedDifficulty);
        moves = 0;
        solved = false;
        bestMoves = null;
        isNewBest = false;
        startedAtUtc = DateTime.UtcNow;
        GeneratePuzzle();
        phase = Phase.Playing;
    }

    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new LaserMazeResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Solved: false,
                Moves: moves,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
        phase = Phase.Setup;
    }

    // Builds a guaranteed-solvable path by walking from a random edge cell,
    // turning 90 degrees at random intervals and recording the one mirror
    // orientation that produces each turn, then scrambles every mirror
    // away from that solution before showing it to the player.
    private void GeneratePuzzle()
    {
        var (minTurns, maxTurns) = TurnsFor(selectedDifficulty);
        var targetTurns = rng.Next(minTurns, maxTurns + 1);

        for (var attempt = 0; attempt < 60; attempt++)
        {
            if (TryBuildPath(targetTurns, out var solution, out var src, out var dir, out var tgt))
            {
                sourceCell = src;
                sourceDir = dir;
                targetCell = tgt;
                mirrorOrientation.Clear();

                var allMatchSolution = true;
                foreach (var (pos, correctOrientation) in solution)
                {
                    var initial = rng.Next(2);
                    mirrorOrientation[pos] = initial;
                    if (initial != correctOrientation) allMatchSolution = false;
                }
                if (allMatchSolution && solution.Count > 0)
                {
                    var flipPos = solution.Keys.ElementAt(rng.Next(solution.Count));
                    mirrorOrientation[flipPos] = 1 - mirrorOrientation[flipPos];
                }

                Simulate();
                return;
            }
        }

        // Fallback: a straight shot across the grid with no mirrors, which
        // is always solvable (and instantly solved), rather than leaving
        // the player with a broken puzzle if generation kept failing.
        sourceCell = (size / 2, 0);
        sourceDir = 1;
        targetCell = (size / 2, size - 1);
        mirrorOrientation.Clear();
        Simulate();
    }

    private bool TryBuildPath(int targetTurns, out Dictionary<(int, int), int> solution, out (int, int) src, out int dir, out (int, int) tgt)
    {
        solution = new Dictionary<(int, int), int>();
        var edge = rng.Next(4);
        src = edge switch
        {
            0 => (rng.Next(size), 0),           // left edge, firing right
            1 => (0, rng.Next(size)),           // top edge, firing down
            2 => (rng.Next(size), size - 1),    // right edge, firing left
            _ => (size - 1, rng.Next(size)),    // bottom edge, firing up
        };
        dir = edge switch { 0 => 1, 1 => 2, 2 => 3, _ => 0 };

        var visited = new HashSet<(int, int)> { src };
        var pos = src;
        var curDir = dir;
        var turnsPlaced = 0;
        var maxIterations = size * 3;

        for (var iter = 0; iter < maxIterations; iter++)
        {
            var segLen = rng.Next(1, 3);
            var moved = 0;
            var cursor = pos;
            for (var s = 0; s < segLen; s++)
            {
                var next = (cursor.Item1 + DR[curDir], cursor.Item2 + DC[curDir]);
                if (!InBounds(next) || visited.Contains(next)) break;
                cursor = next;
                visited.Add(next);
                moved++;
            }
            if (moved == 0)
            {
                tgt = pos;
                return turnsPlaced >= 1;
            }
            pos = cursor;

            var shouldStop = turnsPlaced >= targetTurns || (turnsPlaced >= 1 && rng.NextDouble() < 0.15);
            if (!shouldStop)
            {
                var perps = curDir % 2 == 0 ? new[] { 1, 3 } : new[] { 0, 2 };
                var order = rng.NextDouble() < 0.5 ? perps : new[] { perps[1], perps[0] };
                var placed = false;
                foreach (var newDir in order)
                {
                    var probe = (pos.Item1 + DR[newDir], pos.Item2 + DC[newDir]);
                    if (InBounds(probe) && !visited.Contains(probe))
                    {
                        solution[pos] = Slash[curDir] == newDir ? 0 : 1;
                        curDir = newDir;
                        turnsPlaced++;
                        placed = true;
                        break;
                    }
                }
                if (!placed) shouldStop = true;
            }

            if (shouldStop)
            {
                tgt = pos;
                return turnsPlaced >= Math.Max(1, targetTurns - 1);
            }
        }

        tgt = pos;
        return turnsPlaced >= 1;
    }

    private bool InBounds((int, int) p) => p.Item1 >= 0 && p.Item1 < size && p.Item2 >= 0 && p.Item2 < size;

    private async Task FlipMirror((int, int) pos)
    {
        if (solved || phase != Phase.Playing) return;
        mirrorOrientation[pos] = 1 - mirrorOrientation[pos];
        moves++;
        justFlipped = pos;
        Simulate();
        StateHasChanged();

        await Task.Delay(220);
        justFlipped = null;

        if (solved)
        {
            await PlaySoundAsync("playMatchSound");
            await FinishGame();
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private void Simulate()
    {
        var path = new List<(int Row, int Col)> { sourceCell };
        var pos = sourceCell;
        var dir = sourceDir;
        var maxSteps = size * size * 2;
        var reachedTarget = false;

        for (var step = 0; step < maxSteps; step++)
        {
            var next = (pos.Item1 + DR[dir], pos.Item2 + DC[dir]);
            if (!InBounds(next)) break;
            pos = next;
            path.Add(pos);
            if (pos == targetCell) { reachedTarget = true; break; }
            if (mirrorOrientation.TryGetValue(pos, out var orientation))
            {
                dir = orientation == 0 ? Slash[dir] : Backslash[dir];
            }
        }

        litPath = path;
        solved = reachedTarget;
    }

    // Cell-center coordinates (col+0.5, row+0.5) for the beam's SVG
    // polyline, in the grid's own 0..size coordinate space - the overlay's
    // viewBox matches that space directly so no pixel math is needed.
    private string BeamPoints() =>
        string.Join(" ", litPath.Select(p => $"{p.Col + 0.5},{p.Row + 0.5}"));

    private string SourceArrow() => Arrows[sourceDir];

    private async Task FinishGame()
    {
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "fewest-moves";
            bestMoves = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.LaserMaze, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.LaserMaze, key, moves, lowerIsBetter: true);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new LaserMazeResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Solved: true,
                Moves: moves,
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "5x5 grid, fewer turns",
        Difficulty.Medium => "6x6 grid",
        _ => "7x7 grid, more turns",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record LaserMazeResult(string Difficulty, bool Solved, int Moves, int ElapsedSeconds);
}
