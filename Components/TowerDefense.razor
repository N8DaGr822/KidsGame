@*
    TowerDefense.razor
    An older-kid game (see GAMES_ROADMAP.md Section 9) - noticeably bigger
    than the other built-ins, on par with TankDuel/DressUp rather than the
    ~300-400 line norm. Real persistent campaign progress/unlocks across
    sessions is still a later extension, not v1 - see the roadmap's
    "start with small vertical slices" note.

    Levels are procedurally generated (GenerateLevel) rather than picked
    from a fixed set - an unlimited, always-different supply of routes
    across the same 12x8 board. Clearing a level's 8 waves refunds every
    placed tower (a fresh path needs a fresh layout) and auto-generates
    the next one; Easy/Medium/Hard end the run in victory after
    LevelsToWinCampaign levels, while Endless removes that cap entirely
    and just keeps going - same starting bar as Hard, no finish line, see
    how far you get.

    Enemies (six animal types, reusing Memory Match's art) walk the
    current level's path; tap a grass cell with a tower selected from the
    build palette to place it (if you can afford it). Towers rotate to
    face whatever they're aiming at (or their last target, if nothing's
    in range right now) and auto-fire at the enemy furthest along the
    path that's within range, with a small traveling dot standing in for
    the shot so hits read clearly. The first wave needs a manual "Start
    Wave" tap to give the player time to set up, but every wave after
    that auto-starts a few seconds after the previous one clears -
    "Start Now" on the wave button skips the wait. Reach the end of the
    path and an enemy costs you lives instead of gold; run out of lives
    and the run ends.

    Tap a placed tower to select it - a range circle shows its coverage
    and a small panel offers Upgrade (stronger/faster, up to
    MaxTowerLevel) or Sell (60% of everything spent on it back). Once
    two towers of the same kind both hit MaxTowerLevel, the panel offers
    Merge instead of Upgrade: fuses them (nearest same-type maxed tower
    is the partner, auto-picked) into a Mega tower with splash damage -
    a proper "boom" moment (explosion sound + a visual burst at both
    tiles) rather than just bigger numbers. The in-game "❓" button (also
    on the setup screen) opens a legend showing all three merge
    combinations. Tap a build-palette tower and hover a grass cell
    (mouse only - there's no touch equivalent of hover) to preview its
    range before committing.

    Usage:
        <TowerDefense OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject InteropService Interop
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="td-game">

    @if (phase == Phase.Setup)
    {
        <div class="td-setup game-setup-panel">
            <h2>@currentTheme.Emoji @currentTheme.Title</h2>
            <p>Place towers along the path to stop the enemies before they reach the end. Clear a level and a brand new path takes its place - keep going as long as you can!</p>

            <h3 class="td-section-title game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="td-difficulty-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="td-difficulty-select game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="td-diff-btn game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="td-diff-name">@DifficultyName(diff)</span>
                            <span class="td-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="td-start-btn game-primary-action" @onclick="StartGame">Start Game</button>
            <button class="td-legend-toggle game-secondary-action" @onclick="() => showLegend = true">❓ How tower merges work</button>
        </div>
    }
    else
    {
        <div class="td-hud game-hud">
            <span class="td-stat"><img class="td-coin-icon" src="images/tower-defense/coin.png" alt="" />@gold</span>
            <span class="td-stat">❤️ @lives</span>
            <span class="td-stat">🗺️ Level @levelNumber</span>
            <span class="td-stat">Wave @(waveInLevel + 1)/@WavesPerLevel</span>
            <button class="td-wave-btn game-primary-action" disabled="@(!CanStartWave())" @onclick="StartWave">
                @(waveInProgress ? "Wave in progress…" : nextWaveCountdownMs > 0 ? $"Start Now ({Math.Ceiling(nextWaveCountdownMs / 1000.0)}s)" : "Start Wave")
            </button>
            <button class="td-info-btn game-secondary-action" @onclick="() => showLegend = true" aria-label="How tower merges work">❓</button>
            <button class="td-restart-btn game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="td-palette">
            @foreach (var t in currentTheme.Towers)
            {
                <button class="td-palette-btn @(selectedTowerType?.Id == t.Id ? "selected" : "") @(gold < t.Cost ? "unaffordable" : "")"
                        disabled="@(phase != Phase.Playing)"
                        @onclick="() => SelectTowerType(t)">
                    <img class="td-palette-icon" src="@t.ImagePath" alt="" />
                    <span class="td-palette-name">@t.Name</span>
                    <span class="td-palette-cost"><img class="td-coin-icon" src="images/tower-defense/coin.png" alt="" />@t.Cost</span>
                </button>
            }
        </div>

        @if (selectedPlacedTowerPos is { } selPos && towers.TryGetValue(selPos, out var selTower))
        {
            <div class="td-tower-panel">
                <img class="td-tower-panel-icon" src="@selTower.Type.ImagePath" alt="" />
                <div class="td-tower-panel-info">
                    <span class="td-tower-panel-name">@selTower.Type.Name <span class="td-tower-panel-level">Lv.@selTower.Level</span></span>
                    <span class="td-tower-panel-stats">⚔️ @EffectiveDamage(selTower) 🎯 @EffectiveRange(selTower).ToString("0.#") ⏱️ @(EffectiveFireIntervalMs(selTower))ms</span>
                </div>
                <div class="td-tower-panel-actions">
                    @if (selTower.Level < MaxTowerLevel)
                    {
                        <button class="td-panel-btn game-primary-action" disabled="@(gold < UpgradeCost(selTower))" @onclick="() => UpgradeTower(selPos)">
                            Upgrade <img class="td-coin-icon" src="images/tower-defense/coin.png" alt="" />@UpgradeCost(selTower)
                        </button>
                    }
                    else if (CanMerge(selTower))
                    {
                        @if (FindMergePartner(selPos, selTower) is not null)
                        {
                            <button class="td-panel-btn game-primary-action td-merge-btn" @onclick="() => MergeTower(selPos)">
                                💥 Merge into @currentTheme.MegaByBaseId[selTower.Type.Id].Name
                            </button>
                        }
                        else
                        {
                            <span class="td-merge-hint">Max another @selTower.Type.Name to merge!</span>
                        }
                    }
                    <button class="td-panel-btn game-secondary-action" @onclick="() => SellTower(selPos)">
                        Sell <img class="td-coin-icon" src="images/tower-defense/coin.png" alt="" />@SellValue(selTower)
                    </button>
                    <button class="td-panel-btn game-secondary-action" @onclick="() => selectedPlacedTowerPos = null">Close</button>
                </div>
            </div>
        }

        <div class="td-board" style="--td-cols:@GridCols; --td-rows:@GridRows;">
            @for (var row = 0; row < GridRows; row++)
            {
                for (var col = 0; col < GridCols; col++)
                {
                    var c = col;
                    var r = row;
                    var isPath = pathSet.Contains((c, r));
                    towers.TryGetValue((c, r), out var placed);

                    <button class="td-cell @(isPath ? "path" : "grass") @(placed is not null ? "occupied" : "") @(selectedPlacedTowerPos == (c, r) ? "selected-tower" : "")"
                            disabled="@(isPath || phase != Phase.Playing)"
                            @onclick="() => HandleCellClick(c, r)"
                            @onpointerenter="() => HoverCell(c, r)"
                            @onpointerleave="() => ClearHover(c, r)">
                        @if (placed is not null)
                        {
                            <img class="td-tower-icon @(placed.Type.IsMega ? "mega" : "")" src="@placed.Type.ImagePath" alt="@placed.Type.Name" style="@TowerIconStyle(placed)" />
                            @if (placed.Type.IsMega)
                            {
                                <span class="td-mega-badge">⭐</span>
                            }
                        }
                    </button>
                }
            }

            @if (selectedPlacedTowerPos is { } rangePos && towers.TryGetValue(rangePos, out var rangeTower))
            {
                <div class="td-range-circle" style="@RangeCircleStyle(rangePos, EffectiveRange(rangeTower))"></div>
            }
            else if (selectedTowerType is { } previewType && hoverPreviewCell is { } hoverPos)
            {
                <div class="td-range-circle preview" style="@RangeCircleStyle(hoverPos, previewType.RangeCells)"></div>
            }

            @foreach (var enemy in enemies)
            {
                <div @key="enemy.Id" class="td-enemy @(enemy.HitFlashMs > 0 ? "hit" : "")" style="@EnemyStyle(enemy)">
                    <img class="td-enemy-icon" src="@enemy.Type.ImagePath" alt="" />
                    <div class="td-enemy-hp"><div class="td-enemy-hp-fill" style="width:@((enemy.Hp / enemy.Type.Hp * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%;"></div></div>
                </div>
            }

            @foreach (var shot in shots)
            {
                <div @key="shot.Id" class="td-shot @(shot.Mega ? "mega" : shot.Heavy ? "heavy" : "")" style="@ShotStyle(shot)"></div>
            }

            @foreach (var fx in boomEffects)
            {
                <div @key="fx.Id" class="td-boom @(fx.Big ? "big" : "")" style="@CellPercentStyle((fx.Col, fx.Row))"></div>
            }
        </div>

        @if (phase == Phase.Finished)
        {
            <div class="td-overlay game-result-overlay">
                <div class="td-win-panel game-result-panel">
                    @if (won)
                    {
                        <h2>🎉 Campaign Complete!</h2>
                        <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great job" : PlayerName + ", great job") - you defended all @levelNumber levels!</p>
                    }
                    else
                    {
                        <h2>💥 Base Overrun</h2>
                        <p>You made it to level @levelNumber - want to try again?</p>
                    }
                    <div class="td-win-stats game-result-stats">
                        <div><span class="game-stat-label">Level</span><span class="game-stat-value">@levelNumber</span></div>
                        <div><span class="game-stat-label">Waves cleared</span><span class="game-stat-value">@totalWavesCleared</span></div>
                        <div><span class="game-stat-label">Defeated</span><span class="game-stat-value">@kills</span></div>
                    </div>
                    <PersonalBestBadge Value="@($"Level {bestLevel ?? levelNumber}")" IsNew="isNewLevelBest" />
                    <div class="td-win-actions game-result-actions">
                        <button class="td-start-btn game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="td-restart-btn game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

    @if (showLegend)
    {
        <div class="td-legend-overlay game-result-overlay" @onclick="() => showLegend = false">
            <div class="td-legend-panel game-result-panel" @onclick:stopPropagation="true">
                <h2>💥 Tower Merges</h2>
                <p class="td-legend-intro">Get a tower to level @MaxTowerLevel, then merge it with another maxed tower of the same kind - the fused Mega tower hits everything near its target, not just one enemy.</p>
                @foreach (var t in currentTheme.Towers)
                {
                    var mega = currentTheme.MegaByBaseId[t.Id];
                    <div class="td-legend-row">
                        <img class="td-legend-icon" src="@t.ImagePath" alt="" />
                        <span class="td-legend-plus">+</span>
                        <img class="td-legend-icon" src="@t.ImagePath" alt="" />
                        <span class="td-legend-arrow">➜</span>
                        <img class="td-legend-icon mega" src="@mega.ImagePath" alt="" />
                        <span class="td-legend-name">@mega.Name</span>
                    </div>
                }
                <button class="td-panel-btn game-primary-action" @onclick="() => showLegend = false">Got it</button>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<TowerDefenseResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (highest level reached) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    private int? bestLevel;
    private bool isNewLevelBest;

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    /// <summary>Which visual theme's towers/enemies to use - "animal"
    /// (default, the original theme) or "cat" (Cat Defense).</summary>
    [Parameter] public string Theme { get; set; } = "animal";

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard, Endless }

    /// <summary>LevelsToWin null means no cap - only Endless plays that way;
    /// Easy/Medium/Hard are a completable campaign.</summary>
    private record DifficultyConfig(int StartGold, int StartLives, double EnemyHpMult, int? LevelsToWin);

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard, Difficulty.Endless };

    private const int LevelsToWinCampaign = 3;

    private static DifficultyConfig ConfigFor(Difficulty d) => d switch
    {
        Difficulty.Easy => new DifficultyConfig(160, 25, 0.85, LevelsToWinCampaign),
        Difficulty.Medium => new DifficultyConfig(120, 20, 1.0, LevelsToWinCampaign),
        Difficulty.Hard => new DifficultyConfig(90, 15, 1.25, LevelsToWinCampaign),
        _ => new DifficultyConfig(90, 15, 1.25, null), // Endless - same bar as Hard, but never stops
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    // ---- Tower / enemy definitions -----------------------------------

    private record TowerType(string Id, string Name, string ImagePath, int Cost, double RangeCells, int Damage, int FireIntervalMs, bool IsMega = false, double SplashRadiusCells = 0, string ShotColor = "#ffe066", bool HeavyShot = false);

    private static readonly TowerType[] AnimalTowerTypes =
    {
        new("gatling", "Gatling", "images/tower-defense/tower-gatling.png", 40, 2.2, 6, 350, ShotColor: "#ffe066"),
        new("cannon", "Cannon", "images/tower-defense/tower-cannon.png", 80, 2.8, 18, 700, ShotColor: "#ffa94d"),
        new("rocket", "Rocket", "images/tower-defense/tower-rocket.png", 150, 3.4, 42, 1300, ShotColor: "#ff6b6b", HeavyShot: true),
    };

    // Only reachable by merging two max-level towers of the same base type
    // (see MergeTower) - never appears in the buyable palette, but Cost is
    // still set to a real value here because UpgradeCost() reads Type.Cost
    // for its scaling, and a Mega tower can still be leveled up further.
    // Splash damage (SplashRadiusCells) is the Mega tier's real upgrade,
    // not just bigger numbers: their hits now damage everything nearby too.
    private static readonly TowerType AnimalMegaGatling = new("mega-gatling", "Mega Gatling", "images/tower-defense/tower-gatling.png", 100, 3.0, 16, 220, IsMega: true, SplashRadiusCells: 0.9);
    private static readonly TowerType AnimalMegaCannon = new("mega-cannon", "Mega Cannon", "images/tower-defense/tower-cannon.png", 200, 3.6, 46, 550, IsMega: true, SplashRadiusCells: 1.1);
    private static readonly TowerType AnimalMegaRocket = new("mega-rocket", "Mega Rocket", "images/tower-defense/tower-rocket.png", 350, 4.2, 100, 1050, IsMega: true, SplashRadiusCells: 1.4);

    private static readonly Dictionary<string, TowerType> AnimalMegaByBaseId = new()
    {
        ["gatling"] = AnimalMegaGatling,
        ["cannon"] = AnimalMegaCannon,
        ["rocket"] = AnimalMegaRocket,
    };

    // Cat Defense theme - same mechanics/balance, reskinned via
    // craftpix-net-397030's cat characters (verified tonally consistent
    // and format-usable; see ASSET_TRIAGE.md). The gun-toting cat reads as
    // the rapid-fire tier, the shielded plunger-cat as the sturdy middle
    // tier, the boxing cat as the heavy hitter - same cost/range/damage
    // envelope as the animal theme's gatling/cannon/rocket so difficulty
    // feels identical, just reskinned.
    private static readonly TowerType[] CatTowerTypes =
    {
        new("cat-gatling", "Scout Cat", "images/catdefense/tower-gatling.png", 40, 2.2, 6, 350, ShotColor: "#ffe066"),
        new("cat-cannon", "Guardian Cat", "images/catdefense/tower-cannon.png", 80, 2.8, 18, 700, ShotColor: "#ffa94d"),
        new("cat-rocket", "Boxer Cat", "images/catdefense/tower-rocket.png", 150, 3.4, 42, 1300, ShotColor: "#ff6b6b", HeavyShot: true),
    };

    private static readonly TowerType CatMegaGatling = new("mega-cat-gatling", "Mega Scout Cat", "images/catdefense/tower-gatling.png", 100, 3.0, 16, 220, IsMega: true, SplashRadiusCells: 0.9);
    private static readonly TowerType CatMegaCannon = new("mega-cat-cannon", "Mega Guardian Cat", "images/catdefense/tower-cannon.png", 200, 3.6, 46, 550, IsMega: true, SplashRadiusCells: 1.1);
    private static readonly TowerType CatMegaRocket = new("mega-cat-rocket", "Mega Boxer Cat", "images/catdefense/tower-rocket.png", 350, 4.2, 100, 1050, IsMega: true, SplashRadiusCells: 1.4);

    private static readonly Dictionary<string, TowerType> CatMegaByBaseId = new()
    {
        ["cat-gatling"] = CatMegaGatling,
        ["cat-cannon"] = CatMegaCannon,
        ["cat-rocket"] = CatMegaRocket,
    };

    private record EnemyType(string Id, string ImagePath, int Hp, double SpeedCellsPerSec, int Reward, int LifeCost);

    // Reuses Memory Match's animal art rather than the tower-defense pack's
    // tanks - reads friendlier for a kids' game. Originally 6 of the 13
    // Memory Match animals; a later variety pass considered CraftPix's
    // dedicated tower-defense monster packs but rejected them after
    // actually viewing sample sprites (see ASSET_TRIAGE.md's "Tower
    // Defense Variety" section) - one is a sharp-fanged insectoid that
    // clashes badly with this game's soft round style, the other (Cat
    // Defense kit)'s Json-Atlas enemy folder is a Spine skeletal rig, not
    // usable images. The remaining 7 Memory Match animals were sitting
    // unused and already match perfectly, so the variety pass used those
    // instead - zero new asset work, same art style, just more stat
    // profiles.
    private static readonly EnemyType RabbitEnemy = new("rabbit", "images/memory/animals/rabbit.png", 25, 1.6, 4, 1);
    private static readonly EnemyType DuckEnemy = new("duck", "images/memory/animals/duck.png", 40, 1.1, 5, 1);
    private static readonly EnemyType ChickEnemy = new("chick", "images/memory/animals/chick.png", 18, 1.8, 3, 1);
    private static readonly EnemyType FrogEnemy = new("frog", "images/memory/animals/frog.png", 32, 1.45, 4, 1);
    private static readonly EnemyType PigEnemy = new("pig", "images/memory/animals/pig.png", 55, 1.0, 6, 1);
    private static readonly EnemyType DogEnemy = new("dog", "images/memory/animals/dog.png", 45, 1.35, 6, 1);
    private static readonly EnemyType CowEnemy = new("cow", "images/memory/animals/cow.png", 60, 0.95, 7, 1);
    private static readonly EnemyType MonkeyEnemy = new("monkey", "images/memory/animals/monkey.png", 48, 1.25, 6, 1);
    private static readonly EnemyType BearEnemy = new("bear", "images/memory/animals/bear.png", 100, 0.75, 10, 2);
    private static readonly EnemyType OwlEnemy = new("owl", "images/memory/animals/owl.png", 85, 0.85, 9, 2);
    private static readonly EnemyType GiraffeEnemy = new("giraffe", "images/memory/animals/giraffe.png", 110, 0.7, 12, 2);
    private static readonly EnemyType ElephantEnemy = new("elephant", "images/memory/animals/elephant.png", 220, 0.5, 25, 3);
    private static readonly EnemyType PandaEnemy = new("panda", "images/memory/animals/panda.png", 180, 0.55, 20, 3);

    // Cat Defense enemies - craftpix-net-397030's Png/Enemies/Enemy Reg/Boss
    // folders (flat pre-rendered PNG frames, a different location than the
    // Spine-atlas folder ASSET_TRIAGE.md rejected - see its "Tower Defense
    // Variety" section for the distinction). 8 "critter" regulars plus 2
    // bigger "boss" critters for late-wave variety, same tiered-rarity
    // shape as the animal theme.
    private static readonly EnemyType CritterA1 = new("critter-a1", "images/catdefense/enemy-reg-1.png", 20, 1.8, 4, 1);
    private static readonly EnemyType CritterA2 = new("critter-a2", "images/catdefense/enemy-reg-2.png", 24, 1.6, 4, 1);
    private static readonly EnemyType CritterA3 = new("critter-a3", "images/catdefense/enemy-reg-3.png", 20, 1.9, 3, 1);
    private static readonly EnemyType CritterB1 = new("critter-b1", "images/catdefense/enemy-reg-4.png", 34, 1.4, 4, 1);
    private static readonly EnemyType CritterB2 = new("critter-b2", "images/catdefense/enemy-reg-5.png", 48, 1.15, 6, 1);
    private static readonly EnemyType CritterB3 = new("critter-b3", "images/catdefense/enemy-reg-6.png", 58, 0.95, 7, 1);
    private static readonly EnemyType CritterC1 = new("critter-c1", "images/catdefense/enemy-reg-7.png", 88, 0.8, 9, 2);
    private static readonly EnemyType CritterC2 = new("critter-c2", "images/catdefense/enemy-reg-8.png", 95, 0.78, 9, 2);
    private static readonly EnemyType CritterBoss1 = new("critter-boss1", "images/catdefense/enemy-boss-1.png", 210, 0.5, 22, 3);
    private static readonly EnemyType CritterBoss2 = new("critter-boss2", "images/catdefense/enemy-boss-2.png", 190, 0.55, 20, 3);

    // A tier-gated weighted-pick rule: Type doesn't enter the roll until
    // `wave >= MinWave` (MinWave 0 means always available), then its weight
    // ramps linearly (Growth per wave past the gate) up to Cap. This is the
    // exact shape PickEnemyType used to hand-write per named enemy - see
    // WeightFor for the single formula every theme now shares.
    private record EnemyWeightRule(EnemyType Type, int MinWave, double BaseWeight, double Growth, double Cap);

    private record TdTheme(string Title, string Emoji, TowerType[] Towers, Dictionary<string, TowerType> MegaByBaseId, EnemyWeightRule[] EnemyRules, EnemyType Fallback);

    private static readonly TdTheme AnimalTheme = new(
        Title: "Tower Defense",
        Emoji: "🏯",
        Towers: AnimalTowerTypes,
        MegaByBaseId: AnimalMegaByBaseId,
        EnemyRules: new EnemyWeightRule[]
        {
            new(RabbitEnemy, MinWave: 0, BaseWeight: 2.2, Growth: 0, Cap: 2.2),
            new(DuckEnemy, MinWave: 0, BaseWeight: 2.2, Growth: 0, Cap: 2.2),
            new(ChickEnemy, MinWave: 0, BaseWeight: 2.0, Growth: 0, Cap: 2.0),
            new(FrogEnemy, MinWave: 0, BaseWeight: 2.0, Growth: 0, Cap: 2.0),
            new(PigEnemy, MinWave: 0, BaseWeight: 0.4, Growth: 0.22, Cap: 1.8),
            new(DogEnemy, MinWave: 1, BaseWeight: 0, Growth: 0.3, Cap: 1.8),
            new(CowEnemy, MinWave: 1, BaseWeight: 0.3, Growth: 0.25, Cap: 1.8),
            new(MonkeyEnemy, MinWave: 1, BaseWeight: 0, Growth: 0.3, Cap: 1.8),
            new(BearEnemy, MinWave: 2, BaseWeight: 0, Growth: 0.24, Cap: 1.3),
            new(OwlEnemy, MinWave: 2, BaseWeight: 0, Growth: 0.22, Cap: 1.3),
            new(GiraffeEnemy, MinWave: 3, BaseWeight: 0, Growth: 0.22, Cap: 1.1),
            new(ElephantEnemy, MinWave: 4, BaseWeight: 0, Growth: 0.15, Cap: 0.6),
            new(PandaEnemy, MinWave: 4, BaseWeight: 0, Growth: 0.15, Cap: 0.6),
        },
        Fallback: DuckEnemy);

    private static readonly TdTheme CatTheme = new(
        Title: "Cat Defense",
        Emoji: "🐱",
        Towers: CatTowerTypes,
        MegaByBaseId: CatMegaByBaseId,
        EnemyRules: new EnemyWeightRule[]
        {
            new(CritterA1, MinWave: 0, BaseWeight: 2.2, Growth: 0, Cap: 2.2),
            new(CritterA2, MinWave: 0, BaseWeight: 2.2, Growth: 0, Cap: 2.2),
            new(CritterA3, MinWave: 0, BaseWeight: 2.0, Growth: 0, Cap: 2.0),
            new(CritterB1, MinWave: 0, BaseWeight: 0.4, Growth: 0.22, Cap: 1.8),
            new(CritterB2, MinWave: 1, BaseWeight: 0, Growth: 0.3, Cap: 1.8),
            new(CritterB3, MinWave: 1, BaseWeight: 0.3, Growth: 0.25, Cap: 1.8),
            new(CritterC1, MinWave: 2, BaseWeight: 0, Growth: 0.24, Cap: 1.3),
            new(CritterC2, MinWave: 2, BaseWeight: 0, Growth: 0.22, Cap: 1.3),
            new(CritterBoss1, MinWave: 4, BaseWeight: 0, Growth: 0.15, Cap: 0.6),
            new(CritterBoss2, MinWave: 4, BaseWeight: 0, Growth: 0.15, Cap: 0.6),
        },
        Fallback: CritterA2);

    // ---- Grid / levels ---------------------------------------------------

    private const int GridCols = 12;
    private const int GridRows = 8;
    private const int WavesPerLevel = 8;
    private const int TickMs = 100;
    private const int SpawnIntervalMs = 550;
    private const int AutoWaveDelayMs = 8000;

    /// <summary>Random left-to-right route with 3-5 turns: enters at a
    /// random row on the left edge, zig-zags through strictly increasing
    /// columns (so it can never cross or retrace itself), exits at a
    /// random row on the right edge. Called once per level - an unlimited
    /// supply of distinct layouts instead of picking from a fixed set.</summary>
    private ((int Col, int Row)[] Cells, HashSet<(int Col, int Row)> Set) GenerateLevel()
    {
        var currentRow = rng.Next(0, GridRows);
        var waypoints = new List<(int Col, int Row)> { (0, currentRow) };

        var col = 0;
        var segments = rng.Next(3, 6);

        for (var i = 0; i < segments; i++)
        {
            var remainingCols = GridCols - 1 - col;
            var remainingSegments = segments - i;
            if (remainingCols < remainingSegments) break;

            var step = Math.Max(1, remainingCols / (remainingSegments + 1)) + rng.Next(0, 2);
            col = Math.Min(GridCols - 2, col + step);
            waypoints.Add((col, currentRow));

            var newRow = rng.Next(0, GridRows);
            while (newRow == currentRow) newRow = rng.Next(0, GridRows);
            currentRow = newRow;
            waypoints.Add((col, currentRow));
        }

        waypoints.Add((GridCols - 1, currentRow));
        return BuildPath(waypoints.ToArray());
    }

    private static ((int Col, int Row)[] Cells, HashSet<(int Col, int Row)> Set) BuildPath((int Col, int Row)[] waypoints)
    {
        var cells = new List<(int, int)> { waypoints[0] };

        for (var i = 0; i < waypoints.Length - 1; i++)
        {
            var (c, r) = waypoints[i];
            var (c1, r1) = waypoints[i + 1];
            var dc = Math.Sign(c1 - c);
            var dr = Math.Sign(r1 - r);

            while (c != c1 || r != r1)
            {
                c += dc;
                r += dr;
                cells.Add((c, r));
            }
        }

        var arr = cells.ToArray();
        return (arr, new HashSet<(int Col, int Row)>(arr));
    }

    // ---- Runtime state --------------------------------------------------

    private const int MaxTowerLevel = 3;

    private class PlacedTower
    {
        public required TowerType Type;
        public int CooldownMs;
        public int Level = 1;
        public int TotalInvested;
        public double FacingDeg;
    }

    private class ActiveEnemy
    {
        public string Id { get; } = Guid.NewGuid().ToString();
        public required EnemyType Type;
        public double Hp;
        public double PathProgress;
        public int HitFlashMs;
    }

    private class ShotVisual
    {
        public string Id { get; } = Guid.NewGuid().ToString();
        public double FromCol;
        public double FromRow;
        public double ToCol;
        public double ToRow;
        public string TowerTypeId = "";
        public string Color = "#ffe066";
        public bool Heavy;
        public bool Mega;
        public int Age;
    }

    /// <summary>A one-shot "boom" ring - Big for a tower fusion, small for
    /// a Mega tower's splash hit.</summary>
    private class BoomEffect
    {
        public string Id { get; } = Guid.NewGuid().ToString();
        public double Col;
        public double Row;
        public int RemainingMs;
        public bool Big;
    }

    private const int BoomEffectMs = 450;
    private const int MergeBoomMs = 700;

    private static int UpgradeCost(PlacedTower t) => t.Type.Cost / 2 * t.Level;
    private static int SellValue(PlacedTower t) => (int)Math.Round(t.TotalInvested * 0.6);
    private static int EffectiveDamage(PlacedTower t) => (int)Math.Round(t.Type.Damage * (1 + 0.5 * (t.Level - 1)));
    private static double EffectiveRange(PlacedTower t) => t.Type.RangeCells * (1 + 0.1 * (t.Level - 1));
    private static int EffectiveFireIntervalMs(PlacedTower t) => Math.Max(150, t.Type.FireIntervalMs - 60 * (t.Level - 1));

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private DifficultyConfig config = ConfigFor(Difficulty.Easy);
    private (int Col, int Row)[] pathCells = Array.Empty<(int, int)>();
    private HashSet<(int Col, int Row)> pathSet = new();
    private readonly Dictionary<(int, int), PlacedTower> towers = new();
    private readonly List<ActiveEnemy> enemies = new();
    private readonly List<ShotVisual> shots = new();
    private readonly List<BoomEffect> boomEffects = new();
    private readonly Queue<EnemyType> pendingSpawns = new();
    private TowerType? selectedTowerType;
    private (int Col, int Row)? selectedPlacedTowerPos;
    private (int Col, int Row)? hoverPreviewCell;
    private bool showLegend;
    private int gold;
    private int lives;
    private int kills;
    private int levelNumber;
    private int waveInLevel;
    private int totalWavesCleared;
    private bool waveInProgress;
    private int spawnCooldownMs;
    private int nextWaveCountdownMs;
    private bool won;
    private readonly Random rng = new();
    private DateTime startedAtUtc;
    private System.Threading.Timer? timer;
    private TdTheme currentTheme = AnimalTheme;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
        currentTheme = Theme == "cat" ? CatTheme : AnimalTheme;
    }

    private void StartGame()
    {
        config = ConfigFor(selectedDifficulty);
        (pathCells, pathSet) = GenerateLevel();
        towers.Clear();
        enemies.Clear();
        shots.Clear();
        boomEffects.Clear();
        pendingSpawns.Clear();
        selectedTowerType = null;
        selectedPlacedTowerPos = null;
        hoverPreviewCell = null;
        gold = config.StartGold;
        lives = config.StartLives;
        kills = 0;
        levelNumber = 1;
        waveInLevel = 0;
        totalWavesCleared = 0;
        waveInProgress = false;
        spawnCooldownMs = 0;
        nextWaveCountdownMs = 0;
        won = false;
        bestLevel = null;
        isNewLevelBest = false;
        startedAtUtc = DateTime.UtcNow;
        phase = Phase.Playing;
        StartTimer();
    }

    // Reached from two places: the persistent HUD's "← Exit" during an
    // active run (a genuine early exit, never yet logged), and the
    // Finished overlay's "Exit" (reached after FinishGame() already
    // logged it - must not log again here).
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            if (!string.IsNullOrEmpty(ProfileId))
            {
                await Data.TryRecordBestAsync(ProfileId, BuiltInGames.TowerDefense, "best-level", levelNumber, lowerIsBetter: false);
            }

            await OnComplete.InvokeAsync(new TowerDefenseResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: false,
                LevelsReached: levelNumber,
                TotalWavesCleared: totalWavesCleared,
                Kills: kills,
                Lives: Math.Max(0, lives),
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }

        StopTimer();
        phase = Phase.Setup;
    }

    private bool CanStartWave() => phase == Phase.Playing && !waveInProgress;

    private void StartWave()
    {
        if (!CanStartWave()) return;

        var count = 5 + totalWavesCleared * 2;
        for (var i = 0; i < count; i++)
        {
            pendingSpawns.Enqueue(PickEnemyType(totalWavesCleared));
        }

        waveInProgress = true;
        spawnCooldownMs = 0;
        nextWaveCountdownMs = 0;
    }

    /// <summary>A rule doesn't enter the roll until wave &gt;= MinWave (0
    /// means always available), then its weight ramps linearly by Growth
    /// per wave past that gate, capped at Cap - reproduces exactly what
    /// PickEnemyType used to hand-write per named animal (verified against
    /// the original formulas), now shared by every theme's roster.</summary>
    private static double WeightFor(EnemyWeightRule rule, int wave)
    {
        if (rule.MinWave > 0 && wave < rule.MinWave) return 0;
        var rampWave = rule.MinWave > 0 ? wave - rule.MinWave + 1 : wave;
        return Math.Min(rule.Cap, rule.BaseWeight + rule.Growth * rampWave);
    }

    /// <summary>Weighted pick across the current theme's enemy roster.
    /// Uses the run's total cleared-wave count (not the current level's),
    /// so difficulty keeps climbing across level transitions instead of
    /// resetting each time a new level starts.</summary>
    private EnemyType PickEnemyType(int wave)
    {
        var rules = currentTheme.EnemyRules;
        var total = rules.Sum(r => WeightFor(r, wave));
        var roll = rng.NextDouble() * total;

        foreach (var rule in rules)
        {
            var weight = WeightFor(rule, wave);
            if (roll < weight) return rule.Type;
            roll -= weight;
        }

        return currentTheme.Fallback;
    }

    private void SelectTowerType(TowerType type)
    {
        selectedPlacedTowerPos = null;
        selectedTowerType = selectedTowerType?.Id == type.Id ? null : type;
    }

    private void PlaceTower(int col, int row)
    {
        if (phase != Phase.Playing || pathSet.Contains((col, row)) || towers.ContainsKey((col, row))) return;
        if (selectedTowerType is not { } type || gold < type.Cost) return;

        gold -= type.Cost;
        towers[(col, row)] = new PlacedTower { Type = type, TotalInvested = type.Cost };
        selectedTowerType = null;
    }

    private void HandleCellClick(int col, int row)
    {
        if (towers.ContainsKey((col, row)))
        {
            SelectPlacedTower(col, row);
        }
        else if (selectedTowerType is not null)
        {
            PlaceTower(col, row);
        }
        else
        {
            selectedPlacedTowerPos = null;
        }
    }

    private void SelectPlacedTower(int col, int row)
    {
        selectedTowerType = null;
        var pos = (col, row);
        selectedPlacedTowerPos = selectedPlacedTowerPos == pos ? null : pos;
    }

    private void HoverCell(int col, int row)
    {
        if (selectedTowerType is null || pathSet.Contains((col, row)) || towers.ContainsKey((col, row))) return;
        hoverPreviewCell = (col, row);
    }

    private void ClearHover(int col, int row)
    {
        if (hoverPreviewCell == (col, row)) hoverPreviewCell = null;
    }

    private void UpgradeTower((int Col, int Row) pos)
    {
        if (!towers.TryGetValue(pos, out var tower) || tower.Level >= MaxTowerLevel) return;

        var cost = UpgradeCost(tower);
        if (gold < cost) return;

        gold -= cost;
        tower.TotalInvested += cost;
        tower.Level++;
    }

    private void SellTower((int Col, int Row) pos)
    {
        if (!towers.TryGetValue(pos, out var tower)) return;

        gold += SellValue(tower);
        towers.Remove(pos);
        selectedPlacedTowerPos = null;
    }

    private bool CanMerge(PlacedTower tower) =>
        !tower.Type.IsMega && tower.Level >= MaxTowerLevel && currentTheme.MegaByBaseId.ContainsKey(tower.Type.Id);

    /// <summary>Nearest other max-level tower of the same base type - the
    /// one that Merge will consume. Returns null if there isn't one yet.</summary>
    private (int Col, int Row)? FindMergePartner((int Col, int Row) pos, PlacedTower tower)
    {
        (int Col, int Row)? best = null;
        var bestDist = double.MaxValue;

        foreach (var (otherPos, otherTower) in towers)
        {
            if (otherPos == pos || otherTower.Type.Id != tower.Type.Id || otherTower.Level < MaxTowerLevel) continue;

            var dist = Math.Pow(otherPos.Item1 - pos.Col, 2) + Math.Pow(otherPos.Item2 - pos.Row, 2);
            if (dist < bestDist)
            {
                bestDist = dist;
                best = (otherPos.Item1, otherPos.Item2);
            }
        }

        return best;
    }

    /// <summary>Fuses the tower at pos with its nearest same-type maxed
    /// partner into a Mega tower at pos - the partner's tile goes empty.
    /// Both towers' total investment carries over (nothing is lost), and
    /// an "Epic Boom Boom" plays at both tiles to sell the fusion.</summary>
    private async Task MergeTower((int Col, int Row) pos)
    {
        if (!towers.TryGetValue(pos, out var tower) || !CanMerge(tower)) return;
        if (FindMergePartner(pos, tower) is not { } partner || !towers.TryGetValue(partner, out var partnerTower)) return;

        var mega = currentTheme.MegaByBaseId[tower.Type.Id];
        var combinedInvested = tower.TotalInvested + partnerTower.TotalInvested;

        towers.Remove(partner);
        towers[pos] = new PlacedTower { Type = mega, TotalInvested = combinedInvested, FacingDeg = tower.FacingDeg };
        selectedPlacedTowerPos = pos;

        boomEffects.Add(new BoomEffect { Col = pos.Col + 0.5, Row = pos.Row + 0.5, RemainingMs = MergeBoomMs, Big = true });
        boomEffects.Add(new BoomEffect { Col = partner.Col + 0.5, Row = partner.Row + 0.5, RemainingMs = MergeBoomMs, Big = true });
        StateHasChanged();

        await Interop.InvokeVoidAsync("playExplosionSound");
    }

    private string EnemyStyle(ActiveEnemy enemy) => CellPercentStyle(EnemyPosition(enemy));

    /// <summary>Cell-centered coordinates (a raw path cell of (3,6) sits
    /// visually at the middle of that cell, i.e. (3.5, 6.5)) - every
    /// consumer (targeting distance, range circles, shot endpoints, HUD
    /// rendering) reads this same centered value so they all agree on
    /// where an enemy actually is.</summary>
    private (double Col, double Row) EnemyPosition(ActiveEnemy enemy)
    {
        var idx = (int)Math.Floor(enemy.PathProgress);
        (double Col, double Row) cell;

        if (idx >= pathCells.Length - 1)
        {
            cell = pathCells[^1];
        }
        else
        {
            var frac = enemy.PathProgress - idx;
            var a = pathCells[idx];
            var b = pathCells[idx + 1];
            cell = (a.Col + (b.Col - a.Col) * frac, a.Row + (b.Row - a.Row) * frac);
        }

        return (cell.Col + 0.5, cell.Row + 0.5);
    }

    private static string CellPercentStyle((double Col, double Row) centered)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var left = (centered.Col / GridCols * 100).ToString("0.##", inv);
        var top = (centered.Row / GridRows * 100).ToString("0.##", inv);
        return $"left:{left}%; top:{top}%;";
    }

    private static string RangeCircleStyle((int Col, int Row) pos, double rangeCells)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var left = ((pos.Col + 0.5) / GridCols * 100).ToString("0.##", inv);
        var top = ((pos.Row + 0.5) / GridRows * 100).ToString("0.##", inv);
        var diameterPct = (rangeCells * 2 / GridCols * 100).ToString("0.##", inv);
        return $"left:{left}%; top:{top}%; width:{diameterPct}%;";
    }

    // Mega shots are always a fixed gold regardless of base tower color -
    // matches the original per-id CSS's ".mega-*" rules, which all shared
    // one gold (#ffd43b) rather than each mega tier keeping its base tint.
    private const string MegaShotColor = "#ffd43b";

    private static string ShotStyle(ShotVisual shot)
    {
        var centered = shot.Age == 0 ? (shot.FromCol, shot.FromRow) : (shot.ToCol, shot.ToRow);
        var color = shot.Mega ? MegaShotColor : shot.Color;
        return $"{CellPercentStyle(centered)} color:{color}; background:{color};";
    }

    private static string TowerIconStyle(PlacedTower t)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return $"transform:rotate({t.FacingDeg.ToString("0.#", inv)}deg);";
    }

    // Tick isn't awaited by the Timer that invokes it, so nothing stops the
    // next 100ms tick from starting while this one is still mid-flight
    // (e.g. several towers each awaiting Interop's JS round-trip in
    // the same tick can push its total runtime past TickMs). Without this
    // guard, two ticks could interleave writes to the same enemies/towers/
    // gold state. Missing an occasional tick under load is harmless; racing
    // two of them against the same state is not.
    private bool tickRunning;

    private void Tick(object? _) => InvokeAsync(async () =>
    {
        if (tickRunning) return;
        tickRunning = true;
        try
        {
        if (phase != Phase.Playing) return;

        // Auto-advance to the next wave after a short breather, unless the
        // player already jumped in early via the wave button. The very
        // first wave never auto-starts - StartGame leaves this at 0 - so
        // there's always time to place opening towers before anything
        // spawns.
        if (!waveInProgress && nextWaveCountdownMs > 0)
        {
            nextWaveCountdownMs -= TickMs;
            if (nextWaveCountdownMs <= 0)
            {
                nextWaveCountdownMs = 0;
                StartWave();
            }
        }

        // Spawn scheduling for the current wave.
        if (pendingSpawns.Count > 0)
        {
            spawnCooldownMs -= TickMs;
            if (spawnCooldownMs <= 0)
            {
                var type = pendingSpawns.Dequeue();
                var hpScale = config.EnemyHpMult * (1 + totalWavesCleared * 0.04);
                enemies.Add(new ActiveEnemy { Type = type, Hp = type.Hp * hpScale });
                spawnCooldownMs = SpawnIntervalMs;
            }
        }

        // Enemy movement - reaching the end costs lives instead of gold.
        for (var i = enemies.Count - 1; i >= 0; i--)
        {
            var enemy = enemies[i];
            if (enemy.HitFlashMs > 0) enemy.HitFlashMs -= TickMs;

            enemy.PathProgress += enemy.Type.SpeedCellsPerSec * (TickMs / 1000.0);
            if (enemy.PathProgress >= pathCells.Length - 1)
            {
                lives -= enemy.Type.LifeCost;
                enemies.RemoveAt(i);
            }
        }

        if (lives <= 0)
        {
            await FinishGame(won: false);
            return;
        }

        // Tower firing - each ready tower shoots the enemy furthest along
        // the path (closest to breaking through) that's within range.
        // Facing is updated every tick regardless of cooldown, so a tower
        // visibly tracks a target the instant one comes into range rather
        // than only snapping to face it at the moment it fires.
        foreach (var (pos, tower) in towers)
        {
            var towerCol = pos.Item1 + 0.5;
            var towerRow = pos.Item2 + 0.5;
            var range = EffectiveRange(tower);

            ActiveEnemy? target = null;
            var bestProgress = -1.0;
            foreach (var enemy in enemies)
            {
                var (col, row) = EnemyPosition(enemy);
                var dist = Math.Sqrt(Math.Pow(col - towerCol, 2) + Math.Pow(row - towerRow, 2));
                if (dist <= range && enemy.PathProgress > bestProgress)
                {
                    bestProgress = enemy.PathProgress;
                    target = enemy;
                }
            }

            if (target is not null)
            {
                var (aimCol, aimRow) = EnemyPosition(target);
                // 0deg = sprite's neutral "facing up" art; positive = clockwise.
                tower.FacingDeg = Math.Atan2(aimCol - towerCol, towerRow - aimRow) * 180.0 / Math.PI;
            }

            tower.CooldownMs -= TickMs;
            if (tower.CooldownMs > 0 || target is null) continue;

            target.Hp -= EffectiveDamage(tower);
            target.HitFlashMs = 150;
            tower.CooldownMs = EffectiveFireIntervalMs(tower);

            var (targetCol, targetRow) = EnemyPosition(target);
            shots.Add(new ShotVisual
            {
                FromCol = towerCol,
                FromRow = towerRow,
                ToCol = targetCol,
                ToRow = targetRow,
                TowerTypeId = tower.Type.Id,
                Color = tower.Type.ShotColor,
                Heavy = tower.Type.HeavyShot,
                Mega = tower.Type.IsMega,
            });

            // Mega towers' signature "boom" - splash damage to everything
            // near the primary target, at half the primary hit's damage.
            if (tower.Type.SplashRadiusCells > 0)
            {
                foreach (var other in enemies)
                {
                    if (other == target) continue;

                    var (oCol, oRow) = EnemyPosition(other);
                    var splashDist = Math.Sqrt(Math.Pow(oCol - targetCol, 2) + Math.Pow(oRow - targetRow, 2));
                    if (splashDist <= tower.Type.SplashRadiusCells)
                    {
                        other.Hp -= EffectiveDamage(tower) / 2;
                        other.HitFlashMs = 150;
                    }
                }

                boomEffects.Add(new BoomEffect { Col = targetCol, Row = targetRow, RemainingMs = BoomEffectMs, Big = false });
            }

            await Interop.InvokeVoidAsync("playImpactSound");
        }

        // Age shots and boom effects by one render frame each - shots
        // render at the tower's position on the tick they're fired, then
        // the target's position on the next tick, so the CSS left/top
        // transition animates a quick travel rather than teleporting.
        for (var i = shots.Count - 1; i >= 0; i--)
        {
            shots[i].Age++;
            if (shots[i].Age > 1) shots.RemoveAt(i);
        }

        for (var i = boomEffects.Count - 1; i >= 0; i--)
        {
            boomEffects[i].RemainingMs -= TickMs;
            if (boomEffects[i].RemainingMs <= 0) boomEffects.RemoveAt(i);
        }

        // Resolve deaths after firing so a killing blow doesn't briefly render at negative HP.
        for (var i = enemies.Count - 1; i >= 0; i--)
        {
            if (enemies[i].Hp <= 0)
            {
                gold += enemies[i].Type.Reward;
                kills++;
                enemies.RemoveAt(i);
            }
        }

        if (waveInProgress && pendingSpawns.Count == 0 && enemies.Count == 0)
        {
            waveInProgress = false;
            waveInLevel++;
            totalWavesCleared++;

            if (waveInLevel >= WavesPerLevel)
            {
                if (config.LevelsToWin is { } cap && levelNumber >= cap)
                {
                    await FinishGame(won: true);
                    return;
                }

                // New level, new path - refund every placed tower in full
                // (this isn't a choice the player made, so it shouldn't
                // cost them) and let them rebuild for the new layout.
                levelNumber++;
                waveInLevel = 0;
                gold += towers.Values.Sum(t => t.TotalInvested);
                towers.Clear();
                selectedPlacedTowerPos = null;
                selectedTowerType = null;
                (pathCells, pathSet) = GenerateLevel();
            }

            nextWaveCountdownMs = AutoWaveDelayMs;
        }

        StateHasChanged();
        }
        finally
        {
            tickRunning = false;
        }
    });

    private async Task FinishGame(bool won)
    {
        StopTimer();
        phase = Phase.Finished;
        this.won = won;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "best-level";
            bestLevel = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.TowerDefense, key);
            isNewLevelBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.TowerDefense, key, levelNumber, lowerIsBetter: false);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new TowerDefenseResult(
                Difficulty: DifficultyName(selectedDifficulty),
                Won: won,
                LevelsReached: levelNumber,
                TotalWavesCleared: totalWavesCleared,
                Kills: kills,
                Lives: Math.Max(0, lives),
                ElapsedSeconds: (int)(DateTime.UtcNow - startedAtUtc).TotalSeconds));
        }
    }

    private void StartTimer()
    {
        StopTimer();
        timer = new System.Threading.Timer(Tick, null, TickMs, TickMs);
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        Difficulty.Hard => "Hard",
        _ => "Endless",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "More gold, more lives",
        Difficulty.Medium => "Balanced",
        Difficulty.Hard => "Less gold, tougher enemies",
        _ => "Hard's rules - no end, see how far you get",
    };

    public ValueTask DisposeAsync()
    {
        StopTimer();
        return ValueTask.CompletedTask;
    }

    public record TowerDefenseResult(string Difficulty, bool Won, int LevelsReached, int TotalWavesCleared, int Kills, int Lives, int ElapsedSeconds);
}
