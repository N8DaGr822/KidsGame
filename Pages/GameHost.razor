@code {
    [Parameter] public string GameId { get; set; } = "";

    private Game? _game;
    private PlaySession? _session;
    private System.Threading.Timer? _checkpointTimer;
    private IDisposable? _navigationRegistration;
    private int _routeGeneration;
    private bool _disposed;
    private string? _difficultyOverride;
    private readonly GameHudSlot _hudSlot = new();

    protected override void OnInitialized()
    {
        _hudSlot.Changed += HandleHudChanged;
        _navigationRegistration = Nav.RegisterLocationChangingHandler(async _ => await EndSessionAsync());
    }

    protected override async Task OnParametersSetAsync()
    {
        var generation = ++_routeGeneration;
        await EndSessionAsync();
        if (_disposed || generation != _routeGeneration) return;
        _game = null;
        _session = null;
        var profile = State.CurrentProfile;
        if (profile is null)
        {
            Nav.NavigateTo("");
            return;
        }

        // Game Access: Apply the same enabled/assigned rules at the route boundary as in the picker.
        var allGames = await Data.GetGamesForProfileAsync(profile.Id);
        if (_disposed || generation != _routeGeneration || State.CurrentProfile?.Id != profile.Id) return;
        var game = allGames.FirstOrDefault(g => g.Id == GameId);

        if (game is null)
        {
            Nav.NavigateTo("games");
            return;
        }

        var difficulty = await Data.GetDifficultyOverrideAsync(profile.Id, game.Id);
        if (_disposed || generation != _routeGeneration || State.CurrentProfile?.Id != profile.Id) return;
        _game = game;
        _difficultyOverride = difficulty;
        var session = _session = new PlaySession(Data, profile.Id, game.Id, game.LaunchMode == GameLaunchMode.ExternalIframe);
        // Session Checkpoint: Preserve unfinished visits even if the browser closes without async disposal.
        _checkpointTimer = new System.Threading.Timer(_ =>
        {
            if (!_disposed) _ = InvokeAsync(() => ReferenceEquals(session, _session) ? session.CheckpointAsync() : Task.CompletedTask);
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

