@*
    Cryptogram.razor
    A short phrase is encoded with a random letter-substitution cipher
    (every A becomes some other fixed letter throughout, etc.) - tap a
    cipher letter, then tap your guess on the keyboard, and every
    occurrence of that cipher letter updates at once (the real mechanic
    that makes cryptograms solvable: figure out one letter, and you've
    figured out every copy of it). No per-letter right/wrong feedback -
    solving it fully is the only "you got it" signal, same as a real
    cryptogram. Difficulty controls how many letters start pre-revealed.
    A fixed 3-phrase session ends with a result overlay. Personal best
    tracks fastest total time.

    Usage:
        <Cryptogram OnComplete="HandleGameComplete" />
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AppDataService Data
@using KidsGameLauncher.Services

<div class="cg-game">

    @if (phase == Phase.Setup)
    {
        <div class="cg-setup game-setup-panel">
            <h2>🕵️ Cryptogram</h2>
            <p>Crack the secret phrase! Tap a coded letter, then tap your guess - every matching letter updates at once.</p>

            <h3 class="game-section-title">Choose a difficulty</h3>
            @if (LockedDifficulty is { } locked)
            {
                <p class="game-choice-locked">🔒 A parent set this to <strong>@DifficultyName(locked)</strong> (@DifficultyDetail(locked)).</p>
            }
            else
            {
                <div class="game-option-grid">
                    @foreach (var diff in Difficulties)
                    {
                        <button class="game-option-button @(diff == selectedDifficulty ? "selected" : "")" @onclick="() => selectedDifficulty = diff">
                            <span class="cg-diff-name">@DifficultyName(diff)</span>
                            <span class="cg-diff-detail">@DifficultyDetail(diff)</span>
                        </button>
                    }
                </div>
            }

            <button class="game-primary-action" @onclick="StartGame">Start Game</button>
        </div>
    }
    else
    {
        <div class="game-hud">
            <span class="cg-title">Cryptogram</span>
            <span class="game-stat">Phrase @Math.Min(phraseIndex + 1, SessionSize)/@SessionSize</span>
            <button class="game-secondary-action" @onclick="ExitToSetup">← Exit</button>
        </div>

        <div class="cg-puzzle">
            @foreach (var ch in currentPhrase)
            {
                if (ch == ' ')
                {
                    <span class="cg-space"></span>
                }
                else
                {
                    var cipherChar = ch;
                    var guess = guesses.TryGetValue(cipherChar, out var g) ? g : (char?)null;
                    <button class="cg-letter-tile @(selectedCipher == cipherChar ? "selected" : "") @(locked.Contains(cipherChar) ? "locked" : "")"
                            disabled="@locked.Contains(cipherChar)"
                            @onclick="() => selectedCipher = cipherChar">
                        <span class="cg-guess">@(guess?.ToString() ?? "")</span>
                        <span class="cg-cipher">@cipherChar</span>
                    </button>
                }
            }
        </div>

        <div class="cg-keyboard">
            @foreach (var letter in Alphabet)
            {
                <button class="cg-key" disabled="@(selectedCipher is null)" @onclick="() => AssignLetter(letter)">@letter</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(roundMessage))
        {
            <p class="cg-message">@roundMessage</p>
        }

        @if (phase == Phase.Finished)
        {
            <div class="game-result-overlay">
                <div class="game-result-panel">
                    <h2>🕵️ All Done!</h2>
                    <p>@(string.IsNullOrWhiteSpace(PlayerName) ? "Great decoding" : PlayerName + ", great decoding") - @SessionSize phrases in @FormatTime(elapsedSeconds)!</p>
                    <PersonalBestBadge Value="@FormatTime(bestSeconds ?? elapsedSeconds)" IsNew="isNewBest" />
                    <div class="game-result-actions">
                        <button class="game-primary-action" @onclick="StartGame">Play Again</button>
                        <button class="game-secondary-action" @onclick="ExitToSetup">Exit</button>
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public EventCallback<CryptogramResult> OnComplete { get; set; }

    /// <summary>Current kid profile's id, for the personal-best record
    /// (fastest total time) - null skips recording/display.</summary>
    [Parameter] public string? ProfileId { get; set; }

    /// <summary>A parent-locked difficulty name ("Easy"/"Medium"/"Hard")
    /// from the admin panel; when set, the picker is replaced with a
    /// locked note and that difficulty is used.</summary>
    [Parameter] public string? ForcedDifficulty { get; set; }

    private enum Phase { Setup, Playing, Finished }
    public enum Difficulty { Easy, Medium, Hard }

    private const int SessionSize = 3;
    private const string Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    private static readonly Difficulty[] Difficulties = { Difficulty.Easy, Difficulty.Medium, Difficulty.Hard };

    private static readonly string[] Phrases =
    {
        "PRACTICE MAKES PERFECT", "KNOWLEDGE IS POWER", "BETTER LATE THAN NEVER",
        "THE EARLY BIRD CATCHES THE WORM", "EVERY CLOUD HAS A SILVER LINING",
        "CURIOSITY NEVER KILLED THE CAT", "TEAMWORK MAKES THE DREAM WORK",
        "NEVER GIVE UP ON YOUR DREAMS", "KINDNESS IS ALWAYS IN STYLE",
        "MISTAKES HELP US LEARN AND GROW", "DREAM BIG AND WORK HARD",
        "STAY POSITIVE AND KEEP TRYING", "HONESTY IS THE BEST POLICY",
        "ACTIONS SPEAK LOUDER THAN WORDS", "SHARING IS CARING",
    };

    private Difficulty? LockedDifficulty =>
        Enum.TryParse<Difficulty>(ForcedDifficulty, out var d) ? d : null;

    private static int FreeRevealsFor(Difficulty d) => d switch
    {
        Difficulty.Easy => 4,
        Difficulty.Medium => 2,
        _ => 0,
    };

    private Phase phase = Phase.Setup;
    private Difficulty selectedDifficulty = Difficulty.Easy;
    private List<string> sessionPhrases = new();
    private int phraseIndex;
    private string plainPhrase = "";
    private string currentPhrase = "";
    private Dictionary<char, char> plainToCipher = new();
    private Dictionary<char, char> cipherToPlain = new();
    private readonly Dictionary<char, char> guesses = new();
    private readonly HashSet<char> locked = new();
    private char? selectedCipher;
    private string roundMessage = "";
    private int elapsedSeconds;
    private int? bestSeconds;
    private bool isNewBest;
    private readonly Random rng = new();
    private System.Threading.Timer? timer;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        if (LockedDifficulty is { } locked) selectedDifficulty = locked;
    }

    private void StartGame()
    {
        sessionPhrases = Phrases.OrderBy(_ => rng.Next()).Take(SessionSize).ToList();
        phraseIndex = 0;
        elapsedSeconds = 0;
        bestSeconds = null;
        isNewBest = false;
        LoadPhrase();
        phase = Phase.Playing;
        StartTimer();
    }

    private void LoadPhrase()
    {
        plainPhrase = sessionPhrases[phraseIndex];
        roundMessage = "";
        selectedCipher = null;
        guesses.Clear();
        locked.Clear();

        var shuffled = Alphabet.ToCharArray().OrderBy(_ => rng.Next()).ToArray();
        plainToCipher = new Dictionary<char, char>();
        cipherToPlain = new Dictionary<char, char>();
        for (var i = 0; i < Alphabet.Length; i++)
        {
            plainToCipher[Alphabet[i]] = shuffled[i];
            cipherToPlain[shuffled[i]] = Alphabet[i];
        }

        currentPhrase = new string(plainPhrase.Select(c => c == ' ' ? ' ' : plainToCipher[c]).ToArray());

        var distinctCipherLetters = currentPhrase.Where(c => c != ' ').Distinct().OrderBy(_ => rng.Next()).ToList();
        foreach (var c in distinctCipherLetters.Take(FreeRevealsFor(selectedDifficulty)))
        {
            guesses[c] = cipherToPlain[c];
            locked.Add(c);
        }
    }

    // An early exit still logs to play history (with whatever was reached
    // so far) rather than silently vanishing.
    private async Task ExitToSetup()
    {
        if (phase == Phase.Playing && OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CryptogramResult(
                Difficulty: DifficultyName(selectedDifficulty),
                PhrasesSolved: phraseIndex,
                SessionSize: SessionSize,
                ElapsedSeconds: elapsedSeconds));
        }
        StopTimer();
        phase = Phase.Setup;
    }

    private async Task AssignLetter(char plainGuess)
    {
        if (phase != Phase.Playing || selectedCipher is not { } cipher || locked.Contains(cipher)) return;

        guesses[cipher] = plainGuess;
        StateHasChanged();

        if (IsSolved())
        {
            roundMessage = "Solved!";
            await PlaySoundAsync("playMatchSound");
            StateHasChanged();
            await Task.Delay(1200);
            await AdvanceAsync();
        }
    }

    private bool IsSolved()
    {
        foreach (var ch in currentPhrase)
        {
            if (ch == ' ') continue;
            if (!guesses.TryGetValue(ch, out var g) || g != cipherToPlain[ch]) return false;
        }
        return true;
    }

    private async Task AdvanceAsync()
    {
        if (phraseIndex + 1 >= sessionPhrases.Count)
        {
            await FinishGame();
        }
        else
        {
            phraseIndex++;
            LoadPhrase();
            StateHasChanged();
        }
    }

    private async Task PlaySoundAsync(string function)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync(function);
    }

    private async Task FinishGame()
    {
        StopTimer();
        phase = Phase.Finished;

        if (!string.IsNullOrEmpty(ProfileId))
        {
            const string key = "fastest-time";
            bestSeconds = (int?)await Data.GetBestAsync(ProfileId, BuiltInGames.Cryptogram, key);
            isNewBest = await Data.TryRecordBestAsync(ProfileId, BuiltInGames.Cryptogram, key, elapsedSeconds, lowerIsBetter: true);
        }

        StateHasChanged();

        if (OnComplete.HasDelegate)
        {
            await OnComplete.InvokeAsync(new CryptogramResult(
                Difficulty: DifficultyName(selectedDifficulty),
                PhrasesSolved: sessionPhrases.Count,
                SessionSize: SessionSize,
                ElapsedSeconds: elapsedSeconds));
        }
    }

    private void StartTimer()
    {
        StopTimer();
        timer = new System.Threading.Timer(_ =>
        {
            elapsedSeconds++;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    private static string FormatTime(int totalSeconds)
    {
        var span = TimeSpan.FromSeconds(totalSeconds);
        return span.Minutes > 0 ? $"{span.Minutes}:{span.Seconds:00}" : $"0:{span.Seconds:00}";
    }

    private static string DifficultyName(Difficulty d) => d switch
    {
        Difficulty.Easy => "Easy",
        Difficulty.Medium => "Medium",
        _ => "Hard",
    };

    private static string DifficultyDetail(Difficulty d) => d switch
    {
        Difficulty.Easy => "4 letters given free",
        Difficulty.Medium => "2 letters given free",
        _ => "No free letters",
    };

    public async ValueTask DisposeAsync()
    {
        StopTimer();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }

    public record CryptogramResult(string Difficulty, int PhrasesSolved, int SessionSize, int ElapsedSeconds);
}
