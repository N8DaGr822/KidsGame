@implements IAsyncDisposable

<div class="carousel-wrap">
    @if (ShowArrows)
    {
        <button class="carousel-arrow carousel-arrow-left" @onclick="() => ScrollAsync(-ScrollAmount)" aria-label="Scroll left">
            ‹
        </button>
    }

    <div class="carousel-track" @ref="_trackRef">
        @ChildContent
    </div>

    @if (ShowArrows)
    {
        <button class="carousel-arrow carousel-arrow-right" @onclick="() => ScrollAsync(ScrollAmount)" aria-label="Scroll right">
            ›
        </button>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowArrows { get; set; } = true;
    [Parameter] public int ScrollAmount { get; set; } = 320;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference _trackRef;
    private IJSObjectReference? _module;

    private async Task ScrollAsync(int amount)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await _module.InvokeVoidAsync("scrollCarousel", _trackRef, amount);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* app is unloading, safe to ignore */ }
        }
    }
}
